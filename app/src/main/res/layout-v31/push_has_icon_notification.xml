<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/app_window_bg"
    android:layout_width="match_parent"
    android:layout_height="48dp">
    <ImageView
        android:id="@+id/notification_icon"
        android:layout_width="@dimen/x_dp_87"
        android:layout_height="@dimen/x_dp_48"
        android:scaleType="fitXY"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        android:layout_centerVertical="true"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:layout_toEndOf="@+id/notification_icon">
        <TextView
            android:textSize="@dimen/xshare_text_size_medium"
            android:textColor="@color/txt_primary"
            android:ellipsize="end"
            android:id="@+id/notification_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:singleLine="true"
            style="@style/text_style_bold"/>
        <TextView
            android:textSize="@dimen/xshare_text_size_small"
            android:textColor="@color/txt_secondary"
            android:ellipsize="end"
            android:gravity="start|center_vertical"
            android:id="@+id/notification_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:maxLines="2"/>
    </LinearLayout>
    <ImageView
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginTop="3dp"
        android:src="@drawable/x_notification_small_icon"
        android:scaleType="fitXY"
        android:layout_alignParentTop="true"
        android:layout_marginEnd="3dp"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
