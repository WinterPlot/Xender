<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="48dp">
    <TextView
        android:textSize="@dimen/xshare_text_size_medium"
        android:textColor="@color/primary"
        android:id="@+id/notification_cancel_download"
        android:background="@drawable/btn_line_primary_solid_transparent"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/cx_dlg_cancel"
        android:layout_centerVertical="true"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:layout_marginEnd="16dp"
        android:layout_alignParentEnd="true"/>
    <TextView
        android:textSize="@dimen/xshare_text_size_medium"
        android:textColor="@color/txt_primary"
        android:id="@+id/notification_title_tv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:layout_toStartOf="@+id/notification_cancel_download"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="1dp"
        android:layout_alignParentBottom="true"
        android:layout_toStartOf="@+id/notification_cancel_download">
        <ProgressBar
            android:layout_width="0dp"
            android:layout_height="2dp"
            android:max="100"
            android:progress="10"
            android:progressDrawable="@drawable/bg_progress_notification"
            android:layout_weight="1"
            android:layout_marginEnd="12dp"
            style="@style/Widget.AppCompat.ProgressBar.Horizontal"/>
        <TextView
            android:textSize="@dimen/xshare_text_size_small"
            android:textColor="@color/txt_primary"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/progress_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:layout_marginEnd="16dp"/>
    </LinearLayout>
</RelativeLayout>
