<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/app_window_bg"/>
        </shape>
    </item>
    <item
        android:left="-2dp"
        android:right="-2dp"
        android:bottom="-1dp">
        <shape>
            <stroke
                android:width="0.67dp"
                android:color="@color/x_line"
                android:dashWidth="0dp"
                android:dashGap="0dp"/>
        </shape>
    </item>
</layer-list>
