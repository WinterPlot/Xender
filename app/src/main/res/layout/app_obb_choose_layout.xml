<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="@dimen/cx_dp_16"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/ex_dp_16">
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_large"
        android:textColor="@color/primary"
        android:gravity="center"
        android:id="@+id/obb_choose_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/obb_choose_tips_title"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/bold_text_style"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_medium"
        android:textColor="@color/txt_primary"
        android:gravity="center"
        android:id="@+id/obb_choose_title_tips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/cx_dp_16"
        android:text="@string/obb_choose_tips_des"
        app:layout_constraintTop_toBottomOf="@+id/obb_choose_title"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/obb_iv"
        android:layout_width="@dimen/cx_dp_48"
        android:layout_height="@dimen/cx_dp_48"
        android:layout_marginTop="@dimen/cx_dp_16"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/obb_choose_title_tips"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_large"
        android:textColor="@color/txt_primary"
        android:gravity="start"
        android:id="@+id/obb_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/cx_dp_16"
        android:layout_marginRight="@dimen/cx_dp_16"
        android:layout_marginHorizontal="@dimen/cx_dp_16"
        app:layout_constraintBottom_toTopOf="@+id/obb_size"
        app:layout_constraintEnd_toStartOf="@+id/obb_app_checkbox"
        app:layout_constraintLeft_toRightOf="@+id/obb_iv"
        app:layout_constraintRight_toLeftOf="@+id/obb_app_checkbox"
        app:layout_constraintStart_toEndOf="@+id/obb_iv"
        app:layout_constraintTop_toTopOf="@+id/obb_iv"
        style="@style/bold_text_style"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_small"
        android:textColor="@color/txt_secondary"
        android:gravity="start"
        android:id="@+id/obb_size"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/cx_dp_16"
        android:layout_marginRight="@dimen/cx_dp_16"
        android:layout_marginHorizontal="@dimen/cx_dp_16"
        app:layout_constraintBottom_toBottomOf="@+id/obb_iv"
        app:layout_constraintEnd_toStartOf="@+id/obb_app_checkbox"
        app:layout_constraintLeft_toRightOf="@+id/obb_iv"
        app:layout_constraintRight_toLeftOf="@+id/obb_app_checkbox"
        app:layout_constraintStart_toEndOf="@+id/obb_iv"
        app:layout_constraintTop_toBottomOf="@+id/obb_name"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/obb_app_checkbox"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/svg_checkbox_checked"
        android:scaleType="centerInside"
        app:layout_constraintBottom_toBottomOf="@+id/obb_iv"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/obb_iv"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/obb_res_iv"
        android:layout_width="27dp"
        android:layout_height="27dp"
        android:layout_marginTop="@dimen/cx_dp_16"
        android:src="@drawable/svg_obb_files"
        android:layout_marginStart="11dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/obb_iv"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/obb_res_app_iv"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_marginStart="11dp"
        app:layout_constraintBottom_toBottomOf="@+id/obb_res_iv"
        app:layout_constraintEnd_toEndOf="@+id/obb_res_iv"/>
    <TextView
        android:textSize="8sp"
        android:textColor="@color/secondary"
        android:id="@+id/obb_on_update"
        android:background="@drawable/bg_obb_update_tips"
        android:paddingLeft="5dp"
        android:paddingTop="3dp"
        android:paddingRight="5dp"
        android:paddingBottom="3dp"
        android:layout_width="48dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/obb_choose_no_update"
        android:paddingHorizontal="5dp"
        android:paddingVertical="3dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/obb_res_app_iv"/>
    <CheckBox
        android:gravity="center"
        android:id="@+id/obb_res_checkbox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:buttonTint="@color/secondary"
        app:layout_constraintBottom_toBottomOf="@+id/obb_on_update"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/obb_res_app_iv"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_large"
        android:textColor="@color/txt_primary"
        android:ellipsize="middle"
        android:gravity="start"
        android:id="@+id/obb_res_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/cx_dp_16"
        android:layout_marginRight="@dimen/cx_dp_16"
        android:singleLine="true"
        android:layout_marginHorizontal="@dimen/cx_dp_16"
        app:layout_constraintBottom_toTopOf="@+id/obb_res_tips"
        app:layout_constraintEnd_toStartOf="@+id/obb_res_checkbox"
        app:layout_constraintLeft_toRightOf="@+id/obb_res_app_iv"
        app:layout_constraintRight_toLeftOf="@+id/obb_res_checkbox"
        app:layout_constraintStart_toEndOf="@+id/obb_res_app_iv"
        app:layout_constraintTop_toTopOf="@+id/obb_res_iv"
        style="@style/bold_text_style"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_small"
        android:textColor="@color/txt_secondary"
        android:gravity="start"
        android:id="@+id/obb_res_tips"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/cx_dp_16"
        android:layout_marginRight="@dimen/cx_dp_16"
        android:text="@string/obb_res_tips"
        android:maxLines="2"
        android:layout_marginHorizontal="@dimen/cx_dp_16"
        app:layout_constraintBottom_toBottomOf="@+id/obb_on_update"
        app:layout_constraintEnd_toStartOf="@+id/obb_res_checkbox"
        app:layout_constraintLeft_toRightOf="@+id/obb_res_app_iv"
        app:layout_constraintRight_toLeftOf="@+id/obb_res_checkbox"
        app:layout_constraintStart_toEndOf="@+id/obb_res_app_iv"
        app:layout_constraintTop_toBottomOf="@+id/obb_res_name"/>
    <TextView
        android:gravity="center"
        android:id="@+id/obb_ok_btn"
        android:background="@drawable/btn_primary_round_corner"
        android:layout_width="match_parent"
        android:layout_height="@dimen/x_dp_36"
        android:layout_marginLeft="@dimen/x_dp_36"
        android:layout_marginTop="36dp"
        android:layout_marginRight="@dimen/x_dp_36"
        android:text="@string/dlg_ok"
        android:layout_marginHorizontal="@dimen/x_dp_36"
        app:layout_constraintTop_toBottomOf="@+id/obb_on_update"
        style="@style/cx_button_text_style_bold"/>
</androidx.constraintlayout.widget.ConstraintLayout>
