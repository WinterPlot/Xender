<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="start|center_vertical"
    android:orientation="horizontal"
    android:descendantFocusability="blocksDescendants"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatRadioButton
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/button"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:clickable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:checked="false"
        android:button="@drawable/selector_radio_check"
        android:layout_marginStart="@dimen/x_dp_24"
        android:layout_marginEnd="@dimen/x_dp_6"/>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/x_dp_48"
        android:layout_weight="1">
        <TextView
            android:textSize="@dimen/xshare_text_size_large"
            android:textColor="@color/txt_primary"
            android:gravity="start|center_vertical"
            android:layout_gravity="start|center_vertical"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="@dimen/xshare_text_size_medium"
            android:textColor="@color/txt_secondary"
            android:gravity="start|center_vertical"
            android:layout_gravity="start|center_vertical"
            android:id="@+id/xshare_path"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/change_location_btn"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="56dp"
        android:layout_height="match_parent"
        android:src="@drawable/svg_playlist_edit"
        android:paddingStart="@dimen/x_dp_16"
        android:paddingEnd="@dimen/x_dp_16"
        app:tint="@color/primary"/>
</LinearLayout>
