<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/x_drawer_help_item"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="@dimen/x_dp_54">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/img_help_clicked"
        android:duplicateParentState="true"
        android:layout_width="@dimen/x_dp_24"
        android:layout_height="@dimen/x_dp_24"
        android:layout_marginStart="@dimen/x_dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:clickable="false"
        android:duplicateParentState="true"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginLeft="@dimen/x_dp_12"
        android:layout_marginRight="@dimen/x_dp_12"
        android:text="@string/feedback_title"
        android:layout_centerVertical="true"
        android:layout_marginHorizontal="@dimen/x_dp_12"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/x_help_arrow"
        app:layout_constraintStart_toEndOf="@+id/img_help_clicked"
        style="@style/MenuDrawerWidgetTitleNew"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/x_help_arrow"
        android:clickable="false"
        android:layout_width="@dimen/x_dp_16"
        android:layout_height="@dimen/x_dp_16"
        android:layout_marginEnd="@dimen/x_dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
