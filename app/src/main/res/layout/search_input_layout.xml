<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/search_input_layer"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatEditText
        android:textSize="@dimen/xshare_text_size_small"
        android:textColor="@color/txt_primary"
        android:textColorHint="@color/txt_secondary"
        android:gravity="start|center_vertical"
        android:layout_gravity="start|center_vertical"
        android:id="@+id/file_search_et"
        android:background="@drawable/bg_window_2_color_round_corner"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="0dp"
        android:layout_height="32dp"
        android:layout_marginTop="8dp"
        android:hint="@string/file_search_bar_hint"
        android:singleLine="true"
        android:drawablePadding="7dp"
        android:inputType="textNoSuggestions"
        android:windowSoftInputMode="stateAlwaysVisible"
        android:imeOptions="flagNoFullscreen|actionSearch"
        android:drawableStart="@drawable/svg_search"
        android:paddingStart="9dp"
        android:paddingEnd="32dp"
        android:layout_marginStart="@dimen/x_dp_16"
        android:drawableTint="@color/x_222_or_fff"
        app:layout_constraintEnd_toStartOf="@+id/cancel_search"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <requestFocus/>
    </androidx.appcompat.widget.AppCompatEditText>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/clear_search_text"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/svg_ic_cancel"
        android:tint="@color/x_222_or_fff"
        android:layout_marginEnd="7dp"
        app:layout_constraintBottom_toBottomOf="@+id/file_search_et"
        app:layout_constraintEnd_toEndOf="@+id/file_search_et"
        app:layout_constraintTop_toTopOf="@+id/file_search_et"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="14sp"
        android:textColor="@color/txt_primary"
        android:gravity="center"
        android:id="@+id/cancel_search"
        android:paddingLeft="@dimen/x_dp_16"
        android:paddingRight="@dimen/x_dp_16"
        android:focusable="true"
        android:visibility="visible"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_marginTop="8dp"
        android:text="@string/dlg_cancel"
        android:paddingHorizontal="@dimen/x_dp_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_small"
        android:textColor="@color/color_selector_text_search"
        android:gravity="center"
        android:id="@+id/all_cate_text"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="56dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/search_all_cate"
        android:drawableTop="@drawable/selector_search_all_type"
        android:drawablePadding="4dp"
        app:layout_constraintEnd_toStartOf="@+id/music_cate_text"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/file_search_et"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_small"
        android:textColor="@color/color_selector_text_search"
        android:gravity="center"
        android:id="@+id/music_cate_text"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="56dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/audio"
        android:drawableTop="@drawable/selector_search_music_type"
        android:drawablePadding="4dp"
        app:layout_constraintEnd_toStartOf="@+id/video_cate_text"
        app:layout_constraintStart_toEndOf="@+id/all_cate_text"
        app:layout_constraintTop_toBottomOf="@+id/file_search_et"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_small"
        android:textColor="@color/color_selector_text_search"
        android:gravity="center"
        android:id="@+id/video_cate_text"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="56dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/video"
        android:drawableTop="@drawable/selector_search_video_type"
        android:drawablePadding="4dp"
        app:layout_constraintEnd_toStartOf="@+id/ebook_cate_text"
        app:layout_constraintStart_toEndOf="@+id/music_cate_text"
        app:layout_constraintTop_toBottomOf="@+id/file_search_et"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_small"
        android:textColor="@color/color_selector_text_search"
        android:gravity="center"
        android:id="@+id/ebook_cate_text"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="56dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/cata_ebook"
        android:drawableTop="@drawable/selector_search_ebook_type"
        android:drawablePadding="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/video_cate_text"
        app:layout_constraintTop_toBottomOf="@+id/file_search_et"/>
</androidx.constraintlayout.widget.ConstraintLayout>
