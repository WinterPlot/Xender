<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/selectableItemBackground"
    android:layout_width="match_parent"
    android:layout_height="@dimen/x_dp_80">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/opt_linear"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/x_dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/app_installing_item_file_app_iv"
            android:visibility="gone"
            android:layout_width="@dimen/x_dp_66"
            android:layout_height="22dp"
            android:src="@drawable/cx_svg_waiting"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/xshare_text_size_small"
            android:textColor="@color/primary"
            android:gravity="center"
            android:id="@+id/app_result_install"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="@dimen/x_dp_66"
            android:layout_height="@dimen/x_dp_36"
            android:maxHeight="40dp"
            android:text="@string/messenger_open_apk"
            android:singleLine="true"
            android:layout_marginStart="4dp"
            style="@style/title_text_style_bold"/>
    </LinearLayout>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/app_result_image"
        android:layout_marginStart="@dimen/x_dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/history_item_file_icon_iv_style"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_large"
        android:textColor="@color/txt_primary"
        android:ellipsize="end"
        android:gravity="start|center_vertical"
        android:id="@+id/app_result__name_tv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/x_dp_12"
        android:layout_marginRight="@dimen/x_dp_12"
        android:maxLines="1"
        android:singleLine="false"
        android:layout_marginHorizontal="@dimen/x_dp_12"
        app:layout_constraintBottom_toTopOf="@+id/app_result_size_tv"
        app:layout_constraintEnd_toStartOf="@+id/expend_des_cb"
        app:layout_constraintStart_toEndOf="@+id/app_result_image"
        app:layout_constraintTop_toTopOf="@+id/app_result_image"
        style="@style/history_item_file_name_tv_style"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/expend_des_cb"
        android:paddingLeft="@dimen/x_dp_16"
        android:paddingRight="@dimen/x_dp_16"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:tint="@color/x_222_or_fff"
        android:paddingStart="@dimen/x_dp_16"
        android:paddingEnd="@dimen/x_dp_16"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/opt_linear"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_small"
        android:textColor="@color/txt_secondary"
        android:ellipsize="middle"
        android:gravity="start|bottom"
        android:id="@+id/app_result_size_tv"
        android:background="@null"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        app:layout_constraintBottom_toBottomOf="@+id/app_result_image"
        app:layout_constraintStart_toStartOf="@+id/app_result__name_tv"
        app:layout_constraintTop_toBottomOf="@+id/app_result__name_tv"
        style="@style/title_text_font_style"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/disconnect_bundle_flag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/x_dp_3"
        android:src="@drawable/svg_tra_bundle"
        android:layout_marginStart="5dp"
        app:layout_constraintBottom_toBottomOf="@+id/app_result_size_tv"
        app:layout_constraintStart_toEndOf="@+id/app_result_size_tv"
        app:layout_constraintTop_toTopOf="@+id/app_result_size_tv"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="11sp"
        android:textColor="@color/x_red"
        android:id="@+id/disconnect_bundle_abi_error"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="3dp"
        app:layout_constraintBottom_toBottomOf="@+id/app_result_size_tv"
        app:layout_constraintStart_toEndOf="@+id/disconnect_bundle_flag"
        app:layout_constraintTop_toTopOf="@+id/app_result_size_tv"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_small"
        android:textColor="@color/txt_secondary"
        android:ellipsize="middle"
        android:gravity="center"
        android:id="@+id/app_installing_item_file_app__tv"
        android:background="@null"
        android:layout_width="@dimen/x_dp_66"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/x_dp_2"
        android:singleLine="true"
        android:layout_marginEnd="@dimen/x_dp_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/opt_linear"
        style="@style/title_text_font_style"/>
</androidx.constraintlayout.widget.ConstraintLayout>
