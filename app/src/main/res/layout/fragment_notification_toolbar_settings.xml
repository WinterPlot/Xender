<?xml version="1.0" encoding="utf-8"?>
<com.userlabs.xshare.views.XConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_notification_toolbar_settings_0"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:background="@color/primary"
        android:layout_width="match_parent"
        android:layout_height="@dimen/x_dp_48"
        android:tintMode="src_atop"
        app:contentInsetStartWithNavigation="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:popupTheme="@style/Theme.AppCompat.Light.DarkActionBar"
        app:titleTextAppearance="@style/toolbar_text_style_bold"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_large"
        android:textColor="@color/txt_primary"
        android:gravity="center_vertical"
        android:id="@+id/nf_toolbar_des_tv"
        android:duplicateParentState="true"
        android:layout_width="0dp"
        android:layout_height="@dimen/x_dp_72"
        android:fontFamily="sans-serif-medium"
        android:textDirection="locale"
        android:layout_marginStart="@dimen/x_dp_16"
        app:layout_constraintEnd_toStartOf="@+id/nf_toolbar_des_sb"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"
        style="@style/text_style_bold"/>
    <com.userlabs.xshare.views.swbtn.SwitchButton
        android:id="@+id/nf_toolbar_des_sb"
        android:layout_marginEnd="@dimen/x_dp_16"
        app:layout_constraintBottom_toBottomOf="@+id/nf_toolbar_des_tv"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/nf_toolbar_des_tv"
        style="@style/MaterialDesign_settings_SwitchButton"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_large"
        android:textColor="@color/txt_primary"
        android:gravity="center_vertical"
        android:id="@+id/nf_toolbar_function_des_tv"
        android:duplicateParentState="true"
        android:layout_width="0dp"
        android:layout_height="@dimen/x_dp_72"
        android:fontFamily="sans-serif-medium"
        android:textDirection="locale"
        android:layout_marginStart="@dimen/x_dp_16"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/nf_toolbar_des_tv"
        style="@style/text_style_bold"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/nf_toolbar_functions_iv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/x_dp_16"
        android:layout_marginRight="@dimen/x_dp_16"
        android:scaleType="fitCenter"
        android:textDirection="locale"
        android:layout_marginHorizontal="@dimen/x_dp_16"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/nf_toolbar_function_des_tv"/>
</com.userlabs.xshare.views.XConstraintLayout>
