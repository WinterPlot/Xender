<?xml version="1.0" encoding="utf-8"?>
<com.userlabs.xshare.views.XConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_large"
        android:textColor="@color/primary"
        android:gravity="center"
        android:id="@+id/obb_import_tv"
        android:padding="@dimen/cx_dp_16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/obb_choose_tips_title"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/bold_text_style"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_large"
        android:textColor="@color/txt_secondary"
        android:gravity="center"
        android:id="@+id/obb_import_title"
        android:paddingLeft="@dimen/cx_dp_16"
        android:paddingRight="@dimen/cx_dp_16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/obb_res_import_title"
        android:paddingHorizontal="@dimen/cx_dp_16"
        app:layout_constraintTop_toBottomOf="@+id/obb_import_tv"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/obb_cancel"
        android:padding="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/svg_ic_cancel"
        android:tint="@color/x_222_or_fff"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/obb_import_rv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/cx_dp_16"
        android:layout_marginTop="@dimen/cx_dp_16"
        android:layout_marginRight="@dimen/cx_dp_16"
        android:layout_marginHorizontal="@dimen/cx_dp_16"
        app:layout_constraintTop_toBottomOf="@+id/obb_import_title"/>
    <androidx.legacy.widget.Space
        android:layout_width="match_parent"
        android:layout_height="@dimen/cx_dp_24"
        app:layout_constraintTop_toBottomOf="@+id/obb_import_rv"/>
</com.userlabs.xshare.views.XConstraintLayout>
