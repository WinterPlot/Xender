<?xml version="1.0" encoding="utf-8"?>
<com.userlabs.xshare.views.XConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:background="@color/primary"
        android:layout_width="match_parent"
        android:layout_height="@dimen/x_dp_48"
        android:tintMode="src_atop"
        app:contentInsetStartWithNavigation="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:popupTheme="@style/Theme.AppCompat.Light.DarkActionBar"
        app:titleTextAppearance="@style/toolbar_text_style_bold"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_medium"
        android:textColor="@color/txt_primary"
        android:textColorHint="@color/txt_secondary"
        android:gravity="start|center_vertical"
        android:id="@+id/social_base_download_tv"
        android:background="@drawable/bg_window_2_color_round_corner"
        android:paddingLeft="@dimen/x_dp_16"
        android:paddingRight="@dimen/x_dp_16"
        android:layout_width="match_parent"
        android:layout_height="@dimen/x_dp_40"
        android:layout_marginLeft="@dimen/x_dp_16"
        android:layout_marginTop="@dimen/x_dp_16"
        android:layout_marginRight="@dimen/x_dp_16"
        android:hint="@string/facebook_download_hint"
        android:singleLine="true"
        android:paddingHorizontal="@dimen/x_dp_16"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_medium"
        android:textColor="@color/txt_white"
        android:gravity="center"
        android:id="@+id/social_base_paste_down_btn"
        android:background="@drawable/btn_primary_round_corner"
        android:paddingLeft="@dimen/x_dp_16"
        android:paddingRight="@dimen/x_dp_16"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/x_dp_32"
        android:text="@string/social_download_btn_no"
        android:layout_marginEnd="@dimen/x_dp_4"
        android:paddingHorizontal="@dimen/x_dp_16"
        app:layout_constraintBottom_toBottomOf="@+id/social_base_download_tv"
        app:layout_constraintEnd_toEndOf="@+id/social_base_download_tv"
        app:layout_constraintTop_toTopOf="@+id/social_base_download_tv"/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/x_dp_8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/social_base_paste_down_btn">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:orientation="vertical"
            android:id="@+id/x_tk_tutorial_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/xshare_text_size_large"
                android:textColor="@color/txt_primary"
                android:gravity="center"
                android:id="@+id/x_tk_tutorial_tv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/x_dp_177"
                android:text="@string/x_downloader_tutorial"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/x_tk_tutorial_iv1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/x_dp_16"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/x_tk_tutorial_tv"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/x_tk_tutorial_iv2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/x_dp_16"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/x_tk_tutorial_iv1"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</com.userlabs.xshare.views.XConstraintLayout>
