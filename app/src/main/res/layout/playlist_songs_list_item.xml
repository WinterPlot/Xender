<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/player_mp3_icon_list"
    android:background="@drawable/selector_list_item"
    android:addStatesFromChildren="false"
    android:descendantFocusability="blocksDescendants"
    android:layout_width="match_parent"
    android:layout_height="@dimen/x_dp_80"
    android:textDirection="locale"
    android:layoutDirection="locale">
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="center"
        android:id="@+id/player_mp3_icon_item"
        android:layout_width="@dimen/x_dp_56"
        android:layout_height="@dimen/x_dp_56"
        android:scaleType="fitXY"
        android:layout_marginStart="@dimen/x_dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_smaller"
        android:textColor="@color/txt_white"
        android:gravity="center"
        android:layout_gravity="start|bottom"
        android:id="@+id/music_duration_item"
        android:background="@drawable/bg_duration"
        android:paddingLeft="5dp"
        android:paddingRight="5dp"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/x_dp_16"
        android:layout_marginBottom="5dp"
        android:singleLine="true"
        android:layout_marginEnd="3dp"
        android:paddingHorizontal="5dp"
        app:layout_constraintBottom_toBottomOf="@+id/player_mp3_icon_item"
        app:layout_constraintEnd_toEndOf="@+id/player_mp3_icon_item"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/cx_sp_15"
        android:textColor="@color/txt_primary"
        android:ellipsize="middle"
        android:gravity="start|center_vertical"
        android:id="@+id/player_video_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:layout_marginStart="@dimen/x_dp_16"
        app:layout_constraintBottom_toTopOf="@+id/player_mp3_artist"
        app:layout_constraintEnd_toStartOf="@+id/player_mp3_add_playlist_btn"
        app:layout_constraintStart_toEndOf="@+id/player_mp3_icon_item"
        app:layout_constraintTop_toTopOf="@+id/player_mp3_icon_item"
        app:layout_constraintVertical_chainStyle="spread_inside"
        app:layout_goneMarginEnd="@dimen/x_dp_52"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_small"
        android:textColor="@color/txt_secondary"
        android:gravity="start|center_vertical"
        android:id="@+id/player_mp3_artist"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:singleLine="true"
        app:layout_constraintBottom_toTopOf="@+id/player_mp3_size"
        app:layout_constraintEnd_toEndOf="@+id/player_video_name"
        app:layout_constraintStart_toStartOf="@+id/player_video_name"
        app:layout_constraintTop_toBottomOf="@+id/player_video_name"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_small"
        android:textColor="@color/txt_secondary"
        android:gravity="start|center_vertical"
        android:id="@+id/player_mp3_size"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:singleLine="true"
        app:layout_constraintBottom_toBottomOf="@+id/player_mp3_icon_item"
        app:layout_constraintEnd_toEndOf="@+id/player_video_name"
        app:layout_constraintStart_toStartOf="@+id/player_video_name"
        app:layout_constraintTop_toBottomOf="@+id/player_mp3_artist"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/player_mp3_add_playlist_btn"
        android:background="?attr/selectableItemBackground"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="40dp"
        android:layout_height="match_parent"
        android:scaleType="center"
        android:layout_marginStart="@dimen/x_dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/player_mp3_more_opt"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/player_mp3_more_opt"
        android:background="?attr/selectableItemBackground"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="40dp"
        android:layout_height="match_parent"
        android:scaleType="center"
        android:layout_marginStart="@dimen/x_dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.userlabs.xshare.views.XCheckBox
        android:id="@+id/player_mp3_checkbox"
        android:focusable="false"
        android:visibility="gone"
        android:clickable="false"
        android:duplicateParentState="false"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:scaleType="center"
        android:layout_marginEnd="@dimen/x_dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
