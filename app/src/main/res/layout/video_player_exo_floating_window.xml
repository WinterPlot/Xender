<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:textDirection="locale"
    android:layoutDirection="locale">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:keepScreenOn="true">
        <androidx.media3.ui.PlayerView
            android:layout_gravity="center"
            android:id="@+id/floating_player_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:resize_mode="fit"
            app:surface_type="texture_view"
            app:use_controller="false"/>
    </FrameLayout>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/floating_video_play_pause_btn"
        android:visibility="visible"
        android:layout_width="@dimen/vp_dp_50"
        android:layout_height="@dimen/vp_dp_50"
        android:scaleType="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/floating_max_window_btn"
        android:visibility="visible"
        android:layout_width="@dimen/vp_dp_36"
        android:layout_height="@dimen/vp_dp_36"
        android:layout_marginTop="@dimen/vp_dp_10"
        android:scaleType="center"
        android:layout_marginStart="@dimen/vp_dp_10"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/floating_close_btn"
        android:visibility="visible"
        android:layout_width="@dimen/vp_dp_36"
        android:layout_height="@dimen/vp_dp_36"
        android:layout_marginTop="@dimen/vp_dp_10"
        android:scaleType="center"
        android:layout_marginEnd="@dimen/vp_dp_10"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
