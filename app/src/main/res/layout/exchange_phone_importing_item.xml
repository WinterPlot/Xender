<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/ex_bg_window_2_color_corner_10"
    android:layout_width="match_parent"
    android:layout_height="@dimen/ex_dp_60">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/exchange_item_icon"
        android:layout_width="@dimen/ex_dp_24"
        android:layout_height="@dimen/ex_dp_24"
        android:layout_marginLeft="@dimen/ex_dp_16"
        android:layout_marginRight="@dimen/ex_dp_16"
        android:scaleType="centerInside"
        android:layout_marginHorizontal="@dimen/ex_dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_medium"
        android:textColor="@color/primary"
        android:id="@+id/importing_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/ex_dp_16"
        android:layout_marginRight="@dimen/ex_dp_16"
        android:layout_marginHorizontal="@dimen/ex_dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_medium"
        android:textColor="@color/txt_primary"
        android:gravity="start"
        android:id="@+id/exchange_item_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/ex_dp_16"
        android:layout_marginRight="@dimen/ex_dp_16"
        android:layout_marginHorizontal="@dimen/ex_dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/importing_count"
        app:layout_constraintLeft_toRightOf="@+id/exchange_item_icon"
        app:layout_constraintRight_toLeftOf="@+id/importing_count"
        app:layout_constraintStart_toEndOf="@+id/exchange_item_icon"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/text_style_bold"/>
    <ProgressBar
        android:id="@+id/importing_progress"
        android:background="@color/x_transparent"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:max="100"
        android:progressDrawable="@drawable/ex_progress"
        app:layout_constraintBottom_toBottomOf="parent"
        style="?android:attr/progressBarStyleHorizontal"/>
</androidx.constraintlayout.widget.ConstraintLayout>
