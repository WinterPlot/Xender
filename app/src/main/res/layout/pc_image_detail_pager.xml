<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:tag="layout/pc_image_detail_pager_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:textDirection="locale"
    android:layoutDirection="locale">
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/weline_pager"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/top_bar_layout"
        android:background="@color/mask_shadow_no_theme"
        android:layout_width="match_parent"
        android:layout_height="@dimen/x_dp_48">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/image_back"
            android:layout_width="@dimen/x_dp_48"
            android:layout_height="@dimen/x_dp_48"
            android:foreground="?attr/actionBarItemBackground"
            android:scaleType="center"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/xshare_text_size_large_greater"
            android:textColor="@color/txt_white"
            android:gravity="center"
            android:id="@+id/current_count"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/delete_image"
            android:layout_width="@dimen/x_dp_48"
            android:layout_height="@dimen/x_dp_48"
            android:foreground="?attr/actionBarItemBackground"
            android:scaleType="center"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="bottom"
        android:id="@+id/bottom_bar_layout"
        android:layout_width="match_parent"
        android:layout_height="@dimen/x_dp_48">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/push_img"
            android:layout_width="@dimen/x_dp_48"
            android:layout_height="@dimen/x_dp_48"
            android:foreground="?attr/actionBarItemBackground"
            android:scaleType="center"/>
    </LinearLayout>
</FrameLayout>
