<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/phone_image_detail_pager_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:textDirection="locale"
    android:layoutDirection="locale">
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/pager"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:id="@+id/top_bar_layout"
        android:layout_width="match_parent"
        android:layout_height="@dimen/x_dp_48">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/title_back_iv"
            android:layout_width="@dimen/x_dp_48"
            android:layout_height="@dimen/x_dp_48"
            android:foreground="?attr/actionBarItemBackground"
            android:scaleType="center"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="17sp"
            android:textColor="@color/txt_white"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/current_directory"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:maxLines="1"
            android:layout_weight="1"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center"
            android:id="@+id/delete_image_iv"
            android:layout_width="@dimen/x_dp_48"
            android:layout_height="@dimen/x_dp_48"
            android:foreground="?attr/actionBarItemBackground"
            android:scaleType="center"/>
    </LinearLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:gravity="center_vertical"
        android:layout_gravity="bottom"
        android:id="@+id/bottom_bar_layout"
        android:paddingLeft="@dimen/x_dp_16"
        android:paddingRight="@dimen/x_dp_16"
        android:layout_width="match_parent"
        android:layout_height="@dimen/x_dp_48"
        android:paddingHorizontal="@dimen/x_dp_16">
        <androidx.appcompat.widget.AppCompatButton
            android:gravity="center"
            android:id="@+id/image_view_send"
            android:layout_width="@dimen/x_dp_130"
            android:layout_height="@dimen/x_dp_40"
            android:minWidth="93dp"
            android:text="@string/messenger_send"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/button_text_style_bold"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/image_detail_select"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/cb_image_select"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/button_text_style_bold"/>
        <com.userlabs.xshare.views.XCheckBox
            android:id="@+id/cb_image_select"
            android:duplicateParentState="false"
            android:layout_width="@dimen/x_dp_48"
            android:layout_height="@dimen/x_dp_48"
            android:scaleType="center"
            android:layout_marginStart="@dimen/x_dp_16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
