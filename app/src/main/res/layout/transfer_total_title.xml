<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/primary"
    android:layout_width="match_parent"
    android:layout_height="@dimen/x_dp_48">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/progress_title_close_btn"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="@dimen/x_dp_48"
        android:layout_height="match_parent"
        android:foreground="?attr/selectableItemBackground"
        android:scaleType="center"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@color/txt_white"
        android:gravity="center_vertical"
        android:id="@+id/progress_transfer_title_tv"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:text="@string/history_progress_transfering"
        android:drawablePadding="@dimen/x_dp_5"
        app:layout_constraintStart_toEndOf="@+id/progress_title_close_btn"
        style="@style/toolbar_text_style_bold"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/progress_speed_low_tips_iv"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="56dp"
        android:layout_height="match_parent"
        android:scaleType="center"
        app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
