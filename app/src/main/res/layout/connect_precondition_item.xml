<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/selector_list_item"
    android:paddingLeft="@dimen/cx_dp_16"
    android:paddingRight="@dimen/cx_dp_16"
    android:descendantFocusability="blocksDescendants"
    android:layout_width="match_parent"
    android:layout_height="60dp"
    android:textDirection="locale"
    android:layoutDirection="locale"
    android:paddingHorizontal="@dimen/cx_dp_16">
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_medium"
        android:textColor="@color/txt_primary"
        android:gravity="start|center_vertical"
        android:id="@+id/condition_name_tv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:drawablePadding="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/expend_des_cb"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <CheckBox
        android:id="@+id/expend_des_cb"
        android:clickable="false"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:button="@drawable/selector_checkbox_up_down"
        android:tint="@color/x_222_or_fff"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="80dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:gravity="center"
        android:id="@+id/opt_btn_click_area"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        app:layout_constraintEnd_toEndOf="parent">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/xshare_text_size_smaller"
            android:textColor="@color/primary"
            android:gravity="center"
            android:id="@+id/opt_btn"
            android:background="@drawable/btn_primary_line_round_corner"
            android:duplicateParentState="true"
            android:layout_width="64dp"
            android:layout_height="24dp"
            android:singleLine="true"
            style="@style/capital_bold_text_style"/>
    </LinearLayout>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/opt_done_btn"
        android:focusable="false"
        android:visibility="gone"
        android:clickable="false"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/svg_checkbox_checked"
        android:scaleType="center"
        android:layout_marginEnd="22dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ProgressBar
        android:id="@+id/opt_doing_pb"
        android:visibility="gone"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginEnd="22dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
