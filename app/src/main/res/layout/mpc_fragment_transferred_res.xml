<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/mpc_fragment_transferred_res_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/mpc_sp_16"
        android:textColor="@color/mpc_txt_primary"
        android:gravity="center"
        android:id="@+id/res_list_tv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/mpc_dp_16"
        android:layout_marginTop="@dimen/mpc_dp_16"
        android:layout_marginRight="@dimen/mpc_dp_16"
        android:layout_marginHorizontal="@dimen/mpc_dp_16"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/res_list_rv"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/mpc_dp_16"
        app:layout_constraintTop_toBottomOf="@+id/res_list_tv"/>
</androidx.constraintlayout.widget.ConstraintLayout>
