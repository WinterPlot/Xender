<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_x_qr_scan_0"
    android:focusable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.camera.view.PreviewView
        android:id="@+id/view_finder"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:scaleType="fillCenter"/>
    <com.userlabs.xshare.views.CaptureBgView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:cb_rect_size="@dimen/camera_capture_size"
        app:cb_rect_top_margin="@dimen/camera_top_margin"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:id="@+id/capture_crop_layout"
        android:layout_width="@dimen/camera_capture_size"
        android:layout_height="@dimen/camera_capture_size"
        android:layout_marginTop="@dimen/camera_top_margin"
        android:contentDescription="@string/app_name"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/capture_scan_line"
            android:layout_width="match_parent"
            android:layout_height="@dimen/x_dp_56"
            android:layout_marginTop="-50dp"
            android:scaleType="center"
            android:contentDescription="@string/app_name"/>
    </LinearLayout>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_large"
        android:textColor="@color/txt_white"
        android:gravity="center"
        android:id="@+id/android_o_bubble_tips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/x_dp_16"
        android:layout_marginBottom="@dimen/x_dp_16"
        android:layout_marginVertical="@dimen/x_dp_16"
        app:layout_constraintTop_toBottomOf="@+id/capture_crop_layout"
        style="@style/title_text_font_style"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_small"
        android:gravity="center"
        android:id="@+id/camera_scan_tips"
        android:padding="@dimen/x_dp_12"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/x_dp_24"
        android:layout_marginRight="@dimen/x_dp_24"
        android:layout_marginBottom="@dimen/x_dp_10"
        android:layout_marginHorizontal="@dimen/x_dp_24"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/flashlight_switch_btn"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginBottom="@dimen/x_dp_40"
        android:scaleType="center"
        android:layout_centerHorizontal="true"
        app:layout_constraintBottom_toTopOf="@+id/camera_scan_tips"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_goneMarginBottom="@dimen/x_dp_80"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/back_btn"
        android:layout_width="@dimen/x_dp_48"
        android:layout_height="@dimen/x_dp_48"
        android:scaleType="center"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/camera_ios"
        android:layout_width="@dimen/x_dp_48"
        android:layout_height="@dimen/x_dp_48"
        android:scaleType="center"
        android:contentDescription="@string/app_name"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_large"
        android:textColor="@color/txt_white"
        android:gravity="center"
        android:id="@+id/connect_to_web_btn"
        android:paddingLeft="@dimen/x_dp_16"
        android:paddingRight="@dimen/x_dp_16"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/x_dp_40"
        android:layout_marginTop="@dimen/x_dp_16"
        android:drawablePadding="@dimen/x_dp_16"
        android:paddingHorizontal="@dimen/x_dp_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/back_btn"
        style="@style/title_text_font_style"/>
</androidx.constraintlayout.widget.ConstraintLayout>
