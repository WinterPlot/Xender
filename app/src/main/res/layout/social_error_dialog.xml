<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_large_greater"
        android:textStyle="bold"
        android:textColor="@color/txt_primary"
        android:gravity="center"
        android:id="@+id/error_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/x_dp_16"
        android:text="@string/social_url_parse_error_title"
        android:drawablePadding="8dp"/>
    <TextView
        android:textSize="@dimen/xshare_text_size_large"
        android:textColor="@color/txt_secondary"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/x_dp_16"
        android:layout_marginTop="@dimen/x_dp_16"
        android:layout_marginRight="@dimen/x_dp_16"
        android:text="@string/social_url_parse_error_content"/>
    <TextView
        android:textSize="@dimen/xshare_text_size_large"
        android:textColor="@color/txt_secondary"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/x_dp_16"
        android:layout_marginRight="@dimen/x_dp_16"
        android:text="@string/social_url_parse_error_content1"/>
    <View
        android:background="@color/x_child_bg_line"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginTop="@dimen/x_dp_16"/>
    <TextView
        android:textSize="@dimen/xshare_text_size_large_greater"
        android:textColor="@color/primary"
        android:gravity="center"
        android:id="@+id/error_btn"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:text="@string/social_url_parse_error_ok"/>
</LinearLayout>
