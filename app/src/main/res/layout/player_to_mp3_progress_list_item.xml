<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="?attr/selectableItemBackground"
    android:addStatesFromChildren="false"
    android:descendantFocusability="blocksDescendants"
    android:layout_width="match_parent"
    android:layout_height="@dimen/x_dp_96"
    android:textDirection="locale"
    android:layoutDirection="locale">
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="center"
        android:id="@+id/player_mp3_icon_item"
        android:layout_width="@dimen/x_dp_64"
        android:layout_height="@dimen/x_dp_64"
        android:scaleType="fitXY"
        android:layout_marginStart="@dimen/x_dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/player_mp3_cancel"
        android:background="?attr/selectableItemBackground"
        android:focusable="true"
        android:visibility="visible"
        android:clickable="true"
        android:layout_width="40dp"
        android:layout_height="0dp"
        android:src="@drawable/svg_ic_cancel"
        android:scaleType="center"
        android:tint="@color/x_222_or_fff"
        android:layout_marginStart="@dimen/x_dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_large"
        android:textColor="@color/txt_primary"
        android:ellipsize="middle"
        android:gravity="start|center_vertical"
        android:id="@+id/player_video_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/x_dp_6"
        android:singleLine="true"
        android:layout_marginStart="@dimen/x_dp_16"
        android:layout_marginEnd="@dimen/x_dp_40"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/player_mp3_icon_item"
        app:layout_constraintTop_toTopOf="@+id/player_mp3_icon_item"
        app:layout_constraintVertical_weight="1"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_medium"
        android:textColor="@color/txt_secondary"
        android:gravity="start|center_vertical"
        android:id="@+id/player_mp3_size"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:singleLine="true"
        app:layout_constraintBottom_toBottomOf="@+id/player_mp3_icon_item"
        app:layout_constraintEnd_toEndOf="@+id/player_video_name"
        app:layout_constraintStart_toStartOf="@+id/player_video_name"
        app:layout_constraintVertical_weight="1"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_small"
        android:textColor="@color/primary"
        android:layout_gravity="center_vertical"
        android:id="@+id/player_to_mp3_progress"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp"
        android:layout_marginStart="@dimen/x_dp_16"
        android:layout_marginEnd="@dimen/x_dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
    <ProgressBar
        android:id="@+id/player_to_mp3_progress_bar"
        android:visibility="visible"
        android:layout_width="0dp"
        android:layout_height="2dp"
        android:layout_marginLeft="@dimen/x_dp_16"
        android:layout_marginTop="6dp"
        android:layout_marginRight="@dimen/x_dp_16"
        android:max="100"
        android:progress="10"
        android:progressDrawable="@drawable/bg_progress_notification"
        android:layout_weight="1"
        app:layout_constraintEnd_toStartOf="@+id/player_to_mp3_progress"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/player_mp3_icon_item"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"/>
</androidx.constraintlayout.widget.ConstraintLayout>
