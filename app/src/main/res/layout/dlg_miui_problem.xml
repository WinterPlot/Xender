<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingLeft="@dimen/x_dp_16"
    android:paddingTop="@dimen/x_dp_24"
    android:paddingRight="@dimen/x_dp_16"
    android:paddingBottom="@dimen/x_dp_16"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:textDirection="locale"
    android:layoutDirection="locale"
    android:paddingHorizontal="@dimen/x_dp_16">
    <TextView
        android:textSize="@dimen/xshare_text_size_large_greater"
        android:textColor="@color/x_red"
        android:gravity="center"
        android:id="@+id/pb_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/dlg_title_warning"
        android:drawablePadding="5dp"
        app:drawableStartCompat="@drawable/svg_miui_notice_warning"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/xshare_text_size_medium"
        android:textColor="@color/txt_primary"
        android:id="@+id/dlg_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/x_dp_16"
        android:lineSpacingMultiplier="1.3"
        app:layout_constraintTop_toBottomOf="@+id/pb_title"/>
    <TextView
        android:textSize="@dimen/xshare_text_size_medium"
        android:textColor="@color/txt_primary"
        android:id="@+id/dlg_content_des"
        android:background="?attr/selectableItemBackground"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/x_dp_16"
        android:text="@string/miui_tips_2"
        android:lineSpacingMultiplier="1.3"
        app:layout_constraintTop_toBottomOf="@+id/dlg_content"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/des_photo_iv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/x_dp_16"
        android:src="@drawable/x_miui_pop_pic"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/dlg_content_des"/>
    <TextView
        android:gravity="center"
        android:id="@+id/dlg_turn_off"
        android:background="@drawable/btn_primary_round_corner"
        android:layout_width="match_parent"
        android:layout_height="@dimen/x_dp_42"
        android:layout_marginTop="@dimen/x_dp_24"
        android:text="@string/go_to_turn_off"
        app:layout_constraintTop_toBottomOf="@+id/des_photo_iv"
        style="@style/button_text_style_bold"/>
    <TextView
        android:textSize="@dimen/xshare_text_size_large_greater"
        android:textColor="@color/txt_primary"
        android:layout_gravity="center_horizontal"
        android:id="@+id/confirm_turn_off_tv"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/x_dp_50"
        android:text="@string/confirm_turn_off"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/dlg_turn_off"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/btns_layer"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="top_line,yes_btn,line_1,not_btn"/>
    <View
        android:id="@+id/top_line"
        android:background="@color/x_line"
        android:layout_width="0dp"
        android:layout_height="1px"
        android:layout_marginTop="@dimen/x_dp_50"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/confirm_turn_off_tv"/>
    <TextView
        android:textColor="@color/primary"
        android:gravity="center"
        android:id="@+id/yes_btn"
        android:background="@drawable/selector_list_item"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="0dp"
        android:layout_height="42dp"
        android:text="@string/dlg_yes"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/line_1"
        app:layout_constraintTop_toBottomOf="@+id/top_line"
        style="@style/button_text_style_bold"/>
    <View
        android:id="@+id/line_1"
        android:background="@color/x_line"
        android:layout_width="1px"
        android:layout_height="42dp"
        app:layout_constraintEnd_toStartOf="@+id/not_btn"
        app:layout_constraintStart_toEndOf="@+id/yes_btn"
        app:layout_constraintTop_toBottomOf="@+id/top_line"/>
    <TextView
        android:textColor="@color/txt_secondary"
        android:gravity="center"
        android:id="@+id/not_btn"
        android:background="@drawable/selector_list_item"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="0dp"
        android:layout_height="42dp"
        android:text="@string/not_yet"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/line_1"
        app:layout_constraintTop_toBottomOf="@+id/top_line"
        style="@style/button_text_style_bold"/>
</androidx.constraintlayout.widget.ConstraintLayout>
