<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layoutDirection="locale">
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="end"
        android:layout_width="@dimen/x_dp_16"
        android:layout_height="@dimen/x_dp_16"
        android:src="@drawable/bg_triangle_up_add_item"
        android:layout_marginEnd="6dp"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="vertical"
        android:background="@drawable/bg_add_item_main"
        android:layout_width="@dimen/x_dp_180"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="@color/txt_white"
            android:gravity="start|center_vertical"
            android:id="@+id/toolbar_more_pc_btn"
            android:background="?attr/selectableItemBackground"
            android:layout_width="match_parent"
            android:layout_height="@dimen/x_dp_48"
            android:text="@string/toolbar_more_title_connect_pc"
            android:singleLine="true"
            android:drawablePadding="@dimen/x_dp_8"
            android:paddingStart="@dimen/x_dp_16"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/line_1"
            android:background="@color/x_line_light"
            android:layout_width="match_parent"
            android:layout_height="1px"
            android:layout_marginStart="@dimen/x_dp_16"
            app:layout_constraintTop_toBottomOf="@+id/toolbar_more_pc_btn"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="@color/txt_white"
            android:gravity="start|center_vertical"
            android:id="@+id/toolbar_more_jio_btn"
            android:background="?attr/selectableItemBackground"
            android:layout_width="match_parent"
            android:layout_height="@dimen/x_dp_48"
            android:text="@string/toolbar_more_title_connect_jio"
            android:singleLine="true"
            android:drawablePadding="@dimen/x_dp_8"
            android:paddingStart="@dimen/x_dp_16"
            app:layout_constraintTop_toBottomOf="@+id/line_1"/>
        <View
            android:id="@+id/line_2"
            android:background="@color/x_line_light"
            android:layout_width="match_parent"
            android:layout_height="1px"
            android:layout_marginStart="@dimen/x_dp_16"
            app:layout_constraintTop_toBottomOf="@+id/toolbar_more_jio_btn"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="@color/txt_white"
            android:gravity="start|center_vertical"
            android:id="@+id/toolbar_more_scan_qr_btn"
            android:background="?attr/selectableItemBackground"
            android:layout_width="match_parent"
            android:layout_height="@dimen/x_dp_48"
            android:text="@string/toolbar_more_title_connect_android"
            android:singleLine="true"
            android:drawablePadding="@dimen/x_dp_8"
            android:paddingStart="@dimen/x_dp_16"
            app:layout_constraintTop_toBottomOf="@+id/line_2"/>
        <View
            android:id="@+id/line_3"
            android:background="@color/x_line_light"
            android:layout_width="match_parent"
            android:layout_height="1px"
            android:layout_marginStart="@dimen/x_dp_16"
            app:layout_constraintTop_toBottomOf="@+id/toolbar_more_scan_qr_btn"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="@color/txt_white"
            android:gravity="start|center_vertical"
            android:id="@+id/toolbar_more_share_btn"
            android:background="?attr/selectableItemBackground"
            android:layout_width="match_parent"
            android:layout_height="@dimen/x_dp_48"
            android:text="@string/toolbar_more_title_share_xshare"
            android:singleLine="true"
            android:drawablePadding="@dimen/x_dp_8"
            android:paddingStart="@dimen/x_dp_16"
            app:layout_constraintTop_toBottomOf="@+id/line_3"/>
        <View
            android:id="@+id/line_4"
            android:background="@color/x_line_light"
            android:layout_width="match_parent"
            android:layout_height="1px"
            android:layout_marginStart="@dimen/x_dp_16"
            app:layout_constraintTop_toBottomOf="@+id/toolbar_more_share_btn"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="@color/txt_white"
            android:gravity="start|center_vertical"
            android:id="@+id/toolbar_more_phone_p_btn"
            android:background="?attr/selectableItemBackground"
            android:layout_width="match_parent"
            android:layout_height="@dimen/x_dp_48"
            android:text="@string/menu_exchangephone"
            android:singleLine="true"
            android:drawablePadding="@dimen/x_dp_8"
            android:paddingStart="@dimen/x_dp_16"
            app:layout_constraintTop_toBottomOf="@+id/line_4"/>
        <View
            android:id="@+id/red_dot_pc"
            android:visibility="gone"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_marginTop="12dp"
            android:layout_marginStart="32dp"
            app:layout_constraintStart_toStartOf="@+id/toolbar_more_pc_btn"
            app:layout_constraintTop_toTopOf="@+id/toolbar_more_pc_btn"/>
        <View
            android:id="@+id/red_dot_jio"
            android:visibility="gone"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_marginTop="12dp"
            android:layout_marginStart="32dp"
            app:layout_constraintStart_toStartOf="@+id/toolbar_more_jio_btn"
            app:layout_constraintTop_toTopOf="@+id/toolbar_more_jio_btn"/>
        <View
            android:id="@+id/red_dot_scanqr"
            android:visibility="gone"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_marginTop="12dp"
            android:layout_marginStart="32dp"
            app:layout_constraintStart_toStartOf="@+id/toolbar_more_scan_qr_btn"
            app:layout_constraintTop_toTopOf="@+id/toolbar_more_scan_qr_btn"/>
        <View
            android:id="@+id/red_dot_share"
            android:visibility="gone"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_marginTop="12dp"
            android:layout_marginStart="32dp"
            app:layout_constraintStart_toStartOf="@+id/toolbar_more_share_btn"
            app:layout_constraintTop_toTopOf="@+id/toolbar_more_share_btn"/>
        <View
            android:id="@+id/red_dot_phone_p"
            android:visibility="gone"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_marginTop="12dp"
            android:layout_marginStart="32dp"
            app:layout_constraintStart_toStartOf="@+id/toolbar_more_phone_p_btn"
            app:layout_constraintTop_toTopOf="@+id/toolbar_more_phone_p_btn"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
