<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/vp_selector_playlist_list_item"
    android:layout_width="match_parent"
    android:layout_height="@dimen/vp_dp_72">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/vp_playlist_iv"
        android:layout_width="@dimen/vp_dp_64"
        android:layout_height="@dimen/vp_dp_48"
        android:layout_marginLeft="@dimen/vp_dp_16"
        android:layout_marginRight="@dimen/vp_dp_16"
        android:layout_marginHorizontal="@dimen/vp_dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/vp_sp_15"
        android:textColor="@color/vp_dialog_text_color"
        android:ellipsize="marquee"
        android:gravity="start|center_vertical"
        android:id="@+id/vp_playlist_title"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:singleLine="true"
        android:layout_marginStart="@dimen/vp_dp_16"
        app:layout_constraintBottom_toTopOf="@+id/vp_playlist_duration"
        app:layout_constraintEnd_toStartOf="@+id/vp_playlist_delete"
        app:layout_constraintStart_toEndOf="@+id/vp_playlist_iv"
        app:layout_constraintTop_toTopOf="@+id/vp_playlist_iv"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/vp_sp_12"
        android:textColor="@color/vp_dialog_text_second_color"
        android:ellipsize="marquee"
        android:gravity="start|center_vertical"
        android:id="@+id/vp_playlist_duration"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:singleLine="true"
        android:layout_marginStart="@dimen/vp_dp_16"
        app:layout_constraintBottom_toBottomOf="@+id/vp_playlist_iv"
        app:layout_constraintEnd_toStartOf="@+id/vp_playlist_delete"
        app:layout_constraintStart_toEndOf="@+id/vp_playlist_iv"
        app:layout_constraintTop_toBottomOf="@+id/vp_playlist_title"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/vp_playlist_delete"
        android:background="?attr/selectableItemBackground"
        android:layout_width="@dimen/vp_dp_40"
        android:layout_height="match_parent"
        android:src="@drawable/vp_svg_ic_close_dark"
        android:scaleType="center"
        android:layout_marginEnd="@dimen/vp_dp_8"
        app:layout_constraintEnd_toStartOf="@+id/vp_playlist_sort"
        app:tint="@color/vp_dialog_text_color"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/vp_playlist_sort"
        android:background="?attr/selectableItemBackground"
        android:layout_width="@dimen/vp_dp_40"
        android:layout_height="match_parent"
        android:src="@drawable/vp_svg_ic_playlist_change_sort"
        android:scaleType="center"
        android:layout_marginEnd="@dimen/vp_dp_8"
        app:layout_constraintEnd_toEndOf="parent"
        app:tint="@color/vp_dialog_text_color"/>
</androidx.constraintlayout.widget.ConstraintLayout>
