<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/history_obb_res_progress_lay"
    android:layout_width="match_parent"
    android:layout_height="@dimen/x_dp_60">
    <ProgressBar
        android:id="@+id/history_obb_progress_bar"
        android:background="@color/x_transparent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:max="100"
        android:progress="30"
        android:progressDrawable="@drawable/bg_progress_primary"
        style="?android:attr/progressBarStyleHorizontal"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/history_obb_iv"
        android:layout_width="27dp"
        android:layout_height="27dp"
        android:layout_marginLeft="28dp"
        android:layout_marginRight="28dp"
        android:layout_centerVertical="true"
        android:layout_marginHorizontal="28dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/history_item_file_icon_iv_style"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/obb_app_res"
        android:layout_width="14dp"
        android:layout_height="14dp"
        app:layout_constraintBottom_toBottomOf="@+id/history_obb_iv"
        app:layout_constraintEnd_toEndOf="@+id/history_obb_iv"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/obb_complete_iv"
        android:focusable="false"
        android:visibility="visible"
        android:clickable="false"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:scaleType="center"
        android:layout_marginEnd="@dimen/x_dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="12sp"
        android:textColor="@color/txt_primary"
        android:ellipsize="end"
        android:gravity="start|top"
        android:id="@+id/obb_progress_item_file_name_tv"
        android:layout_marginLeft="@dimen/cx_dp_16"
        android:layout_marginRight="@dimen/cx_dp_16"
        android:maxLines="1"
        android:singleLine="false"
        android:layout_marginHorizontal="@dimen/cx_dp_16"
        app:layout_constraintBottom_toTopOf="@+id/obb_progress_item_file_size_tv"
        app:layout_constraintStart_toEndOf="@+id/history_obb_iv"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/history_item_file_name_tv_style"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_small"
        android:textColor="@color/txt_secondary"
        android:ellipsize="middle"
        android:gravity="start|bottom"
        android:id="@+id/obb_progress_item_file_size_tv"
        android:background="@null"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@+id/obb_progress_item_file_name_tv"
        app:layout_constraintTop_toBottomOf="@+id/obb_progress_item_file_name_tv"
        style="@style/title_text_font_style"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="10sp"
        android:textColor="@color/x_red"
        android:ellipsize="middle"
        android:gravity="start|bottom"
        android:id="@+id/obb_history_progress_item_state_tv"
        android:background="@null"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="5dp"
        android:layout_marginRight="5dp"
        android:text="@string/str_paused"
        android:singleLine="true"
        android:layout_marginStart="5dp"
        android:layout_marginEnd="5dp"
        app:layout_constraintBottom_toBottomOf="@+id/obb_progress_item_file_size_tv"
        app:layout_constraintLeft_toRightOf="@+id/obb_progress_item_file_size_tv"
        style="@style/title_text_font_style"/>
</androidx.constraintlayout.widget.ConstraintLayout>
