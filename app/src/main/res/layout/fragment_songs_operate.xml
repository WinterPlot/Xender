<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/songs_opt_top_line"
        android:background="@drawable/bg_dlg_top_handle"
        android:layout_width="@dimen/x_dp_45"
        android:layout_height="@dimen/x_dp_4"
        android:layout_marginTop="@dimen/x_dp_5"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/songs_opt_iv"
        android:layout_width="@dimen/x_dp_50"
        android:layout_height="@dimen/x_dp_50"
        android:layout_marginTop="@dimen/x_dp_16"
        android:scaleType="fitXY"
        android:layout_marginStart="@dimen/x_dp_16"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/songs_opt_top_line"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_large"
        android:textColor="@color/txt_primary"
        android:ellipsize="end"
        android:id="@+id/songs_opt_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="@dimen/x_dp_10"
        android:layout_marginEnd="@dimen/x_dp_10"
        app:layout_constraintBottom_toTopOf="@+id/songs_opt_sub_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/songs_opt_iv"
        app:layout_constraintTop_toTopOf="@+id/songs_opt_iv"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_medium"
        android:textColor="@color/txt_secondary"
        android:ellipsize="end"
        android:id="@+id/songs_opt_sub_title"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="@dimen/x_dp_10"
        android:layout_marginEnd="@dimen/x_dp_10"
        app:layout_constraintBottom_toBottomOf="@+id/songs_opt_iv"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/songs_opt_iv"
        app:layout_constraintTop_toBottomOf="@+id/songs_opt_title"/>
    <View
        android:id="@+id/songs_divider_line"
        android:layout_width="match_parent"
        android:layout_marginTop="@dimen/x_dp_10"
        app:layout_constraintTop_toBottomOf="@+id/songs_opt_iv"
        style="@style/BottomSheetDialog_Line"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="vertical"
        android:id="@+id/songs_opt_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/songs_divider_line"/>
</androidx.constraintlayout.widget.ConstraintLayout>
