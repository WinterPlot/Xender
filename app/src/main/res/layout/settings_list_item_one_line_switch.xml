<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingLeft="@dimen/x_dp_16"
    android:paddingRight="@dimen/x_dp_16"
    android:clickable="false"
    android:layout_width="match_parent"
    android:layout_height="@dimen/x_dp_64"
    android:paddingHorizontal="@dimen/x_dp_16">
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/cx_sp_15"
        android:textColor="@color/txt_primary"
        android:gravity="center_vertical"
        android:id="@+id/one_line_switch_title_tv"
        android:duplicateParentState="true"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:singleLine="false"
        android:fontFamily="sans-serif-medium"
        android:textDirection="locale"
        android:layout_marginEnd="@dimen/x_dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/one_line_switch_sw"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.userlabs.xshare.views.swbtn.SwitchButton
        android:id="@+id/one_line_switch_sw"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/MaterialDesign_settings_SwitchButton"/>
</androidx.constraintlayout.widget.ConstraintLayout>
