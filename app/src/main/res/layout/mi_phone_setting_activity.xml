<?xml version="1.0" encoding="utf-8"?>
<com.userlabs.xshare.views.XLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:textDirection="locale"
    android:layoutDirection="locale">
    <include layout="@layout/toolbar"/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:paddingTop="@dimen/x_dp_10"
            android:paddingBottom="@dimen/x_dp_10"
            android:descendantFocusability="blocksDescendants"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/x_dp_16"
            android:layout_marginRight="@dimen/x_dp_16"
            android:layout_marginHorizontal="@dimen/x_dp_16"
            android:paddingVertical="@dimen/x_dp_10">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/xshare_text_size_medium"
                android:textColor="@color/primary"
                android:layout_gravity="center"
                android:id="@+id/mi_settings_title"
                android:background="@drawable/bg_line_primary_solid_primary_0e"
                android:padding="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/x_dp_10"
                android:text="@string/mi_setting_tips_title1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/xshare_text_size_medium"
                android:textColor="@color/txt_primary"
                android:id="@+id/connect_problem_tv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/x_dp_16"
                android:text="@string/mi_phone_setting_wifi_assistant"
                app:layout_constraintTop_toBottomOf="@+id/mi_settings_title"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center"
                android:id="@+id/mi_settings_wifi_assistant_iv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/x_dp_16"
                android:src="@drawable/x_miui_pop_pic"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/connect_problem_tv"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/xshare_text_size_medium"
                android:textColor="@color/primary"
                android:layout_gravity="center"
                android:id="@+id/mi_settings_permission_settings_title_tv"
                android:background="@drawable/bg_line_primary_solid_primary_0e"
                android:padding="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/x_dp_20"
                android:text="@string/mi_setting_tips_title2"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/mi_settings_wifi_assistant_iv"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/xshare_text_size_medium"
                android:textColor="@color/txt_primary"
                android:id="@+id/mi_settings_permission_settings_des_tv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/x_dp_16"
                android:text="@string/mi_phone_setting_title"
                app:layout_constraintTop_toBottomOf="@+id/mi_settings_permission_settings_title_tv"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center"
                android:id="@+id/mi_settings_permission_settings_des_iv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/x_dp_16"
                android:src="@drawable/x_miphone_settings_1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/mi_settings_permission_settings_des_tv"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/xshare_text_size_medium"
                android:textColor="@color/txt_primary"
                android:id="@+id/mi_settings_step_tv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/x_dp_20"
                android:text="@string/mi_phone_setting_step_title"
                app:layout_constraintTop_toBottomOf="@+id/mi_settings_permission_settings_des_iv"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/xshare_text_size_medium"
                android:textColor="@color/txt_primary"
                android:id="@+id/mi_settings_step_1_tv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/x_dp_10"
                android:text="@string/mi_phone_setting_step_1"
                app:layout_constraintTop_toBottomOf="@+id/mi_settings_step_tv"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center"
                android:id="@+id/mi_settings_step_1_iv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/x_dp_20"
                android:src="@drawable/x_miphone_settings_2"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/mi_settings_step_1_tv"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/xshare_text_size_medium"
                android:textColor="@color/txt_primary"
                android:id="@+id/mi_settings_step_2_tv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/x_dp_20"
                android:text="@string/mi_phone_setting_step2"
                app:layout_constraintTop_toBottomOf="@+id/mi_settings_step_1_iv"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center"
                android:id="@+id/mi_settings_step_2_iv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/x_dp_20"
                android:src="@drawable/x_miphone_settings_3"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/mi_settings_step_2_tv"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/xshare_text_size_medium"
                android:textColor="@color/txt_primary"
                android:id="@+id/mi_settings_step_3_tv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/x_dp_20"
                android:text="@string/mi_phone_setting_step3"
                app:layout_constraintTop_toBottomOf="@+id/mi_settings_step_2_iv"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center"
                android:id="@+id/mi_settings_step_3_iv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/x_dp_16"
                android:src="@drawable/x_miphone_settings_4"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/mi_settings_step_3_tv"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/xshare_text_size_medium"
                android:textColor="@color/txt_primary"
                android:id="@+id/mi_settings_step_4_tv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/x_dp_20"
                android:text="@string/mi_phone_setting_step4"
                app:layout_constraintTop_toBottomOf="@+id/mi_settings_step_3_iv"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center"
                android:id="@+id/mi_settings_step_4_iv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/x_dp_16"
                android:src="@drawable/x_miphone_settings_5"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/mi_settings_step_4_tv"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/x_dp_10"
                android:layout_marginBottom="18dp"
                android:src="@drawable/x_miphone_settings_6"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/mi_settings_step_4_iv"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</com.userlabs.xshare.views.XLinearLayout>
