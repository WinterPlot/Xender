<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/vp_player_layout"
    android:tag="layout/activity_vp_exo_0"
    android:fitsSystemWindows="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:textDirection="locale"
    android:layoutDirection="locale">
    <androidx.media3.ui.PlayerView
        android:layout_gravity="center"
        android:id="@+id/x_player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:keepScreenOn="true"
        app:resize_mode="fit"
        app:surface_type="texture_view"
        app:use_controller="false"/>
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/video_bar_layout"
        android:background="@color/vp_mask"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/vp_dp_48"
        app:contentInsetStartWithNavigation="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:popupTheme="?attr/actionBarPopupTheme"
        style="?attr/actionBarStyle"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/ver_guide_line"
        android:layout_width="match_parent"
        android:layout_height="1px"
        app:layout_constraintGuide_percent="0.5"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/brightness_changing_ic"
        android:layout_width="@dimen/vp_dp_24"
        android:layout_height="@dimen/vp_dp_24"
        android:scaleType="center"
        android:layout_marginEnd="@dimen/vp_dp_16"
        app:layout_constraintBottom_toTopOf="@+id/brightness_changing_pb"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <ProgressBar
        android:id="@+id/brightness_changing_pb"
        android:layout_width="@dimen/vp_dp_3"
        android:layout_height="@dimen/vp_dp_100"
        android:layout_marginTop="@dimen/vp_dp_20"
        android:max="100"
        android:progress="20"
        android:progressDrawable="@drawable/vp_pb_white_drawer"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/brightness_changing_ic"
        app:layout_constraintStart_toStartOf="@+id/brightness_changing_ic"
        app:layout_constraintTop_toBottomOf="@+id/brightness_changing_ic"
        style="?android:attr/progressBarStyleHorizontal"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/volume_changing_ic"
        android:layout_width="@dimen/vp_dp_24"
        android:layout_height="@dimen/vp_dp_24"
        android:scaleType="center"
        android:layout_marginStart="@dimen/vp_dp_16"
        app:layout_constraintBottom_toTopOf="@+id/volume_changing_pb"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <ProgressBar
        android:id="@+id/volume_changing_pb"
        android:layout_width="@dimen/vp_dp_3"
        android:layout_height="@dimen/vp_dp_100"
        android:layout_marginTop="@dimen/vp_dp_20"
        android:max="100"
        android:progress="20"
        android:progressDrawable="@drawable/vp_pb_white_drawer"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/volume_changing_ic"
        app:layout_constraintStart_toStartOf="@+id/volume_changing_ic"
        app:layout_constraintTop_toBottomOf="@+id/volume_changing_ic"
        style="?android:attr/progressBarStyleHorizontal"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/vp_sp_18"
        android:textColor="@color/vp_white"
        android:gravity="center_vertical"
        android:id="@+id/fast_ward_current_time"
        android:paddingLeft="@dimen/vp_dp_16"
        android:paddingRight="@dimen/vp_dp_16"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/vp_dp_40"
        android:maxWidth="@dimen/vp_dp_200"
        android:drawablePadding="@dimen/vp_dp_8"
        android:drawableStart="@drawable/vp_svg_ic_fast_forward"
        android:paddingHorizontal="@dimen/vp_dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/vp_text_style_sans_medium_bold"/>
    <ProgressBar
        android:id="@+id/waiting_play_pb"
        android:layout_width="@dimen/vp_dp_40"
        android:layout_height="@dimen/vp_dp_40"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/vp_pb_loading"/>
    <FrameLayout
        android:id="@+id/ad_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
