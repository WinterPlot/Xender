<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:layout_gravity="bottom|center_horizontal"
    android:orientation="horizontal"
    android:background="@color/mask_shadow_no_theme"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:minHeight="48dp">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/pause"
        android:background="@drawable/selector_list_item"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:src="@drawable/x_svg_ic_video_pause"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_large"
        android:textColor="@color/txt_white"
        android:id="@+id/time"
        android:padding="4dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/title_text_style_bold"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_large"
        android:textColor="@color/txt_white"
        android:id="@+id/time_current"
        android:padding="4dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/pause"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/title_text_style_bold"/>
    <androidx.appcompat.widget.AppCompatSeekBar
        android:id="@+id/media_controller_progress"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxHeight="4dp"
        android:progressDrawable="@drawable/bg_seekbar_simple_media_player"
        android:minHeight="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/time"
        app:layout_constraintStart_toEndOf="@+id/time_current"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
