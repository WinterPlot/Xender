<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/file_cata_list_item_layer"
    android:background="@drawable/selector_list_item"
    android:addStatesFromChildren="false"
    android:descendantFocusability="blocksDescendants"
    android:layout_width="match_parent"
    android:layout_height="@dimen/x_dp_80">
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="end"
        android:id="@+id/cata_file_badge_new"
        android:visibility="gone"
        android:layout_width="@dimen/x_dp_20"
        android:layout_height="@dimen/x_dp_20"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/cata_file_icon"
        android:layout_width="@dimen/x_dp_56"
        android:layout_height="@dimen/x_dp_56"
        android:layout_marginStart="@dimen/x_dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/app_bundle_flag"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:scaleType="centerInside"
        app:layout_constraintBottom_toBottomOf="@+id/cata_file_icon"
        app:layout_constraintEnd_toEndOf="@+id/cata_file_icon"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="end|top"
        android:id="@+id/offer_little_red_circle"
        android:visibility="gone"
        android:layout_width="@dimen/x_dp_6"
        android:layout_height="@dimen/x_dp_6"
        android:src="@drawable/bg_red_oval"
        android:scaleType="centerInside"
        app:layout_constraintEnd_toEndOf="@+id/cata_file_icon"
        app:layout_constraintTop_toTopOf="@+id/cata_file_icon"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/cx_sp_15"
        android:textColor="@color/txt_primary"
        android:ellipsize="middle"
        android:gravity="start|center_vertical"
        android:id="@+id/cata_file_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/x_dp_8"
        android:singleLine="true"
        android:layout_marginStart="@dimen/x_dp_12"
        app:layout_constraintEnd_toStartOf="@+id/cata_file_check"
        app:layout_constraintStart_toEndOf="@+id/cata_file_icon"
        app:layout_constraintTop_toTopOf="@+id/cata_file_icon"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_small"
        android:textColor="@color/txt_secondary"
        android:id="@+id/cata_file_des"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/x_dp_8"
        android:singleLine="true"
        android:drawablePadding="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/cata_file_icon"
        app:layout_constraintStart_toStartOf="@+id/cata_file_name"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:gravity="center"
        android:id="@+id/cata_bundle_flag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/x_dp_10"
        app:layout_constraintBottom_toBottomOf="@+id/cata_file_des"
        app:layout_constraintStart_toEndOf="@+id/cata_file_des"
        app:layout_constraintTop_toTopOf="@+id/cata_file_des"/>
    <LinearLayout
        android:id="@+id/cata_file_check"
        android:focusable="true"
        android:clickable="true"
        android:duplicateParentState="false"
        android:addStatesFromChildren="true"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        app:layout_constraintEnd_toEndOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:gravity="center"
            android:id="@+id/expend_des_cb"
            android:focusable="true"
            android:visibility="gone"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:tint="@color/x_222_or_fff"
            android:paddingStart="@dimen/x_dp_16"
            android:paddingEnd="@dimen/x_dp_16"/>
        <com.userlabs.xshare.views.XCheckBox
            android:layout_gravity="center"
            android:id="@+id/cb_cata_file_check"
            android:duplicateParentState="false"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginLeft="@dimen/x_dp_16"
            android:layout_marginRight="@dimen/x_dp_16"
            android:scaleType="center"
            android:layout_marginStart="@dimen/x_dp_16"
            android:layout_marginEnd="@dimen/x_dp_16"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
