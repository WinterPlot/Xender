<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="@dimen/cx_dp_24"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/ex_dp_16">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/xshare_text_size_large"
                android:textColor="@color/txt_primary"
                android:gravity="center"
                android:id="@+id/obb_tips_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/obb_choose_tips_title"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/bold_text_style"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/xshare_text_size_medium"
                android:textColor="@color/txt_primary"
                android:gravity="center"
                android:id="@+id/obb_tips_title_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cx_dp_16"
                android:text="@string/obb_res_upgrade_package"
                android:drawablePadding="@dimen/x_dp_8"
                android:drawableStart="@drawable/svg_obb_files"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/obb_tips_title"/>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:orientation="vertical"
                android:id="@+id/obb_res_tips1"
                android:background="@drawable/bg_primary_4d_corner_10"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/x_dp_8"
                app:layout_constraintTop_toBottomOf="@+id/obb_tips_title_1">
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/cx_dp_16"
                    android:layout_marginBottom="@dimen/cx_dp_16"
                    android:src="@drawable/ic_obb_pic_1"
                    android:layout_marginVertical="@dimen/cx_dp_16"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/xshare_text_size_medium"
                    android:textColor="@color/txt_primary"
                    android:gravity="start"
                    android:paddingLeft="@dimen/cx_dp_16"
                    android:paddingRight="@dimen/cx_dp_16"
                    android:paddingBottom="@dimen/cx_dp_16"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/obb_res_tips_des1"
                    android:paddingHorizontal="@dimen/cx_dp_16"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/xshare_text_size_medium"
                android:textColor="@color/txt_primary"
                android:gravity="center"
                android:id="@+id/obb_tips_title_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cx_dp_16"
                android:text="@string/obb_res_upgrade_package"
                android:drawablePadding="@dimen/x_dp_8"
                android:drawableStart="@drawable/svg_obb_files"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/obb_res_tips1"/>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:orientation="vertical"
                android:id="@+id/obb_res_tips2"
                android:background="@drawable/bg_primary_4d_corner_10"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/x_dp_8"
                app:layout_constraintTop_toBottomOf="@+id/obb_tips_title_2">
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/cx_dp_16"
                    android:layout_marginBottom="@dimen/cx_dp_16"
                    android:src="@drawable/ic_obb_pic_2"
                    android:layout_marginVertical="@dimen/cx_dp_16"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/xshare_text_size_medium"
                    android:textColor="@color/txt_primary"
                    android:gravity="start"
                    android:paddingLeft="@dimen/cx_dp_16"
                    android:paddingRight="@dimen/cx_dp_16"
                    android:paddingBottom="@dimen/cx_dp_16"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/obb_res_tips_des2"
                    android:paddingHorizontal="@dimen/cx_dp_16"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
            <androidx.appcompat.widget.AppCompatTextView
                android:gravity="center"
                android:id="@+id/obb_tips_ok"
                android:background="@drawable/btn_primary_round_corner"
                android:layout_width="match_parent"
                android:layout_height="@dimen/x_dp_36"
                android:layout_marginLeft="@dimen/x_dp_36"
                android:layout_marginTop="@dimen/cx_dp_16"
                android:layout_marginRight="@dimen/x_dp_36"
                android:text="@string/dlg_ok"
                android:layout_marginHorizontal="@dimen/x_dp_36"
                app:layout_constraintTop_toBottomOf="@+id/obb_res_tips2"
                style="@style/cx_button_text_style_bold"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
