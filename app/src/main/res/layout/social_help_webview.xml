<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:textDirection="locale"
    android:layoutDirection="locale">
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="end|center_vertical"
        android:id="@+id/x_social_cancel"
        android:background="@drawable/bg_white_oval"
        android:layout_width="@dimen/x_dp_24"
        android:layout_height="@dimen/x_dp_24"
        android:layout_marginTop="@dimen/x_dp_8"
        android:src="@drawable/cx_svg_cancel"
        android:scaleType="centerInside"
        android:tint="@color/x_222"
        android:layout_marginStart="@dimen/x_dp_16"
        android:layout_marginEnd="@dimen/x_dp_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.userlabs.xshare.jsbridge.BridgeWebView
        android:id="@+id/bridgeview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/x_dp_8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/x_social_cancel"/>
</androidx.constraintlayout.widget.ConstraintLayout>
