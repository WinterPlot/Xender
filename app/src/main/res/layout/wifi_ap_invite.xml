<?xml version="1.0" encoding="utf-8"?>
<com.userlabs.xshare.views.XConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include layout="@layout/toolbar"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_medium"
        android:textColor="@color/txt_secondary"
        android:gravity="start|center_vertical"
        android:id="@+id/tv_share_app_hotspot_title"
        android:layout_width="match_parent"
        android:layout_height="@dimen/x_dp_48"
        android:layout_marginLeft="@dimen/x_dp_16"
        android:layout_marginRight="@dimen/x_dp_16"
        android:text="@string/connect_hotspot_tips_title"
        android:layout_marginHorizontal="@dimen/x_dp_16"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"
        style="@style/title_text_style_bold"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_large"
        android:textColor="@color/txt_primary"
        android:gravity="start|center_vertical"
        android:id="@+id/tv_share_app_hotspot_step1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/x_dp_16"
        android:layout_marginRight="@dimen/x_dp_16"
        android:text="@string/hotspot_step_1"
        android:layout_marginHorizontal="@dimen/x_dp_16"
        app:layout_constraintTop_toBottomOf="@+id/tv_share_app_hotspot_title"
        style="@style/title_text_font_style"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_large"
        android:textColor="@color/txt_secondary"
        android:gravity="center"
        android:layout_gravity="start"
        android:id="@+id/hotspot_name_des"
        android:paddingLeft="@dimen/x_dp_18"
        android:paddingRight="@dimen/x_dp_18"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/x_dp_16"
        android:layout_marginRight="@dimen/x_dp_16"
        android:text="@string/web_share_ap_name"
        android:layout_marginHorizontal="@dimen/x_dp_16"
        android:paddingHorizontal="@dimen/x_dp_18"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_share_app_hotspot_step1"
        style="@style/title_text_font_style"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_large"
        android:textColor="@color/secondary"
        android:gravity="center"
        android:layout_gravity="start"
        android:id="@+id/hotspot_ap"
        android:paddingLeft="@dimen/x_dp_12"
        android:paddingRight="@dimen/x_dp_12"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/x_dp_12"
        app:layout_constraintStart_toEndOf="@+id/hotspot_name_des"
        app:layout_constraintTop_toTopOf="@+id/hotspot_name_des"
        style="@style/title_text_font_style"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/password_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="hotspot_pwd_des,hotspot_password"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_large"
        android:textColor="@color/txt_secondary"
        android:gravity="center"
        android:layout_gravity="start"
        android:id="@+id/hotspot_pwd_des"
        android:paddingLeft="@dimen/x_dp_18"
        android:paddingRight="@dimen/x_dp_18"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/web_share_ap_pwd"
        android:paddingHorizontal="@dimen/x_dp_18"
        app:layout_constraintStart_toStartOf="@+id/hotspot_name_des"
        app:layout_constraintTop_toBottomOf="@+id/hotspot_name_des"
        style="@style/title_text_font_style"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_large"
        android:textColor="@color/secondary"
        android:gravity="center"
        android:layout_gravity="start"
        android:id="@+id/hotspot_password"
        android:paddingLeft="@dimen/x_dp_12"
        android:paddingRight="@dimen/x_dp_12"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/x_dp_12"
        app:layout_constraintStart_toEndOf="@+id/hotspot_pwd_des"
        app:layout_constraintTop_toTopOf="@+id/hotspot_pwd_des"
        style="@style/title_text_font_style"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_large"
        android:textColor="@color/txt_primary"
        android:gravity="start|center_vertical"
        android:id="@+id/tv_share_app_hotspot_step2"
        android:layout_width="match_parent"
        android:layout_height="@dimen/x_dp_48"
        android:layout_marginLeft="@dimen/x_dp_16"
        android:layout_marginRight="@dimen/x_dp_16"
        android:text="@string/hotspot_step_2"
        android:layout_marginHorizontal="@dimen/x_dp_16"
        app:layout_constraintTop_toBottomOf="@+id/hotspot_pwd_des"
        style="@style/title_text_font_style"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_large"
        android:textColor="@color/txt_primary"
        android:gravity="start|center_vertical"
        android:id="@+id/tv_share_app_hotspot_step3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/x_dp_16"
        android:layout_marginRight="@dimen/x_dp_16"
        android:text="@string/hotspot_step_3"
        android:layout_marginHorizontal="@dimen/x_dp_16"
        app:layout_constraintTop_toBottomOf="@+id/tv_share_app_hotspot_step2"
        style="@style/title_text_font_style"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_large"
        android:textColor="@color/secondary"
        android:gravity="center"
        android:layout_gravity="start"
        android:id="@+id/hotspot_address"
        android:paddingLeft="@dimen/x_dp_18"
        android:paddingRight="@dimen/x_dp_18"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/x_dp_18"
        app:layout_constraintStart_toStartOf="@+id/tv_share_app_hotspot_step3"
        app:layout_constraintTop_toBottomOf="@+id/tv_share_app_hotspot_step3"
        style="@style/title_text_font_style"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_medium"
        android:textColor="@color/txt_secondary"
        android:gravity="start|center_vertical"
        android:id="@+id/address_tips"
        android:paddingLeft="@dimen/x_dp_18"
        android:paddingRight="@dimen/x_dp_18"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/x_dp_16"
        android:layout_marginRight="@dimen/x_dp_16"
        android:text="@string/connect_hotspot_tips_http"
        android:layout_marginHorizontal="@dimen/x_dp_16"
        android:paddingHorizontal="@dimen/x_dp_18"
        app:layout_constraintTop_toBottomOf="@+id/hotspot_address"
        style="@style/title_text_style_bold"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_medium"
        android:textColor="@color/txt_primary"
        android:gravity="center"
        android:id="@+id/or_line"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/x_dp_16"
        android:layout_marginTop="@dimen/x_dp_16"
        android:layout_marginRight="@dimen/x_dp_16"
        android:text="--------------------- OR -----------------------"
        app:layout_constraintTop_toBottomOf="@+id/address_tips"
        style="@style/title_text_style_bold"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/invite_qrcode_iv"
        android:layout_width="@dimen/x_dp_150"
        android:layout_height="@dimen/x_dp_150"
        android:layout_marginTop="35dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/or_line"/>
</com.userlabs.xshare.views.XConstraintLayout>
