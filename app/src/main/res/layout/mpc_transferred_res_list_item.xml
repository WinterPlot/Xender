<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/selectableItemBackground"
    android:layout_width="match_parent"
    android:layout_height="@dimen/mpc_dp_96"
    android:textDirection="locale"
    android:layoutDirection="locale">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/res_icon_iv"
        android:layout_width="@dimen/mpc_dp_64"
        android:layout_height="@dimen/mpc_dp_64"
        android:layout_marginStart="@dimen/mpc_dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/mpc_sp_16"
        android:textStyle="normal"
        android:textColor="@color/mpc_txt_primary"
        android:gravity="start"
        android:id="@+id/res_name_tv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/mpc_dp_10"
        android:layout_marginRight="@dimen/mpc_dp_10"
        android:singleLine="true"
        android:fontFamily="sans-serif-medium"
        android:layout_marginHorizontal="@dimen/mpc_dp_10"
        app:layout_constraintBottom_toTopOf="@+id/res_artist_tv"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/res_icon_iv"
        app:layout_constraintTop_toTopOf="@+id/res_icon_iv"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="14sp"
        android:textStyle="normal"
        android:textColor="@color/mpc_txt_secondary"
        android:gravity="start"
        android:id="@+id/res_artist_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/mpc_dp_16"
        android:singleLine="true"
        android:fontFamily="sans-serif-medium"
        app:layout_constraintBottom_toBottomOf="@+id/res_icon_iv"
        app:layout_constraintStart_toStartOf="@+id/res_name_tv"
        app:layout_constraintTop_toBottomOf="@+id/res_name_tv"/>
</androidx.constraintlayout.widget.ConstraintLayout>
