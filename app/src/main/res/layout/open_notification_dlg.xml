<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="center"
        android:id="@+id/goto_open_notification_iv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/x_dp_16"/>
    <androidx.appcompat.widget.AppCompatButton
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/goto_open_notification_bt"
        android:layout_width="match_parent"
        android:layout_height="@dimen/x_dp_48"
        android:layout_marginLeft="24dp"
        android:layout_marginTop="@dimen/x_dp_16"
        android:layout_marginRight="24dp"
        android:layout_marginBottom="32dp"
        android:text="@string/item_open"
        android:textAllCaps="false"
        style="@style/button_text_style_bold"/>
</LinearLayout>
