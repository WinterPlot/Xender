<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/x_dp_96">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/icon"
        android:layout_width="@dimen/x_dp_40"
        android:layout_height="@dimen/x_dp_40"
        android:scaleType="fitXY"
        android:layout_marginStart="@dimen/x_dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_medium"
        android:textColor="@color/txt_primary"
        android:ellipsize="end"
        android:gravity="start"
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxWidth="@dimen/x_dp_200"
        android:singleLine="true"
        android:layout_marginStart="@dimen/x_dp_10"
        app:layout_constraintEnd_toStartOf="@+id/cbExtend"
        app:layout_constraintStart_toEndOf="@+id/icon"
        app:layout_constraintTop_toTopOf="@+id/icon"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_small"
        android:textColor="@color/txt_secondary"
        android:gravity="start|center_vertical"
        android:id="@+id/tvSize"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/x_dp_16"
        android:maxLines="2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@+id/title"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_small"
        android:textColor="@color/txt_white"
        android:gravity="center"
        android:id="@+id/vip_flag"
        android:background="@drawable/tt_bg_vip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="VIP"
        android:maxLines="1"
        android:layout_marginStart="@dimen/x_dp_10"
        app:layout_constraintBottom_toBottomOf="@+id/tvSize"
        app:layout_constraintStart_toEndOf="@+id/tvSize"
        app:layout_constraintTop_toTopOf="@+id/tvSize"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_small"
        android:textColor="@color/txt_white"
        android:gravity="center"
        android:id="@+id/af_flag"
        android:background="@drawable/tt_bg_af"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="AF"
        android:maxLines="1"
        android:layout_marginStart="@dimen/x_dp_5"
        app:layout_constraintBottom_toBottomOf="@+id/tvSize"
        app:layout_constraintStart_toEndOf="@+id/vip_flag"
        app:layout_constraintTop_toTopOf="@+id/tvSize"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_small"
        android:textColor="@color/txt_white"
        android:gravity="center"
        android:id="@+id/hot_flag"
        android:background="@drawable/tt_bg_af"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="HOT"
        android:maxLines="1"
        android:layout_marginStart="@dimen/x_dp_5"
        app:layout_constraintBottom_toBottomOf="@+id/tvSize"
        app:layout_constraintStart_toEndOf="@+id/af_flag"
        app:layout_constraintTop_toTopOf="@+id/tvSize"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_small"
        android:textColor="@color/txt_white"
        android:gravity="center"
        android:id="@+id/belong_flag"
        android:background="@drawable/tt_bg_af"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="@dimen/x_dp_5"
        app:layout_constraintBottom_toBottomOf="@+id/tvSize"
        app:layout_constraintStart_toEndOf="@+id/hot_flag"
        app:layout_constraintTop_toTopOf="@+id/tvSize"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/cbExtend"
        android:background="@drawable/selector_list_item"
        android:layout_width="@dimen/x_dp_64"
        android:layout_height="0dp"
        android:src="@drawable/selector_checkbox_up_down"
        android:scaleType="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/tvButton"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_medium"
        android:textColor="@color/primary"
        android:gravity="center"
        android:id="@+id/tvButton"
        android:layout_width="@dimen/x_dp_64"
        android:layout_height="@dimen/x_dp_30"
        android:singleLine="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
