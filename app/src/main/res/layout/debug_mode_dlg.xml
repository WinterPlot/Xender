<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/debug_layout"
    android:padding="@dimen/x_dp_24"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatEditText
        android:theme="@style/MyEditText"
        android:textSize="@dimen/xshare_text_size_large"
        android:textColor="@color/txt_primary"
        android:textColorHint="@color/btn_disable"
        android:id="@+id/debug_mode_edittext"
        android:background="@drawable/bg_line_round_corner"
        android:layout_width="0dp"
        android:layout_height="@dimen/x_dp_48"
        android:hint="please input debug pwd"
        android:layout_weight="1"
        android:inputType="text"
        android:imeOptions="actionDone"
        android:paddingStart="24dp"
        android:paddingEnd="@dimen/x_dp_16"/>
</LinearLayout>
