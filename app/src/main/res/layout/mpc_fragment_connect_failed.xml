<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/mpc_fragment_connect_failed_0"
    android:background="@color/mpc_main_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/connected_failed_bg_view"
        android:layout_width="match_parent"
        android:layout_height="@dimen/mpc_dp_50"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/mpc_sp_14"
        android:textStyle="normal"
        android:textColor="@color/x_red"
        android:gravity="center"
        android:id="@+id/connected_failed_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/mpc_dp_16"
        android:layout_marginRight="@dimen/mpc_dp_16"
        android:drawablePadding="@dimen/mpc_dp_10"
        android:fontFamily="sans-serif"
        android:layout_marginHorizontal="@dimen/mpc_dp_16"
        app:layout_constraintBottom_toBottomOf="@+id/connected_failed_bg_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/connected_failed_bg_view"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/mpc_sp_14"
        android:textStyle="normal"
        android:textColor="@color/mpc_txt_primary"
        android:gravity="center"
        android:id="@+id/connected_failed_reason_tv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/mpc_dp_45"
        android:layout_marginTop="@dimen/mpc_dp_60"
        android:layout_marginRight="@dimen/mpc_dp_45"
        android:fontFamily="sans-serif"
        android:layout_marginHorizontal="@dimen/mpc_dp_45"
        app:layout_constraintTop_toBottomOf="@+id/connected_failed_bg_view"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/mpc_sp_14"
        android:textStyle="normal"
        android:textColor="@color/mpc_txt_primary"
        android:gravity="center"
        android:id="@+id/connected_failed_must_same_wifi_tv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/mpc_dp_45"
        android:layout_marginRight="@dimen/mpc_dp_45"
        android:layout_marginBottom="@dimen/mpc_dp_40"
        android:fontFamily="sans-serif"
        android:layout_marginHorizontal="@dimen/mpc_dp_45"
        app:layout_constraintBottom_toTopOf="@+id/failed_retry_btn"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="14sp"
        android:textStyle="normal"
        android:textColor="@color/mpc_white"
        android:gravity="center"
        android:id="@+id/failed_retry_btn"
        android:layout_width="@dimen/mpc_dp_240"
        android:layout_height="@dimen/mpc_dp_40"
        android:layout_marginTop="@dimen/mpc_dp_80"
        android:fontFamily="sans-serif"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="14sp"
        android:textStyle="normal"
        android:textColor="@color/mpc_color_primary"
        android:gravity="center"
        android:id="@+id/failed_back_to_home"
        android:layout_width="@dimen/mpc_dp_240"
        android:layout_height="@dimen/mpc_dp_40"
        android:layout_marginTop="@dimen/mpc_dp_16"
        android:layout_marginBottom="@dimen/mpc_dp_20"
        android:fontFamily="sans-serif"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/failed_retry_btn"/>
    <FrameLayout
        android:id="@+id/connected_failed_special_router_tips_layout"
        android:layout_width="@dimen/mpc_dp_240"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/failed_back_to_home">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/mpc_sp_14"
            android:textStyle="normal"
            android:textColor="@color/mpc_white"
            android:gravity="center"
            android:id="@+id/connected_failed_special_router_tips_tv"
            android:paddingLeft="@dimen/mpc_dp_8"
            android:paddingTop="24dp"
            android:paddingRight="@dimen/mpc_dp_8"
            android:paddingBottom="@dimen/mpc_dp_8"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/mpc_dp_30"
            android:fontFamily="sans-serif"
            android:paddingHorizontal="@dimen/mpc_dp_8"/>
    </FrameLayout>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/mpc_sp_14"
        android:textStyle="normal"
        android:textColor="@color/mpc_txt_primary"
        android:gravity="center"
        android:id="@+id/failed_step_3_tv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/mpc_dp_20"
        android:lineSpacingMultiplier="1.2"
        android:fontFamily="sans-serif"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
