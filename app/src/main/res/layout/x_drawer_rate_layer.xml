<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/x_drawer_rate_item"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="@dimen/x_dp_54">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/img_rate_clicked"
        android:duplicateParentState="true"
        android:layout_width="@dimen/x_dp_24"
        android:layout_height="@dimen/x_dp_24"
        android:layout_marginStart="@dimen/x_dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@drawable/selector_left_drawer_text_color"
        android:id="@+id/text_rate_clicked"
        android:clickable="false"
        android:duplicateParentState="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/x_rate_us"
        android:layout_marginStart="@dimen/x_dp_12"
        app:layout_constraintBottom_toTopOf="@+id/rate_5_star"
        app:layout_constraintStart_toEndOf="@+id/img_rate_clicked"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@drawable/selector_left_drawer_text_color"
        android:id="@+id/text_rate_clicked_en"
        android:clickable="false"
        android:duplicateParentState="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/menu_rate_en"
        android:layout_centerVertical="true"
        android:layout_marginStart="5dp"
        app:layout_constraintStart_toEndOf="@+id/text_rate_clicked"
        app:layout_constraintTop_toTopOf="@+id/text_rate_clicked"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/rate_5_star"
        android:clickable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@+id/text_rate_clicked"
        app:layout_constraintTop_toBottomOf="@+id/text_rate_clicked"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/x_rate_us_arrow"
        android:clickable="false"
        android:layout_width="@dimen/x_dp_16"
        android:layout_height="@dimen/x_dp_16"
        android:layout_marginEnd="@dimen/x_dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
