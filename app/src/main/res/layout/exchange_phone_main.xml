<?xml version="1.0" encoding="utf-8"?>
<com.userlabs.xshare.views.XConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/app_window_bg"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include layout="@layout/ex_toolbar"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/des_container"
        android:background="@drawable/rect_dotted_line"
        android:paddingBottom="@dimen/cx_dp_16"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/cx_dp_16"
        android:layout_marginTop="@dimen/ex_first_des_top_margin"
        android:layout_marginRight="@dimen/cx_dp_16"
        android:layout_marginHorizontal="@dimen/cx_dp_16"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="24sp"
        android:textColor="@color/txt_primary"
        android:gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/ex_dp_16"
        android:layout_marginTop="@dimen/ex_first_top_30"
        android:layout_marginRight="@dimen/ex_dp_16"
        android:layout_marginBottom="@dimen/ex_dp_30"
        android:text="@string/exchange_phone_old_or_new"
        android:layout_marginHorizontal="@dimen/ex_dp_16"
        app:layout_constraintBottom_toTopOf="@+id/create_layout"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/ex_text_style_bold"/>
    <FrameLayout
        android:id="@+id/create_layout"
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:layout_marginTop="@dimen/ex_first_top_30"
        android:layout_marginBottom="@dimen/ex_dp_30"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/join_layout"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintStart_toStartOf="parent">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/cx_sp_20"
            android:textColor="@color/app_window_bg"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ex_dp_16"
            android:text="@string/exchange_new_phone"
            android:textAllCaps="true"
            android:layout_marginStart="@dimen/ex_dp_16"
            style="@style/ex_text_style_bold"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/join_layout"
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:layout_marginTop="@dimen/ex_first_top_30"
        android:layout_marginBottom="@dimen/ex_dp_30"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/create_layout">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/cx_sp_20"
            android:textColor="@color/app_window_bg"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/ex_dp_16"
            android:layout_marginTop="@dimen/ex_dp_16"
            android:text="@string/exchange_old_phone"
            android:textAllCaps="true"
            android:layout_marginStart="@dimen/ex_dp_16"
            style="@style/ex_text_style_bold"/>
    </FrameLayout>
</com.userlabs.xshare.views.XConstraintLayout>
