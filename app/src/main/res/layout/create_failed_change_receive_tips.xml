<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:id="@+id/create_change_scan_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="vertical"
        android:id="@+id/create_change_scan_view"
        android:layout_width="match_parent"
        android:layout_height="@dimen/x_dp_312"
        android:layout_marginLeft="@dimen/x_dp_30"
        android:layout_marginRight="@dimen/x_dp_30"
        android:layout_marginHorizontal="@dimen/x_dp_30"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/xshare_text_size_large"
            android:textColor="@color/txt_primary"
            android:id="@+id/create_change_scan_title1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/x_dp_16"
            android:layout_marginTop="@dimen/x_dp_80"
            android:layout_marginRight="@dimen/x_dp_16"
            android:layout_marginHorizontal="@dimen/x_dp_16"
            style="@style/title_text_style_roboto_font"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/xshare_text_size_large"
            android:textColor="@color/txt_primary"
            android:id="@+id/create_change_scan_title2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/x_dp_16"
            android:layout_marginTop="@dimen/x_dp_14"
            android:layout_marginRight="@dimen/x_dp_16"
            android:layout_marginHorizontal="@dimen/x_dp_16"
            style="@style/title_text_style_roboto_font"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/xshare_text_size_large"
            android:textColor="@color/txt_primary"
            android:id="@+id/create_change_scan_title3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/x_dp_16"
            android:layout_marginTop="@dimen/x_dp_14"
            android:layout_marginRight="@dimen/x_dp_16"
            android:layout_marginHorizontal="@dimen/x_dp_16"
            style="@style/title_text_style_roboto_font"/>
        <Button
            android:gravity="center"
            android:id="@+id/create_change_scan_btn"
            android:layout_width="match_parent"
            android:layout_height="@dimen/x_dp_48"
            android:layout_marginLeft="@dimen/x_dp_40"
            android:layout_marginTop="@dimen/x_dp_50"
            android:layout_marginRight="@dimen/x_dp_40"
            android:layout_marginHorizontal="@dimen/x_dp_40"
            style="@style/button_text_style_bold"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.constraintlayout.widget.ConstraintLayout>
