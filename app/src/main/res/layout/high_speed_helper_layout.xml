<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/high_speed_helper_layout"
    android:paddingLeft="@dimen/x_dp_16"
    android:paddingRight="@dimen/x_dp_16"
    android:paddingBottom="@dimen/x_dp_20"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/x_dp_16">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/high_speed_helper_top_line"
        android:background="@drawable/bg_dlg_top_handle"
        android:layout_width="@dimen/x_dp_45"
        android:layout_height="@dimen/x_dp_4"
        android:layout_marginTop="@dimen/x_dp_5"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/high_speed_helper_rocket_icon"
        android:layout_width="@dimen/x_dp_45"
        android:layout_height="@dimen/x_dp_45"
        android:layout_marginTop="@dimen/x_dp_20"
        android:scaleType="center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/high_speed_helper_top_line"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_large"
        android:textColor="@color/primary"
        android:gravity="start"
        android:id="@+id/high_speed_helper_msg_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/x_dp_16"
        app:layout_constraintTop_toBottomOf="@+id/high_speed_helper_rocket_icon"
        style="@style/text_style_bold"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/high_speed_helper_msg_2_oval"
        android:layout_width="5dp"
        android:layout_height="5dp"
        android:layout_marginTop="@dimen/x_dp_8"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/high_speed_helper_msg_2"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_medium"
        android:textColor="@color/txt_primary"
        android:gravity="start"
        android:id="@+id/high_speed_helper_msg_2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/x_dp_10"
        android:lineSpacingMultiplier="1.2"
        android:layout_marginStart="3dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/high_speed_helper_msg_2_oval"
        app:layout_constraintTop_toBottomOf="@+id/high_speed_helper_msg_1"
        style="@style/text_style_bold"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/high_speed_helper_msg_3_oval"
        android:layout_width="5dp"
        android:layout_height="5dp"
        android:layout_marginTop="@dimen/x_dp_8"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/high_speed_helper_msg_3"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_medium"
        android:textColor="@color/txt_primary"
        android:gravity="start"
        android:id="@+id/high_speed_helper_msg_3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/x_dp_10"
        android:lineSpacingMultiplier="1.2"
        android:layout_marginStart="3dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/high_speed_helper_msg_3_oval"
        app:layout_constraintTop_toBottomOf="@+id/high_speed_helper_msg_2"
        style="@style/text_style_bold"/>
    <View
        android:id="@+id/high_speed_helper_bottom_bg_view"
        android:layout_width="match_parent"
        android:layout_height="@dimen/x_dp_200"
        android:layout_marginTop="@dimen/x_dp_20"
        app:layout_constraintTop_toBottomOf="@+id/high_speed_helper_msg_3"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_large"
        android:textColor="@color/txt_primary"
        android:gravity="center"
        android:id="@+id/high_speed_helper_bottom_title_tv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/x_dp_16"
        android:layout_marginTop="@dimen/x_dp_16"
        android:layout_marginRight="@dimen/x_dp_16"
        android:layout_marginHorizontal="@dimen/x_dp_16"
        app:layout_constraintEnd_toEndOf="@+id/high_speed_helper_bottom_bg_view"
        app:layout_constraintStart_toStartOf="@+id/high_speed_helper_bottom_bg_view"
        app:layout_constraintTop_toTopOf="@+id/high_speed_helper_bottom_bg_view"
        style="@style/text_style_bold"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_smaller"
        android:textColor="@color/primary"
        android:gravity="start|center_vertical"
        android:id="@+id/high_speed_helper_bottom_subtitle_tv_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/x_dp_16"
        android:layout_marginTop="@dimen/x_dp_16"
        android:layout_marginRight="@dimen/x_dp_16"
        android:maxLines="1"
        android:drawablePadding="@dimen/x_dp_4"
        android:drawableStart="@drawable/x_svg_high_speed_des_app_ver"
        android:layout_marginHorizontal="@dimen/x_dp_16"
        app:layout_constraintStart_toStartOf="@+id/high_speed_helper_bottom_bg_view"
        app:layout_constraintTop_toBottomOf="@+id/high_speed_helper_bottom_title_tv"
        style="@style/text_style_bold"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_smaller"
        android:textColor="@color/txt_primary"
        android:gravity="start"
        android:id="@+id/high_speed_helper_bottom_app_version_des_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/x_dp_16"
        android:layout_marginTop="@dimen/x_dp_6"
        android:layout_marginRight="@dimen/x_dp_16"
        android:lineSpacingMultiplier="1.5"
        android:layout_marginHorizontal="@dimen/x_dp_16"
        app:layout_constraintStart_toStartOf="@+id/high_speed_helper_bottom_subtitle_tv_1"
        app:layout_constraintTop_toBottomOf="@+id/high_speed_helper_bottom_subtitle_tv_1"
        style="@style/text_style_bold"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_smaller"
        android:textColor="@color/primary"
        android:gravity="start|center_vertical"
        android:id="@+id/high_speed_helper_bottom_subtitle_tv_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/x_dp_16"
        android:layout_marginTop="@dimen/x_dp_16"
        android:layout_marginRight="@dimen/x_dp_16"
        android:maxLines="1"
        android:drawablePadding="@dimen/x_dp_4"
        android:drawableStart="@drawable/x_svg_high_speed_des_device"
        android:layout_marginHorizontal="@dimen/x_dp_16"
        app:layout_constraintStart_toStartOf="@+id/high_speed_helper_bottom_bg_view"
        app:layout_constraintTop_toBottomOf="@+id/high_speed_helper_bottom_app_version_des_tv"
        style="@style/text_style_bold"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_smaller"
        android:textColor="@color/txt_primary"
        android:gravity="start"
        android:id="@+id/high_speed_helper_bottom_device_des_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/x_dp_16"
        android:layout_marginTop="@dimen/x_dp_6"
        android:layout_marginRight="@dimen/x_dp_16"
        android:lineSpacingMultiplier="1.5"
        android:layout_marginHorizontal="@dimen/x_dp_16"
        app:layout_constraintStart_toStartOf="@+id/high_speed_helper_bottom_subtitle_tv_2"
        app:layout_constraintTop_toBottomOf="@+id/high_speed_helper_bottom_subtitle_tv_2"
        style="@style/text_style_bold"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:gravity="center"
        android:id="@+id/high_speed_helper_btn"
        android:layout_width="@dimen/x_dp_240"
        android:layout_height="@dimen/x_dp_48"
        android:layout_marginTop="@dimen/x_dp_20"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/high_speed_helper_bottom_bg_view"
        style="@style/button_text_style_bold"/>
</androidx.constraintlayout.widget.ConstraintLayout>
