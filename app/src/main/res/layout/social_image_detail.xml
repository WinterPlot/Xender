<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/social_view_pager"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/ad_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/imageView_toolbar"
        android:background="@color/x_transparent"
        android:layout_width="0dp"
        android:layout_height="@dimen/x_dp_48"
        android:minHeight="@dimen/x_dp_48"
        app:contentInsetStartWithNavigation="0dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIcon="@drawable/cx_svg_back"
        app:popupTheme="@style/Theme.AppCompat.Light.DarkActionBar"
        app:titleTextColor="@color/txt_white"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/bottom_operation_layout"
        android:background="@color/x_transparent"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/x_dp_48"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
