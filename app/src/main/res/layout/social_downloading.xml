<?xml version="1.0" encoding="utf-8"?>
<com.userlabs.xshare.views.X4W3HFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/social_download_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/bg_icon_iv"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/cover_iv"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"/>
    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:layout_gravity="center"
        android:id="@+id/social_download_progress"
        android:background="@drawable/bg_white_oval"
        android:layout_width="@dimen/x_dp_60"
        android:layout_height="@dimen/x_dp_60"
        android:indeterminate="false"
        app:indicatorColor="@color/primary"
        app:indicatorInset="0dp"
        app:indicatorSize="@dimen/x_dp_60"
        app:trackColor="@color/primary_0e"
        app:trackCornerRadius="3dp"
        app:trackThickness="6dp"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/cx_sp_12"
        android:textColor="@color/primary"
        android:layout_gravity="center"
        android:id="@+id/social_download_progress_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/cx_sp_12"
        android:textColor="@color/primary"
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/social_downloading_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/cx_dp_8"
        android:text="@string/friend_app_waiting"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:gravity="center"
        android:layout_gravity="end"
        android:id="@+id/social_download_cancel"
        android:layout_width="@dimen/cx_dp_16"
        android:layout_height="@dimen/cx_dp_16"
        android:layout_margin="8dp"
        android:src="@drawable/svg_ic_cancel"
        android:scaleType="centerInside"
        android:tint="@color/x_222_or_fff"/>
</com.userlabs.xshare.views.X4W3HFrameLayout>
