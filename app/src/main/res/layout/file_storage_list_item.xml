<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:addStatesFromChildren="false"
    android:descendantFocusability="blocksDescendants"
    android:layout_width="match_parent"
    android:layout_height="@dimen/x_dp_102">
    <View
        android:id="@+id/storage_bg_view"
        android:layout_width="match_parent"
        android:layout_height="@dimen/x_dp_87"
        android:layout_marginLeft="@dimen/x_dp_16"
        android:layout_marginRight="@dimen/x_dp_16"
        android:layout_marginHorizontal="@dimen/x_dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/storage_file_icon"
        android:layout_width="@dimen/x_dp_64"
        android:layout_height="@dimen/x_dp_64"
        android:scaleType="center"
        android:layout_marginStart="@dimen/x_dp_12"
        app:layout_constraintBottom_toBottomOf="@+id/storage_bg_view"
        app:layout_constraintStart_toStartOf="@+id/storage_bg_view"
        app:layout_constraintTop_toTopOf="@+id/storage_bg_view"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/cx_sp_15"
        android:textColor="@color/txt_primary"
        android:gravity="start|center_vertical"
        android:id="@+id/storage_name_tv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/x_dp_12"
        android:layout_marginTop="@dimen/x_dp_4"
        android:layout_marginRight="@dimen/x_dp_12"
        android:singleLine="true"
        android:layout_marginHorizontal="@dimen/x_dp_12"
        app:layout_constraintEnd_toEndOf="@+id/storage_bg_view"
        app:layout_constraintStart_toEndOf="@+id/storage_file_icon"
        app:layout_constraintTop_toTopOf="@+id/storage_file_icon"/>
    <ProgressBar
        android:id="@+id/storage_space_pb"
        android:layout_width="0dp"
        android:layout_height="@dimen/x_dp_6"
        android:layout_marginBottom="@dimen/x_dp_4"
        android:max="100"
        android:layout_marginEnd="@dimen/x_dp_12"
        app:layout_constraintBottom_toBottomOf="@+id/storage_file_icon"
        app:layout_constraintEnd_toEndOf="@+id/storage_bg_view"
        app:layout_constraintStart_toStartOf="@+id/storage_name_tv"
        style="?android:attr/progressBarStyleHorizontal"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_small"
        android:textColor="@color/txt_secondary"
        android:id="@+id/storage_size_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/x_dp_4"
        android:singleLine="true"
        android:drawablePadding="4dp"
        app:layout_constraintBottom_toTopOf="@+id/storage_space_pb"
        app:layout_constraintStart_toStartOf="@+id/storage_space_pb"/>
</androidx.constraintlayout.widget.ConstraintLayout>
