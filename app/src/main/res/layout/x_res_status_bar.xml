<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/x_res_status_bar_layout"
    android:layout_width="match_parent"
    android:layout_height="@dimen/x_dp_40">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/x_res_cancel_edit"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:tint="@color/txt_secondary"
        android:layout_marginStart="@dimen/x_dp_16"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_medium"
        android:textColor="@color/txt_secondary"
        android:gravity="center"
        android:id="@+id/x_res_count"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/x_dp_20"
        app:layout_constraintStart_toEndOf="@+id/x_res_cancel_edit"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginStart="@dimen/x_dp_16"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:gravity="center"
        android:id="@+id/x_res_search"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/x_dp_16"
        android:layout_marginEnd="@dimen/x_dp_20"
        app:layout_constraintEnd_toStartOf="@+id/x_res_change_mode"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:gravity="center"
        android:id="@+id/x_res_change_mode"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/x_dp_16"
        android:layout_marginEnd="@dimen/x_dp_20"
        app:layout_constraintEnd_toStartOf="@+id/x_res_sort"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/x_res_sort"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:src="@drawable/svg_sort"
        android:layout_marginStart="@dimen/x_dp_16"
        android:layout_marginEnd="@dimen/x_dp_20"
        app:layout_constraintEnd_toStartOf="@+id/x_res_checkbox"
        app:layout_goneMarginEnd="@dimen/x_dp_56"/>
    <com.userlabs.xshare.views.XCheckBox
        android:id="@+id/x_res_checkbox"
        android:visibility="gone"
        android:layout_width="@dimen/x_dp_20"
        android:layout_height="@dimen/x_dp_20"
        android:scaleType="center"
        android:layout_marginEnd="@dimen/x_dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/x_res_options"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginEnd="@dimen/x_dp_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
