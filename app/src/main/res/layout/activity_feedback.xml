<?xml version="1.0" encoding="utf-8"?>
<com.userlabs.xshare.views.XConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:background="@color/primary"
        android:layout_width="match_parent"
        android:layout_height="@dimen/x_dp_48"
        app:contentInsetStartWithNavigation="0dp"
        app:homeAsUpIndicator="@drawable/cx_svg_back"
        app:layout_constraintTop_toTopOf="parent"
        app:popupTheme="@style/Theme.AppCompat.Light.DarkActionBar"
        app:titleTextAppearance="@style/toolbar_text_style_bold">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center"
                android:id="@+id/title_close_btn"
                android:background="?attr/actionBarItemBackground"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="@dimen/x_dp_48"
                android:layout_height="match_parent"
                android:src="@drawable/svg_ic_cancel"
                android:scaleType="center"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textAppearance="@style/toolbar_text_style_bold"
                android:gravity="start|center_vertical"
                android:id="@+id/title_text"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="@string/feedback_title"
                android:paddingEnd="@dimen/x_dp_16"/>
        </LinearLayout>
    </androidx.appcompat.widget.Toolbar>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_large"
        android:gravity="center"
        android:id="@+id/open_net_work"
        android:paddingLeft="@dimen/x_dp_16"
        android:paddingRight="@dimen/x_dp_16"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/feedback_no_net_tips"
        android:drawableTop="@drawable/svg_network_retry"
        android:drawablePadding="@dimen/x_dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"/>
    <include
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"
        layout="@layout/poor_network_layout"/>
    <include
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"
        layout="@layout/wait_loading_iv"/>
    <include
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"
        layout="@layout/wait_loading_tv"/>
    <WebView
        android:id="@+id/help_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"/>
</com.userlabs.xshare.views.XConstraintLayout>
