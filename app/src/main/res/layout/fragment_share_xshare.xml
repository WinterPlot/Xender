<?xml version="1.0" encoding="utf-8"?>
<com.userlabs.xshare.views.XLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:focusable="true"
    android:fitsSystemWindows="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:textDirection="locale"
    android:layoutDirection="locale">
    <include layout="@layout/toolbar"/>
    <ScrollView
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/xd_qr_iv"
                android:layout_width="@dimen/x_dp_120"
                android:layout_height="@dimen/x_dp_120"
                android:layout_marginTop="@dimen/x_dp_24"
                android:scaleType="fitCenter"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/xshare_text_size_large"
                android:textColor="@color/txt_primary"
                android:gravity="center"
                android:id="@+id/qr_des_tv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/x_dp_8"
                android:layout_marginBottom="24dp"
                android:text="@string/share_me_with_qr_tips"
                app:layout_constraintTop_toBottomOf="@+id/xd_qr_iv"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/xshare_text_size_medium"
                android:textColor="@color/txt_secondary"
                android:gravity="start|center_vertical"
                android:id="@+id/invite_nearby_header_tv"
                android:background="@color/child_window_bg"
                android:layout_width="match_parent"
                android:layout_height="@dimen/x_dp_30"
                android:layout_marginTop="@dimen/x_dp_24"
                android:text="@string/share_title_no_usage"
                android:paddingStart="@dimen/x_dp_16"
                android:paddingEnd="@dimen/x_dp_16"
                app:layout_constraintTop_toBottomOf="@+id/qr_des_tv"
                style="@style/title_text_style_bold"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:gravity="center"
                android:id="@+id/btn_bl"
                android:background="@drawable/btn_primary_round_corner"
                android:paddingLeft="@dimen/x_dp_16"
                android:paddingRight="@dimen/x_dp_16"
                android:layout_width="248dp"
                android:layout_height="@dimen/x_dp_48"
                android:layout_marginLeft="@dimen/x_dp_32"
                android:layout_marginTop="@dimen/x_dp_16"
                android:layout_marginRight="@dimen/x_dp_32"
                android:text="@string/invite_bluetooth"
                android:drawableStart="@drawable/svg_share_bluetooth"
                android:layout_marginHorizontal="@dimen/x_dp_32"
                android:paddingHorizontal="@dimen/x_dp_16"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/invite_nearby_header_tv"
                style="@style/button_text_style_bold"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:gravity="center"
                android:id="@+id/btn_hotspot"
                android:background="@drawable/btn_secondary_round_corner"
                android:paddingLeft="@dimen/x_dp_16"
                android:paddingRight="@dimen/x_dp_16"
                android:layout_width="248dp"
                android:layout_height="@dimen/x_dp_48"
                android:layout_marginLeft="@dimen/x_dp_32"
                android:layout_marginTop="@dimen/x_dp_16"
                android:layout_marginRight="@dimen/x_dp_32"
                android:text="@string/hotspot_str"
                android:drawableStart="@drawable/svg_share_hotspot"
                android:layout_marginHorizontal="@dimen/x_dp_32"
                android:paddingHorizontal="@dimen/x_dp_16"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/btn_bl"
                style="@style/button_text_style_bold"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/xshare_text_size_medium"
                android:textColor="@color/txt_secondary"
                android:gravity="start|center_vertical"
                android:id="@+id/invite_remote_header_tv"
                android:background="@color/child_window_bg"
                android:paddingLeft="@dimen/x_dp_16"
                android:paddingRight="@dimen/x_dp_16"
                android:layout_width="match_parent"
                android:layout_height="@dimen/x_dp_30"
                android:layout_marginTop="@dimen/x_dp_16"
                android:text="@string/share_title_with_friend"
                android:paddingStart="@dimen/x_dp_16"
                android:paddingEnd="@dimen/x_dp_16"
                app:layout_constraintTop_toBottomOf="@+id/btn_hotspot"
                style="@style/title_text_style_bold"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/xshare_text_size_large"
                android:textColor="@color/txt_primary"
                android:gravity="start|center_vertical"
                android:id="@+id/share_via_messenger_btn"
                android:background="?attr/selectableItemBackground"
                android:paddingLeft="@dimen/x_dp_16"
                android:paddingRight="@dimen/x_dp_16"
                android:layout_width="match_parent"
                android:layout_height="@dimen/x_dp_48"
                android:text="@string/share_via_messenger"
                android:drawablePadding="@dimen/x_dp_16"
                android:drawableStart="@drawable/svg_share_xd_messenger"
                android:drawableEnd="@drawable/svg_arrow"
                android:paddingHorizontal="@dimen/x_dp_16"
                app:layout_constraintTop_toBottomOf="@+id/invite_remote_header_tv"/>
            <View
                android:id="@+id/messenger_line"
                android:background="@color/x_line"
                android:layout_width="match_parent"
                android:layout_height="1px"
                app:layout_constraintTop_toBottomOf="@+id/share_via_messenger_btn"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/xshare_text_size_large"
                android:textColor="@color/txt_primary"
                android:gravity="start|center_vertical"
                android:id="@+id/share_via_hike_btn"
                android:background="?attr/selectableItemBackground"
                android:paddingLeft="@dimen/x_dp_16"
                android:paddingRight="@dimen/x_dp_16"
                android:layout_width="match_parent"
                android:layout_height="@dimen/x_dp_48"
                android:text="@string/share_via_hike"
                android:drawablePadding="@dimen/x_dp_16"
                android:drawableStart="@drawable/svg_share_xd_hike"
                android:drawableEnd="@drawable/svg_arrow"
                android:paddingHorizontal="@dimen/x_dp_16"
                app:layout_constraintTop_toBottomOf="@+id/messenger_line"/>
            <View
                android:id="@+id/hike_line"
                android:background="@color/x_line"
                android:layout_width="match_parent"
                android:layout_height="1px"
                app:layout_constraintTop_toBottomOf="@+id/share_via_hike_btn"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/xshare_text_size_large"
                android:textColor="@color/txt_primary"
                android:gravity="start|center_vertical"
                android:id="@+id/share_via_message_btn"
                android:background="?attr/selectableItemBackground"
                android:paddingLeft="@dimen/x_dp_16"
                android:paddingRight="@dimen/x_dp_16"
                android:layout_width="match_parent"
                android:layout_height="@dimen/x_dp_48"
                android:text="@string/share_via_message"
                android:drawablePadding="@dimen/x_dp_16"
                android:drawableStart="@drawable/svg_share_xd_message"
                android:drawableEnd="@drawable/svg_arrow"
                android:paddingHorizontal="@dimen/x_dp_16"
                app:layout_constraintTop_toBottomOf="@+id/hike_line"/>
            <View
                android:id="@+id/message_line"
                android:background="@color/x_line"
                android:layout_width="match_parent"
                android:layout_height="1px"
                app:layout_constraintTop_toBottomOf="@+id/share_via_message_btn"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/xshare_text_size_large"
                android:textColor="@color/txt_primary"
                android:gravity="start|center_vertical"
                android:id="@+id/share_via_status_btn"
                android:background="?attr/selectableItemBackground"
                android:paddingLeft="@dimen/x_dp_16"
                android:paddingRight="@dimen/x_dp_16"
                android:layout_width="match_parent"
                android:layout_height="@dimen/x_dp_48"
                android:text="@string/menu_whatsapp"
                android:drawablePadding="@dimen/x_dp_16"
                android:drawableStart="@drawable/svg_share_xd_wa"
                android:drawableEnd="@drawable/svg_arrow"
                android:paddingHorizontal="@dimen/x_dp_16"
                app:layout_constraintTop_toBottomOf="@+id/message_line"/>
            <View
                android:id="@+id/status_line"
                android:background="@color/x_line"
                android:layout_width="match_parent"
                android:layout_height="1px"
                app:layout_constraintTop_toBottomOf="@+id/share_via_status_btn"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/xshare_text_size_large"
                android:textColor="@color/txt_primary"
                android:gravity="start|center_vertical"
                android:id="@+id/share_via_fb_btn"
                android:background="?attr/selectableItemBackground"
                android:paddingLeft="@dimen/x_dp_16"
                android:paddingRight="@dimen/x_dp_16"
                android:layout_width="match_parent"
                android:layout_height="@dimen/x_dp_48"
                android:text="@string/about_facebook"
                android:drawablePadding="@dimen/x_dp_16"
                android:drawableStart="@drawable/svg_share_xd_fb"
                android:drawableEnd="@drawable/svg_arrow"
                android:paddingHorizontal="@dimen/x_dp_16"
                app:layout_constraintTop_toBottomOf="@+id/status_line"/>
            <View
                android:id="@+id/fb_line"
                android:background="@color/x_line"
                android:layout_width="match_parent"
                android:layout_height="1px"
                app:layout_constraintTop_toBottomOf="@+id/share_via_fb_btn"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/xshare_text_size_large"
                android:textColor="@color/txt_primary"
                android:gravity="start|center_vertical"
                android:id="@+id/share_via_tw_btn"
                android:background="?attr/selectableItemBackground"
                android:paddingLeft="@dimen/x_dp_16"
                android:paddingRight="@dimen/x_dp_16"
                android:layout_width="match_parent"
                android:layout_height="@dimen/x_dp_48"
                android:text="@string/about_twitter"
                android:drawablePadding="@dimen/x_dp_16"
                android:drawableStart="@drawable/svg_share_xd_x"
                android:drawableEnd="@drawable/svg_arrow"
                android:paddingHorizontal="@dimen/x_dp_16"
                app:layout_constraintTop_toBottomOf="@+id/fb_line"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</com.userlabs.xshare.views.XLinearLayout>
