<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivTop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="50dp"
            android:src="@drawable/pc_connect_after"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/xshare_text_size_large_greater"
            android:textColor="@color/primary"
            android:id="@+id/tvNetworkHintText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="@string/unknown_name"
            android:drawablePadding="5dp"
            android:drawableStart="@drawable/svg_pc_connect_wifi"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ivTop"/>
        <View
            android:id="@+id/midBg"
            android:background="@color/child_window_bg"
            android:layout_width="240dp"
            android:layout_height="120dp"
            android:layout_marginTop="26dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvNetworkHintText"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivModelIcon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="15dp"
            android:src="@drawable/svg_pc_yun"
            android:scaleType="center"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@+id/midBg"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="14sp"
            android:textColor="@color/primary"
            android:gravity="center"
            android:id="@+id/tvConnectTip"
            android:layout_width="240dp"
            android:layout_height="wrap_content"
            android:text="@string/pc_cloud_connect_tip"
            android:maxLines="2"
            app:layout_constraintLeft_toLeftOf="@+id/midBg"
            app:layout_constraintRight_toRightOf="@+id/midBg"
            app:layout_constraintTop_toBottomOf="@+id/ivModelIcon"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/xshare_text_size_large_greater"
            android:textColor="@color/txt_primary"
            android:id="@+id/ivNetworkTypeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="@string/connect_type_local"
            android:singleLine="true"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/midBg"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="@color/primary"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/btnNetworkDisconnect"
            android:background="@drawable/btn_primary_line_round_corner"
            android:layout_width="match_parent"
            android:layout_height="@dimen/x_dp_48"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="20dp"
            android:text="@string/disconnect"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ivNetworkTypeText"
            style="@style/button_text_style_bold"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
