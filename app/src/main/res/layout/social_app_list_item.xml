<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/x_dp_72"
    android:layout_height="@dimen/x_dp_64">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/social_icon_iv"
        android:layout_width="@dimen/x_dp_40"
        android:layout_height="@dimen/x_dp_40"
        app:layout_constraintBottom_toTopOf="@+id/social_icon_name_tv"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_small"
        android:textColor="@color/txt_primary"
        android:gravity="center_horizontal"
        android:id="@+id/social_icon_name_tv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/social_icon_iv"/>
</androidx.constraintlayout.widget.ConstraintLayout>
