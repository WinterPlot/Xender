<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/x_volume_layout"
    android:tag="layout/x_volume_layout_0"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="@dimen/x_dp_96"
    android:translationZ="@dimen/x_dp_2">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/x_volume_iv"
        android:layout_width="@dimen/x_dp_30"
        android:layout_height="@dimen/x_dp_30"
        android:layout_marginBottom="@dimen/x_dp_12"
        app:layout_constraintBottom_toTopOf="@+id/x_volume_seek_bar"
        app:layout_constraintEnd_toStartOf="@+id/x_volume_normal_tv"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@color/x_volume_boost_pb_progress"
        android:gravity="center"
        android:id="@+id/x_volume_normal_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/x_volume_iv"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/x_volume_iv"
        app:layout_constraintTop_toTopOf="@+id/x_volume_iv"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/x_volume_normal_group"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="x_volume_iv,x_volume_normal_tv"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/x_enhancer_left_iv"
        android:layout_width="@dimen/x_dp_24"
        android:layout_height="@dimen/x_dp_24"
        android:layout_marginBottom="@dimen/x_dp_12"
        android:layout_marginStart="@dimen/x_dp_16"
        app:layout_constraintBottom_toTopOf="@+id/x_volume_seek_bar"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@color/x_volume_boost_pb_progress"
        android:id="@+id/x_enhancer_tv"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/x_volume"
        app:layout_constraintBottom_toBottomOf="@+id/x_enhancer_left_iv"
        app:layout_constraintEnd_toStartOf="@+id/x_enhancer_tv_progress"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/x_enhancer_left_iv"
        style="@style/x_volume"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@color/primary"
        android:gravity="center"
        android:id="@+id/x_enhancer_tv_progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/x_dp_6"
        app:layout_constraintBottom_toBottomOf="@+id/x_enhancer_tv"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/x_enhancer_tv"
        app:layout_constraintTop_toTopOf="@+id/x_enhancer_tv"
        style="@style/x_volume"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/x_enhancer_right_iv"
        android:layout_width="@dimen/x_dp_24"
        android:layout_height="@dimen/x_dp_24"
        android:layout_marginEnd="@dimen/x_dp_16"
        app:layout_constraintBottom_toBottomOf="@+id/x_enhancer_left_iv"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/x_enhancer_left_iv"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/x_volume_enhancer_group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="x_enhancer_left_iv,x_enhancer_tv,x_enhancer_tv_progress,x_enhancer_right_iv"/>
    <androidx.appcompat.widget.AppCompatSeekBar
        android:id="@+id/x_volume_seek_bar"
        android:layout_width="0dp"
        android:layout_height="@dimen/x_dp_16"
        android:layout_marginBottom="@dimen/x_dp_24"
        android:progressDrawable="@drawable/bg_volume_boost_sb_progress_low"
        android:thumb="@drawable/bg_volume_boost_sb_thumb_2"
        android:layout_marginStart="@dimen/x_dp_8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/x_volume_enhancer_low_btn"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/x_volume_enhancer_low_btn"
        android:padding="@dimen/x_dp_7"
        android:visibility="visible"
        android:layout_width="@dimen/x_dp_24"
        android:layout_height="@dimen/x_dp_24"
        android:src="@drawable/bg_volume_boost_dot"
        android:layout_marginEnd="@dimen/x_dp_8"
        app:layout_constraintBottom_toBottomOf="@+id/x_volume_seek_bar"
        app:layout_constraintEnd_toStartOf="@+id/x_volume_enhancer_medium_btn"
        app:layout_constraintStart_toEndOf="@+id/x_volume_seek_bar"
        app:layout_constraintTop_toTopOf="@+id/x_volume_seek_bar"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/x_volume_enhancer_medium_btn"
        android:padding="@dimen/x_dp_7"
        android:visibility="visible"
        android:layout_width="@dimen/x_dp_24"
        android:layout_height="@dimen/x_dp_24"
        android:src="@drawable/bg_volume_boost_dot"
        android:layout_marginEnd="@dimen/x_dp_8"
        app:layout_constraintBottom_toBottomOf="@+id/x_volume_seek_bar"
        app:layout_constraintEnd_toStartOf="@+id/x_volume_enhancer_high_btn"
        app:layout_constraintStart_toEndOf="@+id/x_volume_enhancer_low_btn"
        app:layout_constraintTop_toTopOf="@+id/x_volume_seek_bar"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/x_volume_enhancer_high_btn"
        android:padding="@dimen/x_dp_7"
        android:visibility="visible"
        android:layout_width="@dimen/x_dp_24"
        android:layout_height="@dimen/x_dp_24"
        android:src="@drawable/bg_volume_boost_dot"
        android:layout_marginEnd="@dimen/x_dp_10"
        app:layout_constraintBottom_toBottomOf="@+id/x_volume_seek_bar"
        app:layout_constraintEnd_toStartOf="@+id/x_end_space"
        app:layout_constraintStart_toEndOf="@+id/x_volume_enhancer_medium_btn"
        app:layout_constraintTop_toTopOf="@+id/x_volume_seek_bar"/>
    <androidx.legacy.widget.Space
        android:id="@+id/x_end_space"
        android:layout_width="@dimen/x_dp_8"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/x_volume_seek_bar"
        app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
