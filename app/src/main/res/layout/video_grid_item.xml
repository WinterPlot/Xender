<?xml version="1.0" encoding="utf-8"?>
<com.userlabs.xshare.views.X43SquareConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/video_new_badge"
        android:visibility="gone"
        android:layout_width="@dimen/x_dp_20"
        android:layout_height="@dimen/x_dp_20"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="center"
        android:id="@+id/video_icon_item"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/video_checked_shadow"
        android:background="@color/mask_shadow"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_smaller"
        android:textColor="@color/txt_white"
        android:gravity="center"
        android:layout_gravity="start|bottom"
        android:id="@+id/video_duration_item"
        android:background="@drawable/bg_duration"
        android:paddingLeft="@dimen/x_dp_5"
        android:paddingRight="@dimen/x_dp_5"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/x_dp_16"
        android:layout_marginBottom="5dp"
        android:singleLine="true"
        android:layout_marginEnd="3dp"
        android:paddingHorizontal="@dimen/x_dp_5"
        app:layout_constraintBottom_toBottomOf="@+id/video_icon_item"
        app:layout_constraintEnd_toEndOf="@+id/video_icon_item"/>
    <com.userlabs.xshare.views.XCheckBox
        android:id="@+id/cb_video_check"
        android:paddingTop="0dp"
        android:paddingBottom="16dp"
        android:duplicateParentState="false"
        android:layout_width="@dimen/x_dp_52"
        android:layout_height="@dimen/x_dp_52"
        android:scaleType="center"
        android:paddingStart="@dimen/x_dp_3"
        android:paddingEnd="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</com.userlabs.xshare.views.X43SquareConstraintLayout>
