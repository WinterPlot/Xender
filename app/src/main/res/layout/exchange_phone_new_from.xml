<?xml version="1.0" encoding="utf-8"?>
<com.userlabs.xshare.views.XConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:background="@color/app_window_bg"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include layout="@layout/ex_toolbar"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="center"
        android:id="@+id/import_from_android_tv"
        android:background="@drawable/ex_android_bg"
        android:layout_width="match_parent"
        android:layout_height="@dimen/ex_dp_145"
        android:layout_marginLeft="@dimen/ex_dp_25"
        android:layout_marginRight="@dimen/ex_dp_25"
        android:layout_marginBottom="@dimen/cx_dp_16"
        android:layout_marginHorizontal="@dimen/ex_dp_25"
        app:layout_constraintBottom_toTopOf="@+id/import_from_iphone_tv">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ex_bg_android"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/import_from_android_iv"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginLeft="@dimen/ex_dp_40"
            android:layout_marginRight="@dimen/ex_dp_40"
            android:src="@drawable/ex_bg_new_android"
            android:scaleType="centerInside"
            android:layout_marginHorizontal="@dimen/ex_dp_40"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/ex_00C099"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/cx_sp_30"
            android:textColor="@color/ex_00C099"
            android:id="@+id/new_phone_android"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Android"
            android:layout_marginStart="@dimen/ex_dp_40"
            app:layout_constraintBottom_toTopOf="@+id/new_phone_android_des"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            style="@style/ex_text_style_bold"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/xshare_text_size_large"
            android:textColor="@color/ex_00C099"
            android:gravity="start"
            android:id="@+id/new_phone_android_des"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/ex_dp_40"
            android:layout_marginRight="@dimen/ex_dp_40"
            android:text="@string/exchange_phone_title_from_android"
            android:layout_marginHorizontal="@dimen/ex_dp_40"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/import_from_android_iv"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/new_phone_android"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="center"
        android:id="@+id/import_from_iphone_tv"
        android:background="@drawable/ex_bg_window_2_color_corner_10"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/ex_dp_145"
        android:layout_marginLeft="@dimen/ex_dp_25"
        android:layout_marginRight="@dimen/ex_dp_25"
        android:layout_marginBottom="@dimen/ex_dp_40"
        android:layout_marginHorizontal="@dimen/ex_dp_25"
        app:layout_constraintBottom_toBottomOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ex_bg_iphone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/import_from_iphone_iv"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginLeft="@dimen/ex_dp_40"
            android:layout_marginRight="@dimen/ex_dp_40"
            android:src="@drawable/ex_bg_new_iphone"
            android:layout_marginHorizontal="@dimen/ex_dp_40"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/ex_404A59"/>
        <TextView
            android:textSize="@dimen/cx_sp_30"
            android:textColor="@color/ex_404A59"
            android:id="@+id/new_phone_iphone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="iPhone"
            android:layout_marginStart="@dimen/ex_dp_40"
            app:layout_constraintBottom_toTopOf="@+id/new_phone_iphone_des"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            style="@style/ex_text_style_bold"/>
        <TextView
            android:textSize="@dimen/xshare_text_size_large"
            android:textColor="@color/ex_404A59"
            android:gravity="start"
            android:id="@+id/new_phone_iphone_des"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/ex_dp_40"
            android:layout_marginRight="@dimen/ex_dp_40"
            android:text="@string/exchange_phone_title_from_iphone"
            android:layout_marginHorizontal="@dimen/ex_dp_40"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/import_from_iphone_iv"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/new_phone_iphone"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.userlabs.xshare.views.XConstraintLayout>
