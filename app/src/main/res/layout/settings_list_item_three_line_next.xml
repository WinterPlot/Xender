<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/selector_list_item"
    android:paddingLeft="@dimen/x_dp_16"
    android:paddingTop="@dimen/x_dp_5"
    android:paddingRight="@dimen/x_dp_16"
    android:paddingBottom="@dimen/x_dp_5"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/x_dp_64"
    android:paddingHorizontal="@dimen/x_dp_16"
    android:paddingVertical="@dimen/x_dp_5">
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/cx_sp_15"
        android:textColor="@color/txt_primary"
        android:gravity="start"
        android:id="@+id/three_line_next_title_tv"
        android:duplicateParentState="true"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:textDirection="locale"
        app:layout_constraintBottom_toTopOf="@+id/three_line_next_des1_tv"
        app:layout_constraintEnd_toStartOf="@+id/three_line_next_iv"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_small"
        android:textColor="@color/primary"
        android:id="@+id/three_line_next_des1_tv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/x_dp_5"
        android:textDirection="locale"
        app:layout_constraintBottom_toTopOf="@+id/three_line_next_des2_tv"
        app:layout_constraintEnd_toStartOf="@+id/three_line_next_iv"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/three_line_next_title_tv"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_small"
        android:textColor="@color/x_red"
        android:gravity="start|center_vertical"
        android:id="@+id/three_line_next_des2_tv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/x_dp_5"
        android:drawablePadding="@dimen/x_dp_5"
        android:textDirection="locale"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/three_line_next_iv"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/three_line_next_des1_tv"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/three_line_next_iv"
        android:clickable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
