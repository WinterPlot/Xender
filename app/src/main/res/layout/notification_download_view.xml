<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="80dp">
    <ImageView
        android:id="@+id/notification_icon_iv"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_margin="12dp"
        android:src="@drawable/x_notification_icon"
        android:scaleType="centerInside"
        android:layout_centerVertical="true"
        android:layout_alignParentStart="true"/>
    <TextView
        android:textSize="@dimen/xshare_text_size_medium"
        android:textColor="@color/primary"
        android:id="@+id/notification_cancel_download"
        android:background="@drawable/btn_line_primary_solid_transparent"
        android:paddingLeft="8dp"
        android:paddingTop="4dp"
        android:paddingRight="8dp"
        android:paddingBottom="4dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/cx_dlg_cancel"
        android:layout_centerVertical="true"
        android:layout_marginEnd="16dp"
        android:layout_alignParentEnd="true"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_toStartOf="@+id/notification_cancel_download"
        android:layout_toEndOf="@+id/notification_icon_iv">
        <TextView
            android:textSize="@dimen/xshare_text_size_large"
            android:textColor="@color/txt_primary"
            android:id="@+id/notification_title_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"/>
        <TextView
            android:textSize="@dimen/xshare_text_size_medium"
            android:textColor="@color/txt_secondary"
            android:id="@+id/notification_ticker_text_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="1dp"
        android:layout_alignParentBottom="true">
        <ProgressBar
            android:layout_width="0dp"
            android:layout_height="2dp"
            android:max="100"
            android:progress="10"
            android:progressDrawable="@drawable/bg_progress_notification"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            style="@style/Widget.AppCompat.ProgressBar.Horizontal"/>
        <TextView
            android:textSize="@dimen/xshare_text_size_small"
            android:textColor="@color/txt_primary"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/progress_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:layout_marginEnd="16dp"/>
    </LinearLayout>
</RelativeLayout>
