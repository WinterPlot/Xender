<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/bg_window_2_color_top_corner_10"
    android:paddingTop="@dimen/x_dp_16"
    android:paddingBottom="@dimen/x_dp_16"
    android:visibility="visible"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="@dimen/x_dp_16">
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_small"
        android:textColor="@color/txt_primary"
        android:id="@+id/fb_social_iv"
        android:padding="@dimen/x_dp_16"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:text="@string/social_fb_title"
        android:drawableTop="@drawable/svg_social_share_facebook"
        android:drawablePadding="6dp"
        app:layout_constraintEnd_toStartOf="@+id/fb_guide_line"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/fb_guide_line"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.2"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_small"
        android:textColor="@color/txt_primary"
        android:id="@+id/fb_lite_social_iv"
        android:padding="@dimen/x_dp_16"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:text="@string/social_fb_lite_title"
        android:drawableTop="@drawable/svg_social_share_lite"
        android:drawablePadding="6dp"
        app:layout_constraintEnd_toStartOf="@+id/lite_guide_line"
        app:layout_constraintStart_toEndOf="@+id/fb_guide_line"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/lite_guide_line"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.4"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_small"
        android:textColor="@color/txt_primary"
        android:id="@+id/instagram_social_iv"
        android:padding="@dimen/x_dp_16"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:text="@string/social_ins_title"
        android:drawableTop="@drawable/svg_social_share_instagram"
        android:drawablePadding="6dp"
        app:layout_constraintEnd_toStartOf="@+id/ins_guide_line"
        app:layout_constraintStart_toEndOf="@+id/lite_guide_line"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/ins_guide_line"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.6"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_small"
        android:textColor="@color/txt_primary"
        android:id="@+id/wa_social_iv"
        android:padding="@dimen/x_dp_16"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:text="@string/social_wa_title"
        android:drawableTop="@drawable/svg_social_share_whatsapp"
        android:drawablePadding="6dp"
        app:layout_constraintEnd_toStartOf="@+id/wa_guide_line"
        app:layout_constraintStart_toEndOf="@+id/ins_guide_line"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/wa_guide_line"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.8"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_small"
        android:textColor="@color/txt_primary"
        android:gravity="center"
        android:id="@+id/tw_social_iv"
        android:padding="@dimen/x_dp_16"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:text="@string/social_tw_title"
        android:drawableTop="@drawable/svg_social_share_twitter"
        android:drawablePadding="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/wa_guide_line"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatButton
        android:textSize="@dimen/xshare_text_size_large_greater"
        android:textColor="@color/txt_primary"
        android:id="@+id/cancel_share_btn"
        android:background="@drawable/btn_white"
        android:layout_width="0dp"
        android:layout_height="@dimen/x_dp_48"
        android:layout_marginLeft="@dimen/x_dp_32"
        android:layout_marginTop="@dimen/x_dp_16"
        android:layout_marginRight="@dimen/x_dp_32"
        android:text="@string/cancel_operation"
        android:layout_marginHorizontal="@dimen/x_dp_32"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/fb_social_iv"/>
</androidx.constraintlayout.widget.ConstraintLayout>
