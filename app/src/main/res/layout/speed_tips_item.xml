<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_large"
        android:textColor="@color/primary"
        android:layout_gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/speed_slow_why"
        style="@style/title_text_font_medium_style"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="center"
        android:id="@+id/speed_tips_iv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="13dp"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_medium"
        android:textColor="@color/txt_primary"
        android:id="@+id/speed_tips_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginStart="@dimen/x_dp_16"
        android:layout_marginEnd="@dimen/x_dp_16"/>
</LinearLayout>
