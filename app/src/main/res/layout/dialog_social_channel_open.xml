<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingLeft="@dimen/x_dp_16"
    android:paddingTop="@dimen/x_dp_16"
    android:paddingRight="@dimen/x_dp_16"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="@dimen/x_dp_16">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/social_noti_iv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:scaleType="centerInside"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_large"
        android:gravity="start"
        android:id="@+id/social_noti_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/x_dp_30"
        style="@style/text_style_bold"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_large"
        android:gravity="start"
        android:id="@+id/social_noti_tips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/x_dp_10"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:gravity="center"
        android:id="@+id/social_noti_turn_on"
        android:layout_width="match_parent"
        android:layout_height="@dimen/x_dp_48"
        android:layout_marginTop="@dimen/x_dp_30"
        style="@style/button_text_style_bold"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_large"
        android:textColor="@color/txt_secondary"
        android:gravity="center"
        android:id="@+id/social_noti_cancel"
        android:layout_width="match_parent"
        android:layout_height="@dimen/x_dp_48"
        android:layout_marginTop="@dimen/x_dp_10"
        style="@style/button_text_style_bold"/>
</androidx.appcompat.widget.LinearLayoutCompat>
