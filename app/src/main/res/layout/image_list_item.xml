<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/image_list_item_layer"
    android:background="@drawable/selector_list_item"
    android:descendantFocusability="afterDescendants"
    android:layout_width="match_parent"
    android:layout_height="@dimen/x_dp_80">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/image_icon_item"
        android:layout_width="@dimen/x_dp_56"
        android:layout_height="@dimen/x_dp_56"
        android:layout_marginLeft="@dimen/x_dp_16"
        android:layout_marginRight="@dimen/x_dp_16"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.userlabs.xshare.views.XCheckBox
        android:id="@+id/cb_image_check"
        android:duplicateParentState="false"
        android:layout_width="@dimen/x_dp_20"
        android:layout_height="@dimen/x_dp_20"
        android:scaleType="centerInside"
        android:layout_marginEnd="@dimen/x_dp_14"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/image_badge_new"
        android:visibility="visible"
        android:layout_width="@dimen/x_dp_20"
        android:layout_height="@dimen/x_dp_20"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/cx_sp_15"
        android:textColor="@color/txt_primary"
        android:ellipsize="middle"
        android:gravity="start|center_vertical"
        android:id="@+id/image_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/x_dp_12"
        android:layout_marginRight="@dimen/x_dp_12"
        android:singleLine="true"
        android:layout_marginHorizontal="@dimen/x_dp_12"
        app:layout_constraintBottom_toTopOf="@+id/image_size"
        app:layout_constraintEnd_toStartOf="@+id/cb_image_check"
        app:layout_constraintStart_toEndOf="@+id/image_icon_item"
        app:layout_constraintTop_toTopOf="@+id/image_icon_item"
        app:layout_constraintVertical_chainStyle="spread"
        app:layout_constraintVertical_weight="1"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_small"
        android:textColor="@color/txt_secondary"
        android:gravity="start|center_vertical"
        android:id="@+id/image_size"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:layout_marginEnd="@dimen/x_dp_16"
        app:layout_constraintBottom_toTopOf="@+id/image_date"
        app:layout_constraintEnd_toStartOf="@+id/cb_image_check"
        app:layout_constraintStart_toStartOf="@+id/image_name"
        app:layout_constraintTop_toBottomOf="@+id/image_name"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_small"
        android:textColor="@color/txt_secondary"
        android:gravity="start|center_vertical"
        android:id="@+id/image_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        app:layout_constraintBottom_toBottomOf="@+id/image_icon_item"
        app:layout_constraintStart_toStartOf="@+id/image_name"
        app:layout_constraintTop_toBottomOf="@+id/image_size"/>
</androidx.constraintlayout.widget.ConstraintLayout>
