<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/exit_rate_dialog"
    android:paddingTop="@dimen/x_dp_16"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <include
        android:id="@+id/auto_scroll_pager"
        android:layout_width="match_parent"
        android:layout_height="187dp"
        android:layout_marginLeft="@dimen/x_dp_16"
        android:layout_marginRight="@dimen/x_dp_16"
        android:layout_marginHorizontal="@dimen/x_dp_16"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/auto_scroll_view_pager_layer"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_large"
        android:textColor="@color/txt_primary"
        android:id="@+id/exit_dlg_tv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/x_dp_18"
        android:text="@string/rate_us_title"
        android:layout_marginStart="@dimen/x_dp_36"
        app:layout_constraintTop_toBottomOf="@+id/auto_scroll_pager"
        style="@style/text_style_bold"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/rate_us_star_iv_press_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/x_dp_24"
        android:src="@drawable/svg_rate_us_press"
        app:layout_constraintEnd_toStartOf="@+id/rate_us_star_iv_press_2"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/exit_dlg_tv"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/rate_us_star_iv_press_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/svg_rate_us_press"
        android:layout_marginStart="22dp"
        app:layout_constraintEnd_toStartOf="@+id/rate_us_star_iv_press_3"
        app:layout_constraintStart_toEndOf="@+id/rate_us_star_iv_press_1"
        app:layout_constraintTop_toTopOf="@+id/rate_us_star_iv_press_1"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/rate_us_star_iv_press_3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/svg_rate_us_press"
        android:layout_marginStart="22dp"
        app:layout_constraintEnd_toStartOf="@+id/rate_us_star_iv_press_4"
        app:layout_constraintStart_toEndOf="@+id/rate_us_star_iv_press_2"
        app:layout_constraintTop_toTopOf="@+id/rate_us_star_iv_press_1"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/rate_us_star_iv_press_4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/svg_rate_us_press"
        android:layout_marginStart="22dp"
        app:layout_constraintEnd_toStartOf="@+id/rate_us_star_iv_press_5"
        app:layout_constraintStart_toEndOf="@+id/rate_us_star_iv_press_3"
        app:layout_constraintTop_toTopOf="@+id/rate_us_star_iv_press_1"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/rate_us_star_iv_press_5"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/svg_rate_us_press"
        android:layout_marginStart="22dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/rate_us_star_iv_press_4"
        app:layout_constraintTop_toTopOf="@+id/rate_us_star_iv_press_1"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/rate_me_plz"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/svg_rate_us_hand"
        android:layout_below="@+id/rate_us_star_iv_press_5"
        app:layout_constraintEnd_toEndOf="@+id/rate_us_star_iv_press_5"
        app:layout_constraintStart_toStartOf="@+id/rate_us_star_iv_press_5"
        app:layout_constraintTop_toTopOf="@+id/rate_us_star_iv_press_5"/>
    <View
        android:id="@+id/exit_dlg_horizontal_line"
        android:background="@color/x_line"
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:layout_marginTop="@dimen/x_dp_50"
        app:layout_constraintTop_toBottomOf="@+id/rate_us_star_iv_press_1"/>
    <View
        android:id="@+id/exit_dlg_vertical_line"
        android:background="@color/x_line"
        android:layout_width="1px"
        android:layout_height="@dimen/x_dp_50"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/exit_dlg_horizontal_line"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_medium"
        android:textColor="@color/txt_secondary"
        android:gravity="center"
        android:id="@+id/exit_quit_rate"
        android:background="@drawable/selector_list_item"
        android:layout_width="0dp"
        android:layout_height="@dimen/x_dp_50"
        android:text="@string/rate_us_later"
        app:layout_constraintEnd_toStartOf="@+id/exit_dlg_vertical_line"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/exit_dlg_horizontal_line"
        style="@style/title_text_style_bold"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_medium"
        android:textColor="@color/primary"
        android:gravity="center"
        android:id="@+id/exit_go_rate"
        android:background="@drawable/selector_list_item"
        android:layout_width="0dp"
        android:layout_height="@dimen/x_dp_50"
        android:text="@string/rate_us_now"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/exit_dlg_vertical_line"
        app:layout_constraintTop_toBottomOf="@+id/exit_dlg_horizontal_line"
        style="@style/title_text_style_bold"/>
</androidx.constraintlayout.widget.ConstraintLayout>
