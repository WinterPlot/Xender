<?xml version="1.0" encoding="utf-8"?>
<com.userlabs.xshare.views.XConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/activity_me_0"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/me_toolbar"
        android:background="@color/primary"
        android:layout_width="match_parent"
        android:layout_height="@dimen/x_dp_48"
        android:minHeight="@dimen/x_dp_48"
        android:tintMode="src_atop"
        app:contentInsetStartWithNavigation="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:popupTheme="@style/Theme.AppCompat.Light.DarkActionBar"
        app:titleTextAppearance="@style/toolbar_text_style_bold"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/me_message"
        android:layout_width="@dimen/x_dp_24"
        android:layout_height="@dimen/x_dp_24"
        android:scaleType="center"
        android:layout_marginEnd="@dimen/x_dp_16"
        app:layout_constraintBottom_toBottomOf="@+id/me_toolbar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/me_toolbar"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/me_message_tips"
        android:visibility="gone"
        android:layout_width="@dimen/x_dp_8"
        android:layout_height="@dimen/x_dp_8"
        app:layout_constraintCircle="@+id/me_message"
        app:layout_constraintCircleAngle="45"
        app:layout_constraintCircleRadius="16dp"
        app:layout_constraintEnd_toEndOf="@+id/me_message"
        app:layout_constraintTop_toTopOf="@+id/me_message"/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/me_toolbar">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:tag="binding_1"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/me_avatar"
                android:layout_width="@dimen/x_dp_60"
                android:layout_height="@dimen/x_dp_60"
                android:layout_marginTop="@dimen/x_dp_16"
                android:layout_marginStart="@dimen/x_dp_16"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/xshare_text_size_large_greater"
                android:textColor="@color/txt_primary"
                android:id="@+id/me_nickname"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/x_dp_6"
                app:layout_constraintBottom_toBottomOf="@+id/me_avatar"
                app:layout_constraintStart_toEndOf="@+id/me_avatar"
                app:layout_constraintTop_toTopOf="@+id/me_avatar"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/me_edit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:tint="@color/x_222_or_fff"
                android:layout_marginEnd="@dimen/x_dp_16"
                app:layout_constraintBottom_toBottomOf="@+id/me_avatar"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/me_avatar"/>
            <include
                android:id="@+id/me_summary_layout"
                android:layout_width="match_parent"
                android:layout_height="@dimen/x_dp_87"
                android:layout_marginLeft="@dimen/x_dp_16"
                android:layout_marginTop="@dimen/x_dp_20"
                android:layout_marginRight="@dimen/x_dp_16"
                android:layout_marginHorizontal="@dimen/x_dp_16"
                app:layout_constraintTop_toBottomOf="@+id/me_avatar"
                layout="@layout/me_summary"/>
            <include
                android:id="@+id/me_files_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/x_dp_12"
                app:layout_constraintTop_toBottomOf="@+id/me_summary_layout"
                layout="@layout/me_files"/>
            <include
                android:id="@+id/me_saved_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/x_dp_12"
                app:layout_constraintTop_toBottomOf="@+id/me_files_layout"
                layout="@layout/me_saved"/>
            <include
                android:id="@+id/me_friend_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/x_dp_12"
                app:layout_constraintTop_toBottomOf="@+id/me_saved_layout"
                layout="@layout/me_friend"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</com.userlabs.xshare.views.XConstraintLayout>
