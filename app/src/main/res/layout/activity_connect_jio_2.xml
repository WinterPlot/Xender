<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/kaios_part2"
    android:focusable="true"
    android:visibility="gone"
    android:fitsSystemWindows="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ProgressBar
        android:layout_gravity="center"
        android:id="@+id/kaios_loading_open"
        android:visibility="gone"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginTop="@dimen/x_dp_16"
        style="@style/ProgressBar.Loading"/>
    <ScrollView
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/xshare_text_size_small"
                android:textColor="@color/txt_primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/x_dp_16"
                android:text="@string/kaios_connect_step1"
                android:layout_marginStart="@dimen/x_dp_16"
                android:layout_marginEnd="@dimen/x_dp_16"/>
            <TextView
                android:textSize="@dimen/xshare_text_size_small"
                android:textColor="@color/txt_primary"
                android:id="@+id/kaios_connect_wifi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/kaios_connect_wifi"
                android:layout_marginStart="@dimen/x_dp_16"
                android:layout_marginEnd="@dimen/x_dp_16"/>
            <LinearLayout
                android:orientation="horizontal"
                android:background="@drawable/bg_window_2_color_corner_10"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="@dimen/x_dp_16"
                android:layout_marginStart="@dimen/x_dp_16"
                android:layout_marginEnd="@dimen/x_dp_16">
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_gravity="center"
                    android:background="@drawable/svg_jio_wifi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"/>
                <TextView
                    android:textSize="@dimen/xshare_text_size_medium"
                    android:textColor="@color/txt_primary"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/kaios_ap_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/kaios_create_ap_password"
                android:background="@drawable/bg_window_2_color_corner_10"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="@dimen/x_dp_16"
                android:layout_marginStart="@dimen/x_dp_16"
                android:layout_marginEnd="@dimen/x_dp_16">
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_gravity="center"
                    android:background="@drawable/svg_jio_password"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"/>
                <TextView
                    android:textSize="@dimen/xshare_text_size_medium"
                    android:textColor="@color/txt_primary"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/kaios_ap_password"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/connect_kaios_password_need_tips_layout"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/x_dp_16"
                android:layout_marginEnd="@dimen/x_dp_16">
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_gravity="center"
                    android:id="@+id/connect_kaios_password_need_tips_iv"
                    android:background="@drawable/svg_connect_pc_prompt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/xshare_text_size_medium"
                    android:layout_gravity="center"
                    android:id="@+id/connect_kaios_password_need_tips_layout_tv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/connect_pc_password_needed"/>
            </LinearLayout>
            <Button
                android:gravity="center"
                android:id="@+id/kaios_go_step2"
                android:background="@drawable/btn_primary_round_corner"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="@dimen/x_dp_16"
                android:text="@string/kaios_connect_step2_button"
                android:layout_marginStart="@dimen/x_dp_16"
                android:layout_marginEnd="@dimen/x_dp_16"
                style="@style/cx_button_text_style_bold"/>
            <TextView
                android:textSize="@dimen/xshare_text_size_small"
                android:textColor="@color/txt_secondary"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/kaios_go_step2_tips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/kaios_connect_wifi_next"
                android:layout_marginStart="@dimen/x_dp_16"
                android:layout_marginEnd="@dimen/x_dp_16"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/connect_use_app"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <TextView
                    android:textSize="@dimen/xshare_text_size_small"
                    android:textColor="@color/txt_primary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/x_dp_16"
                    android:text="@string/kaios_connect_step2"
                    android:layout_marginStart="@dimen/x_dp_16"
                    android:layout_marginEnd="@dimen/x_dp_16"/>
                <TextView
                    android:textSize="@dimen/xshare_text_size_small"
                    android:textColor="@color/txt_primary"
                    android:id="@+id/kaios_connect_use_qr_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/kaios_connect_use_qr"
                    android:layout_marginStart="@dimen/x_dp_16"
                    android:layout_marginEnd="@dimen/x_dp_16"/>
                <androidx.cardview.widget.CardView
                    android:layout_gravity="center"
                    android:layout_width="@dimen/x_dp_200"
                    android:layout_height="@dimen/x_dp_200"
                    android:layout_marginTop="@dimen/x_dp_16"
                    app:cardBackgroundColor="@color/app_window_bg"
                    app:cardCornerRadius="@dimen/x_dp_2">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_gravity="center"
                        android:id="@+id/kaios_qr_iv"
                        android:layout_width="@dimen/x_dp_168"
                        android:layout_height="@dimen/x_dp_168"/>
                </androidx.cardview.widget.CardView>
                <TextView
                    android:textSize="@dimen/xshare_text_size_small"
                    android:textColor="@color/primary"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/kaios_connect_no_app"
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:layout_marginTop="8dp"
                    android:text="@string/kaios_connect_no_app"
                    android:layout_marginStart="@dimen/x_dp_16"
                    android:layout_marginEnd="@dimen/x_dp_16"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/connect_use_browser"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <TextView
                    android:textSize="@dimen/xshare_text_size_small"
                    android:textColor="@color/txt_primary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/x_dp_16"
                    android:text="@string/kaios_connect_step2"
                    android:layout_marginStart="@dimen/x_dp_16"
                    android:layout_marginEnd="@dimen/x_dp_16"/>
                <TextView
                    android:textSize="@dimen/xshare_text_size_small"
                    android:textColor="@color/txt_primary"
                    android:id="@+id/kaios_connect_web"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/kaios_connect_use_web"
                    android:layout_marginStart="@dimen/x_dp_16"
                    android:layout_marginEnd="@dimen/x_dp_16"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:background="@drawable/bg_window_2_color_corner_10"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="@dimen/x_dp_16"
                    android:layout_marginBottom="57dp"
                    android:layout_marginStart="@dimen/x_dp_16"
                    android:layout_marginEnd="@dimen/x_dp_16">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_gravity="center"
                        android:background="@drawable/svg_jio_ip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"/>
                    <TextView
                        android:textSize="@dimen/xshare_text_size_medium"
                        android:textColor="@color/txt_primary"
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:id="@+id/connect_kaios_address"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <androidx.cardview.widget.CardView
        android:id="@+id/no_xshare_tips"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        app:cardCornerRadius="4dp">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:background="@drawable/bg_dotted_line_secondary_2"
            android:padding="@dimen/x_dp_16"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="4dp">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/pull_model_tips_iv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/svg_transmission_tips"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/no_xshare_tips_cancel"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/svg_ic_cancel"
                android:tint="@color/x_222_or_fff"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/xshare_text_size_large"
                android:textColor="@color/secondary_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dlg_tips"
                android:layout_marginStart="8dp"
                app:layout_constraintBottom_toBottomOf="@+id/pull_model_tips_iv"
                app:layout_constraintStart_toEndOf="@+id/pull_model_tips_iv"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/title_text_style_bold"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/xshare_text_size_medium"
                android:textColor="@color/txt_primary"
                android:id="@+id/kaios_install_app_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/x_dp_16"
                android:text="@string/kaios_install_app_tips"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/pull_model_tips_iv"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
    <View
        android:id="@+id/disconnect_button_dividing"
        android:background="@color/x_line"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"/>
    <Button
        android:textColor="@color/primary"
        android:gravity="center"
        android:layout_gravity="bottom"
        android:id="@+id/disconnect_button"
        android:background="@drawable/bg_line_primary_round_corner"
        android:layout_width="match_parent"
        android:layout_height="@dimen/x_dp_48"
        android:layout_marginTop="@dimen/x_dp_16"
        android:layout_marginBottom="@dimen/x_dp_10"
        android:text="@string/disconnect"
        android:layout_marginStart="@dimen/x_dp_16"
        android:layout_marginEnd="@dimen/x_dp_16"
        style="@style/button_text_style_bold"/>
</LinearLayout>
