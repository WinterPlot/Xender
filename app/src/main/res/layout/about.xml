<?xml version="1.0" encoding="utf-8"?>
<com.userlabs.xshare.views.XConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/about_0"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:textDirection="locale"
    android:layoutDirection="locale">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:background="@color/primary"
        android:layout_width="match_parent"
        android:layout_height="@dimen/x_dp_48"
        android:tintMode="src_atop"
        app:contentInsetStartWithNavigation="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:popupTheme="@style/Theme.AppCompat.Light.DarkActionBar"
        app:titleTextAppearance="@style/toolbar_text_style_bold"/>
    <View
        android:id="@+id/about_device_info"
        android:layout_width="@dimen/x_dp_100"
        android:layout_height="@dimen/x_dp_100"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/top_icon_iv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/x_dp_50"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_large"
        android:textColor="@color/txt_primary"
        android:gravity="center"
        android:id="@+id/about_version"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/x_dp_10"
        android:textIsSelectable="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/top_icon_iv"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_small"
        android:textColor="@color/txt_primary"
        android:gravity="center"
        android:id="@+id/build_time_tv"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textIsSelectable="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/about_version"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/top_group"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="top_icon_iv,about_version,build_time_tv"/>
    <View
        android:id="@+id/line_1"
        android:background="@color/x_line"
        android:layout_width="match_parent"
        android:layout_height="@dimen/divider_line_height"
        android:layout_marginTop="@dimen/x_dp_220"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_large_greater"
        android:textColor="@color/txt_primary"
        android:gravity="start|center_vertical"
        android:id="@+id/about_privacy_policy"
        android:paddingLeft="@dimen/x_dp_16"
        android:paddingRight="@dimen/x_dp_16"
        android:layout_width="match_parent"
        android:layout_height="@dimen/x_dp_64"
        android:text="@string/privacy_policy"
        android:drawablePadding="@dimen/x_dp_16"
        android:paddingHorizontal="@dimen/x_dp_16"
        app:layout_constraintTop_toBottomOf="@+id/line_1"/>
    <View
        android:id="@+id/line_2"
        android:background="@color/x_line"
        android:layout_width="match_parent"
        android:layout_height="@dimen/divider_line_height"
        app:layout_constraintTop_toBottomOf="@+id/about_privacy_policy"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_large_greater"
        android:textColor="@color/txt_primary"
        android:gravity="start|center_vertical"
        android:id="@+id/about_contact_us"
        android:paddingLeft="@dimen/x_dp_16"
        android:paddingRight="@dimen/x_dp_16"
        android:layout_width="match_parent"
        android:layout_height="@dimen/x_dp_64"
        android:text="@string/persion_contact_us_title"
        android:drawablePadding="@dimen/x_dp_16"
        android:paddingHorizontal="@dimen/x_dp_16"
        app:layout_constraintTop_toBottomOf="@+id/line_2"/>
    <View
        android:id="@+id/line_3"
        android:background="@color/x_line"
        android:layout_width="match_parent"
        android:layout_height="@dimen/divider_line_height"
        app:layout_constraintTop_toBottomOf="@+id/about_contact_us"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_large_greater"
        android:textColor="@color/txt_primary"
        android:textStyle="bold"
        android:gravity="start|center_vertical"
        android:id="@+id/about_open_source_title"
        android:paddingLeft="@dimen/x_dp_16"
        android:paddingRight="@dimen/x_dp_16"
        android:paddingTop="@dimen/x_dp_16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/about_open_source_title"
        app:layout_constraintTop_toBottomOf="@+id/line_3"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_small"
        android:textColor="@color/txt_primary"
        android:gravity="start|center_vertical"
        android:id="@+id/about_open_source"
        android:paddingLeft="@dimen/x_dp_16"
        android:paddingRight="@dimen/x_dp_16"
        android:paddingBottom="@dimen/x_dp_16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/about_open_source"
        app:layout_constraintTop_toBottomOf="@+id/about_open_source_title"/>
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_to_roaming"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:text="full screen"
        android:layout_marginEnd="@dimen/x_dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_to_usage"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:text="TLS"
        android:layout_marginEnd="@dimen/x_dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/btn_to_roaming"/>
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_to_usage_compt"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:text="ug com"
        android:layout_marginEnd="@dimen/x_dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/btn_to_usage"/>
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_to_settings_compt"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:text="st com"
        android:layout_marginEnd="@dimen/x_dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/btn_to_usage_compt"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/btn_params"
        android:background="@color/x_transparent"
        android:visibility="gone"
        android:layout_width="100dp"
        android:layout_height="48dp"
        android:layout_marginTop="50dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</com.userlabs.xshare.views.XConstraintLayout>
