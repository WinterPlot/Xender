<?xml version="1.0" encoding="utf-8"?>
<com.userlabs.xshare.views.XLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include layout="@layout/toolbar"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/params_indicator"
            android:background="@color/primary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/x_dp_40"
            android:elevation="4dp"
            app:tabIconTint="@drawable/selector_tab_color"
            app:tabIndicatorColor="@color/tab_color_selected"
            app:tabMode="scrollable"
            app:tabSelectedTextColor="@color/tab_color_selected"
            app:tabTextAppearance="@style/TabLayoutTextStyle"
            app:tabTextColor="@color/tab_color_normal"/>
    </LinearLayout>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.viewpager2.widget.ViewPager2
            android:layout_gravity="center"
            android:id="@+id/params_vPager"
            android:persistentDrawingCache="animation"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:flipInterval="30"/>
    </FrameLayout>
</com.userlabs.xshare.views.XLinearLayout>
