<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_add_item_main"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_medium"
        android:textColor="@color/txt_secondary"
        android:gravity="center_vertical"
        android:id="@+id/sort_title"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/x_dp_48"
        android:text="@string/x_sort_title"
        android:drawablePadding="@dimen/x_dp_12"
        android:layout_marginStart="@dimen/x_dp_20"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/sort_title_arrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/x_dp_24"
        app:layout_constraintBottom_toBottomOf="@+id/sort_title"
        app:layout_constraintStart_toEndOf="@+id/sort_title"
        app:layout_constraintTop_toTopOf="@+id/sort_title"/>
    <View
        android:id="@+id/sort_title_layout"
        android:background="?attr/selectableItemBackground"
        android:layout_width="@dimen/x_dp_180"
        android:layout_height="@dimen/x_dp_48"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_medium"
        android:textColor="@color/txt_secondary"
        android:gravity="center_vertical"
        android:id="@+id/sort_artist"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/x_dp_48"
        android:text="@string/x_sort_artist"
        android:drawablePadding="@dimen/x_dp_12"
        android:layout_marginStart="@dimen/x_dp_20"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/sort_title"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/sort_artist_arrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/x_dp_24"
        app:layout_constraintBottom_toBottomOf="@+id/sort_artist"
        app:layout_constraintStart_toEndOf="@+id/sort_artist"
        app:layout_constraintTop_toTopOf="@+id/sort_artist"/>
    <View
        android:id="@+id/sort_artist_layout"
        android:background="?attr/selectableItemBackground"
        android:layout_width="@dimen/x_dp_180"
        android:layout_height="@dimen/x_dp_48"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/sort_title"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_medium"
        android:textColor="@color/txt_secondary"
        android:gravity="center_vertical"
        android:id="@+id/sort_duration"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/x_dp_48"
        android:text="@string/x_sort_duration"
        android:drawablePadding="@dimen/x_dp_12"
        android:layout_marginStart="@dimen/x_dp_20"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/sort_artist"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/sort_duration_arrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/x_dp_24"
        app:layout_constraintBottom_toBottomOf="@+id/sort_duration"
        app:layout_constraintStart_toEndOf="@+id/sort_duration"
        app:layout_constraintTop_toTopOf="@+id/sort_duration"/>
    <View
        android:id="@+id/sort_duration_layout"
        android:background="?attr/selectableItemBackground"
        android:layout_width="@dimen/x_dp_180"
        android:layout_height="@dimen/x_dp_48"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/sort_artist"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_medium"
        android:textColor="@color/txt_secondary"
        android:gravity="center_vertical"
        android:id="@+id/sort_size"
        android:background="?attr/selectableItemBackground"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/x_dp_48"
        android:text="@string/x_sort_size"
        android:drawablePadding="@dimen/x_dp_12"
        android:layout_marginStart="@dimen/x_dp_20"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/sort_duration"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/sort_size_arrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/x_dp_24"
        app:layout_constraintBottom_toBottomOf="@+id/sort_size"
        app:layout_constraintStart_toEndOf="@+id/sort_size"
        app:layout_constraintTop_toTopOf="@+id/sort_size"/>
    <View
        android:id="@+id/sort_size_layout"
        android:background="?attr/selectableItemBackground"
        android:layout_width="@dimen/x_dp_180"
        android:layout_height="@dimen/x_dp_48"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/sort_duration"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_medium"
        android:textColor="@color/txt_secondary"
        android:gravity="center_vertical"
        android:id="@+id/sort_date"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/x_dp_48"
        android:text="@string/x_sort_date"
        android:drawablePadding="@dimen/x_dp_12"
        android:layout_marginStart="@dimen/x_dp_20"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/sort_size"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/sort_date_arrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/x_dp_24"
        app:layout_constraintBottom_toBottomOf="@+id/sort_date"
        app:layout_constraintStart_toEndOf="@+id/sort_date"
        app:layout_constraintTop_toTopOf="@+id/sort_date"/>
    <View
        android:id="@+id/sort_date_layout"
        android:background="?attr/selectableItemBackground"
        android:layout_width="@dimen/x_dp_180"
        android:layout_height="@dimen/x_dp_48"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/sort_size"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/artist_group"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="sort_artist,sort_artist_arrow,sort_artist_layout"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/duration_group"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="sort_duration,sort_duration_arrow,sort_duration_layout"/>
</androidx.constraintlayout.widget.ConstraintLayout>
