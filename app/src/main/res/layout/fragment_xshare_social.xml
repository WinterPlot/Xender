<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:background="@color/primary"
        android:layout_width="match_parent"
        android:layout_height="@dimen/x_dp_48"
        android:tintMode="src_atop"
        app:contentInsetStartWithNavigation="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:popupTheme="@style/Theme.AppCompat.Light.DarkActionBar"
        app:titleTextAppearance="@style/toolbar_text_style_bold"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_medium"
        android:textColor="@color/txt_primary"
        android:textColorHint="@color/txt_secondary"
        android:gravity="start|center_vertical"
        android:id="@+id/social_download_tv"
        android:background="@drawable/bg_window_2_color_round_corner"
        android:layout_width="match_parent"
        android:layout_height="@dimen/x_dp_40"
        android:layout_marginLeft="@dimen/x_dp_16"
        android:layout_marginTop="@dimen/x_dp_16"
        android:layout_marginRight="@dimen/x_dp_16"
        android:hint="@string/facebook_download_hint"
        android:singleLine="true"
        android:paddingStart="@dimen/x_dp_16"
        android:paddingEnd="0dp"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_medium"
        android:textColor="@color/txt_white"
        android:gravity="center"
        android:id="@+id/social_paste_down_btn"
        android:background="@drawable/btn_primary_round_corner"
        android:paddingLeft="@dimen/x_dp_16"
        android:paddingRight="@dimen/x_dp_16"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/x_dp_32"
        android:text="@string/social_download_btn_no"
        android:layout_marginEnd="@dimen/x_dp_4"
        android:paddingHorizontal="@dimen/x_dp_16"
        app:layout_constraintBottom_toBottomOf="@+id/social_download_tv"
        app:layout_constraintEnd_toEndOf="@+id/social_download_tv"
        app:layout_constraintTop_toTopOf="@+id/social_download_tv"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/social_app_list"
        android:scrollbars="none"
        android:clipToPadding="false"
        android:descendantFocusability="afterDescendants"
        android:layout_width="match_parent"
        android:layout_height="@dimen/x_dp_120"
        android:layout_marginLeft="@dimen/x_dp_16"
        android:layout_marginTop="@dimen/x_dp_16"
        android:layout_marginRight="@dimen/x_dp_16"
        android:fastScrollEnabled="false"
        android:layout_marginHorizontal="@dimen/x_dp_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/social_download_tv"/>
    <include
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginLeft="@dimen/x_dp_12"
        android:layout_marginTop="@dimen/x_dp_8"
        android:layout_marginRight="@dimen/x_dp_12"
        android:layout_marginHorizontal="@dimen/x_dp_12"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/social_app_list"
        layout="@layout/recyclerview_layout"/>
</androidx.constraintlayout.widget.ConstraintLayout>
