<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/bottom_controller_0"
    android:paddingTop="@dimen/vp_dp_8"
    android:paddingBottom="@dimen/vp_dp_10"
    android:layout_width="match_parent"
    android:layout_height="@dimen/vp_dp_126">
    <LinearLayout
        android:gravity="end|center_vertical"
        android:orientation="horizontal"
        android:id="@+id/vp_btm_components"
        android:layout_width="match_parent"
        android:layout_height="@dimen/vp_dp_20"
        android:layout_marginStart="@dimen/vp_dp_16"
        android:layout_marginEnd="@dimen/vp_dp_16"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatSeekBar
        android:id="@+id/vp_btm_progress_sb"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="5dp"
        android:layout_marginRight="5dp"
        android:maxHeight="2dp"
        android:minHeight="2dp"
        android:layout_marginHorizontal="5dp"
        app:layout_constraintBottom_toBottomOf="@+id/vp_btm_current_time_tv"
        app:layout_constraintEnd_toStartOf="@+id/vp_btm_total_time_tv"
        app:layout_constraintStart_toEndOf="@+id/vp_btm_current_time_tv"
        app:layout_constraintTop_toTopOf="@+id/vp_btm_current_time_tv"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/vp_sp_12"
        android:textColor="@color/vp_white"
        android:gravity="center"
        android:id="@+id/vp_btm_current_time_tv"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/vp_dp_20"
        android:layout_marginTop="@dimen/vp_dp_5"
        android:layout_marginStart="@dimen/vp_dp_16"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/vp_btm_components"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/vp_sp_12"
        android:textColor="@color/vp_white"
        android:gravity="center"
        android:id="@+id/vp_btm_total_time_tv"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/vp_dp_20"
        android:layout_marginTop="@dimen/vp_dp_5"
        android:layout_marginEnd="@dimen/vp_dp_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/vp_btm_components"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/vp_btm_subtitle_btn"
        android:layout_width="@dimen/vp_dp_40"
        android:layout_height="@dimen/vp_dp_40"
        android:scaleType="center"
        android:layout_marginStart="@dimen/vp_dp_8"
        app:layout_constraintBottom_toBottomOf="@+id/vp_btm_play_pause_btn"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/vp_btm_play_pause_btn"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/vp_btm_audio_track_btn"
        android:layout_width="@dimen/vp_dp_40"
        android:layout_height="@dimen/vp_dp_40"
        android:scaleType="center"
        android:layout_marginStart="@dimen/vp_dp_8"
        app:layout_constraintBottom_toBottomOf="@+id/vp_btm_play_pause_btn"
        app:layout_constraintStart_toEndOf="@+id/vp_btm_subtitle_btn"
        app:layout_constraintTop_toTopOf="@+id/vp_btm_play_pause_btn"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/vp_btm_previous"
        android:layout_width="@dimen/vp_dp_40"
        android:layout_height="@dimen/vp_dp_40"
        android:scaleType="center"
        android:layout_marginEnd="@dimen/vp_dp_12"
        app:layout_constraintBottom_toBottomOf="@+id/vp_btm_play_pause_btn"
        app:layout_constraintEnd_toStartOf="@+id/vp_btm_play_pause_btn"
        app:layout_constraintTop_toTopOf="@+id/vp_btm_play_pause_btn"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/vp_btm_play_pause_btn"
        android:layout_width="@dimen/vp_dp_40"
        android:layout_height="@dimen/vp_dp_40"
        android:scaleType="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/vp_btm_next"
        android:layout_width="@dimen/vp_dp_40"
        android:layout_height="@dimen/vp_dp_40"
        android:scaleType="center"
        android:layout_marginStart="@dimen/vp_dp_12"
        app:layout_constraintBottom_toBottomOf="@+id/vp_btm_play_pause_btn"
        app:layout_constraintStart_toEndOf="@+id/vp_btm_play_pause_btn"
        app:layout_constraintTop_toTopOf="@+id/vp_btm_play_pause_btn"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/vp_btm_lock_auto_rotate_btn"
        android:layout_width="@dimen/vp_dp_40"
        android:layout_height="@dimen/vp_dp_40"
        android:scaleType="center"
        android:layout_marginEnd="@dimen/vp_dp_8"
        app:layout_constraintBottom_toBottomOf="@+id/vp_btm_play_pause_btn"
        app:layout_constraintEnd_toStartOf="@+id/vp_btm_playlist"
        app:layout_constraintTop_toTopOf="@+id/vp_btm_play_pause_btn"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/vp_btm_playlist"
        android:layout_width="@dimen/vp_dp_40"
        android:layout_height="@dimen/vp_dp_40"
        android:scaleType="center"
        android:layout_marginEnd="@dimen/vp_dp_8"
        app:layout_constraintBottom_toBottomOf="@+id/vp_btm_play_pause_btn"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/vp_btm_play_pause_btn"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/vp_btm_play_group"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:constraint_referenced_ids="vp_btm_play_pause_btn,vp_btm_audio_track_btn,vp_btm_lock_auto_rotate_btn,vp_btm_playlist,vp_btm_subtitle_btn,vp_btm_previous,vp_btm_next"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/vp_btm_locked_btn"
        android:visibility="gone"
        android:layout_width="@dimen/vp_dp_40"
        android:layout_height="@dimen/vp_dp_40"
        android:scaleType="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
