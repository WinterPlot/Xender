<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/me_saved_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_medium"
        android:textColor="@color/txt_secondary"
        android:gravity="start|center_vertical"
        android:id="@+id/me_saved_header"
        android:background="@color/child_window_bg"
        android:paddingLeft="@dimen/x_dp_16"
        android:paddingRight="@dimen/x_dp_16"
        android:layout_width="match_parent"
        android:layout_height="@dimen/x_dp_40"
        android:paddingHorizontal="@dimen/x_dp_16"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.userlabs.xshare.views.RatioDistributionView
        android:id="@+id/me_receive_ratio"
        android:layout_width="0dp"
        android:layout_height="@dimen/x_dp_24"
        android:layout_marginLeft="@dimen/x_dp_16"
        android:layout_marginTop="@dimen/x_dp_20"
        android:layout_marginRight="@dimen/x_dp_16"
        android:layout_marginHorizontal="@dimen/x_dp_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/me_saved_header"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/me_guideline_third"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.333"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/me_guideline_third2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.666"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/me_receive_apps_dot"
        android:layout_width="@dimen/x_dp_4"
        android:layout_height="@dimen/x_dp_4"
        android:layout_marginStart="@dimen/x_dp_12"
        app:layout_constraintBottom_toBottomOf="@+id/me_receive_apps_name"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/me_receive_apps_name"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_small"
        android:textColor="@color/txt_secondary"
        android:id="@+id/me_receive_apps_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/x_dp_20"
        android:layout_marginStart="@dimen/x_dp_3"
        app:layout_constraintStart_toEndOf="@+id/me_receive_apps_dot"
        app:layout_constraintTop_toBottomOf="@+id/me_receive_ratio"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_large_greater"
        android:textColor="@color/txt_primary"
        android:id="@+id/me_receive_apps_percent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/x_dp_3"
        app:layout_constraintStart_toStartOf="@+id/me_receive_apps_name"
        app:layout_constraintTop_toBottomOf="@+id/me_receive_apps_name"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_small"
        android:textColor="@color/txt_secondary"
        android:id="@+id/me_receive_app_percent_flag"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/x_dp_2"
        android:layout_marginStart="@dimen/x_dp_3"
        app:layout_constraintBottom_toBottomOf="@+id/me_receive_apps_percent"
        app:layout_constraintStart_toEndOf="@+id/me_receive_apps_percent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/me_receive_photos_dot"
        android:layout_width="@dimen/x_dp_4"
        android:layout_height="@dimen/x_dp_4"
        android:layout_marginEnd="@dimen/x_dp_3"
        app:layout_constraintBottom_toBottomOf="@+id/me_receive_apps_name"
        app:layout_constraintEnd_toStartOf="@+id/me_receive_photos_name"
        app:layout_constraintTop_toTopOf="@+id/me_receive_apps_name"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_small"
        android:textColor="@color/txt_secondary"
        android:id="@+id/me_receive_photos_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/x_dp_20"
        android:layout_marginStart="@dimen/x_dp_3"
        app:layout_constraintEnd_toEndOf="@+id/me_guideline_third2"
        app:layout_constraintStart_toStartOf="@+id/me_guideline_third"
        app:layout_constraintTop_toBottomOf="@+id/me_receive_ratio"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_large_greater"
        android:textColor="@color/txt_primary"
        android:id="@+id/me_receive_photos_percent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/x_dp_3"
        app:layout_constraintStart_toStartOf="@+id/me_receive_photos_name"
        app:layout_constraintTop_toBottomOf="@+id/me_receive_photos_name"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_small"
        android:textColor="@color/txt_secondary"
        android:id="@+id/me_receive_photos_percent_flag"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/x_dp_2"
        android:layout_marginStart="@dimen/x_dp_3"
        app:layout_constraintBottom_toBottomOf="@+id/me_receive_photos_percent"
        app:layout_constraintStart_toEndOf="@+id/me_receive_photos_percent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/me_receive_music_dot"
        android:layout_width="@dimen/x_dp_4"
        android:layout_height="@dimen/x_dp_4"
        android:layout_marginEnd="@dimen/x_dp_3"
        app:layout_constraintBottom_toBottomOf="@+id/me_receive_music_name"
        app:layout_constraintEnd_toStartOf="@+id/me_receive_music_name"
        app:layout_constraintTop_toTopOf="@+id/me_receive_music_name"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_small"
        android:textColor="@color/txt_secondary"
        android:id="@+id/me_receive_music_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/x_dp_20"
        android:layout_marginStart="@dimen/x_dp_3"
        android:layout_marginEnd="@dimen/x_dp_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/me_receive_ratio"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_large_greater"
        android:textColor="@color/txt_primary"
        android:id="@+id/me_receive_music_percent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/x_dp_3"
        app:layout_constraintStart_toStartOf="@+id/me_receive_music_name"
        app:layout_constraintTop_toBottomOf="@+id/me_receive_music_name"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_small"
        android:textColor="@color/txt_secondary"
        android:id="@+id/me_receive_music_percent_flag"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/x_dp_2"
        android:layout_marginStart="@dimen/x_dp_3"
        app:layout_constraintBottom_toBottomOf="@+id/me_receive_music_percent"
        app:layout_constraintStart_toEndOf="@+id/me_receive_music_percent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/me_receive_videos_dot"
        android:layout_width="@dimen/x_dp_4"
        android:layout_height="@dimen/x_dp_4"
        android:layout_marginStart="@dimen/x_dp_12"
        app:layout_constraintBottom_toBottomOf="@+id/me_receive_videos_name"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/me_receive_videos_name"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_small"
        android:textColor="@color/txt_secondary"
        android:id="@+id/me_receive_videos_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/x_dp_16"
        android:layout_marginStart="@dimen/x_dp_3"
        app:layout_constraintStart_toEndOf="@+id/me_receive_videos_dot"
        app:layout_constraintTop_toBottomOf="@+id/me_receive_apps_percent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_large_greater"
        android:textColor="@color/txt_primary"
        android:id="@+id/me_receive_videos_percent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/x_dp_3"
        app:layout_constraintStart_toStartOf="@+id/me_receive_videos_name"
        app:layout_constraintTop_toBottomOf="@+id/me_receive_videos_name"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_small"
        android:textColor="@color/txt_secondary"
        android:id="@+id/me_receive_videos_percent_flag"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/x_dp_2"
        android:layout_marginStart="@dimen/x_dp_3"
        app:layout_constraintBottom_toBottomOf="@+id/me_receive_videos_percent"
        app:layout_constraintStart_toEndOf="@+id/me_receive_videos_percent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/me_receive_others_dot"
        android:layout_width="@dimen/x_dp_4"
        android:layout_height="@dimen/x_dp_4"
        android:layout_marginEnd="@dimen/x_dp_3"
        app:layout_constraintBottom_toBottomOf="@+id/me_receive_others_name"
        app:layout_constraintEnd_toStartOf="@+id/me_receive_others_name"
        app:layout_constraintTop_toTopOf="@+id/me_receive_others_name"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_small"
        android:textColor="@color/txt_secondary"
        android:id="@+id/me_receive_others_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/x_dp_20"
        android:layout_marginStart="@dimen/x_dp_3"
        app:layout_constraintEnd_toEndOf="@+id/me_guideline_third2"
        app:layout_constraintStart_toStartOf="@+id/me_guideline_third"
        app:layout_constraintTop_toBottomOf="@+id/me_receive_photos_percent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_large_greater"
        android:textColor="@color/txt_primary"
        android:id="@+id/me_receive_others_percent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/x_dp_3"
        app:layout_constraintStart_toStartOf="@+id/me_receive_others_name"
        app:layout_constraintTop_toBottomOf="@+id/me_receive_others_name"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_small"
        android:textColor="@color/txt_secondary"
        android:id="@+id/me_receive_others_percent_flag"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/x_dp_2"
        android:layout_marginStart="@dimen/x_dp_3"
        app:layout_constraintBottom_toBottomOf="@+id/me_receive_others_percent"
        app:layout_constraintStart_toEndOf="@+id/me_receive_others_percent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
