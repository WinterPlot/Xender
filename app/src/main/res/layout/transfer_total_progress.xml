<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/primary"
    android:layout_width="match_parent"
    android:layout_height="40dp">
    <ProgressBar
        android:id="@+id/transfer_total_pb"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="@dimen/x_dp_16"
        android:layout_marginRight="@dimen/x_dp_16"
        android:max="100"
        android:progress="30"
        android:progressDrawable="@drawable/bg_progress_secondary_2_round_corner"
        android:layout_marginHorizontal="@dimen/x_dp_16"
        style="?android:attr/progressBarStyleHorizontal"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/cx_sp_12"
        android:textColor="@color/txt_white"
        android:id="@+id/transfer_total_speed_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/x_dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@+id/transfer_total_pb"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/cx_sp_12"
        android:textColor="@color/txt_white"
        android:id="@+id/transfer_total_size_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/x_dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/transfer_total_pb"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
