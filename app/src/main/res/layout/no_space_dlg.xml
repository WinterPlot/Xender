<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_large"
        android:textColor="@color/txt_primary"
        android:gravity="center"
        android:paddingLeft="@dimen/x_dp_16"
        android:paddingRight="@dimen/x_dp_16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:text="@string/no_space_des"
        android:paddingHorizontal="@dimen/x_dp_16"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/x_dp_16"
        android:src="@drawable/svg_tips_micro_sd"/>
    <androidx.appcompat.widget.AppCompatButton
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/no_space_btn"
        android:background="@drawable/btn_primary_round_corner"
        android:layout_width="match_parent"
        android:layout_height="@dimen/x_dp_48"
        android:layout_marginLeft="24dp"
        android:layout_marginTop="30dp"
        android:layout_marginRight="24dp"
        android:layout_marginBottom="32dp"
        android:text="@string/dlg_ok"
        android:textAllCaps="false"
        style="@style/button_text_style_bold"/>
</LinearLayout>
