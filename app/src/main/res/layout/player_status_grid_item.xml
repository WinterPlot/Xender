<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:addStatesFromChildren="false"
    android:descendantFocusability="blocksDescendants"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:textDirection="locale"
    android:layoutDirection="locale">
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="center"
        android:id="@+id/player_status_icon_item"
        android:layout_width="match_parent"
        android:layout_height="95dp"
        android:scaleType="fitXY"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="center"
        android:id="@+id/status_play"
        android:background="@drawable/bg_mask_shadow_oval"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:src="@drawable/cx_svg_play"
        android:tint="@android:color/white"
        app:layout_constraintBottom_toBottomOf="@+id/player_status_icon_item"
        app:layout_constraintEnd_toEndOf="@+id/player_status_icon_item"
        app:layout_constraintStart_toStartOf="@+id/player_status_icon_item"
        app:layout_constraintTop_toTopOf="@+id/player_status_icon_item"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_small"
        android:textColor="@color/txt_white"
        android:gravity="center"
        android:layout_gravity="start|bottom"
        android:id="@+id/player_status_duration_item"
        android:background="@drawable/bg_mask_shadow_round_corner"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="5dp"
        android:minHeight="22dp"
        android:singleLine="true"
        android:drawablePadding="4dp"
        android:drawableStart="@drawable/svg_video_play"
        android:layout_marginEnd="5dp"
        app:layout_constraintBottom_toBottomOf="@+id/player_status_icon_item"
        app:layout_constraintEnd_toEndOf="@+id/player_status_icon_item"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/player_status_download"
        android:background="?attr/selectableItemBackground"
        android:visibility="visible"
        android:layout_width="@dimen/x_dp_40"
        android:layout_height="@dimen/x_dp_40"
        android:scaleType="center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/player_status_icon_item"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/player_status_share"
        android:background="?attr/selectableItemBackground"
        android:layout_width="40dp"
        android:layout_height="@dimen/x_dp_40"
        android:src="@drawable/svg_social_share_whatsapp"
        android:scaleType="centerInside"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        app:layout_constraintEnd_toStartOf="@+id/player_status_download"
        app:layout_constraintTop_toBottomOf="@+id/player_status_icon_item"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_small"
        android:textColor="@color/txt_secondary"
        android:gravity="start|center_vertical"
        android:id="@+id/player_status_time"
        android:visibility="visible"
        android:layout_width="0dp"
        android:layout_height="@dimen/x_dp_40"
        android:maxLines="1"
        android:layout_marginStart="4dp"
        app:autoSizeMaxTextSize="@dimen/xshare_text_size_small"
        app:autoSizeMinTextSize="@dimen/xshare_text_size_smaller"
        app:autoSizeStepGranularity="1sp"
        app:autoSizeTextType="uniform"
        app:layout_constraintEnd_toStartOf="@+id/player_status_share"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/player_status_icon_item"/>
</androidx.constraintlayout.widget.ConstraintLayout>
