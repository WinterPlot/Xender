<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_mplayer_show_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/music_player_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"/>
    <FrameLayout
        android:orientation="horizontal"
        android:id="@+id/music_player_top_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/x_dp_56">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/music_player_top_bar_back"
            android:layout_width="@dimen/x_dp_48"
            android:layout_height="@dimen/x_dp_48"
            android:src="@drawable/svg_transfer_arrow_down_nonet"
            android:scaleType="center"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="end"
            android:id="@+id/music_player_top_bar_more"
            android:layout_width="@dimen/x_dp_48"
            android:layout_height="@dimen/x_dp_48"
            android:src="@drawable/svg_three_dot"
            android:scaleType="center"/>
    </FrameLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/music_player_mini_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/x_dp_66"
        android:alpha="0">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="16sp"
            android:textColor="#ffffffff"
            android:ellipsize="end"
            android:gravity="bottom"
            android:id="@+id/music_player_mini_bar_song_title"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:maxLines="1"
            android:layout_marginStart="82dp"
            android:layout_marginEnd="@dimen/x_dp_16"
            app:layout_constraintBottom_toTopOf="@+id/music_player_mini_bar_song_artist"
            app:layout_constraintEnd_toStartOf="@+id/music_player_mini_bar_player"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="spread"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="14sp"
            android:textColor="#b3ffffff"
            android:ellipsize="end"
            android:gravity="top"
            android:id="@+id/music_player_mini_bar_song_artist"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:maxLines="1"
            android:layout_marginStart="82dp"
            android:layout_marginEnd="@dimen/x_dp_16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/music_player_mini_bar_player"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/music_player_mini_bar_song_title"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/music_player_mini_bar_player"
            android:background="?attr/selectableItemBackground"
            android:layout_width="@dimen/x_dp_48"
            android:layout_height="@dimen/x_dp_48"
            android:layout_marginEnd="@dimen/x_dp_16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/music_player_album_cover"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="vertical"
        android:id="@+id/music_player_controller"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="@dimen/x_dp_96"
        app:layout_collapseMode="none">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/xmp_sp_24"
            android:textColor="#ffffffff"
            android:ellipsize="end"
            android:id="@+id/music_player_song_title"
            android:paddingLeft="@dimen/x_dp_30"
            android:paddingRight="@dimen/x_dp_30"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:paddingHorizontal="@dimen/x_dp_30"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/xmp_sp_16"
            android:textColor="#b3ffffff"
            android:ellipsize="end"
            android:id="@+id/music_player_song_artist"
            android:paddingLeft="@dimen/x_dp_30"
            android:paddingRight="@dimen/x_dp_30"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:maxLines="1"
            android:paddingHorizontal="@dimen/x_dp_30"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/music_player_song_title"/>
        <SeekBar
            android:id="@+id/music_player_seek_bar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxHeight="2dp"
            android:progressDrawable="@drawable/bg_progress_primary_bg_white"
            android:minHeight="2dp"
            android:thumb="@drawable/bg_mp_seekbar_theme"
            app:layout_constraintBottom_toBottomOf="@+id/music_player_current_time"
            app:layout_constraintEnd_toStartOf="@+id/music_player_total_time"
            app:layout_constraintStart_toEndOf="@+id/music_player_current_time"
            app:layout_constraintTop_toTopOf="@+id/music_player_current_time"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/xshare_text_size_medium"
            android:textColor="#ffffffff"
            android:id="@+id/music_player_current_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/x_dp_10"
            android:fontFamily="sans-serif-light"
            android:layout_marginStart="@dimen/x_dp_16"
            app:layout_constraintBottom_toTopOf="@+id/music_player_components"
            app:layout_constraintStart_toStartOf="parent"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/xshare_text_size_medium"
            android:textColor="#ffffffff"
            android:id="@+id/music_player_total_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/x_dp_10"
            android:fontFamily="sans-serif-light"
            android:layout_marginEnd="@dimen/x_dp_16"
            app:layout_constraintBottom_toTopOf="@+id/music_player_components"
            app:layout_constraintEnd_toEndOf="parent"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/music_player_components"
            android:layout_width="match_parent"
            android:layout_height="@dimen/x_dp_20"
            android:layout_marginBottom="@dimen/x_dp_12"
            android:layout_marginStart="@dimen/x_dp_16"
            android:layout_marginEnd="@dimen/x_dp_16"
            app:layout_constraintBottom_toTopOf="@+id/music_player_play"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/music_player_cycle"
            android:background="?attr/selectableItemBackground"
            android:layout_width="@dimen/x_dp_45"
            android:layout_height="@dimen/x_dp_45"
            android:scaleType="center"
            android:layout_marginStart="@dimen/x_dp_20"
            app:layout_constraintBottom_toBottomOf="@+id/music_player_play"
            app:layout_constraintEnd_toStartOf="@+id/music_player_previous"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/music_player_play"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/music_player_previous"
            android:background="?attr/selectableItemBackground"
            android:layout_width="@dimen/x_dp_45"
            android:layout_height="@dimen/x_dp_45"
            android:scaleType="center"
            app:layout_constraintBottom_toBottomOf="@+id/music_player_play"
            app:layout_constraintEnd_toStartOf="@+id/music_player_play"
            app:layout_constraintStart_toEndOf="@+id/music_player_cycle"
            app:layout_constraintTop_toTopOf="@+id/music_player_play"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/music_player_play"
            android:layout_width="@dimen/x_music_play_icon_size"
            android:layout_height="@dimen/x_music_play_icon_size"
            android:layout_marginBottom="@dimen/x_dp_16"
            android:scaleType="center"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/music_player_next"
            android:background="?attr/selectableItemBackground"
            android:layout_width="@dimen/x_dp_45"
            android:layout_height="@dimen/x_dp_45"
            android:scaleType="center"
            app:layout_constraintBottom_toBottomOf="@+id/music_player_play"
            app:layout_constraintEnd_toStartOf="@+id/music_player_share"
            app:layout_constraintStart_toEndOf="@+id/music_player_play"
            app:layout_constraintTop_toTopOf="@+id/music_player_play"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/music_player_share"
            android:background="?attr/selectableItemBackground"
            android:layout_width="@dimen/x_dp_45"
            android:layout_height="@dimen/x_dp_45"
            android:scaleType="center"
            android:layout_marginEnd="@dimen/x_dp_20"
            app:layout_constraintBottom_toBottomOf="@+id/music_player_play"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/music_player_next"
            app:layout_constraintTop_toTopOf="@+id/music_player_play"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <FrameLayout
        android:id="@+id/bottom_sheet"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:behavior_hideable="false"
        app:behavior_peekHeight="@dimen/x_dp_96"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="@dimen/x_dp_66">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/player_tips"
                android:layout_width="@dimen/x_dp_45"
                android:layout_height="@dimen/x_dp_4"
                android:layout_marginTop="@dimen/x_dp_5"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.google.android.material.tabs.TabLayout
                android:id="@+id/music_player_tabs"
                android:layout_width="match_parent"
                android:layout_height="@dimen/x_dp_40"
                android:layout_marginTop="10dp"
                app:layout_constraintTop_toBottomOf="@+id/player_tips"/>
            <View
                android:id="@+id/music_player_tabs_line"
                android:layout_width="match_parent"
                android:layout_height="@dimen/x_dp_1"
                app:layout_constraintTop_toBottomOf="@+id/music_player_tabs"/>
            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/music_player_view_pager"
                android:fitsSystemWindows="true"
                android:persistentDrawingCache="animation"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:flipInterval="30"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/music_player_tabs"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </FrameLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
