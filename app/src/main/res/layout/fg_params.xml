<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_large"
        android:textColor="@color/txt_primary"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/params_version"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:text="@string/about_version"
        android:textIsSelectable="true"
        android:layout_marginVertical="10dp"/>
    <LinearLayout
        android:background="@color/child_window_bg"
        android:layout_width="match_parent"
        android:layout_height="48dp">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/xshare_text_size_large_greater"
            android:textColor="@color/txt_primary"
            android:gravity="center"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Channel"
            android:layout_marginStart="@dimen/x_dp_16"
            style="@style/title_text_style_bold"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="bottom"
        android:orientation="horizontal"
        android:paddingLeft="@dimen/x_dp_16"
        android:paddingRight="@dimen/x_dp_16"
        android:duplicateParentState="true"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:paddingHorizontal="@dimen/x_dp_16">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="14sp"
            android:textColor="@color/txt_secondary"
            android:id="@+id/tv_init_channel"
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:text="Initial:"/>
        <androidx.appcompat.widget.AppCompatEditText
            android:textSize="14sp"
            android:textColor="@color/txt_secondary"
            android:id="@+id/et_init_channel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/theme_default_green"
            android:layout_weight="1"
            android:inputType="textNoSuggestions"/>
        <androidx.appcompat.widget.AppCompatButton
            android:textSize="12sp"
            android:textColor="@color/default_green"
            android:id="@+id/bt_init_channel"
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:text="Modify"
            android:fontFamily="@string/roboto_medium_font"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="bottom"
        android:orientation="horizontal"
        android:paddingLeft="@dimen/x_dp_16"
        android:paddingRight="@dimen/x_dp_16"
        android:duplicateParentState="true"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:paddingHorizontal="@dimen/x_dp_16">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="14sp"
            android:textColor="@color/txt_secondary"
            android:id="@+id/tv_current_channel"
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:text="Current:"/>
        <androidx.appcompat.widget.AppCompatEditText
            android:textSize="14sp"
            android:textColor="@color/txt_secondary"
            android:id="@+id/et_current_channel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/theme_default_green"
            android:layout_weight="1"
            android:inputType="textNoSuggestions"/>
        <androidx.appcompat.widget.AppCompatButton
            android:textSize="12sp"
            android:textColor="@color/default_green"
            android:id="@+id/bt_current_channel"
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:text="Modify"
            android:fontFamily="@string/roboto_medium_font"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="bottom"
        android:orientation="horizontal"
        android:id="@+id/about_token"
        android:paddingLeft="@dimen/x_dp_16"
        android:paddingRight="@dimen/x_dp_16"
        android:duplicateParentState="true"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:paddingHorizontal="@dimen/x_dp_16">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="14sp"
            android:textColor="@color/txt_secondary"
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:text="Token:"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="14sp"
            android:textColor="@color/txt_secondary"
            android:id="@+id/about_token_tv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="NULL"
            android:layout_weight="1"/>
        <androidx.appcompat.widget.AppCompatButton
            android:textSize="12sp"
            android:textColor="@color/default_green"
            android:id="@+id/about_token_copy"
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:text="Copy"
            android:fontFamily="@string/roboto_medium_font"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="bottom"
        android:orientation="horizontal"
        android:paddingLeft="@dimen/x_dp_16"
        android:paddingRight="@dimen/x_dp_16"
        android:duplicateParentState="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/x_dp_16">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="14sp"
            android:textColor="@color/txt_secondary"
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:text="Topics:"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="14sp"
            android:textColor="@color/txt_secondary"
            android:id="@+id/about_subscribed_topics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="NULL"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="bottom"
        android:orientation="horizontal"
        android:id="@+id/test_like_layer"
        android:paddingLeft="@dimen/x_dp_16"
        android:paddingRight="@dimen/x_dp_16"
        android:duplicateParentState="true"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:paddingHorizontal="@dimen/x_dp_16">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="14sp"
            android:textColor="@color/txt_secondary"
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:text="Test like:"/>
        <androidx.appcompat.widget.AppCompatEditText
            android:textSize="12sp"
            android:textColor="@color/txt_secondary"
            android:id="@+id/et_key_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
        <androidx.appcompat.widget.AppCompatButton
            android:textSize="12sp"
            android:textColor="@color/default_green"
            android:id="@+id/bt_key_input"
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:text="start"
            android:fontFamily="@string/roboto_medium_font"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="bottom"
        android:orientation="horizontal"
        android:paddingLeft="@dimen/x_dp_16"
        android:paddingRight="@dimen/x_dp_16"
        android:duplicateParentState="true"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:paddingHorizontal="@dimen/x_dp_16">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="14sp"
            android:textColor="@color/txt_secondary"
            android:id="@+id/shard_transfer_tips_tv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="shard download:"
            android:layout_weight="1"/>
        <com.userlabs.xshare.views.swbtn.SwitchButton
            android:id="@+id/shard_transfer_sb"
            android:layout_marginEnd="@dimen/x_dp_16"
            style="@style/MaterialDesign_settings_SwitchButton"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="bottom"
        android:orientation="horizontal"
        android:id="@+id/ct_code_layer"
        android:paddingLeft="@dimen/x_dp_16"
        android:paddingRight="@dimen/x_dp_16"
        android:visibility="gone"
        android:duplicateParentState="true"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:paddingHorizontal="@dimen/x_dp_16">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="14sp"
            android:textColor="@color/txt_secondary"
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:text="CT code:"/>
        <androidx.appcompat.widget.AppCompatEditText
            android:textSize="12sp"
            android:textColor="@color/txt_secondary"
            android:id="@+id/et_ct_code_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
        <androidx.appcompat.widget.AppCompatButton
            android:textSize="12sp"
            android:textColor="@color/default_green"
            android:id="@+id/bt_ct_code"
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:text="OK"
            android:fontFamily="@string/roboto_medium_font"/>
    </LinearLayout>
</LinearLayout>
