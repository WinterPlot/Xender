<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/pc_connect_layout"
    android:tag="layout/mpc_fragment_connecting_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/pc_connect_pc_info_view"
        android:layout_width="@dimen/mpc_dp_240"
        android:layout_height="@dimen/mpc_dp_150"
        app:layout_constraintBottom_toTopOf="@+id/pc_connect_phone_info_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.userlabs.xshare.views.LineRippleView
        android:id="@+id/pc_ripple"
        android:layout_width="@dimen/mpc_dp_150"
        android:layout_height="@dimen/mpc_dp_150"
        app:arcColor="@color/mpc_connecting_pc_ripple"
        app:centerRadius="@dimen/mpc_dp_40"
        app:layout_constraintBottom_toBottomOf="@+id/pc_connect_pc_info_view"
        app:layout_constraintEnd_toEndOf="@+id/pc_connect_pc_info_view"
        app:layout_constraintStart_toStartOf="@+id/pc_connect_pc_info_view"
        app:layout_constraintTop_toTopOf="@+id/pc_connect_pc_info_view"
        app:maxWidth="@dimen/mpc_dp_150"
        app:rippleAmount="3"
        app:rippleDuration="1500"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="center"
        android:id="@+id/pc_iv"
        android:layout_width="@dimen/mpc_dp_40"
        android:layout_height="@dimen/mpc_dp_40"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="@+id/pc_connect_pc_info_view"
        app:layout_constraintEnd_toEndOf="@+id/pc_connect_pc_info_view"
        app:layout_constraintStart_toStartOf="@+id/pc_connect_pc_info_view"
        app:layout_constraintTop_toTopOf="@+id/pc_connect_pc_info_view"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="14sp"
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:id="@+id/pc_connect_pc_ip_info_tv"
        android:paddingLeft="@dimen/mpc_dp_8"
        android:paddingRight="@dimen/mpc_dp_8"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/mpc_dp_14"
        android:maxLines="2"
        android:paddingHorizontal="@dimen/mpc_dp_8"
        app:layout_constraintEnd_toEndOf="@+id/pc_connect_pc_info_view"
        app:layout_constraintStart_toStartOf="@+id/pc_connect_pc_info_view"
        app:layout_constraintTop_toTopOf="@+id/pc_connect_pc_info_view"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="16sp"
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:id="@+id/pc_connect_pc_ssid_info_tv"
        android:paddingLeft="@dimen/mpc_dp_8"
        android:paddingRight="@dimen/mpc_dp_8"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/mpc_dp_14"
        android:maxLines="2"
        android:paddingHorizontal="@dimen/mpc_dp_8"
        app:layout_constraintBottom_toBottomOf="@+id/pc_connect_pc_info_view"
        app:layout_constraintEnd_toEndOf="@+id/pc_connect_pc_info_view"
        app:layout_constraintStart_toStartOf="@+id/pc_connect_pc_info_view"/>
    <View
        android:id="@+id/pc_connect_phone_info_view"
        android:layout_width="@dimen/mpc_dp_240"
        android:layout_height="@dimen/mpc_dp_150"
        app:layout_constraintBottom_toTopOf="@+id/pc_connecting_info_tv"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/pc_connect_pc_info_view"/>
    <com.userlabs.xshare.views.LineRippleView
        android:id="@+id/phone_ripple"
        android:layout_width="@dimen/mpc_dp_150"
        android:layout_height="@dimen/mpc_dp_150"
        app:arcColor="@color/mpc_connecting_phone_ripple"
        app:centerRadius="@dimen/mpc_dp_40"
        app:layout_constraintBottom_toBottomOf="@+id/pc_connect_phone_info_view"
        app:layout_constraintEnd_toEndOf="@+id/pc_connect_phone_info_view"
        app:layout_constraintStart_toStartOf="@+id/pc_connect_phone_info_view"
        app:layout_constraintTop_toTopOf="@+id/pc_connect_phone_info_view"
        app:maxWidth="@dimen/mpc_dp_150"
        app:rippleAmount="3"
        app:rippleDuration="1500"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="14sp"
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:id="@+id/pc_connect_phone_ip_info_tv"
        android:paddingLeft="@dimen/mpc_dp_8"
        android:paddingRight="@dimen/mpc_dp_8"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/mpc_dp_14"
        android:maxLines="2"
        android:paddingHorizontal="@dimen/mpc_dp_8"
        app:layout_constraintEnd_toEndOf="@+id/pc_connect_phone_info_view"
        app:layout_constraintStart_toStartOf="@+id/pc_connect_phone_info_view"
        app:layout_constraintTop_toTopOf="@+id/pc_connect_phone_info_view"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="16sp"
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:id="@+id/pc_connect_phone_ssid_info_tv"
        android:paddingLeft="@dimen/mpc_dp_8"
        android:paddingRight="@dimen/mpc_dp_8"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/mpc_dp_14"
        android:maxLines="2"
        android:paddingHorizontal="@dimen/mpc_dp_8"
        app:layout_constraintBottom_toBottomOf="@+id/pc_connect_phone_info_view"
        app:layout_constraintEnd_toEndOf="@+id/pc_connect_phone_info_view"
        app:layout_constraintStart_toStartOf="@+id/pc_connect_phone_info_view"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="center"
        android:id="@+id/phone_iv"
        android:layout_width="@dimen/mpc_dp_40"
        android:layout_height="@dimen/mpc_dp_40"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="@+id/pc_connect_phone_info_view"
        app:layout_constraintEnd_toEndOf="@+id/pc_connect_phone_info_view"
        app:layout_constraintStart_toStartOf="@+id/pc_connect_phone_info_view"
        app:layout_constraintTop_toTopOf="@+id/pc_connect_phone_info_view"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@color/mpc_txt_primary"
        android:gravity="center"
        android:id="@+id/pc_connecting_info_tv"
        android:layout_width="match_parent"
        android:layout_height="@dimen/mpc_dp_80"
        android:layout_marginLeft="@dimen/mpc_dp_16"
        android:layout_marginRight="@dimen/mpc_dp_16"
        android:layout_marginBottom="@dimen/mpc_dp_10"
        android:layout_marginHorizontal="@dimen/mpc_dp_16"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/pc_info_group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="pc_connect_pc_info_view,pc_connect_pc_ip_info_tv,pc_connect_pc_ssid_info_tv"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/phone_info_group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="pc_connect_phone_info_view,pc_connect_phone_ssid_info_tv,pc_connect_phone_ip_info_tv"/>
</androidx.constraintlayout.widget.ConstraintLayout>
