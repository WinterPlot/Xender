<?xml version="1.0" encoding="utf-8"?>
<com.userlabs.xshare.views.XLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:focusable="true"
    android:fitsSystemWindows="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include layout="@layout/toolbar"/>
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabs"
        android:background="@color/primary"
        android:layout_width="match_parent"
        android:layout_height="@dimen/x_dp_40"
        app:tabIndicator="@drawable/bg_tab_indicator_fixed"
        app:tabIndicatorColor="@color/x_white"
        app:tabMode="fixed"
        app:tabSelectedTextColor="@color/tab_color_selected"
        app:tabTextColor="@color/tab_color_normal"/>
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/disconnect_transfer_viewpager"
        android:persistentDrawingCache="animation"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:flipInterval="30"
        android:layout_weight="1"/>
</com.userlabs.xshare.views.XLinearLayout>
