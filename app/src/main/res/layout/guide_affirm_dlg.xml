<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="@dimen/x_dp_16"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_small"
        android:textColor="@color/txt_secondary"
        android:id="@+id/affirm_content"
        android:scrollbars="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:layout_marginBottom="@dimen/x_dp_18"
        android:maxHeight="300dp"
        app:layout_constraintBottom_toTopOf="@+id/affirm_bt"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:gravity="center"
        android:id="@+id/affirm_bt"
        android:background="@drawable/btn_primary_round_corner"
        android:layout_width="match_parent"
        android:layout_height="@dimen/x_dp_40"
        android:layout_marginBottom="@dimen/x_dp_16"
        app:layout_constraintBottom_toTopOf="@+id/deny_btn"
        style="@style/button_text_style_bold"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@color/primary"
        android:gravity="center"
        android:id="@+id/deny_btn"
        android:background="@drawable/selector_list_item"
        android:layout_width="match_parent"
        android:layout_height="@dimen/x_dp_40"
        app:layout_constraintBottom_toBottomOf="parent"
        style="@style/button_text_style_bold"/>
</androidx.constraintlayout.widget.ConstraintLayout>
