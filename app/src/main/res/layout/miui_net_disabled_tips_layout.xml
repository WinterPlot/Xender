<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/x_miui_net_dialog"
    android:background="@color/x_transparent"
    android:paddingBottom="@dimen/x_dp_32"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/net_disabled_tips_title_icon"
        android:layout_width="@dimen/x_dp_50"
        android:layout_height="@dimen/x_dp_50"
        android:layout_marginTop="@dimen/x_dp_16"
        android:scaleType="fitXY"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_large"
        android:textColor="@color/txt_primary"
        android:gravity="center"
        android:id="@+id/net_disabled_tips_title_tv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/x_dp_16"
        android:layout_marginTop="@dimen/x_dp_16"
        android:layout_marginRight="@dimen/x_dp_16"
        android:text="@string/miui_connection_tips"
        app:layout_constraintTop_toBottomOf="@+id/net_disabled_tips_title_icon"
        style="@style/title_text_style_bold"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/net_disabled_tips_des_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/x_dp_16"
        android:scaleType="fitXY"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/net_disabled_tips_title_tv"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@color/txt_secondary"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/net_disabled_tips_cancel_btn"
        android:layout_width="match_parent"
        android:layout_height="@dimen/x_dp_50"
        android:layout_marginLeft="48dp"
        android:layout_marginTop="19dp"
        android:layout_marginRight="48dp"
        android:text="@string/dlg_cancel"
        app:layout_constraintTop_toBottomOf="@+id/net_disabled_tips_des_icon"
        style="@style/button_text_style_bold"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/net_disabled_tips_ok_btn"
        android:layout_width="match_parent"
        android:layout_height="@dimen/x_dp_50"
        android:layout_marginLeft="48dp"
        android:layout_marginTop="19dp"
        android:layout_marginRight="48dp"
        android:text="@string/dlg_ok"
        app:layout_constraintTop_toBottomOf="@+id/net_disabled_tips_cancel_btn"
        style="@style/button_text_style_bold"/>
</androidx.constraintlayout.widget.ConstraintLayout>
