<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:fitsSystemWindows="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.AppCompatTextView
        android:gravity="center"
        android:id="@+id/new_playlist_title"
        android:layout_width="match_parent"
        android:layout_height="@dimen/x_dp_56"
        android:text="@string/x_play_list_new"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/BottomSheetDialog_Title"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="end|center_vertical"
        android:id="@+id/new_playlist_cancel"
        android:layout_width="@dimen/x_dp_56"
        android:layout_height="@dimen/x_dp_56"
        android:src="@drawable/svg_ic_cancel"
        android:scaleType="centerInside"
        android:tint="@color/x_222_or_fff"
        app:layout_constraintBottom_toBottomOf="@+id/new_playlist_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/new_playlist_title"/>
    <View
        android:id="@+id/divider_line"
        android:layout_width="match_parent"
        app:layout_constraintTop_toBottomOf="@+id/new_playlist_title"
        style="@style/BottomSheetDialog_Line"/>
    <androidx.appcompat.widget.AppCompatEditText
        android:theme="@style/MyUserEditText"
        android:textSize="@dimen/xshare_text_size_large"
        android:textColor="@color/txt_primary"
        android:textColorHint="@color/txt_secondary"
        android:gravity="start"
        android:layout_gravity="center_horizontal"
        android:id="@+id/new_playlist_edit"
        android:focusable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/x_dp_45"
        android:layout_marginTop="@dimen/x_dp_24"
        android:layout_marginRight="@dimen/x_dp_45"
        android:hint="@string/x_play_list_edit_hint"
        android:maxLength="50"
        android:inputType="textNoSuggestions"
        android:textCursorDrawable="@null"
        android:layout_marginHorizontal="@dimen/x_dp_45"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/new_playlist_title"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:gravity="center"
        android:id="@+id/new_playlist_ok"
        android:background="@drawable/btn_primary_round_corner"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="@dimen/x_dp_48"
        android:layout_marginLeft="@dimen/x_dp_60"
        android:layout_marginTop="@dimen/x_dp_50"
        android:layout_marginRight="@dimen/x_dp_60"
        android:layout_marginBottom="@dimen/x_dp_40"
        android:text="@string/dlg_ok"
        android:layout_marginHorizontal="@dimen/x_dp_60"
        app:layout_constraintTop_toBottomOf="@+id/new_playlist_edit"
        style="@style/button_text_style_bold"/>
    <Space
        android:layout_width="match_parent"
        android:layout_height="@dimen/x_dp_30"
        app:layout_constraintTop_toBottomOf="@+id/new_playlist_ok"/>
</androidx.constraintlayout.widget.ConstraintLayout>
