<?xml version="1.0" encoding="utf-8"?>
<com.userlabs.xshare.views.XConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:textDirection="locale"
    android:layoutDirection="locale">
    <include layout="@layout/toolbar"/>
    <View
        android:id="@+id/label_view"
        android:background="@color/primary"
        android:layout_width="5dp"
        android:layout_height="18dp"
        app:layout_constraintBottom_toBottomOf="@+id/for_tips"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"
        app:layout_constraintTop_toTopOf="@+id/for_tips"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_large_greater"
        android:textColor="@color/txt_primary"
        android:gravity="center"
        android:id="@+id/for_tips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="@dimen/x_dp_16"
        android:layout_marginRight="8dp"
        android:text="@string/contact_us_for"
        app:layout_constraintStart_toEndOf="@+id/label_view"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_large_greater"
        android:textStyle="bold"
        android:textColor="@color/txt_primary"
        android:gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="6dp"
        android:layout_marginRight="6dp"
        android:text="@string/contact_us_for_using_problem"
        app:layout_constraintBottom_toBottomOf="@+id/for_tips"
        app:layout_constraintStart_toEndOf="@+id/for_tips"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_large"
        android:id="@+id/step_one"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="8dp"
        android:text="@string/contact_us_for_using_problem_one"
        android:fontFamily="@string/roboto_font"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/for_tips"
        app:layout_constraintTop_toBottomOf="@+id/for_tips"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_large"
        android:id="@+id/step_two"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/contact_us_for_using_problem_two"
        android:fontFamily="@string/roboto_font"
        app:layout_constraintEnd_toEndOf="@+id/step_one"
        app:layout_constraintStart_toStartOf="@+id/step_one"
        app:layout_constraintTop_toBottomOf="@+id/step_one"/>
</com.userlabs.xshare.views.XConstraintLayout>
