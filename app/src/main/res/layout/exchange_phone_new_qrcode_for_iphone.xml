<?xml version="1.0" encoding="utf-8"?>
<com.userlabs.xshare.views.XConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/app_window_bg"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include layout="@layout/ex_toolbar"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/ex_bg_window_2_color_corner_10"
        android:padding="@dimen/ex_dp_16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/ex_dp_16"
        android:layout_marginTop="@dimen/ex_dp_48"
        app:layout_constraintTop_toBottomOf="@+id/toolbar">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ex_phonecopy_decorate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ex_phone_copy_des"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/xshare_text_size_large"
            android:textColor="@color/txt_primary"
            android:gravity="start"
            android:id="@+id/form_iphone_tv1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ex_dp_16"
            android:text="@string/exchange_no_qr_des_1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ex_phonecopy_decorate"/>
        <TextView
            android:textSize="@dimen/xshare_text_size_large"
            android:textColor="@color/txt_primary"
            android:gravity="start"
            android:id="@+id/form_iphone_tv2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cx_dp_4"
            android:text="@string/exchange_no_qr_iphone_des_2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/form_iphone_tv1"/>
        <TextView
            android:textSize="@dimen/xshare_text_size_large"
            android:textColor="@color/txt_primary"
            android:gravity="start"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cx_dp_4"
            android:text="@string/exchange_no_qr_des_3"
            app:layout_constraintTop_toBottomOf="@+id/form_iphone_tv2"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <Button
        android:textColor="@color/txt_white"
        android:gravity="center"
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/next_btn"
        android:background="@drawable/btn_primary_round_corner"
        android:layout_width="match_parent"
        android:layout_height="@dimen/ex_dp_48"
        android:layout_marginLeft="@dimen/ex_dp_16"
        android:layout_marginRight="@dimen/ex_dp_16"
        android:layout_marginBottom="13dp"
        android:text="@string/exchange_next"
        android:layout_marginHorizontal="@dimen/ex_dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        style="@style/cx_button_text_style_bold"/>
</com.userlabs.xshare.views.XConstraintLayout>
