<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/vp_playlist_layout_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.AppCompatTextView
        android:gravity="center"
        android:id="@+id/vp_playlist_tv"
        android:layout_width="match_parent"
        android:layout_height="@dimen/vp_dp_56"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/vp_BottomSheetDialog_Title"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/vp_playlist_cancel"
        android:layout_width="@dimen/vp_dp_56"
        android:layout_height="@dimen/vp_dp_56"
        android:scaleType="center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/vp_dialog_text_color"/>
    <View
        android:id="@+id/vp_playlist_line"
        android:layout_width="match_parent"
        app:layout_constraintTop_toBottomOf="@+id/vp_playlist_cancel"
        style="@style/vp_BottomSheetDialog_Line"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/vp_playlist_recycleview"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:divider="@null"
        app:layout_constraintTop_toBottomOf="@+id/vp_playlist_line"/>
</androidx.constraintlayout.widget.ConstraintLayout>
