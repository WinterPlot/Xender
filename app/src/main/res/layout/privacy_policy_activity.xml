<?xml version="1.0" encoding="utf-8"?>
<com.userlabs.xshare.views.XConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include layout="@layout/toolbar"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_large"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/privacy_unavaiable_tv"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/load_again"
        android:drawableTop="@drawable/svg_network_retry"
        android:drawablePadding="30dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"/>
    <ProgressBar
        android:layout_gravity="center"
        android:id="@+id/pb_waiting"
        android:visibility="visible"
        android:layout_width="@dimen/x_dp_50"
        android:layout_height="@dimen/x_dp_50"
        android:layout_centerInParent="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"
        style="@style/ProgressBar.Loading"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_small"
        android:textColor="@color/primary"
        android:id="@+id/privacy_text_progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0%"
        android:layout_centerInParent="true"
        app:layout_constraintBottom_toBottomOf="@+id/pb_waiting"
        app:layout_constraintEnd_toEndOf="@+id/pb_waiting"
        app:layout_constraintStart_toStartOf="@+id/pb_waiting"
        app:layout_constraintTop_toTopOf="@+id/pb_waiting"
        style="@style/title_text_style_bold"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/privacy_progress_layer"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        app:constraint_referenced_ids="pb_waiting,privacy_text_progress"/>
    <WebView
        android:id="@+id/privacy_help_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"/>
</com.userlabs.xshare.views.XConstraintLayout>
