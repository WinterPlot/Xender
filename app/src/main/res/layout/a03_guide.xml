<?xml version="1.0" encoding="utf-8"?>
<com.userlabs.xshare.views.XConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include layout="@layout/toolbar"/>
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/guide_viewpager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/circles"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/circles"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/x_dp_48"
        android:layout_marginBottom="@dimen/x_dp_30"
        app:layout_constraintBottom_toTopOf="@+id/go_permission"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
    <androidx.appcompat.widget.AppCompatButton
        android:textSize="@dimen/xshare_text_size_large"
        android:textColor="@color/txt_white"
        android:gravity="center"
        android:id="@+id/go_permission"
        android:background="@drawable/btn_primary_round_corner"
        android:layout_width="match_parent"
        android:layout_height="@dimen/x_dp_48"
        android:layout_marginLeft="@dimen/cx_dp_24"
        android:layout_marginRight="@dimen/cx_dp_24"
        android:layout_marginBottom="@dimen/x_dp_30"
        android:text="@string/x_go"
        android:layout_marginHorizontal="@dimen/cx_dp_24"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        style="@style/title_text_style_bold"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/tips_right"
        android:background="@drawable/bg_red_oval"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/svg_right_arrow"
        android:scaleType="center"
        android:layout_marginEnd="@dimen/x_dp_16"
        app:layout_constraintBottom_toBottomOf="@+id/guide_viewpager"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/guide_viewpager"/>
</com.userlabs.xshare.views.XConstraintLayout>
