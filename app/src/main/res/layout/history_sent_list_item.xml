<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:id="@+id/history_list_item_layer"
    android:background="@drawable/selector_list_item"
    android:layout_width="match_parent"
    android:layout_height="@dimen/x_dp_80">
    <FrameLayout
        android:orientation="horizontal"
        android:id="@+id/history_checkbox"
        android:focusable="false"
        android:clickable="false"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.userlabs.xshare.views.XCheckBox
            android:layout_gravity="center"
            android:id="@+id/cb_history_checkbox"
            android:duplicateParentState="false"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginLeft="@dimen/x_dp_16"
            android:layout_marginRight="@dimen/x_dp_16"
            android:scaleType="center"
            android:layout_marginStart="@dimen/x_dp_16"
            android:layout_marginEnd="@dimen/x_dp_16"/>
    </FrameLayout>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/history_item_file_icon_iv"
        android:layout_marginStart="@dimen/x_dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/history_item_file_icon_iv_style"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="center"
        android:id="@+id/history_item_avatar_iv"
        android:background="@drawable/bg_line_oval"
        android:padding="1dp"
        android:layout_width="@dimen/x_dp_16"
        android:layout_height="@dimen/x_dp_16"
        android:scaleType="centerInside"
        app:layout_constraintBottom_toBottomOf="@+id/history_item_file_icon_iv"
        app:layout_constraintCircle="@+id/history_item_file_icon_iv"
        app:layout_constraintCircleAngle="135"
        app:layout_constraintCircleRadius="32dp"
        app:layout_constraintEnd_toEndOf="@+id/history_item_file_icon_iv"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/cx_sp_15"
        android:ellipsize="end"
        android:gravity="start|center_vertical"
        android:id="@+id/history_item_file_name_tv"
        android:layout_width="0dp"
        android:layout_marginTop="@dimen/x_dp_8"
        android:maxLines="1"
        android:singleLine="false"
        android:layout_marginStart="@dimen/x_dp_12"
        app:layout_constraintEnd_toStartOf="@+id/history_checkbox"
        app:layout_constraintStart_toEndOf="@+id/history_item_file_icon_iv"
        app:layout_constraintTop_toTopOf="@+id/history_item_file_icon_iv"
        style="@style/history_item_file_name_tv_style"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_small"
        android:textColor="@color/txt_secondary"
        android:ellipsize="middle"
        android:gravity="start|center_vertical"
        android:id="@+id/history_item_file_size_tv"
        android:background="@null"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/x_dp_8"
        android:singleLine="true"
        app:layout_constraintBottom_toBottomOf="@+id/history_item_file_icon_iv"
        app:layout_constraintStart_toStartOf="@+id/history_item_file_name_tv"
        style="@style/title_text_font_style"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/history_bundle_flag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginStart="5dp"
        app:layout_constraintBottom_toBottomOf="@+id/history_item_file_size_tv"
        app:layout_constraintStart_toEndOf="@+id/history_item_file_size_tv"
        app:layout_constraintTop_toTopOf="@+id/history_item_file_size_tv"/>
</androidx.constraintlayout.widget.ConstraintLayout>
