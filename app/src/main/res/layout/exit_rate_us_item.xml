<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginStart="26dp">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/rate_us_item_iv"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:scaleType="fitXY"
            android:layout_marginEnd="@dimen/x_dp_16"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/xshare_text_size_medium"
            android:textColor="@color/txt_primary"
            android:layout_gravity="center"
            android:id="@+id/rate_us_item_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="19dp"
        android:src="@drawable/svg_rate_us_five_star_small"
        android:layout_marginStart="26dp"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_medium"
        android:textColor="@color/txt_primary"
        android:id="@+id/rate_us_item_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:lines="2"
        android:layout_marginStart="26dp"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:background="#d8d8d8"
        android:layout_width="32dp"
        android:layout_height="1dp"
        android:layout_marginStart="26dp"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_small"
        android:textColor="@color/txt_secondary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/rate_us_helpful"
        android:layout_marginStart="26dp"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:background="@color/primary"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginLeft="26dp"
        android:layout_marginTop="20dp"
        android:layout_marginRight="26dp"
        android:layout_marginStart="26dp"
        android:layout_marginEnd="26dp"/>
</LinearLayout>
