<?xml version="1.0" encoding="utf-8"?>
<com.userlabs.xshare.views.slidinguppanel.SlidingUpPanelLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="bottom"
    android:id="@+id/slidingUpPanelLayout"
    android:tag="layout/fragment_connect_pc_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:textDirection="locale"
    android:layoutDirection="locale"
    app:umanoClipPanel="true">
    <ScrollView
        android:scrollbars="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivOpenVideo"
                android:visibility="gone"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:src="@drawable/svg_pc_connect_video"
                android:scaleType="center"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivNetChange"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/x_pc_hotspot_mode"
                android:layout_marginEnd="@dimen/x_dp_10"
                app:layout_constraintBottom_toBottomOf="@+id/tvHotspotTitle"
                app:layout_constraintEnd_toStartOf="@+id/tvHotspotTitle"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/tvHotspotTitle"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/xshare_text_size_large_greater"
                android:textColor="@color/txt_primary"
                android:id="@+id/tvHotspotTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/hotspot_mode_free"
                android:layout_marginStart="10dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/ivNetChange"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/cx_sp_15"
                android:textColor="@color/txt_white"
                android:gravity="center"
                android:id="@+id/tvStep1"
                android:background="@drawable/bg_secondary_2_right_corner"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginTop="30dp"
                android:minWidth="80dp"
                android:text="@string/step1"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvHotspotTitle"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/cx_sp_15"
                android:textColor="@color/txt_primary"
                android:id="@+id/tvStepContext"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintTop_toBottomOf="@+id/tvStep1"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/cx_sp_15"
                android:textColor="@color/txt_secondary"
                android:id="@+id/tvStepPwd"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/pc_offline_set_pwd"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintTop_toBottomOf="@+id/tvStepContext"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:gravity="center"
                android:id="@+id/go_open_hotspot"
                android:background="@drawable/btn_primary_round_corner"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginTop="10dp"
                android:minWidth="120dp"
                android:text="@string/x_set"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvStepPwd"
                style="@style/button_text_style_bold"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/cx_sp_15"
                android:textColor="@color/txt_white"
                android:gravity="center"
                android:id="@+id/tvStep2"
                android:background="@drawable/bg_secondary_2_right_corner"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginTop="10dp"
                android:minWidth="80dp"
                android:text="@string/step2"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/go_open_hotspot"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/cx_sp_15"
                android:textColor="@color/txt_primary"
                android:id="@+id/tvStep2Context"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/pc_offline_step2"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintTop_toBottomOf="@+id/tvStep2"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/cx_sp_15"
                android:textColor="@color/txt_secondary"
                android:id="@+id/tvStepNP"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/pc_offline_set_np"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintTop_toBottomOf="@+id/tvStep2Context"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/cx_sp_15"
                android:textColor="@color/txt_white"
                android:gravity="center"
                android:id="@+id/tvStep3"
                android:background="@drawable/bg_secondary_2_right_corner"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginTop="20dp"
                android:minWidth="80dp"
                android:text="@string/step3"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvStepNP"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/cx_sp_15"
                android:textColor="@color/txt_primary"
                android:id="@+id/tvStep3Context"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/x_dp_16"
                android:layout_marginTop="3dp"
                android:layout_marginRight="@dimen/x_dp_16"
                android:text="@string/pc_offline_step3_new2"
                android:layout_marginHorizontal="@dimen/x_dp_16"
                app:layout_constraintTop_toBottomOf="@+id/tvStep3"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/cx_sp_15"
                android:textColor="@color/primary"
                android:gravity="center_vertical"
                android:id="@+id/tvOfflineAdd"
                android:background="@drawable/bg_line_round_corner"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginLeft="@dimen/x_dp_16"
                android:layout_marginTop="@dimen/x_dp_16"
                android:layout_marginRight="@dimen/x_dp_16"
                android:drawablePadding="10dp"
                android:drawableStart="@drawable/svg_search"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:drawableTint="@color/x_222_or_fff"
                android:layout_marginHorizontal="@dimen/x_dp_16"
                app:layout_constraintTop_toBottomOf="@+id/tvStep3Context"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/xshare_text_size_medium"
                android:textColor="@color/primary"
                android:gravity="start|center_vertical"
                android:id="@+id/refresh_hotspot_info_tv"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/x_dp_16"
                android:text="@string/cp_hotspot_on_but_no_ip"
                android:layout_marginEnd="@dimen/x_dp_16"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="@+id/tvOfflineAdd"
                app:layout_constraintTop_toBottomOf="@+id/tvOfflineAdd"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:gravity="center"
                android:id="@+id/gmail_iv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/x_dp_16"
                android:src="@drawable/svg_email"
                android:layout_marginStart="@dimen/x_dp_16"
                android:layout_marginEnd="5dp"
                app:layout_constraintEnd_toStartOf="@+id/gmail_tv"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/refresh_hotspot_info_tv"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/xshare_text_size_large"
                android:textColor="@color/primary"
                android:gravity="center"
                android:id="@+id/gmail_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:text="@string/pc_email_describe_btn"
                android:layout_marginEnd="@dimen/x_dp_16"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/gmail_iv"
                app:layout_constraintTop_toBottomOf="@+id/refresh_hotspot_info_tv"/>
            <RelativeLayout
                android:id="@+id/vPlayLayout"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                app:layout_constraintBottom_toTopOf="@+id/tvStep2"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/dragView"
        android:background="@color/child_window_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clDirectMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="20sp"
                android:textColor="@color/primary"
                android:gravity="center"
                android:id="@+id/tvDirectModeTitle"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:text="@string/web_mode"
                android:drawableTop="@drawable/svg_pc_hot_up"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivDirectPic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:src="@drawable/pc_connect_webmode"
                android:scaleType="center"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvDirectModeTitle"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/xshare_text_size_large"
                android:textColor="@color/txt_primary"
                android:gravity="start|center_vertical"
                android:id="@+id/tvDirectStepTitle1"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/connect_pc_same_wifi_tip"
                android:maxLines="2"
                android:singleLine="false"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/ivDirectPic"
                style="@style/title_text_style_bold"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/xshare_text_size_large_greater"
                android:textColor="@color/primary"
                android:gravity="center_vertical"
                android:id="@+id/tvDirectWifiName"
                android:background="@drawable/bg_primary_0e_corner_10"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:layout_marginTop="10dp"
                android:text="@string/app_name"
                android:drawablePadding="5dp"
                android:drawableStart="@drawable/svg_pc_connect_wifi"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvDirectStepTitle1"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/xshare_text_size_large"
                android:textColor="@color/txt_primary"
                android:gravity="center_vertical"
                android:id="@+id/tvDirectStepTitle2"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:layout_marginTop="15dp"
                android:text="@string/connect_pc_open_web_tip"
                android:singleLine="false"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvDirectWifiName"
                style="@style/title_text_style_bold"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/xshare_text_size_medium"
                android:textColor="@color/txt_secondary"
                android:gravity="start|center_vertical"
                android:id="@+id/tvDirectWifiAddress"
                android:background="@drawable/bg_window_1_color_with_line_corner_10"
                android:padding="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="20dp"
                android:text="@string/disconnect_title"
                android:singleLine="true"
                android:drawablePadding="@dimen/x_dp_8"
                android:drawableStart="@drawable/svg_pc_scan_web"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvDirectStepTitle2"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.userlabs.xshare.views.slidinguppanel.SlidingUpPanelLayout>
