<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.userlabs.xshare.views.HistoryProgressLayout
        android:id="@+id/progress_bar"
        android:background="@color/primary_0e"
        android:layout_width="match_parent"
        android:layout_height="@dimen/x_dp_40"
        app:isItem="true"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/history_progress_speed_layer"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="@dimen/x_dp_40"
            android:baselineAligned="false">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/svg_pc_connect_left"
                    android:layout_marginStart="36dp"
                    android:layout_marginEnd="5dp"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/xshare_text_size_medium"
                    android:textColor="@color/primary"
                    android:gravity="start|center_vertical"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/history_total_speed_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    style="@style/title_text_style_bold"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/svg_pc_connect_right"
                    android:layout_marginStart="36dp"
                    android:layout_marginEnd="5dp"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/xshare_text_size_medium"
                    android:textColor="@color/primary"
                    android:gravity="start|center_vertical"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/history_total_saved_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    style="@style/title_text_style_bold"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/history_progress_average_speed_layer"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="@dimen/x_dp_40"
            android:baselineAligned="false">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/svg_pc_connect_left"
                    android:layout_marginStart="40dp"
                    android:layout_marginEnd="5dp"/>
                <com.userlabs.xshare.views.runingtext.RiseNumberTextView
                    android:textSize="@dimen/xshare_text_size_medium"
                    android:textColor="@color/primary"
                    android:gravity="start|center_vertical"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/history_total_average_speed_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    style="@style/title_text_style_bold"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/svg_pc_connect_right"
                    android:layout_marginStart="40dp"
                    android:layout_marginEnd="5dp"/>
                <com.userlabs.xshare.views.runingtext.RiseNumberTextView
                    android:textSize="@dimen/xshare_text_size_medium"
                    android:textColor="@color/primary"
                    android:gravity="start|center_vertical"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/history_total_average_saved_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    style="@style/title_text_style_bold"/>
            </LinearLayout>
        </LinearLayout>
    </com.userlabs.xshare.views.HistoryProgressLayout>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_medium"
        android:textColor="@color/txt_white"
        android:gravity="center_vertical"
        android:id="@+id/range_task_tv"
        android:background="@color/secondary"
        android:paddingLeft="@dimen/x_dp_16"
        android:paddingRight="@dimen/x_dp_16"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="@dimen/x_dp_30"
        android:text="@string/range_transfer_unfinished_task"
        android:paddingStart="@dimen/x_dp_16"
        android:paddingEnd="@dimen/x_dp_16"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/progress_bar"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_medium"
        android:textColor="@color/txt_secondary"
        android:gravity="center"
        android:id="@+id/history_null"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="100dp"
        android:text="@string/history_null"
        android:drawableTop="@drawable/svg_blank_history"
        android:drawablePadding="@dimen/x_dp_24"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/history_progress_listview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:listSelector="@color/x_transparent"
        android:cacheColorHint="@android:color/transparent"
        android:divider="@null"
        android:headerDividersEnabled="false"
        android:footerDividersEnabled="true"
        android:smoothScrollbar="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/range_task_tv"/>
</androidx.constraintlayout.widget.ConstraintLayout>
