<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/me_files_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/me_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.5"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_medium"
        android:textColor="@color/txt_secondary"
        android:gravity="start|center_vertical"
        android:id="@+id/me_files_header"
        android:background="@color/child_window_bg"
        android:paddingLeft="@dimen/x_dp_16"
        android:paddingRight="@dimen/x_dp_16"
        android:layout_width="match_parent"
        android:layout_height="@dimen/x_dp_40"
        android:layout_marginTop="@dimen/x_dp_12"
        android:paddingHorizontal="@dimen/x_dp_16"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.userlabs.xshare.views.piechart.PieChart
        android:id="@+id/me_files_chart"
        android:background="@color/x_transparent"
        android:layout_width="@dimen/x_dp_150"
        android:layout_height="@dimen/x_dp_150"
        android:layout_marginTop="@dimen/x_dp_20"
        android:layout_marginEnd="@dimen/x_dp_16"
        app:layout_constraintEnd_toEndOf="@+id/me_guideline"
        app:layout_constraintTop_toBottomOf="@+id/me_files_header"/>
    <View
        android:id="@+id/me_files_received"
        android:layout_width="0dp"
        android:layout_height="@dimen/x_dp_40"
        android:layout_marginStart="@dimen/x_dp_16"
        android:layout_marginEnd="@dimen/x_dp_40"
        app:layout_constraintBottom_toTopOf="@+id/me_files_sent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/me_guideline"
        app:layout_constraintTop_toTopOf="@+id/me_files_chart"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/me_files_received_dot"
        android:layout_width="@dimen/x_dp_8"
        android:layout_height="@dimen/x_dp_8"
        android:layout_marginStart="@dimen/x_dp_12"
        app:layout_constraintBottom_toBottomOf="@+id/me_files_received"
        app:layout_constraintStart_toStartOf="@+id/me_files_received"
        app:layout_constraintTop_toTopOf="@+id/me_files_received"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_small"
        android:textColor="@color/txt_primary"
        android:id="@+id/me_files_received_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/x_dp_8"
        app:layout_constraintBottom_toBottomOf="@+id/me_files_received"
        app:layout_constraintStart_toEndOf="@+id/me_files_received_dot"
        app:layout_constraintTop_toTopOf="@+id/me_files_received"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_large_greater"
        android:textColor="@color/txt_primary"
        android:id="@+id/me_files_received_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/x_dp_12"
        app:layout_constraintBottom_toBottomOf="@+id/me_files_received"
        app:layout_constraintEnd_toEndOf="@+id/me_files_received"
        app:layout_constraintTop_toTopOf="@+id/me_files_received"/>
    <View
        android:id="@+id/me_files_sent"
        android:layout_width="0dp"
        android:layout_height="@dimen/x_dp_40"
        android:layout_marginStart="@dimen/x_dp_16"
        android:layout_marginEnd="@dimen/x_dp_40"
        app:layout_constraintBottom_toBottomOf="@+id/me_files_chart"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/me_guideline"
        app:layout_constraintTop_toBottomOf="@+id/me_files_received"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/me_files_sent_dot"
        android:layout_width="@dimen/x_dp_8"
        android:layout_height="@dimen/x_dp_8"
        android:layout_marginStart="@dimen/x_dp_12"
        app:layout_constraintBottom_toBottomOf="@+id/me_files_sent"
        app:layout_constraintStart_toStartOf="@+id/me_files_sent"
        app:layout_constraintTop_toTopOf="@+id/me_files_sent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_small"
        android:textColor="@color/txt_primary"
        android:id="@+id/me_files_sent_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/x_dp_8"
        app:layout_constraintBottom_toBottomOf="@+id/me_files_sent"
        app:layout_constraintStart_toEndOf="@+id/me_files_sent_dot"
        app:layout_constraintTop_toTopOf="@+id/me_files_sent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_large_greater"
        android:textColor="@color/txt_primary"
        android:id="@+id/me_files_sent_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/x_dp_12"
        app:layout_constraintBottom_toBottomOf="@+id/me_files_sent"
        app:layout_constraintEnd_toEndOf="@+id/me_files_sent"
        app:layout_constraintTop_toTopOf="@+id/me_files_sent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
