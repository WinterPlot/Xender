<?xml version="1.0" encoding="utf-8"?>
<com.userlabs.xshare.views.XConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/app_window_bg"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include layout="@layout/ex_toolbar"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_medium"
        android:textColor="@color/txt_secondary"
        android:gravity="start|center_vertical"
        android:id="@+id/ex_invite_instructions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/ex_dp_16"
        android:layout_marginTop="@dimen/ex_dp_16"
        android:layout_marginRight="@dimen/ex_dp_16"
        android:text="@string/ex_connect_hotspot_tips_title"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"
        style="@style/text_style_bold"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="vertical"
        android:id="@+id/ex_invite_step1"
        android:background="@drawable/ex_bg_window_2_color_corner_10"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/ex_dp_16"
        android:layout_marginTop="35dp"
        android:layout_marginRight="@dimen/ex_dp_16"
        android:layout_marginHorizontal="@dimen/ex_dp_16"
        app:layout_constraintTop_toBottomOf="@+id/ex_invite_instructions">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/xshare_text_size_large"
            android:textColor="@color/txt_primary"
            android:gravity="start|center_vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/ex_dp_16"
            android:layout_marginTop="@dimen/ex_dp_30"
            android:layout_marginRight="@dimen/ex_dp_16"
            android:text="@string/ex_hotspot_step_1"
            android:layout_marginHorizontal="@dimen/ex_dp_16"
            style="@style/text_style_bold"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/xshare_text_size_large"
            android:textColor="@color/txt_primary"
            android:gravity="start|center_vertical"
            android:id="@+id/ex_hotspot_ap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/ex_dp_16"
            android:layout_marginTop="@dimen/ex_dp_4"
            android:layout_marginRight="@dimen/ex_dp_16"
            android:layout_marginBottom="@dimen/ex_dp_16"
            android:layout_marginHorizontal="@dimen/ex_dp_16"
            style="@style/text_style_bold"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/cx_sp_20"
        android:textColor="@color/txt_white"
        android:gravity="center"
        android:background="@drawable/ex_bg_primary"
        android:layout_width="@dimen/ex_dp_30"
        android:layout_height="@dimen/ex_dp_30"
        android:layout_marginTop="24dp"
        android:text="@string/ex_step1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ex_invite_instructions"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="vertical"
        android:id="@+id/ex_invite_step2"
        android:background="@drawable/ex_bg_window_2_color_corner_10"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/ex_dp_16"
        android:layout_marginTop="35dp"
        android:layout_marginRight="@dimen/ex_dp_16"
        android:layout_marginHorizontal="@dimen/ex_dp_16"
        app:layout_constraintTop_toBottomOf="@+id/ex_invite_step1">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/xshare_text_size_large"
            android:textColor="@color/txt_primary"
            android:gravity="start|center_vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/ex_dp_16"
            android:layout_marginTop="@dimen/ex_dp_30"
            android:layout_marginRight="@dimen/ex_dp_16"
            android:layout_marginBottom="@dimen/ex_dp_16"
            android:text="@string/ex_hotspot_step_2"
            android:layout_marginHorizontal="@dimen/ex_dp_16"
            style="@style/text_style_bold"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/cx_sp_20"
        android:textColor="@color/txt_white"
        android:gravity="center"
        android:background="@drawable/ex_bg_primary"
        android:layout_width="@dimen/ex_dp_30"
        android:layout_height="@dimen/ex_dp_30"
        android:layout_marginTop="24dp"
        android:text="@string/ex_step2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ex_invite_step1"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="vertical"
        android:background="@drawable/ex_bg_window_2_color_corner_10"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/ex_dp_16"
        android:layout_marginTop="35dp"
        android:layout_marginRight="@dimen/ex_dp_16"
        android:layout_marginHorizontal="@dimen/ex_dp_16"
        app:layout_constraintTop_toBottomOf="@+id/ex_invite_step2">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/xshare_text_size_large"
            android:textColor="@color/txt_primary"
            android:gravity="start|center_vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/ex_dp_16"
            android:layout_marginTop="@dimen/ex_dp_30"
            android:layout_marginRight="@dimen/ex_dp_16"
            android:text="@string/ex_hotspot_step_3"
            android:layout_marginHorizontal="@dimen/ex_dp_16"
            style="@style/text_style_bold"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/xshare_text_size_large"
            android:textColor="@color/primary"
            android:gravity="start|center_vertical"
            android:id="@+id/ex_hotspot_address"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/ex_dp_16"
            android:layout_marginTop="@dimen/ex_dp_4"
            android:layout_marginRight="@dimen/ex_dp_16"
            android:layout_marginBottom="@dimen/ex_dp_16"
            android:layout_marginHorizontal="@dimen/ex_dp_16"
            style="@style/text_style_bold"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/cx_sp_20"
        android:textColor="@color/txt_white"
        android:gravity="center"
        android:background="@drawable/ex_bg_primary"
        android:layout_width="@dimen/ex_dp_30"
        android:layout_height="@dimen/ex_dp_30"
        android:layout_marginTop="24dp"
        android:text="@string/ex_step3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ex_invite_step2"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_medium"
        android:textColor="@color/txt_primary"
        android:gravity="start|center_vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/ex_dp_16"
        android:layout_marginTop="@dimen/ex_dp_30"
        android:layout_marginRight="@dimen/ex_dp_16"
        android:layout_marginBottom="@dimen/ex_dp_16"
        android:text="@string/ex_invite_next"
        android:layout_marginHorizontal="@dimen/ex_dp_16"
        app:layout_constraintBottom_toTopOf="@+id/next_btn"/>
    <Button
        android:textColor="@color/txt_white"
        android:gravity="center"
        android:id="@+id/next_btn"
        android:background="@drawable/btn_primary_round_corner"
        android:layout_width="match_parent"
        android:layout_height="@dimen/ex_dp_48"
        android:layout_marginLeft="@dimen/ex_dp_16"
        android:layout_marginTop="@dimen/ex_dp_13"
        android:layout_marginRight="@dimen/ex_dp_16"
        android:layout_marginBottom="@dimen/ex_dp_13"
        android:text="@string/exchange_next"
        android:layout_marginHorizontal="@dimen/ex_dp_16"
        android:layout_marginVertical="@dimen/ex_dp_13"
        app:layout_constraintBottom_toBottomOf="parent"
        style="@style/cx_button_text_style_bold"/>
</com.userlabs.xshare.views.XConstraintLayout>
