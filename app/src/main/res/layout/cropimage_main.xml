<?xml version="1.0" encoding="utf-8"?>
<com.userlabs.xshare.views.XConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.userlabs.xshare.cropimage.CropImageView
        android:id="@+id/crop_image_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="@dimen/x_dp_7"
        app:layout_constraintBottom_toTopOf="@+id/crop_image_cancel_btn"
        app:layout_constraintTop_toTopOf="parent"/>
    <Button
        android:textColor="@color/txt_secondary"
        android:gravity="center"
        android:id="@+id/crop_image_cancel_btn"
        android:background="@drawable/btn_white"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="@dimen/x_dp_150"
        android:layout_height="@dimen/x_dp_40"
        android:layout_marginBottom="@dimen/x_dp_7"
        android:text="@string/messenger_cancel"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/crop_image_save_btn"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/button_text_style_bold"/>
    <Button
        android:gravity="center"
        android:id="@+id/crop_image_save_btn"
        android:background="@drawable/btn_primary_round_corner"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="@dimen/x_dp_150"
        android:layout_height="@dimen/x_dp_40"
        android:layout_marginBottom="@dimen/x_dp_7"
        android:text="@string/slide_image_save"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/crop_image_cancel_btn"
        style="@style/button_text_style_bold"/>
</com.userlabs.xshare.views.XConstraintLayout>
