<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/history_progress_lay"
    android:layout_width="match_parent"
    android:layout_height="@dimen/x_dp_80">
    <ProgressBar
        android:id="@+id/history_progress_bar"
        android:background="@color/x_transparent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:max="100"
        android:progress="30"
        android:progressDrawable="@drawable/bg_progress_primary_corner_8dp"
        style="?android:attr/progressBarStyleHorizontal"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/history_progress_item_file_icon_iv"
        android:layout_marginStart="@dimen/x_dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/history_item_file_icon_iv_style"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/history_progress_cancel_iv"
        android:background="?attr/actionBarItemBackground"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:scaleType="center"
        android:layout_marginEnd="80dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_small"
        android:textColor="@color/txt_white"
        android:gravity="center"
        android:id="@+id/history_progress_complete_opt_btn"
        android:focusable="true"
        android:visibility="visible"
        android:clickable="true"
        android:layout_width="@dimen/x_dp_64"
        android:layout_height="wrap_content"
        android:maxHeight="40dp"
        android:minHeight="@dimen/x_dp_26"
        android:singleLine="true"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="@dimen/x_dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/title_text_style_bold"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_medium"
        android:ellipsize="end"
        android:gravity="start|center_vertical"
        android:id="@+id/history_progress_item_file_name_tv"
        android:layout_width="0dp"
        android:maxLines="1"
        android:singleLine="false"
        android:layout_marginStart="@dimen/x_dp_12"
        app:layout_constraintBottom_toTopOf="@+id/history_progress_item_file_size_tv"
        app:layout_constraintEnd_toStartOf="@+id/history_progress_cancel_iv"
        app:layout_constraintStart_toEndOf="@+id/history_progress_item_file_icon_iv"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_goneMarginEnd="92dp"
        style="@style/history_item_file_name_tv_style"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_small"
        android:textColor="@color/txt_secondary"
        android:ellipsize="middle"
        android:gravity="start|center_vertical"
        android:id="@+id/history_progress_item_file_size_tv"
        android:background="@null"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/x_dp_3"
        android:singleLine="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@+id/history_progress_item_file_name_tv"
        app:layout_constraintTop_toBottomOf="@+id/history_progress_item_file_name_tv"
        style="@style/title_text_font_style"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/progress_bundle_flag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="5dp"
        app:layout_constraintBottom_toBottomOf="@+id/history_progress_item_file_size_tv"
        app:layout_constraintStart_toEndOf="@+id/history_progress_item_file_size_tv"
        app:layout_constraintTop_toTopOf="@+id/history_progress_item_file_size_tv"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="11sp"
        android:textColor="@color/x_red"
        android:id="@+id/history_bundle_abi_error"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="3dp"
        app:layout_constraintBottom_toBottomOf="@+id/history_progress_item_file_size_tv"
        app:layout_constraintStart_toEndOf="@+id/progress_bundle_flag"
        app:layout_constraintTop_toTopOf="@+id/history_progress_item_file_size_tv"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_small"
        android:textColor="@color/x_red"
        android:ellipsize="middle"
        android:gravity="start|bottom"
        android:id="@+id/history_progress_item_state_tv"
        android:background="@null"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="5dp"
        android:layout_marginRight="5dp"
        android:text="@string/str_paused"
        android:singleLine="true"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="5dp"
        android:layout_marginEnd="5dp"
        app:layout_constraintBottom_toBottomOf="@+id/history_progress_item_file_size_tv"
        app:layout_constraintStart_toEndOf="@+id/history_bundle_abi_error"
        app:layout_constraintTop_toTopOf="@+id/history_progress_item_file_size_tv"
        style="@style/title_text_font_style"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/history_loading_btn"
        android:visibility="visible"
        android:layout_width="@dimen/x_dp_64"
        android:layout_height="22dp"
        android:scaleType="center"
        android:layout_marginEnd="@dimen/x_dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_small"
        android:textColor="@color/txt_secondary"
        android:ellipsize="middle"
        android:gravity="center"
        android:id="@+id/history_installing_item_file_app__tv"
        android:background="@null"
        android:layout_width="@dimen/x_dp_66"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/x_dp_5"
        android:text="@string/x_installing"
        android:singleLine="true"
        app:layout_constraintEnd_toEndOf="@+id/history_loading_btn"
        app:layout_constraintStart_toStartOf="@+id/history_loading_btn"
        app:layout_constraintTop_toBottomOf="@+id/history_loading_btn"
        style="@style/title_text_font_style"/>
</androidx.constraintlayout.widget.ConstraintLayout>
