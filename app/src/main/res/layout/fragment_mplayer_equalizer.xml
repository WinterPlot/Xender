<?xml version="1.0" encoding="utf-8"?>
<com.userlabs.xshare.views.XConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/mp_equalizer_layout"
    android:tag="layout/fragment_mplayer_equalizer_0"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/mp_eq_toolbar"
        android:background="@color/primary"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/mp_equalizer_back_btn"
            android:background="?attr/selectableItemBackground"
            android:paddingLeft="@dimen/x_dp_16"
            android:paddingRight="@dimen/x_dp_16"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:src="@drawable/cx_svg_back"
            app:layout_constraintStart_toStartOf="parent"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="20sp"
            android:textColor="@color/x_white"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/equalizer_title"
            app:layout_constraintEnd_toStartOf="@+id/mp_equalizer_switch_btn"
            app:layout_constraintStart_toEndOf="@+id/mp_equalizer_back_btn"/>
        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/mp_equalizer_switch_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/x_dp_16"
            android:layout_marginRight="@dimen/x_dp_16"
            android:checked="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:switchMinWidth="@dimen/x_dp_50"
            app:thumbTint="@color/x_white"
            app:trackTint="@color/color_selector_switch_equalizer"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ScrollView
        android:background="#ffffffff"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/mp_eq_toolbar">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:orientation="vertical"
            android:paddingBottom="@dimen/x_dp_30"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <View
                android:layout_gravity="center"
                android:id="@+id/mp_equalizer_dot_view"
                android:layout_width="0dp"
                android:layout_height="@dimen/x_dp_2"
                android:layout_marginLeft="@dimen/x_dp_16"
                android:layout_marginRight="@dimen/x_dp_16"
                android:layerType="software"
                android:layout_marginHorizontal="@dimen/x_dp_16"
                app:layout_constraintBottom_toBottomOf="@+id/mp_eq_seek_bar_60"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/mp_middle_eq_level_tv"
                app:layout_constraintTop_toTopOf="@+id/mp_eq_seek_bar_60"/>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:orientation="horizontal"
                android:id="@+id/mp_presets_layout"
                android:layout_width="match_parent"
                android:layout_height="@dimen/x_dp_40"
                android:layout_marginLeft="@dimen/x_dp_24"
                android:layout_marginTop="@dimen/x_dp_20"
                android:layout_marginRight="@dimen/x_dp_24"
                android:layout_marginHorizontal="@dimen/x_dp_24"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textColor="#000000"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/mp_presets_tv"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_margin="0.5dp"
                    android:text="@string/equalizer_presets"
                    android:textAllCaps="true"
                    android:paddingHorizontal="10dp"/>
                <androidx.appcompat.widget.AppCompatSpinner
                    android:theme="@style/Theme.AppCompat.Light"
                    android:id="@+id/mp_preset_spinner"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/x_dp_40"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
            <androidx.appcompat.widget.AppCompatTextView
                android:textColor="#de000000"
                android:gravity="center"
                android:id="@+id/mp_max_eq_level_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/x_dp_16"
                android:text="@string/equalizer_max_bandlevel"
                android:layout_marginStart="@dimen/x_dp_16"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/mp_eq_seek_bar_60"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textColor="#de000000"
                android:gravity="center"
                android:id="@+id/mp_middle_eq_level_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/equalizer_normal_bandlevel"
                app:layout_constraintBottom_toTopOf="@+id/mp_min_eq_level_tv"
                app:layout_constraintStart_toStartOf="@+id/mp_max_eq_level_tv"
                app:layout_constraintTop_toBottomOf="@+id/mp_max_eq_level_tv"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textColor="#de000000"
                android:gravity="center"
                android:id="@+id/mp_min_eq_level_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/x_dp_16"
                android:text="@string/equalizer_min_bandlevel"
                app:layout_constraintBottom_toBottomOf="@+id/mp_eq_seek_bar_60"
                app:layout_constraintStart_toStartOf="@+id/mp_max_eq_level_tv"/>
            <com.userlabs.xshare.views.VerticalSeekBar
                android:id="@+id/mp_eq_seek_bar_60"
                android:clickable="false"
                android:layout_width="wrap_content"
                android:layout_height="200dp"
                android:layout_marginTop="@dimen/x_dp_20"
                android:maxHeight="4dp"
                android:minHeight="4dp"
                android:splitTrack="false"
                app:layout_constraintEnd_toStartOf="@+id/mp_eq_seek_bar_230"
                app:layout_constraintStart_toEndOf="@+id/mp_max_eq_level_tv"
                app:layout_constraintTop_toBottomOf="@+id/mp_presets_layout"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textColor="#de000000"
                android:id="@+id/mp_seek_bar_60_des_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/equalizer_60Hz"
                app:layout_constraintEnd_toEndOf="@+id/mp_eq_seek_bar_60"
                app:layout_constraintStart_toStartOf="@+id/mp_eq_seek_bar_60"
                app:layout_constraintTop_toBottomOf="@+id/mp_eq_seek_bar_60"/>
            <com.userlabs.xshare.views.VerticalSeekBar
                android:id="@+id/mp_eq_seek_bar_230"
                android:clickable="false"
                android:layout_width="wrap_content"
                android:layout_height="200dp"
                android:maxHeight="4dp"
                android:minHeight="4dp"
                android:splitTrack="false"
                app:layout_constraintEnd_toStartOf="@+id/mp_eq_seek_bar_910"
                app:layout_constraintStart_toEndOf="@+id/mp_eq_seek_bar_60"
                app:layout_constraintTop_toTopOf="@+id/mp_eq_seek_bar_60"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textColor="#de000000"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/equalizer_230Hz"
                app:layout_constraintEnd_toEndOf="@+id/mp_eq_seek_bar_230"
                app:layout_constraintStart_toStartOf="@+id/mp_eq_seek_bar_230"
                app:layout_constraintTop_toBottomOf="@+id/mp_eq_seek_bar_230"/>
            <com.userlabs.xshare.views.VerticalSeekBar
                android:id="@+id/mp_eq_seek_bar_910"
                android:clickable="false"
                android:layout_width="wrap_content"
                android:layout_height="200dp"
                android:maxHeight="4dp"
                android:minHeight="4dp"
                android:splitTrack="false"
                app:layout_constraintEnd_toStartOf="@+id/mp_eq_seek_bar_3600"
                app:layout_constraintStart_toEndOf="@+id/mp_eq_seek_bar_230"
                app:layout_constraintTop_toTopOf="@+id/mp_eq_seek_bar_60"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textColor="#de000000"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/equalizer_910Hz"
                app:layout_constraintEnd_toEndOf="@+id/mp_eq_seek_bar_910"
                app:layout_constraintStart_toStartOf="@+id/mp_eq_seek_bar_910"
                app:layout_constraintTop_toBottomOf="@+id/mp_eq_seek_bar_910"/>
            <com.userlabs.xshare.views.VerticalSeekBar
                android:id="@+id/mp_eq_seek_bar_3600"
                android:clickable="false"
                android:layout_width="wrap_content"
                android:layout_height="200dp"
                android:maxHeight="4dp"
                android:minHeight="4dp"
                android:splitTrack="false"
                app:layout_constraintEnd_toStartOf="@+id/mp_eq_seek_bar_14000"
                app:layout_constraintStart_toEndOf="@+id/mp_eq_seek_bar_910"
                app:layout_constraintTop_toTopOf="@+id/mp_eq_seek_bar_60"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textColor="#de000000"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/equalizer_3600Hz"
                app:layout_constraintEnd_toEndOf="@+id/mp_eq_seek_bar_3600"
                app:layout_constraintStart_toStartOf="@+id/mp_eq_seek_bar_3600"
                app:layout_constraintTop_toBottomOf="@+id/mp_eq_seek_bar_3600"/>
            <com.userlabs.xshare.views.VerticalSeekBar
                android:id="@+id/mp_eq_seek_bar_14000"
                android:clickable="false"
                android:layout_width="wrap_content"
                android:layout_height="200dp"
                android:maxHeight="4dp"
                android:minHeight="4dp"
                android:splitTrack="false"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/mp_eq_seek_bar_3600"
                app:layout_constraintTop_toTopOf="@+id/mp_eq_seek_bar_60"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textColor="#de000000"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/equalizer_14000Hz"
                app:layout_constraintEnd_toEndOf="@+id/mp_eq_seek_bar_14000"
                app:layout_constraintStart_toStartOf="@+id/mp_eq_seek_bar_14000"
                app:layout_constraintTop_toBottomOf="@+id/mp_eq_seek_bar_14000"/>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:orientation="horizontal"
                android:id="@+id/mp_reverb_layout"
                android:layout_width="match_parent"
                android:layout_height="@dimen/x_dp_40"
                android:layout_marginLeft="@dimen/x_dp_24"
                android:layout_marginTop="@dimen/x_dp_20"
                android:layout_marginRight="@dimen/x_dp_24"
                android:layout_marginHorizontal="@dimen/x_dp_24"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/mp_seek_bar_60_des_tv">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textColor="#000000"
                    android:gravity="center"
                    android:id="@+id/mp_reverb_tv"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_margin="0.5dp"
                    android:text="@string/equalizer_reverb"
                    android:textAllCaps="true"
                    android:paddingHorizontal="10dp"/>
                <androidx.appcompat.widget.AppCompatSpinner
                    android:theme="@style/Theme.AppCompat.Light"
                    android:id="@+id/mp_reverb_spinner"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/x_dp_40"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
            <androidx.appcompat.widget.AppCompatTextView
                android:textColor="#de000000"
                android:gravity="center"
                android:id="@+id/mp_bass_boost_title_tv"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/x_dp_40"
                android:layout_marginTop="@dimen/x_dp_16"
                android:text="@string/equalizer_bassboost"
                android:layout_marginStart="@dimen/x_dp_16"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/mp_reverb_layout"/>
            <androidx.appcompat.widget.AppCompatSeekBar
                android:id="@+id/mp_bass_boost_seek_bar"
                android:clickable="false"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:maxHeight="4dp"
                android:max="1000"
                android:progress="0"
                android:progressDrawable="@drawable/bg_progress_primary_round_corner"
                android:minHeight="4dp"
                android:thumb="@drawable/svg_seek_thumb_vertical"
                android:layout_marginStart="@dimen/x_dp_8"
                android:splitTrack="false"
                app:layout_constraintBottom_toBottomOf="@+id/mp_bass_boost_title_tv"
                app:layout_constraintEnd_toStartOf="@+id/mp_bass_boost_progress_tv"
                app:layout_constraintStart_toEndOf="@+id/mp_bass_boost_title_tv"
                app:layout_constraintTop_toTopOf="@+id/mp_bass_boost_title_tv"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textColor="#de000000"
                android:gravity="center"
                android:id="@+id/mp_bass_boost_progress_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/x_dp_16"
                app:layout_constraintBottom_toBottomOf="@+id/mp_bass_boost_title_tv"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/mp_bass_boost_title_tv"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textColor="#de000000"
                android:gravity="center"
                android:id="@+id/mp_virtuzlizer_title_tv"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/x_dp_40"
                android:layout_marginTop="@dimen/x_dp_16"
                android:text="@string/equalizer_virtualizer"
                app:layout_constraintStart_toStartOf="@+id/mp_bass_boost_title_tv"
                app:layout_constraintTop_toBottomOf="@+id/mp_bass_boost_title_tv"/>
            <androidx.appcompat.widget.AppCompatSeekBar
                android:id="@+id/mp_virtuzlizer_seek_bar"
                android:clickable="false"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:maxHeight="4dp"
                android:max="1000"
                android:progress="0"
                android:minHeight="4dp"
                android:splitTrack="false"
                app:layout_constraintBottom_toBottomOf="@+id/mp_virtuzlizer_title_tv"
                app:layout_constraintEnd_toEndOf="@+id/mp_bass_boost_seek_bar"
                app:layout_constraintStart_toStartOf="@+id/mp_bass_boost_seek_bar"
                app:layout_constraintTop_toTopOf="@+id/mp_virtuzlizer_title_tv"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textColor="#de000000"
                android:gravity="center"
                android:id="@+id/mp_virtuzlizer_progress_tv"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginEnd="@dimen/x_dp_16"
                app:layout_constraintBottom_toBottomOf="@+id/mp_virtuzlizer_title_tv"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/mp_virtuzlizer_title_tv"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textColor="#de000000"
                android:gravity="center"
                android:id="@+id/mp_volume_title_tv"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/x_dp_40"
                android:layout_marginTop="@dimen/x_dp_16"
                android:text="@string/equalizer_volume"
                app:layout_constraintStart_toStartOf="@+id/mp_bass_boost_title_tv"
                app:layout_constraintTop_toBottomOf="@+id/mp_virtuzlizer_title_tv"/>
            <androidx.appcompat.widget.AppCompatSeekBar
                android:id="@+id/mp_volume_seek_bar"
                android:clickable="false"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:maxHeight="4dp"
                android:minHeight="4dp"
                android:splitTrack="false"
                app:layout_constraintBottom_toBottomOf="@+id/mp_volume_title_tv"
                app:layout_constraintEnd_toEndOf="@+id/mp_bass_boost_seek_bar"
                app:layout_constraintStart_toStartOf="@+id/mp_bass_boost_seek_bar"
                app:layout_constraintTop_toTopOf="@+id/mp_volume_title_tv"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textColor="#de000000"
                android:gravity="center"
                android:id="@+id/mp_volume_progress_tv"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginEnd="@dimen/x_dp_16"
                app:layout_constraintBottom_toBottomOf="@+id/mp_volume_title_tv"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/mp_volume_title_tv"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
    <View
        android:id="@+id/mp_not_enabled_view"
        android:background="#8a000000"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/mp_eq_toolbar"/>
</com.userlabs.xshare.views.XConstraintLayout>
