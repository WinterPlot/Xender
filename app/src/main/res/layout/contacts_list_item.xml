<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/selector_list_item"
    android:addStatesFromChildren="false"
    android:descendantFocusability="blocksDescendants"
    android:layout_width="match_parent"
    android:layout_height="@dimen/x_dp_64"
    android:textDirection="locale"
    android:layoutDirection="locale">
    <com.userlabs.xshare.views.XCheckBox
        android:id="@+id/contacts_check_cb"
        android:focusable="false"
        android:clickable="false"
        android:duplicateParentState="false"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:scaleType="center"
        android:layout_marginEnd="@dimen/x_dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/cx_sp_20"
        android:textColor="@color/txt_white"
        android:gravity="center"
        android:id="@+id/contacts_icon_tv"
        android:background="@drawable/bg_red_oval"
        android:layout_width="@dimen/x_dp_48"
        android:layout_height="@dimen/x_dp_48"
        android:layout_marginStart="@dimen/x_dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/cx_sp_15"
        android:textColor="@color/txt_primary"
        android:ellipsize="middle"
        android:gravity="start|center_vertical"
        android:id="@+id/contacts_name_tv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/x_dp_12"
        android:layout_marginRight="@dimen/x_dp_12"
        android:singleLine="true"
        android:layout_marginHorizontal="@dimen/x_dp_12"
        app:layout_constraintBottom_toTopOf="@+id/contacts_number_tv"
        app:layout_constraintEnd_toStartOf="@+id/contacts_check_cb"
        app:layout_constraintStart_toEndOf="@+id/contacts_icon_tv"
        app:layout_constraintTop_toTopOf="@+id/contacts_icon_tv"
        app:layout_constraintVertical_chainStyle="spread"
        app:layout_constraintVertical_weight="1"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_small"
        android:textColor="@color/txt_secondary"
        android:gravity="start|center_vertical"
        android:id="@+id/contacts_number_tv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:singleLine="true"
        app:layout_constraintBottom_toBottomOf="@+id/contacts_icon_tv"
        app:layout_constraintEnd_toEndOf="@+id/contacts_name_tv"
        app:layout_constraintStart_toStartOf="@+id/contacts_name_tv"
        app:layout_constraintTop_toBottomOf="@+id/contacts_name_tv"/>
</androidx.constraintlayout.widget.ConstraintLayout>
