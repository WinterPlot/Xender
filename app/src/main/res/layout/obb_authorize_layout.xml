<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_window_1_color_corner_2"
    android:padding="@dimen/cx_dp_16"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/ex_dp_16">
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_large"
        android:textColor="@color/primary"
        android:gravity="center"
        android:id="@+id/obb_authorize_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/sd_card_need_oauth"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/bold_text_style"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_medium"
        android:textColor="@color/txt_primary"
        android:gravity="center"
        android:id="@+id/obb_authorize_des"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/cx_dp_16"
        android:text="@string/obb_authorize_des"
        app:layout_constraintTop_toBottomOf="@+id/obb_authorize_title"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:gravity="center"
        android:id="@+id/obb_authorize_ok"
        android:background="@drawable/btn_primary_round_corner"
        android:layout_width="match_parent"
        android:layout_height="@dimen/x_dp_36"
        android:layout_marginLeft="@dimen/x_dp_36"
        android:layout_marginTop="@dimen/cx_dp_16"
        android:layout_marginRight="@dimen/x_dp_36"
        android:text="@string/obb_permission_set"
        android:layout_marginHorizontal="@dimen/x_dp_36"
        app:layout_constraintTop_toBottomOf="@+id/obb_authorize_des"
        style="@style/cx_button_text_style_bold"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@color/txt_secondary"
        android:gravity="center"
        android:id="@+id/obb_authorize_cancel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/cx_dp_16"
        android:text="@string/messenger_cancel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/obb_authorize_ok"
        style="@style/cx_button_text_style_bold"/>
</androidx.constraintlayout.widget.ConstraintLayout>
