<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/vp_guide_step1_guide_line"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.35"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/vp_guide_step1_guide_line1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.6"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/vp_guide_more_btn"
        android:layout_width="@dimen/vp_dp_48"
        android:layout_height="@dimen/vp_dp_48"
        android:scaleType="center"
        android:layout_marginEnd="@dimen/vp_dp_8"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/vp_guide_step1_head_tv"
        android:layout_marginLeft="@dimen/vp_dp_30"
        android:layout_marginRight="@dimen/vp_dp_30"
        android:layout_marginHorizontal="@dimen/vp_dp_30"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/vp_guide_step1_guide_line"
        style="@style/vp_guide_head_text_style"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/vp_guide_step1_description_tv"
        android:layout_marginLeft="@dimen/vp_dp_30"
        android:layout_marginTop="@dimen/vp_dp_8"
        android:layout_marginRight="@dimen/vp_dp_30"
        android:layout_marginHorizontal="@dimen/vp_dp_30"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/vp_guide_step1_head_tv"
        style="@style/vp_guide_description_text_style"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/vp_guide_step1_btn"
        android:layout_marginLeft="@dimen/vp_dp_30"
        android:layout_marginRight="@dimen/vp_dp_30"
        android:layout_marginHorizontal="@dimen/vp_dp_30"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/vp_guide_step1_guide_line1"
        style="@style/vp_guide_button_text_style"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/vp_guide_play_pause_btn"
        android:layout_width="@dimen/vp_dp_60"
        android:layout_height="@dimen/vp_dp_60"
        android:layout_marginBottom="@dimen/vp_dp_8"
        android:scaleType="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/vp_guide_subtitle_btn"
        android:layout_width="@dimen/vp_dp_48"
        android:layout_height="@dimen/vp_dp_48"
        android:scaleType="center"
        android:layout_marginStart="@dimen/vp_dp_8"
        app:layout_constraintBottom_toBottomOf="@+id/vp_guide_play_pause_btn"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/vp_guide_play_pause_btn"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/vp_guide_track_btn"
        android:layout_width="@dimen/vp_dp_48"
        android:layout_height="@dimen/vp_dp_48"
        android:scaleType="center"
        android:layout_marginStart="@dimen/vp_dp_3"
        app:layout_constraintBottom_toBottomOf="@+id/vp_guide_play_pause_btn"
        app:layout_constraintStart_toEndOf="@+id/vp_guide_subtitle_btn"
        app:layout_constraintTop_toTopOf="@+id/vp_guide_play_pause_btn"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/vp_guide_rotate_btn"
        android:layout_width="@dimen/vp_dp_48"
        android:layout_height="@dimen/vp_dp_48"
        android:scaleType="center"
        android:layout_marginEnd="@dimen/vp_dp_8"
        app:layout_constraintBottom_toBottomOf="@+id/vp_guide_play_pause_btn"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/vp_guide_play_pause_btn"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/vp_guide_lock_auto_rotate_btn"
        android:layout_width="@dimen/vp_dp_48"
        android:layout_height="@dimen/vp_dp_48"
        android:scaleType="center"
        android:layout_marginEnd="@dimen/vp_dp_3"
        app:layout_constraintBottom_toBottomOf="@+id/vp_guide_play_pause_btn"
        app:layout_constraintEnd_toStartOf="@+id/vp_guide_rotate_btn"
        app:layout_constraintTop_toTopOf="@+id/vp_guide_play_pause_btn"/>
</androidx.constraintlayout.widget.ConstraintLayout>
