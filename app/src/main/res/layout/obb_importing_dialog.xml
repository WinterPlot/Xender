<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="@dimen/cx_dp_24"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/ex_dp_16">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/obb_res_iv"
        android:layout_width="27dp"
        android:layout_height="27dp"
        android:src="@drawable/svg_obb_files"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/obb_app_res_iv"
        android:layout_width="12dp"
        android:layout_height="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/obb_res_iv"
        app:layout_constraintEnd_toEndOf="@+id/obb_res_iv"
        app:layout_constraintRight_toRightOf="@+id/obb_res_iv"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_medium"
        android:textColor="@color/txt_primary"
        android:gravity="center"
        android:id="@+id/obb_import_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/x_dp_8"
        android:layout_marginRight="@dimen/x_dp_8"
        android:text="@string/obb_res_importing"
        android:layout_marginHorizontal="@dimen/x_dp_8"
        app:layout_constraintBottom_toBottomOf="@+id/obb_res_iv"
        app:layout_constraintLeft_toRightOf="@+id/obb_res_iv"
        app:layout_constraintStart_toEndOf="@+id/obb_res_iv"
        app:layout_constraintTop_toTopOf="@+id/obb_res_iv"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/obb_import_loading"
        android:layout_width="@dimen/x_dp_66"
        android:layout_height="22dp"
        android:layout_marginTop="@dimen/cx_dp_24"
        android:layout_marginBottom="@dimen/cx_dp_24"
        android:src="@drawable/cx_svg_waiting"
        android:layout_marginVertical="@dimen/cx_dp_24"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/obb_import_tv"/>
</androidx.constraintlayout.widget.ConstraintLayout>
