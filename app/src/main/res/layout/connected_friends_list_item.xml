<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="start"
    android:layout_width="match_parent"
    android:layout_height="@dimen/x_dp_54"
    android:layout_centerVertical="true"
    android:layout_marginStart="@dimen/x_dp_12">
    <TextView
        android:textSize="@dimen/xshare_text_size_medium"
        android:textColor="@color/txt_primary"
        android:ellipsize="middle"
        android:gravity="center_vertical"
        android:id="@+id/connected_friend_name_tv"
        android:background="@drawable/bg_window_2_color_round_corner"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/x_dp_32"
        android:singleLine="true"
        android:layout_centerVertical="true"
        android:paddingStart="@dimen/x_dp_40"
        android:paddingEnd="@dimen/x_dp_12"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/connected_friend_avatar_iv"
        android:background="@drawable/bg_line_oval"
        android:padding="1dp"
        android:layout_width="@dimen/x_dp_32"
        android:layout_height="@dimen/x_dp_32"
        android:layout_centerVertical="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
