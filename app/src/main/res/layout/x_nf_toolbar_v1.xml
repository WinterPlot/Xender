<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="48dp">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/nf_toolbar_transfer_layer"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">
        <ImageView
            android:id="@+id/nf_toolbar_transfer_iv"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:scaleType="center"/>
        <TextView
            android:textSize="10sp"
            android:id="@+id/nf_toolbar_transfer_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:maxLines="1"
            style="@style/TextAppearance.Compat.Notification.Title"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/nf_toolbar_mp3_layer"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">
        <ImageView
            android:id="@+id/nf_toolbar_mp3_iv"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:scaleType="center"/>
        <TextView
            android:textSize="10sp"
            android:id="@+id/nf_toolbar_mp3_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:singleLine="true"
            style="@style/TextAppearance.Compat.Notification.Title"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/nf_toolbar_social_layer"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">
        <ImageView
            android:id="@+id/nf_toolbar_social_iv"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:scaleType="center"/>
        <TextView
            android:textSize="10sp"
            android:id="@+id/nf_toolbar_social_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:singleLine="true"
            style="@style/TextAppearance.Compat.Notification.Title"/>
    </LinearLayout>
    <ImageView
        android:layout_gravity="center_vertical"
        android:background="@color/x_line"
        android:layout_width="1dp"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/nf_toolbar_settings_layer"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/nf_toolbar_settings_iv"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:scaleType="center"/>
    </FrameLayout>
</LinearLayout>
