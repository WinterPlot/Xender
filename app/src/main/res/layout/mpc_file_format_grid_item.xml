<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/selectableItemBackground"
    android:layout_width="match_parent"
    android:layout_height="@dimen/mpc_dp_64"
    android:textDirection="locale"
    android:layoutDirection="locale">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/mpc_file_format_icon_iv"
        android:layout_width="@dimen/mpc_dp_24"
        android:layout_height="@dimen/mpc_dp_24"
        android:tint="@color/mpc_txt_primary"
        android:layout_marginStart="@dimen/mpc_dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/mpc_sp_14"
        android:textStyle="normal"
        android:textColor="@color/mpc_txt_primary"
        android:gravity="center_vertical"
        android:id="@+id/mpc_file_format_title_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif"
        android:layout_marginStart="@dimen/mpc_dp_16"
        app:layout_constraintBottom_toTopOf="@+id/mpc_file_format_contains_count_tv"
        app:layout_constraintStart_toEndOf="@+id/mpc_file_format_icon_iv"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="12sp"
        android:textStyle="normal"
        android:textColor="@color/mpc_txt_secondary"
        android:gravity="center_vertical"
        android:id="@+id/mpc_file_format_contains_count_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/mpc_dp_5"
        android:drawablePadding="@dimen/mpc_dp_8"
        android:fontFamily="sans-serif"
        android:layout_marginEnd="@dimen/mpc_dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@+id/mpc_file_format_title_tv"
        app:layout_constraintTop_toBottomOf="@+id/mpc_file_format_title_tv"/>
</androidx.constraintlayout.widget.ConstraintLayout>
