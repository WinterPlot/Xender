<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/selectableItemBackground"
    android:layout_width="match_parent"
    android:layout_height="@dimen/x_dp_80">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/all_songs_iv"
        android:layout_width="@dimen/x_dp_56"
        android:layout_height="@dimen/x_dp_56"
        android:layout_marginStart="@dimen/x_dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_smaller"
        android:textColor="@color/txt_white"
        android:gravity="center"
        android:layout_gravity="start|bottom"
        android:id="@+id/all_duration_item"
        android:background="@drawable/bg_duration"
        android:paddingLeft="5dp"
        android:paddingRight="5dp"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/x_dp_16"
        android:layout_marginBottom="5dp"
        android:singleLine="true"
        android:layout_marginEnd="3dp"
        android:paddingHorizontal="5dp"
        app:layout_constraintBottom_toBottomOf="@+id/all_songs_iv"
        app:layout_constraintEnd_toEndOf="@+id/all_songs_iv"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/all_songs_added"
        android:layout_width="@dimen/x_dp_24"
        android:layout_height="@dimen/x_dp_24"
        android:layout_marginLeft="@dimen/x_dp_16"
        android:layout_marginRight="@dimen/x_dp_16"
        android:scaleType="center"
        android:layout_marginHorizontal="@dimen/x_dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_large"
        android:textColor="@color/txt_primary"
        android:ellipsize="end"
        android:id="@+id/all_songs_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/x_dp_3"
        android:maxLines="1"
        android:layout_marginStart="@dimen/x_dp_12"
        android:layout_marginEnd="@dimen/x_dp_16"
        app:layout_constraintBottom_toTopOf="@+id/all_songs_artist"
        app:layout_constraintEnd_toStartOf="@+id/all_songs_added"
        app:layout_constraintStart_toEndOf="@+id/all_songs_iv"
        app:layout_constraintTop_toTopOf="@+id/all_songs_iv"
        app:layout_constraintVertical_chainStyle="spread_inside"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_small"
        android:textColor="@color/txt_secondary"
        android:gravity="start|center_vertical"
        android:id="@+id/all_songs_artist"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:singleLine="true"
        app:layout_constraintBottom_toTopOf="@+id/all_songs_size"
        app:layout_constraintEnd_toStartOf="@+id/all_songs_added"
        app:layout_constraintStart_toStartOf="@+id/all_songs_name"
        app:layout_constraintTop_toBottomOf="@+id/all_songs_name"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_small"
        android:textColor="@color/txt_secondary"
        android:id="@+id/all_songs_size"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/x_dp_3"
        android:maxLines="1"
        android:layout_marginEnd="@dimen/x_dp_16"
        app:layout_constraintBottom_toBottomOf="@+id/all_songs_iv"
        app:layout_constraintEnd_toStartOf="@+id/all_songs_added"
        app:layout_constraintStart_toStartOf="@+id/all_songs_name"
        app:layout_constraintTop_toBottomOf="@+id/all_songs_artist"/>
</androidx.constraintlayout.widget.ConstraintLayout>
