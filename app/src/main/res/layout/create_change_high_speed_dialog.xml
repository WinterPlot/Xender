<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:paddingTop="@dimen/x_dp_16"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/high_speed_dialog_oval_1"
        android:layout_width="5dp"
        android:layout_height="5dp"
        android:layout_marginTop="@dimen/x_dp_8"
        android:layout_marginStart="@dimen/cx_dp_16"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/high_speed_dialog_tips1"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_medium"
        android:textColor="@color/txt_primary"
        android:gravity="start"
        android:id="@+id/high_speed_dialog_tips1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/x_dp_10"
        android:lineSpacingMultiplier="1.2"
        android:layout_marginStart="3dp"
        android:layout_marginEnd="@dimen/cx_dp_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/high_speed_dialog_oval_1"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/text_style_bold"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/high_speed_dialog_oval_2"
        android:layout_width="5dp"
        android:layout_height="5dp"
        android:layout_marginTop="@dimen/x_dp_8"
        android:layout_marginStart="@dimen/cx_dp_16"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/high_speed_dialog_tips2"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_medium"
        android:textColor="@color/txt_primary"
        android:gravity="start"
        android:id="@+id/high_speed_dialog_tips2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/x_dp_10"
        android:lineSpacingMultiplier="1.2"
        android:layout_marginStart="3dp"
        android:layout_marginEnd="@dimen/cx_dp_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/high_speed_dialog_oval_2"
        app:layout_constraintTop_toBottomOf="@+id/high_speed_dialog_tips1"
        style="@style/text_style_bold"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/high_speed_dialog_oval_3"
        android:layout_width="5dp"
        android:layout_height="5dp"
        android:layout_marginTop="@dimen/x_dp_8"
        android:layout_marginStart="@dimen/cx_dp_16"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/high_speed_dialog_tips3"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_medium"
        android:textColor="@color/txt_primary"
        android:gravity="start"
        android:id="@+id/high_speed_dialog_tips3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/x_dp_10"
        android:lineSpacingMultiplier="1.2"
        android:layout_marginStart="3dp"
        android:layout_marginEnd="@dimen/cx_dp_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/high_speed_dialog_oval_3"
        app:layout_constraintTop_toBottomOf="@+id/high_speed_dialog_tips2"
        style="@style/text_style_bold"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_medium"
        android:textColor="@color/txt_secondary"
        android:gravity="start"
        android:id="@+id/high_speed_dialog_tips4"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/x_dp_12"
        android:lineSpacingMultiplier="1.2"
        android:layout_marginEnd="@dimen/cx_dp_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/high_speed_dialog_tips3"
        app:layout_constraintTop_toBottomOf="@+id/high_speed_dialog_tips3"
        style="@style/text_style_bold"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_large"
        android:textColor="@color/txt_primary"
        android:ellipsize="middle"
        android:gravity="center"
        android:id="@+id/high_speed_dialog_tips_btn"
        android:padding="@dimen/x_dp_12"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/x_dp_18"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/high_speed_dialog_tips4"/>
</androidx.constraintlayout.widget.ConstraintLayout>
