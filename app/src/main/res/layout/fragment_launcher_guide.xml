<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/guide_vp"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintHeight_percent="0.65"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_small"
        android:textColor="@color/txt_secondary"
        android:gravity="center"
        android:id="@+id/guide_privacy_tv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/x_dp_40"
        android:layout_marginRight="@dimen/x_dp_40"
        android:layout_marginBottom="@dimen/x_dp_16"
        android:layout_marginHorizontal="@dimen/x_dp_40"
        app:layout_constraintBottom_toTopOf="@+id/agree_and_continue_btn"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:gravity="center"
        android:id="@+id/agree_and_continue_btn"
        android:background="@drawable/btn_primary_round_corner"
        android:layout_width="match_parent"
        android:layout_height="@dimen/x_dp_48"
        android:layout_marginLeft="@dimen/x_dp_40"
        android:layout_marginRight="@dimen/x_dp_40"
        android:layout_marginBottom="@dimen/x_dp_36"
        android:text="@string/guide_start"
        android:textAllCaps="true"
        android:layout_marginHorizontal="@dimen/x_dp_40"
        app:layout_constraintBottom_toBottomOf="parent"
        style="@style/button_text_style_bold"/>
</androidx.constraintlayout.widget.ConstraintLayout>
