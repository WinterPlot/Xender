<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/vp_guide_step3_guide_line"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.35"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/vp_guide_step3_guide_line1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.6"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/vp_guide_step3_slideupanddown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/vp_dp_32"
        app:layout_constraintBottom_toBottomOf="@+id/vp_guide_step3_description_tv"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/vp_guide_step3_head_tv"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/vp_guide_step3_volume"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vp_dp_10"
        android:layout_marginStart="@dimen/vp_dp_20"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/vp_guide_step3_slideupanddown"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/vp_guide_step3_progressbar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vp_dp_10"
        android:layout_marginStart="@dimen/vp_dp_30"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/vp_guide_step3_volume"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:gravity="start"
        android:id="@+id/vp_guide_step3_head_tv"
        android:layout_marginStart="@dimen/vp_dp_24"
        android:layout_marginEnd="@dimen/vp_dp_16"
        app:layout_constraintStart_toEndOf="@+id/vp_guide_step3_volume"
        app:layout_constraintTop_toTopOf="@+id/vp_guide_step3_guide_line"
        style="@style/vp_guide_head_text_style"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:gravity="start"
        android:id="@+id/vp_guide_step3_description_tv"
        android:layout_marginTop="@dimen/vp_dp_8"
        android:layout_marginStart="@dimen/vp_dp_24"
        android:layout_marginEnd="@dimen/vp_dp_16"
        app:layout_constraintStart_toEndOf="@+id/vp_guide_step3_volume"
        app:layout_constraintTop_toBottomOf="@+id/vp_guide_step3_head_tv"
        style="@style/vp_guide_description_text_style"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/vp_guide_step3_btn"
        android:layout_marginLeft="@dimen/vp_dp_30"
        android:layout_marginRight="@dimen/vp_dp_30"
        android:layout_marginHorizontal="@dimen/vp_dp_30"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/vp_guide_step3_guide_line1"
        style="@style/vp_guide_button_text_style"/>
</androidx.constraintlayout.widget.ConstraintLayout>
