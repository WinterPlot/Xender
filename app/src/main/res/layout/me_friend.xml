<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/me_friend_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_medium"
        android:textColor="@color/txt_secondary"
        android:gravity="start|center_vertical"
        android:id="@+id/me_friend_header"
        android:background="@color/child_window_bg"
        android:paddingLeft="@dimen/x_dp_16"
        android:paddingRight="@dimen/x_dp_16"
        android:layout_width="match_parent"
        android:layout_height="@dimen/x_dp_40"
        android:text="@string/transfered_people_suffix"
        android:paddingHorizontal="@dimen/x_dp_16"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_medium"
        android:textColor="@color/primary"
        android:gravity="start|center_vertical"
        android:id="@+id/me_friend_clear"
        android:paddingLeft="@dimen/x_dp_16"
        android:paddingRight="@dimen/x_dp_16"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/x_dp_16"
        app:layout_constraintBottom_toBottomOf="@+id/me_friend_header"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/me_friend_header"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_large_greater"
        android:textColor="@color/txt_secondary"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/me_friend_none"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/x_dp_24"
        android:text="@string/no_connnect_records_string"
        android:drawableTop="@drawable/svg_me_no_record"
        android:drawablePadding="@dimen/x_dp_10"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/me_friend_header"/>
    <Space
        android:id="@+id/me_friend_space"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/x_dp_24"
        app:layout_constraintTop_toBottomOf="@+id/me_friend_none"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/me_friend_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="never"
        android:nestedScrollingEnabled="false"
        app:layout_constraintTop_toBottomOf="@+id/me_friend_header"/>
</androidx.constraintlayout.widget.ConstraintLayout>
