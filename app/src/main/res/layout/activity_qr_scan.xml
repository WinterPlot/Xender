<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/x_camera_scan_layout"
    android:tag="layout/activity_qr_scan_0"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:textDirection="locale"
    android:layoutDirection="locale">
    <com.userlabs.xshare.zxing.ViewfinderView
        android:id="@+id/viewfinder_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <SurfaceView
        android:id="@+id/capture_preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="vertical"
        android:id="@+id/camera_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.userlabs.xshare.views.CaptureBgView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:cb_rect_size="@dimen/camera_capture_size"
            app:cb_rect_top_margin="@dimen/camera_top_margin"/>
        <LinearLayout
            android:gravity="center_horizontal"
            android:id="@+id/capture_crop_layout"
            android:layout_width="@dimen/camera_capture_size"
            android:layout_height="@dimen/camera_capture_size"
            android:layout_marginTop="@dimen/camera_top_margin"
            android:contentDescription="@string/app_name"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/capture_scan_line"
                android:layout_width="match_parent"
                android:layout_height="@dimen/x_dp_56"
                android:layout_marginTop="-50dp"
                android:contentDescription="@string/app_name"/>
        </LinearLayout>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/xshare_text_size_large"
            android:textColor="@color/txt_white"
            android:gravity="center"
            android:id="@+id/android_o_bubble_tips"
            android:paddingTop="@dimen/x_dp_16"
            android:paddingBottom="@dimen/x_dp_16"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@+id/capture_crop_layout"
            style="@style/title_text_font_style"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/xshare_text_size_small"
            android:gravity="center"
            android:id="@+id/camera_scan_tips"
            android:padding="@dimen/x_dp_12"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/x_dp_24"
            android:layout_marginRight="@dimen/x_dp_24"
            android:layout_marginBottom="@dimen/x_dp_30"
            android:layout_marginHorizontal="@dimen/x_dp_24"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/flashlight_switch_btn"
            android:layout_width="@dimen/x_dp_50"
            android:layout_height="@dimen/x_dp_50"
            android:layout_marginBottom="@dimen/x_dp_40"
            android:scaleType="center"
            android:layout_centerHorizontal="true"
            app:layout_constraintBottom_toTopOf="@+id/camera_scan_tips"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_goneMarginBottom="@dimen/x_dp_80"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/back_btn"
            android:layout_width="@dimen/x_dp_48"
            android:layout_height="@dimen/x_dp_48"
            android:scaleType="center"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/camera_ios"
            android:visibility="gone"
            android:layout_width="@dimen/x_dp_48"
            android:layout_height="@dimen/x_dp_48"
            android:scaleType="center"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/xshare_text_size_large"
            android:textColor="@color/txt_white"
            android:gravity="center"
            android:id="@+id/connect_to_web_btn"
            android:paddingLeft="@dimen/x_dp_16"
            android:paddingRight="@dimen/x_dp_16"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/x_dp_40"
            android:layout_marginTop="@dimen/x_dp_16"
            android:drawablePadding="@dimen/x_dp_16"
            android:paddingHorizontal="@dimen/x_dp_16"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/back_btn"
            style="@style/title_text_font_style"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
