<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/selector_list_item"
    android:addStatesFromChildren="false"
    android:descendantFocusability="blocksDescendants"
    android:layout_width="match_parent"
    android:layout_height="@dimen/x_dp_80">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/root_file_icon"
        android:layout_width="@dimen/x_dp_56"
        android:layout_height="@dimen/x_dp_56"
        android:scaleType="center"
        android:layout_marginStart="@dimen/x_dp_16"
        android:tintMode="src_atop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="8sp"
        android:textColor="@color/txt_white"
        android:gravity="center"
        android:layout_gravity="end|top"
        android:id="@+id/root_has_offer_count_tv"
        android:background="@drawable/bg_red_oval"
        android:visibility="gone"
        android:layout_width="13dp"
        android:layout_height="13dp"
        android:scaleType="centerInside"
        app:layout_constraintEnd_toEndOf="@+id/root_file_icon"
        app:layout_constraintTop_toTopOf="@+id/root_file_icon"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/cx_sp_15"
        android:textColor="@color/txt_primary"
        android:gravity="start|center_vertical"
        android:id="@+id/root_title_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/x_dp_8"
        android:singleLine="true"
        android:layout_marginStart="@dimen/x_dp_12"
        app:layout_constraintStart_toEndOf="@+id/root_file_icon"
        app:layout_constraintTop_toTopOf="@+id/root_file_icon"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_smaller"
        android:textColor="@color/x_red"
        android:gravity="start|center_vertical"
        android:id="@+id/root_offer_apks_tips"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:text="@string/apk_not_install"
        android:singleLine="true"
        android:layout_marginStart="@dimen/x_dp_5"
        app:layout_constraintBottom_toBottomOf="@+id/root_title_tv"
        app:layout_constraintStart_toEndOf="@+id/root_title_tv"
        app:layout_constraintTop_toTopOf="@+id/root_title_tv"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_small"
        android:textColor="@color/txt_secondary"
        android:id="@+id/root_des_tv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/x_dp_8"
        android:singleLine="true"
        android:drawablePadding="4dp"
        android:layout_marginEnd="@dimen/x_dp_16"
        app:layout_constraintBottom_toBottomOf="@+id/root_file_icon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/root_title_tv"/>
</androidx.constraintlayout.widget.ConstraintLayout>
