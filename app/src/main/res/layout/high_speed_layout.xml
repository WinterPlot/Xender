<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/send_high_speed_line"
        android:background="@color/x_child_bg_line"
        android:layout_width="match_parent"
        android:layout_height="@dimen/x_dp_1"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/send_high_speed_iv"
        android:layout_width="@dimen/x_dp_24"
        android:layout_height="@dimen/x_dp_24"
        android:scaleType="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/send_high_speed_tv"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/send_high_speed_line"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_large"
        android:textColor="@color/primary"
        android:id="@+id/send_high_speed_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="@dimen/x_dp_8"
        android:layout_marginEnd="@dimen/x_dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/send_high_speed_sw"
        app:layout_constraintStart_toEndOf="@+id/send_high_speed_iv"
        app:layout_constraintTop_toBottomOf="@+id/send_high_speed_line"/>
    <com.userlabs.xshare.views.swbtn.SwitchButton
        android:id="@+id/send_high_speed_sw"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/send_high_speed_tv"
        app:layout_constraintTop_toBottomOf="@+id/send_high_speed_line"
        style="@style/MaterialDesign_settings_SwitchButton"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/high_speed_helper_iv"
        android:layout_width="@dimen/x_dp_24"
        android:layout_height="@dimen/x_dp_24"
        android:layout_marginLeft="@dimen/cx_dp_16"
        android:layout_marginRight="@dimen/cx_dp_16"
        android:layout_marginHorizontal="@dimen/cx_dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/send_high_speed_line"/>
</androidx.constraintlayout.widget.ConstraintLayout>
