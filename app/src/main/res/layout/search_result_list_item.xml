<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/sdcard_cate"
    android:background="@drawable/selector_list_item"
    android:addStatesFromChildren="false"
    android:descendantFocusability="blocksDescendants"
    android:layout_width="match_parent"
    android:layout_height="@dimen/x_dp_80">
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="center"
        android:id="@+id/search_icon_item"
        android:layout_width="@dimen/x_dp_56"
        android:layout_height="@dimen/x_dp_56"
        android:scaleType="fitXY"
        android:layout_marginStart="@dimen/x_dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/app_bundle_flag"
        android:layout_width="@dimen/x_dp_16"
        android:layout_height="@dimen/x_dp_16"
        android:scaleType="centerInside"
        app:layout_constraintBottom_toBottomOf="@+id/search_icon_item"
        app:layout_constraintEnd_toEndOf="@+id/search_icon_item"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_medium"
        android:textColor="@color/txt_primary"
        android:id="@+id/search_result_tv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/x_dp_16"
        android:layout_marginRight="@dimen/x_dp_16"
        android:singleLine="true"
        android:layout_marginHorizontal="@dimen/x_dp_16"
        app:layout_constraintBottom_toTopOf="@+id/search_size_item"
        app:layout_constraintEnd_toStartOf="@+id/search_click_item"
        app:layout_constraintStart_toEndOf="@+id/search_icon_item"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_small"
        android:textColor="@color/txt_secondary"
        android:gravity="center_vertical"
        android:id="@+id/search_size_item"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/x_dp_10"
        android:singleLine="true"
        android:drawablePadding="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/search_result_tv"
        app:layout_constraintStart_toStartOf="@+id/search_result_tv"
        app:layout_constraintTop_toBottomOf="@+id/search_result_tv"/>
    <LinearLayout
        android:id="@+id/search_click_item"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        app:layout_constraintEnd_toEndOf="parent">
        <com.userlabs.xshare.views.XCheckBox
            android:layout_gravity="center"
            android:id="@+id/cb_search_click_item"
            android:duplicateParentState="false"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_margin="14dp"
            android:scaleType="center"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
