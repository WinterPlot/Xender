<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="top|center_horizontal"
    android:padding="@dimen/x_dp_16"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_large"
        android:textColor="@color/x_red"
        android:gravity="center_vertical"
        android:id="@+id/tips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:drawablePadding="@dimen/x_dp_5"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_small"
        android:textColor="@color/txt_primary"
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/x_dp_16"
        android:text="@string/x_storage_location_private_dlg_content"
        app:layout_constraintTop_toBottomOf="@+id/tips"/>
    <androidx.appcompat.widget.AppCompatCheckBox
        android:textColor="#ff999999"
        android:id="@+id/cb"
        android:paddingLeft="@dimen/x_dp_5"
        android:paddingRight="@dimen/x_dp_5"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/x_dp_16"
        android:button="@drawable/selector_checkbox_normal"
        android:text="@string/not_show_next_time"
        android:paddingHorizontal="@dimen/x_dp_5"
        app:layout_constraintTop_toBottomOf="@+id/content"/>
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn"
        android:background="@drawable/btn_primary_round_corner"
        android:layout_width="match_parent"
        android:layout_height="@dimen/x_dp_36"
        android:layout_marginTop="@dimen/x_dp_16"
        android:text="@string/dlg_iknow"
        app:layout_constraintTop_toBottomOf="@+id/cb"
        style="@style/button_text_style_bold"/>
</androidx.constraintlayout.widget.ConstraintLayout>
