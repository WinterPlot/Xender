<?xml version="1.0" encoding="utf-8"?>
<com.userlabs.xshare.views.XConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/root"
    android:tag="layout/settings_profile_0"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:background="@color/primary"
        android:layout_width="match_parent"
        android:layout_height="@dimen/x_dp_48"
        android:tintMode="src_atop"
        app:contentInsetStartWithNavigation="0dp"
        app:popupTheme="@style/Theme.AppCompat.Light.DarkActionBar"
        app:titleTextAppearance="@style/toolbar_text_style_bold"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/my_avatar_iv"
        android:layout_width="@dimen/x_dp_80"
        android:layout_height="@dimen/x_dp_80"
        android:layout_marginTop="48dp"
        android:src="@drawable/x_profile_photo1"
        android:scaleType="fitXY"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"/>
    <androidx.appcompat.widget.AppCompatEditText
        android:textSize="@dimen/xshare_text_size_large"
        android:textColor="@color/txt_primary"
        android:textColorHint="@color/txt_secondary"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/profile_name_edit"
        android:background="@null"
        android:focusable="true"
        android:layout_width="140dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/x_dp_16"
        android:hint="@string/app_name"
        android:cursorVisible="false"
        android:maxLines="1"
        android:maxLength="12"
        android:inputType="textNoSuggestions"
        android:imeOptions="actionDone"
        android:textCursorDrawable="@null"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/my_avatar_iv"/>
    <View
        android:layout_gravity="center_horizontal"
        android:background="@color/x_line"
        android:layout_width="140dp"
        android:layout_height="1dp"
        android:layout_marginTop="5dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/profile_name_edit"/>
    <androidx.recyclerview.widget.RecyclerView
        android:layout_gravity="center_horizontal"
        android:id="@+id/profile_photo_list"
        android:layout_width="264dp"
        android:layout_height="148dp"
        android:layout_marginTop="@dimen/x_dp_16"
        android:scrollingCache="true"
        android:fastScrollEnabled="false"
        android:layoutDirection="locale"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/profile_name_edit"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guide_line"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintGuide_percent="0.5"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/profile_photo_list"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:gravity="center"
        android:id="@+id/profile_create_photo_from_camera"
        android:background="@drawable/btn_primary_round_corner"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="120dp"
        android:layout_height="@dimen/x_dp_48"
        android:layout_marginTop="28dp"
        android:text="@string/profile_create_photo_from_camera"
        android:layout_marginEnd="12dp"
        app:layout_constraintRight_toLeftOf="@+id/guide_line"
        app:layout_constraintTop_toBottomOf="@+id/profile_photo_list"
        style="@style/button_text_style_bold"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:gravity="center"
        android:id="@+id/profile_create_photo_from_album"
        android:background="@drawable/btn_primary_round_corner"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="120dp"
        android:layout_height="@dimen/x_dp_48"
        android:text="@string/profile_create_photo_from_album"
        android:layout_marginStart="12dp"
        app:layout_constraintLeft_toRightOf="@+id/guide_line"
        app:layout_constraintTop_toTopOf="@+id/profile_create_photo_from_camera"
        style="@style/button_text_style_bold"/>
</com.userlabs.xshare.views.XConstraintLayout>
