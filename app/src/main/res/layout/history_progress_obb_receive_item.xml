<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/obb_receive_history_progress_lay"
    android:layout_width="match_parent"
    android:layout_height="@dimen/x_dp_60">
    <ProgressBar
        android:id="@+id/obb_receive_history_progress_bar"
        android:background="@color/x_transparent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:max="100"
        android:progress="30"
        android:progressDrawable="@drawable/bg_progress_primary"
        style="?android:attr/progressBarStyleHorizontal"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/history_progress_item_file_icon_iv"
        android:layout_width="27dp"
        android:layout_height="27dp"
        android:layout_marginStart="@dimen/x_dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/history_item_file_icon_iv_style"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/obb_app_res"
        android:layout_width="14dp"
        android:layout_height="14dp"
        app:layout_constraintBottom_toBottomOf="@+id/history_progress_item_file_icon_iv"
        app:layout_constraintEnd_toEndOf="@+id/history_progress_item_file_icon_iv"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/obb_receive_history_progress_cancel_iv"
        android:background="?attr/actionBarItemBackground"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:scaleType="center"
        android:tint="@color/x_222_or_fff"
        android:layout_marginEnd="76dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_small"
        android:textColor="@color/txt_white"
        android:gravity="center"
        android:id="@+id/history_receive_progress_complete_opt_btn"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="@dimen/x_dp_66"
        android:layout_height="wrap_content"
        android:maxHeight="40dp"
        android:minHeight="@dimen/x_dp_26"
        android:singleLine="true"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="@dimen/x_dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/title_text_style_bold"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/history_obb_loading_btn"
        android:visibility="visible"
        android:layout_width="@dimen/x_dp_66"
        android:layout_height="22dp"
        android:scaleType="center"
        android:layout_marginEnd="@dimen/x_dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_small"
        android:textColor="@color/txt_primary"
        android:id="@+id/history_obb_name"
        android:layout_width="0dp"
        android:layout_marginStart="@dimen/x_dp_16"
        app:layout_constraintBottom_toTopOf="@+id/obb_receive_history_progress_item_file_size_tv"
        app:layout_constraintEnd_toStartOf="@+id/obb_receive_history_progress_cancel_iv"
        app:layout_constraintStart_toEndOf="@+id/history_progress_item_file_icon_iv"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_goneMarginEnd="92dp"
        style="@style/history_item_file_name_tv_style"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_small"
        android:textColor="@color/txt_secondary"
        android:ellipsize="middle"
        android:id="@+id/obb_receive_history_progress_item_file_size_tv"
        android:background="@null"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/x_dp_3"
        android:singleLine="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@+id/history_obb_name"
        app:layout_constraintTop_toBottomOf="@+id/history_obb_name"
        style="@style/title_text_font_style"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="10sp"
        android:textColor="@color/x_red"
        android:ellipsize="middle"
        android:gravity="start|bottom"
        android:id="@+id/obb_receive_history_progress_item_state_tv"
        android:background="@null"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/str_paused"
        android:singleLine="true"
        android:layout_marginStart="5dp"
        android:layout_marginEnd="5dp"
        app:layout_constraintBottom_toBottomOf="@+id/obb_receive_history_progress_item_file_size_tv"
        app:layout_constraintStart_toEndOf="@+id/obb_receive_history_progress_item_file_size_tv"
        style="@style/title_text_font_style"/>
</androidx.constraintlayout.widget.ConstraintLayout>
