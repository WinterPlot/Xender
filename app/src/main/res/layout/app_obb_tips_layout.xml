<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_obb_tips"
    android:layout_width="match_parent"
    android:layout_height="44dp"
    android:layout_margin="@dimen/ex_dp_16">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/obb_android_iv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/ex_dp_5"
        android:layout_marginRight="@dimen/ex_dp_5"
        android:src="@drawable/svg_obb_android"
        android:layout_marginHorizontal="@dimen/ex_dp_5"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@color/secondary"
        android:id="@+id/obb_add"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/ex_dp_5"
        android:layout_marginRight="@dimen/ex_dp_5"
        android:text="+"
        android:layout_marginHorizontal="@dimen/ex_dp_5"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/obb_android_iv"
        app:layout_constraintStart_toEndOf="@+id/obb_android_iv"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/obb_android_res"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/ex_dp_5"
        android:layout_marginRight="@dimen/ex_dp_5"
        android:src="@drawable/svg_obb_res"
        android:layout_marginHorizontal="@dimen/ex_dp_5"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/obb_add"
        app:layout_constraintStart_toEndOf="@+id/obb_add"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="12sp"
        android:textColor="@color/secondary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/cx_dp_10"
        android:layout_marginRight="@dimen/cx_dp_10"
        android:text="@string/app_tab_obb_tips"
        android:layout_marginHorizontal="@dimen/cx_dp_10"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/obb_info"
        app:layout_constraintStart_toEndOf="@+id/obb_android_res"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/obb_info"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_marginLeft="@dimen/ex_dp_5"
        android:layout_marginRight="@dimen/ex_dp_5"
        android:src="@drawable/svg_obb_info"
        android:layout_marginHorizontal="@dimen/ex_dp_5"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintLeft_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
