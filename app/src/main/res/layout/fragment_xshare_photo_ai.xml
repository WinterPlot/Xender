<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/fragment_xshare_photo_ai_0"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/photo_ai_toolbar"
        android:background="@color/primary"
        android:layout_width="match_parent"
        android:layout_height="@dimen/x_dp_48"
        android:tintMode="src_atop"
        app:contentInsetStartWithNavigation="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:popupTheme="@style/Theme.AppCompat.Light.DarkActionBar"
        app:titleTextAppearance="@style/toolbar_text_style_bold"/>
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/photo_ai_tabs"
        android:background="@color/primary"
        android:layout_width="match_parent"
        android:layout_height="@dimen/x_dp_40"
        app:layout_constraintTop_toBottomOf="@+id/photo_ai_toolbar"
        app:tabIndicator="@drawable/bg_tab_indicator_fixed"
        app:tabIndicatorColor="@color/tab_color_selected"
        app:tabIndicatorFullWidth="false"
        app:tabMode="fixed"
        app:tabSelectedTextColor="@color/tab_color_selected"
        app:tabTextColor="@color/tab_color_normal"/>
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/photo_ai_pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/photo_ai_tabs"/>
</androidx.constraintlayout.widget.ConstraintLayout>
