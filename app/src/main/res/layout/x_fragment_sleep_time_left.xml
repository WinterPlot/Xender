<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/x_fragment_sleep_time_left_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.AppCompatTextView
        android:gravity="center"
        android:id="@+id/x_title_tv"
        android:layout_width="match_parent"
        android:layout_height="@dimen/x_dp_56"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/BottomSheetDialog_Title"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/x_close_btn"
        android:layout_width="@dimen/x_dp_56"
        android:layout_height="@dimen/x_dp_56"
        android:scaleType="center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/x_222_or_fff"/>
    <View
        android:layout_width="match_parent"
        app:layout_constraintTop_toBottomOf="@+id/x_title_tv"
        style="@style/BottomSheetDialog_Line"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="48sp"
        android:textColor="@color/txt_primary"
        android:gravity="center"
        android:id="@+id/x_sleep_timer_left"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/x_dp_40"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/x_title_tv"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_medium"
        android:textColor="@color/primary"
        android:gravity="center"
        android:id="@+id/x_sleep_timer_add5"
        android:layout_width="0dp"
        android:layout_height="@dimen/x_dp_48"
        android:layout_marginLeft="@dimen/x_dp_60"
        android:layout_marginTop="@dimen/x_dp_40"
        android:layout_marginRight="@dimen/x_dp_60"
        android:layout_marginHorizontal="@dimen/x_dp_60"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/x_sleep_timer_left"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_medium"
        android:textColor="@color/txt_white"
        android:gravity="center"
        android:id="@+id/x_sleep_timer_cancel"
        android:layout_width="0dp"
        android:layout_height="@dimen/x_dp_48"
        android:layout_marginLeft="@dimen/x_dp_60"
        android:layout_marginTop="104dp"
        android:layout_marginRight="@dimen/x_dp_60"
        android:layout_marginHorizontal="@dimen/x_dp_60"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/x_sleep_timer_left"/>
</androidx.constraintlayout.widget.ConstraintLayout>
