<?xml version="1.0" encoding="utf-8"?>
<com.userlabs.xshare.views.XConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/app_window_bg"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include layout="@layout/ex_toolbar"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/ex_wait_old_phone_step1"
        android:background="@drawable/ex_bg_window_2_color_corner_10"
        android:padding="@dimen/ex_dp_16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/ex_dp_16"
        app:layout_constraintTop_toBottomOf="@+id/toolbar">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/cx_sp_12"
            android:textColor="@color/app_window_bg"
            android:gravity="center"
            android:background="@drawable/ex_bg_primary"
            android:layout_width="@dimen/ex_dp_20"
            android:layout_height="@dimen/ex_dp_20"
            android:text="@string/ex_step1"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/xshare_text_size_medium"
            android:textColor="@color/txt_primary"
            android:id="@+id/new_phone_created_tv_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/ex_dp_16"
            android:layout_marginRight="@dimen/ex_dp_16"
            android:text="@string/wait_old_phone_join_text_1"
            android:layout_marginHorizontal="@dimen/ex_dp_16"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/ex_wait_old_phone_step2"
        android:background="@drawable/ex_bg_window_2_color_corner_10"
        android:padding="@dimen/ex_dp_16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/ex_dp_16"
        app:layout_constraintTop_toBottomOf="@+id/ex_wait_old_phone_step1">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/cx_sp_12"
            android:textColor="@color/app_window_bg"
            android:gravity="center"
            android:background="@drawable/ex_bg_primary"
            android:layout_width="@dimen/ex_dp_20"
            android:layout_height="@dimen/ex_dp_20"
            android:text="@string/ex_step2"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/xshare_text_size_medium"
            android:textColor="@color/txt_primary"
            android:id="@+id/new_phone_created_tv_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/ex_dp_16"
            android:layout_marginRight="@dimen/ex_dp_16"
            android:text="@string/wait_old_phone_join_text_2"
            android:layout_below="@+id/new_phone_created_tv_1"
            android:layout_marginHorizontal="@dimen/ex_dp_16"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/ex_wait_old_phone_step3"
        android:background="@drawable/ex_bg_window_2_color_corner_10"
        android:padding="@dimen/ex_dp_16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/ex_dp_16"
        app:layout_constraintTop_toBottomOf="@+id/ex_wait_old_phone_step2">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/cx_sp_12"
            android:textColor="@color/app_window_bg"
            android:gravity="center"
            android:background="@drawable/ex_bg_primary"
            android:layout_width="@dimen/ex_dp_20"
            android:layout_height="@dimen/ex_dp_20"
            android:text="@string/ex_step3"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/xshare_text_size_medium"
            android:textColor="@color/txt_primary"
            android:id="@+id/new_phone_created_tv_3"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:layout_marginLeft="@dimen/ex_dp_16"
            android:layout_marginRight="@dimen/ex_dp_16"
            android:text="@string/wait_old_phone_join_text_3"
            android:layout_below="@+id/new_phone_created_tv_2"
            android:layout_marginHorizontal="@dimen/ex_dp_16"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="horizontal"
        android:id="@+id/ex_wait_old_phone_step4"
        android:background="@drawable/ex_bg_window_2_color_corner_10"
        android:padding="@dimen/ex_dp_16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/ex_dp_16"
        app:layout_constraintTop_toBottomOf="@+id/ex_wait_old_phone_step3">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/cx_sp_12"
            android:textColor="@color/app_window_bg"
            android:gravity="center"
            android:background="@drawable/ex_bg_primary"
            android:layout_width="@dimen/ex_dp_20"
            android:layout_height="@dimen/ex_dp_20"
            android:text="@string/ex_step4"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/xshare_text_size_medium"
            android:textColor="@color/txt_primary"
            android:id="@+id/new_phone_created_tv_4"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:layout_marginLeft="@dimen/ex_dp_16"
            android:layout_marginRight="@dimen/ex_dp_16"
            android:text="@string/wait_old_phone_join_text_4"
            android:layout_below="@+id/new_phone_created_tv_3"
            android:layout_marginHorizontal="@dimen/ex_dp_16"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <androidx.cardview.widget.CardView
        android:id="@+id/ex_wait_old_phone_step5"
        android:layout_width="@dimen/ex_new_phone_qr_weight"
        android:layout_height="@dimen/ex_new_phone_qr_height"
        android:layout_marginTop="@dimen/ex_dp_30"
        app:cardCornerRadius="@dimen/ex_dp_16"
        app:cardElevation="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ex_wait_old_phone_step4">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/android_o_ap_qr_code"
            android:layout_width="@dimen/ex_new_phone_qr_size"
            android:layout_height="@dimen/ex_new_phone_qr_size"
            android:layout_marginTop="@dimen/ex_dp_20"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/xshare_text_size_medium"
            android:textColor="@color/txt_primary"
            android:gravity="center"
            android:layout_gravity="bottom"
            android:id="@+id/ssid_name"
            android:layout_width="match_parent"
            android:layout_height="@dimen/ex_new_phone_name_size"
            android:layout_marginLeft="@dimen/ex_dp_16"
            android:layout_marginRight="@dimen/ex_dp_16"
            android:maxLines="2"
            android:layout_marginHorizontal="@dimen/ex_dp_16"/>
    </androidx.cardview.widget.CardView>
</com.userlabs.xshare.views.XConstraintLayout>
