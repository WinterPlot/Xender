<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:id="@+id/ll_video_header"
    android:background="@color/child_window_bg"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="@dimen/x_dp_40"
    android:textDirection="locale"
    android:layoutDirection="locale"
    app:slm_headerDisplay="sticky|inline"
    app:slm_isHeader="true">
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_small"
        android:textColor="@color/txt_secondary"
        android:gravity="start|center_vertical"
        android:id="@+id/text1"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:singleLine="true"
        android:layout_marginStart="@dimen/x_dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/header_check"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/title_text_style_bold"/>
    <com.userlabs.xshare.views.XCheckBox
        android:id="@+id/header_check"
        android:layout_width="52dp"
        android:layout_height="match_parent"
        android:scaleType="center"
        app:layout_constraintEnd_toEndOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/sys_header_check"
        android:visibility="gone"
        android:clickable="false"
        android:layout_width="@dimen/x_dp_52"
        android:layout_height="match_parent"
        android:scaleType="center"
        android:tintMode="src_atop"
        app:layout_constraintEnd_toEndOf="parent"
        app:tint="@color/x_blank_color"/>
</androidx.constraintlayout.widget.ConstraintLayout>
