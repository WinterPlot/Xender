<?xml version="1.0" encoding="utf-8"?>
<com.userlabs.xshare.views.bottombar.SelectActionLinear xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:layout_gravity="bottom"
    android:orientation="horizontal"
    android:focusable="true"
    android:visibility="gone"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="@dimen/x_dp_54">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/select_action_button_cancel"
        android:background="?attr/selectableItemBackground"
        android:layout_width="@dimen/x_dp_54"
        android:layout_height="match_parent"
        android:src="@drawable/svg_ic_cancel"
        android:scaleType="center"
        android:tint="@color/x_222_or_fff"/>
    <View
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_weight="1"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/select_action_button_send"
        android:background="@drawable/btn_primary_round_corner"
        android:layout_width="@dimen/x_dp_170"
        android:layout_height="@dimen/x_dp_40"
        android:text="@string/messenger_send"
        android:singleLine="true"
        style="@style/button_text_style_bold"/>
    <View
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_weight="1"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/select_action_button_delete"
        android:background="?attr/selectableItemBackground"
        android:layout_width="@dimen/x_dp_54"
        android:layout_height="match_parent"
        android:layout_margin="1dp"
        android:src="@drawable/svg_ic_delete"
        android:scaleType="center"
        android:tint="@color/x_222_or_fff"/>
</com.userlabs.xshare.views.bottombar.SelectActionLinear>
