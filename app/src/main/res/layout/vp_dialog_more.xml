<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/vp_dialog_more_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="center"
        android:id="@+id/vp_more_top"
        android:layout_width="@dimen/vp_dp_45"
        android:layout_height="@dimen/vp_dp_4"
        android:layout_marginTop="@dimen/vp_dp_5"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:gravity="start|center_vertical"
        android:id="@+id/vp_more_lock"
        android:layout_width="match_parent"
        android:layout_marginTop="@dimen/vp_dp_16"
        app:layout_constraintTop_toBottomOf="@+id/vp_more_top"
        style="@style/vp_BottomSheetDialog_Text"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:gravity="start|center_vertical"
        android:id="@+id/vp_more_mute"
        android:layout_width="match_parent"
        app:layout_constraintTop_toBottomOf="@+id/vp_more_lock"
        style="@style/vp_BottomSheetDialog_Text"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:gravity="start|center_vertical"
        android:id="@+id/vp_more_playback_speed"
        android:layout_width="match_parent"
        app:layout_constraintTop_toBottomOf="@+id/vp_more_mute"
        style="@style/vp_BottomSheetDialog_Text"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/vp_sp_15"
        android:textColor="@color/vp_primary"
        android:gravity="start|center_vertical"
        android:layout_gravity="center"
        android:id="@+id/vp_current_speed_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/vp_dp_16"
        app:layout_constraintBottom_toBottomOf="@+id/vp_more_playback_speed"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/vp_more_playback_speed"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:gravity="start|center_vertical"
        android:id="@+id/vp_more_sleep"
        android:layout_width="match_parent"
        app:layout_constraintTop_toBottomOf="@+id/vp_more_playback_speed"
        style="@style/vp_BottomSheetDialog_Text"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/vp_sp_16"
        android:textColor="@color/vp_primary"
        android:gravity="start|center_vertical"
        android:layout_gravity="center"
        android:id="@+id/vp_more_sleep_current"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/vp_dp_16"
        app:layout_constraintBottom_toBottomOf="@+id/vp_more_sleep"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/vp_more_sleep"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:gravity="start|center_vertical"
        android:id="@+id/vp_more_pop"
        android:layout_width="match_parent"
        app:layout_constraintTop_toBottomOf="@+id/vp_more_sleep"
        style="@style/vp_BottomSheetDialog_Text"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/vp_sp_15"
        android:gravity="start|center_vertical"
        android:id="@+id/vp_more_settings"
        android:layout_width="match_parent"
        app:layout_constraintTop_toBottomOf="@+id/vp_more_pop"
        style="@style/vp_BottomSheetDialog_Text"/>
</androidx.constraintlayout.widget.ConstraintLayout>
