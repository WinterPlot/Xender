<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/x_scan_same_wifi_tips_layout"
    android:background="@drawable/bg_window_2_color_top_corner_20"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:textDirection="locale"
    android:layoutDirection="locale">
    <View
        android:id="@+id/top_select_line"
        android:layout_width="@dimen/x_dp_45"
        android:layout_height="@dimen/x_dp_4"
        android:layout_marginTop="@dimen/x_dp_5"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/x_scan_wifi_iv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/x_dp_36"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/top_select_line"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_large"
        android:textColor="@color/x_red"
        android:gravity="start|center_vertical"
        android:id="@+id/x_scan_wifi_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/x_dp_20"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="@dimen/x_dp_16"
        android:layout_marginEnd="@dimen/x_dp_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/x_scan_wifi_iv"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/x_scan_wifi_tips1_dot"
        android:layout_width="3dp"
        android:layout_height="3dp"
        android:layout_marginStart="@dimen/cx_dp_20"
        app:layout_constraintBottom_toBottomOf="@+id/x_scan_wifi_tips1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/x_scan_wifi_tips1"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_medium"
        android:textColor="@color/x_222_or_fff"
        android:gravity="start"
        android:id="@+id/x_scan_wifi_tips1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/x_dp_14"
        android:layout_marginStart="@dimen/x_dp_5"
        android:layout_marginEnd="@dimen/x_dp_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/x_scan_wifi_tips1_dot"
        app:layout_constraintTop_toBottomOf="@+id/x_scan_wifi_tv"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/x_scan_wifi_tips2_dot"
        android:layout_width="3dp"
        android:layout_height="3dp"
        android:layout_marginStart="@dimen/cx_dp_20"
        app:layout_constraintBottom_toBottomOf="@+id/x_scan_wifi_tips2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/x_scan_wifi_tips2"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_medium"
        android:textColor="@color/x_222_or_fff"
        android:gravity="start"
        android:id="@+id/x_scan_wifi_tips2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/x_dp_14"
        android:layout_marginStart="@dimen/x_dp_5"
        android:layout_marginEnd="@dimen/x_dp_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/x_scan_wifi_tips1_dot"
        app:layout_constraintTop_toBottomOf="@+id/x_scan_wifi_tips1"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@color/txt_white"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/x_scan_wifi_setup"
        android:layout_width="match_parent"
        android:layout_height="@dimen/x_dp_48"
        android:layout_marginTop="@dimen/x_dp_40"
        android:layout_marginStart="@dimen/x_dp_68"
        android:layout_marginEnd="@dimen/x_dp_68"
        app:layout_constraintBottom_toTopOf="@+id/x_scan_wifi_setup_space"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/x_scan_wifi_tips2"
        style="@style/button_text_style_bold"/>
    <Space
        android:id="@+id/x_scan_wifi_setup_space"
        android:layout_width="match_parent"
        android:layout_height="@dimen/x_dp_24"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
