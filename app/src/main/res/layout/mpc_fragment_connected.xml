<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/mpc_fragment_connected_0"
    android:background="@color/mpc_main_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/mpc_sp_14"
        android:textStyle="normal"
        android:textColor="@color/mpc_color_secondary"
        android:gravity="center"
        android:id="@+id/connected_status_tv"
        android:layout_width="match_parent"
        android:layout_height="@dimen/mpc_dp_50"
        android:fontFamily="sans-serif"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/flag_iv"
        android:layout_width="@dimen/mpc_dp_130"
        android:layout_height="@dimen/mpc_dp_40"
        android:layout_marginTop="@dimen/mpc_dp_30"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/connected_status_tv"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/file_format_list"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="@dimen/mpc_dp_150"
        android:layout_marginLeft="@dimen/mpc_dp_16"
        android:layout_marginTop="@dimen/mpc_dp_40"
        android:layout_marginRight="@dimen/mpc_dp_16"
        android:layout_marginHorizontal="@dimen/mpc_dp_16"
        app:layout_constraintTop_toBottomOf="@+id/flag_iv"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/mpc_sp_14"
        android:textStyle="normal"
        android:textColor="@color/mpc_txt_primary"
        android:gravity="center"
        android:id="@+id/update_des_tv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/mpc_dp_16"
        android:layout_marginTop="@dimen/mpc_dp_50"
        android:layout_marginRight="@dimen/mpc_dp_16"
        android:lineSpacingMultiplier="1.3"
        android:fontFamily="sans-serif"
        android:layout_marginHorizontal="@dimen/mpc_dp_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/file_format_list"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/mpc_sp_14"
        android:textStyle="normal"
        android:textColor="@color/x_red"
        android:gravity="center"
        android:id="@+id/close_connection_btn"
        android:layout_width="match_parent"
        android:layout_height="@dimen/mpc_dp_40"
        android:layout_marginLeft="@dimen/mpc_dp_30"
        android:layout_marginRight="@dimen/mpc_dp_30"
        android:layout_marginBottom="@dimen/mpc_dp_30"
        android:fontFamily="sans-serif"
        android:layout_marginHorizontal="@dimen/mpc_dp_30"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/close_connection_icon"
        android:clickable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/mpc_dp_10"
        app:layout_constraintBottom_toBottomOf="@+id/close_connection_btn"
        app:layout_constraintStart_toStartOf="@+id/close_connection_btn"
        app:layout_constraintTop_toTopOf="@+id/close_connection_btn"/>
</androidx.constraintlayout.widget.ConstraintLayout>
