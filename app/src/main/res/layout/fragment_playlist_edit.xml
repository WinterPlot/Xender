<?xml version="1.0" encoding="utf-8"?>
<com.userlabs.xshare.views.XLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/x_pl_toolbar"
        android:background="@color/primary"
        android:layout_width="match_parent"
        android:layout_height="@dimen/x_dp_48"
        app:contentInsetStartWithNavigation="0dp"
        app:popupTheme="@style/Theme.AppCompat.Light.DarkActionBar"
        app:titleTextAppearance="@style/toolbar_text_style_bold">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/xshare_text_size_large"
            android:textColor="@color/txt_white"
            android:layout_gravity="end"
            android:id="@+id/x_pl_save"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/x_dp_16"
            android:layout_marginRight="@dimen/x_dp_16"
            android:text="@string/slide_image_save"
            android:layout_marginHorizontal="@dimen/x_dp_16"
            style="@style/text_style_bold"/>
    </androidx.appcompat.widget.Toolbar>
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="center"
        android:id="@+id/x_pl_edit_iv"
        android:layout_width="@dimen/x_dp_120"
        android:layout_height="@dimen/x_dp_120"
        android:layout_marginTop="@dimen/x_dp_30"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_small"
        android:textColor="@color/txt_primary"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/x_pl_edit_change_iv"
        android:background="@drawable/bg_line_round_corner"
        android:paddingLeft="@dimen/x_dp_16"
        android:paddingRight="@dimen/x_dp_16"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/x_dp_26"
        android:layout_marginTop="@dimen/x_dp_26"
        android:text="@string/x_play_list_edit_change_iv"
        android:paddingHorizontal="@dimen/x_dp_16"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_small"
        android:textColor="@color/txt_primary"
        android:gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/x_dp_16"
        android:layout_marginTop="@dimen/x_dp_40"
        android:layout_marginRight="@dimen/x_dp_16"
        android:text="@string/x_play_list_edit_name"
        android:layout_marginHorizontal="@dimen/x_dp_16"/>
    <androidx.appcompat.widget.AppCompatEditText
        android:theme="@style/MyUserEditText"
        android:textSize="@dimen/xshare_text_size_large"
        android:textColor="@color/txt_primary"
        android:textColorHint="@color/txt_secondary"
        android:gravity="start"
        android:layout_gravity="center_horizontal"
        android:id="@+id/x_pl_edit_change_name"
        android:focusable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/x_dp_16"
        android:layout_marginTop="@dimen/x_dp_12"
        android:layout_marginRight="@dimen/x_dp_16"
        android:hint="@string/x_play_list_edit_hint"
        android:maxLength="50"
        android:inputType="textNoSuggestions"
        android:textCursorDrawable="@null"
        android:layout_marginHorizontal="@dimen/x_dp_16"/>
</com.userlabs.xshare.views.XLinearLayout>
