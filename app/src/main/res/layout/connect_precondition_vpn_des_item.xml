<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="8sp"
        android:textColor="@color/txt_secondary"
        android:gravity="center"
        android:id="@+id/condition_des_setup1"
        android:layout_width="@dimen/cx_dp_12"
        android:layout_height="@dimen/cx_dp_12"
        android:layout_marginStart="@dimen/cx_dp_40"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_smaller"
        android:textColor="@color/txt_primary"
        android:gravity="start|center_vertical"
        android:id="@+id/condition_des_setup1_bold_tv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/cx_dp_5"
        app:layout_constraintBottom_toBottomOf="@+id/condition_des_setup1"
        app:layout_constraintStart_toEndOf="@+id/condition_des_setup1"
        app:layout_constraintTop_toTopOf="@+id/condition_des_setup1"
        style="@style/bold_text_style"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_smaller"
        android:textColor="@color/txt_secondary"
        android:gravity="start|center_vertical"
        android:id="@+id/condition_des_setup1_tv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/condition_des_setup1"
        app:layout_constraintStart_toEndOf="@+id/condition_des_setup1_bold_tv"
        app:layout_constraintTop_toTopOf="@+id/condition_des_setup1"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/condition_des_iv1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:scaleType="centerInside"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/condition_des_setup1"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="8sp"
        android:textColor="@color/txt_secondary"
        android:gravity="center"
        android:id="@+id/condition_des_setup2"
        android:layout_width="@dimen/cx_dp_12"
        android:layout_height="@dimen/cx_dp_12"
        android:layout_marginTop="@dimen/cx_dp_5"
        android:layout_marginStart="@dimen/cx_dp_40"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/condition_des_iv1"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_smaller"
        android:textColor="@color/txt_primary"
        android:gravity="start|center_vertical"
        android:id="@+id/condition_des_setup2_bold_tv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/cx_dp_5"
        app:layout_constraintBottom_toBottomOf="@+id/condition_des_setup2"
        app:layout_constraintStart_toEndOf="@+id/condition_des_setup2"
        app:layout_constraintTop_toTopOf="@+id/condition_des_setup2"
        style="@style/bold_text_style"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_smaller"
        android:textColor="@color/txt_secondary"
        android:gravity="start|center_vertical"
        android:id="@+id/condition_des_setup2_tv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/condition_des_setup2"
        app:layout_constraintStart_toEndOf="@+id/condition_des_setup2_bold_tv"
        app:layout_constraintTop_toTopOf="@+id/condition_des_setup2"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/condition_des_iv2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:scaleType="centerInside"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/condition_des_setup2"/>
</androidx.constraintlayout.widget.ConstraintLayout>
