<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/x_player_setting_layout"
    android:background="@drawable/bg_window_1_color_top_corner_20"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:textDirection="locale"
    android:layoutDirection="locale">
    <View
        android:id="@+id/top_select_line"
        android:background="@drawable/bg_dlg_top_handle"
        android:layout_width="@dimen/x_dp_45"
        android:layout_height="@dimen/x_dp_4"
        android:layout_marginTop="@dimen/x_dp_5"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:gravity="start|center_vertical"
        android:id="@+id/music_eq"
        android:layout_width="match_parent"
        android:layout_marginTop="@dimen/x_dp_16"
        android:text="@string/equalizer_title"
        app:layout_constraintTop_toBottomOf="@+id/top_select_line"
        style="@style/BottomSheetDialog_Text"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:gravity="start|center_vertical"
        android:id="@+id/music_speed"
        android:layout_width="match_parent"
        android:text="@string/play_speed"
        app:layout_constraintTop_toBottomOf="@+id/music_eq"
        style="@style/BottomSheetDialog_Text"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_large"
        android:textColor="@color/primary"
        android:gravity="start|center_vertical"
        android:layout_gravity="center"
        android:id="@+id/current_speed_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/x_dp_16"
        app:layout_constraintBottom_toBottomOf="@+id/music_speed"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/music_speed"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:gravity="start|center_vertical"
        android:id="@+id/music_pitch"
        android:layout_width="match_parent"
        android:text="@string/play_pitch"
        app:layout_constraintTop_toBottomOf="@+id/music_speed"
        style="@style/BottomSheetDialog_Text"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_large"
        android:textColor="@color/primary"
        android:gravity="start|center_vertical"
        android:layout_gravity="center"
        android:id="@+id/current_pitch_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/x_dp_16"
        app:layout_constraintBottom_toBottomOf="@+id/music_pitch"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/music_pitch"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:gravity="start|center_vertical"
        android:id="@+id/music_sleep"
        android:layout_width="match_parent"
        android:text="@string/sleep_timer"
        app:layout_constraintTop_toBottomOf="@+id/music_pitch"
        style="@style/BottomSheetDialog_Text"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_large"
        android:textColor="@color/primary"
        android:gravity="start|center_vertical"
        android:layout_gravity="center"
        android:id="@+id/sleep_time_left"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/x_dp_16"
        app:layout_constraintBottom_toBottomOf="@+id/music_sleep"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/music_sleep"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:gravity="start|center_vertical"
        android:id="@+id/add_playlist_tv"
        android:layout_width="match_parent"
        android:text="@string/x_play_list_add_to"
        app:layout_constraintTop_toBottomOf="@+id/music_sleep"
        style="@style/BottomSheetDialog_Text"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:gravity="start|center_vertical"
        android:id="@+id/music_edit"
        android:layout_width="match_parent"
        android:text="@string/x_music_edit_info"
        app:layout_constraintTop_toBottomOf="@+id/add_playlist_tv"
        style="@style/BottomSheetDialog_Text"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:gravity="start|center_vertical"
        android:id="@+id/as_ringtone_tv"
        android:layout_width="match_parent"
        android:text="@string/x_play_list_ringtone"
        app:layout_constraintTop_toBottomOf="@+id/music_edit"
        style="@style/BottomSheetDialog_Text"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:gravity="start|center_vertical"
        android:id="@+id/music_setting"
        android:layout_width="match_parent"
        android:text="@string/menu_settings"
        app:layout_constraintTop_toBottomOf="@+id/as_ringtone_tv"
        style="@style/BottomSheetDialog_Text"/>
</androidx.constraintlayout.widget.ConstraintLayout>
