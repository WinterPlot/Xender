<?xml version="1.0" encoding="utf-8"?>
<com.userlabs.xshare.views.XConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:textDirection="locale"
    android:layoutDirection="locale">
    <include
        android:id="@+id/toolbar"
        layout="@layout/toolbar"/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:orientation="vertical"
            android:paddingLeft="@dimen/x_dp_16"
            android:paddingRight="@dimen/x_dp_16"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/x_dp_16">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/xshare_text_size_large"
                android:textColor="@color/txt_primary"
                android:id="@+id/tv_bluetooth_first_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/x_dp_16"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/title_text_font_style"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/xshare_text_size_large"
                android:textColor="@color/txt_primary"
                android:gravity="center_vertical"
                android:id="@+id/tv_bluetooth_first_step1"
                android:paddingLeft="@dimen/x_dp_16"
                android:paddingRight="@dimen/x_dp_16"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginLeft="@dimen/x_dp_16"
                android:layout_marginTop="@dimen/x_dp_16"
                android:layout_marginRight="@dimen/x_dp_16"
                android:text="@string/bluetooth_str"
                android:drawableEnd="@drawable/cx_svg_switch"
                android:paddingStart="@dimen/x_dp_16"
                android:paddingEnd="@dimen/x_dp_16"
                app:layout_constraintTop_toBottomOf="@+id/tv_bluetooth_first_title"
                style="@style/title_text_font_style"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/xshare_text_size_large"
                android:textColor="@color/txt_primary"
                android:gravity="center_vertical"
                android:id="@+id/tv_bluetooth_first_step2"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginLeft="@dimen/x_dp_16"
                android:layout_marginTop="10dp"
                android:layout_marginRight="@dimen/x_dp_16"
                android:text="@string/bluetooth_discoverable"
                android:drawableEnd="@drawable/cx_svg_switch"
                android:paddingStart="@dimen/x_dp_16"
                android:paddingEnd="@dimen/x_dp_16"
                app:layout_constraintTop_toBottomOf="@+id/tv_bluetooth_first_step1"
                style="@style/title_text_font_style"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="46dp"
                android:src="@drawable/x_ic_setting_grant"
                android:layout_marginEnd="22dp"
                app:layout_constraintBottom_toBottomOf="@+id/tv_bluetooth_first_step1"
                app:layout_constraintEnd_toEndOf="@+id/tv_bluetooth_first_step1"
                app:layout_constraintTop_toTopOf="@+id/tv_bluetooth_first_step1"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/xshare_text_size_large"
                android:textColor="@color/txt_primary"
                android:id="@+id/tv_bluetooth_second_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/x_dp_16"
                app:layout_constraintTop_toBottomOf="@+id/tv_bluetooth_first_step2"
                style="@style/title_text_font_style"/>
            <androidx.appcompat.widget.AppCompatButton
                android:gravity="center"
                android:id="@+id/bluetooth_send_btn"
                android:background="@drawable/btn_primary_round_corner"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="@dimen/x_dp_48"
                android:layout_marginTop="@dimen/x_dp_16"
                android:layout_marginBottom="@dimen/x_dp_16"
                android:text="@string/bluetooth_scan_and_send"
                android:layout_marginVertical="@dimen/x_dp_16"
                app:layout_constraintTop_toBottomOf="@+id/tv_bluetooth_second_title"
                style="@style/button_text_style_bold"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/bl_failed_des_iv"
                android:layout_width="@dimen/x_dp_60"
                android:layout_height="@dimen/x_dp_60"
                android:layout_marginTop="@dimen/x_dp_16"
                android:src="@drawable/svg_warning"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/bluetooth_send_btn"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/xshare_text_size_large"
                android:textColor="@color/x_red"
                android:layout_gravity="center_horizontal"
                android:id="@+id/bl_failed_des_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/x_dp_16"
                android:text="@string/bluetooth_share_failed_warning"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/bl_failed_des_iv"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textColor="@color/txt_white"
                android:gravity="center"
                android:id="@+id/btn_hotspot_send"
                android:background="@drawable/btn_secondary_round_corner"
                android:paddingLeft="@dimen/x_dp_16"
                android:paddingRight="@dimen/x_dp_16"
                android:layout_width="match_parent"
                android:layout_height="@dimen/x_dp_48"
                android:layout_marginTop="@dimen/x_dp_16"
                android:text="@string/bluetooth_share_failed_warning_btn_str"
                android:singleLine="true"
                android:paddingHorizontal="@dimen/x_dp_16"
                app:drawableStartCompat="@drawable/svg_share_hotspot"
                app:layout_constraintTop_toBottomOf="@+id/bl_failed_des_tv"
                style="@style/button_text_style_bold"/>
            <androidx.constraintlayout.widget.Group
                android:id="@+id/bl_send_failed_area"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:constraint_referenced_ids="btn_hotspot_send,bl_failed_des_tv,bl_failed_des_iv"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</com.userlabs.xshare.views.XConstraintLayout>
