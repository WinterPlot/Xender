<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:id="@+id/send_create_success_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/create_qr_line_bg_view"
        android:layout_width="match_parent"
        android:layout_height="@dimen/x_dp_360"
        android:layout_marginLeft="@dimen/x_dp_30"
        android:layout_marginRight="@dimen/x_dp_30"
        android:layout_marginHorizontal="@dimen/x_dp_30"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/send_qr_view"
        android:layout_width="@dimen/x_dp_240"
        android:layout_height="@dimen/x_dp_240"
        android:layout_marginTop="33dp"
        app:layout_constraintEnd_toEndOf="@+id/create_qr_line_bg_view"
        app:layout_constraintStart_toStartOf="@+id/create_qr_line_bg_view"
        app:layout_constraintTop_toTopOf="@+id/create_qr_line_bg_view"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/send_qr_avatar"
        android:layout_width="@dimen/x_dp_16"
        android:layout_height="@dimen/x_dp_16"
        android:layout_marginTop="@dimen/x_dp_10"
        android:layout_marginEnd="@dimen/x_dp_5"
        app:layout_constraintEnd_toStartOf="@+id/send_qr_tv"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/send_qr_view"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_large"
        android:textColor="@color/primary"
        android:id="@+id/send_qr_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/send_qr_avatar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/send_qr_avatar"
        app:layout_constraintTop_toTopOf="@+id/send_qr_avatar"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_large"
        android:textColor="@color/txt_primary"
        android:id="@+id/send_qr_state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/x_dp_10"
        app:layout_constraintEnd_toEndOf="@+id/create_qr_line_bg_view"
        app:layout_constraintStart_toStartOf="@+id/create_qr_line_bg_view"
        app:layout_constraintTop_toBottomOf="@+id/send_qr_avatar"/>
</androidx.constraintlayout.widget.ConstraintLayout>
