<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/selector_mp_list_item"
    android:layout_width="match_parent"
    android:layout_height="88dp">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/xm_playing_list_iv"
        android:layout_width="@dimen/x_dp_56"
        android:layout_height="@dimen/x_dp_56"
        android:layout_marginLeft="@dimen/x_dp_16"
        android:layout_marginRight="@dimen/x_dp_16"
        android:layout_marginHorizontal="@dimen/x_dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/xm_playing_item_iv"
        android:layout_width="@dimen/x_dp_16"
        android:layout_height="@dimen/x_dp_16"
        android:layout_margin="@dimen/x_dp_5"
        android:layout_marginStart="@dimen/x_dp_16"
        app:layout_constraintBottom_toBottomOf="@+id/xm_playing_list_iv"
        app:layout_constraintEnd_toEndOf="@+id/xm_playing_list_iv"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_large"
        android:textColor="#ffffff"
        android:ellipsize="marquee"
        android:gravity="start|center_vertical"
        android:id="@+id/xm_playing_list_title"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:singleLine="true"
        android:layout_marginStart="@dimen/x_dp_16"
        app:layout_constraintBottom_toTopOf="@+id/xm_playing_list_artist"
        app:layout_constraintEnd_toStartOf="@+id/playlist_delete"
        app:layout_constraintStart_toEndOf="@+id/xm_playing_list_iv"
        app:layout_constraintTop_toTopOf="@+id/xm_playing_list_iv"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_medium"
        android:textColor="#b3ffffff"
        android:ellipsize="marquee"
        android:gravity="start|center_vertical"
        android:id="@+id/xm_playing_list_artist"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:singleLine="true"
        android:layout_marginStart="@dimen/x_dp_16"
        app:layout_constraintBottom_toBottomOf="@+id/xm_playing_list_iv"
        app:layout_constraintEnd_toStartOf="@+id/playlist_delete"
        app:layout_constraintStart_toEndOf="@+id/xm_playing_list_iv"
        app:layout_constraintTop_toBottomOf="@+id/xm_playing_list_title"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/playlist_delete"
        android:background="?attr/selectableItemBackground"
        android:layout_width="@dimen/x_dp_40"
        android:layout_height="match_parent"
        android:src="@drawable/svg_playlist_delete_icon"
        android:scaleType="center"
        app:layout_constraintEnd_toStartOf="@+id/playlist_change_sort"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/playlist_change_sort"
        android:background="?attr/selectableItemBackground"
        android:layout_width="@dimen/x_dp_40"
        android:layout_height="match_parent"
        android:src="@drawable/svg_playlist_change_sort"
        android:scaleType="center"
        app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
