<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/audio_list_item_layer"
    android:paddingTop="@dimen/x_dp_32"
    android:paddingBottom="@dimen/x_dp_8"
    android:addStatesFromChildren="false"
    android:descendantFocusability="blocksDescendants"
    android:layout_width="match_parent"
    android:layout_height="@dimen/x_dp_96"
    android:textDirection="locale"
    android:layoutDirection="locale"
    android:paddingStart="@dimen/x_dp_24"
    android:paddingEnd="@dimen/x_dp_24">
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_large"
        android:textColor="@color/txt_primary"
        android:gravity="center"
        android:id="@+id/title_tv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/task_layer"
        android:layout_width="match_parent"
        android:layout_height="@dimen/x_dp_48"
        android:layout_marginTop="@dimen/x_dp_16"
        android:layout_marginStart="@dimen/x_dp_24"
        android:layout_marginEnd="@dimen/x_dp_24"
        app:layout_constraintTop_toBottomOf="@+id/title_tv">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/icon_iv"
            android:layout_width="@dimen/x_dp_24"
            android:layout_height="@dimen/x_dp_24"
            android:scaleType="fitXY"
            android:layout_marginStart="@dimen/x_dp_16"
            android:layout_marginEnd="@dimen/x_dp_8"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/xshare_text_size_large"
            android:textColor="@color/txt_primary"
            android:id="@+id/task_name_tv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:layout_weight="1"/>
        <ProgressBar
            android:layout_width="@dimen/x_dp_24"
            android:layout_height="@dimen/x_dp_24"
            android:layout_marginStart="@dimen/x_dp_16"
            android:layout_marginEnd="@dimen/x_dp_16"
            style="@style/ProgressBar.Loading"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
