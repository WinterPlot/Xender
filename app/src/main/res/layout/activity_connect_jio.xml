<?xml version="1.0" encoding="utf-8"?>
<com.userlabs.xshare.views.XLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:focusable="true"
    android:fitsSystemWindows="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include layout="@layout/toolbar"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/kaios_part1"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:id="@+id/rl_connect_jio_top"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivOpenVideo"
                android:paddingLeft="14dp"
                android:paddingTop="12dp"
                android:paddingRight="14dp"
                android:paddingBottom="12dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/svg_pc_connect_video"
                android:scaleType="center"
                android:layout_alignParentEnd="true"
                android:paddingHorizontal="14dp"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/xshare_text_size_large_greater"
                android:gravity="center"
                android:id="@+id/tvWifiName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/x_dp_16"
                android:layout_marginBottom="32dp"
                android:text="@string/hotspot_set"
                android:drawablePadding="@dimen/x_dp_5"
                android:layout_below="@+id/ivOpenVideo"
                android:layout_centerHorizontal="true"
                android:drawableStart="@drawable/svg_pc_connect_hotspot"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/connect_jio_des_iv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/tvWifiName"
                android:layout_centerHorizontal="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.2">
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/share_to_facebook_layout"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:layout_centerHorizontal="true"
                android:elevation="2dp">
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/bg_triangle_up_secondary"/>
                <LinearLayout
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_secondary_corner_10"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_gravity="center"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/x_svg_right_share_xshare"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textColor="@color/txt_white"
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/fb_share_dlg_btn_txt"
                        android:paddingStart="4dp"
                        android:paddingEnd="8dp"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingStart="@dimen/x_dp_16"
                android:paddingEnd="@dimen/x_dp_16">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/xshare_text_size_large"
                    android:textColor="@color/txt_primary"
                    android:gravity="center"
                    android:id="@+id/how_to_connect_jio_tv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="58dp"
                    android:text="@string/connect_jio_phone_tips"/>
                <androidx.appcompat.widget.AppCompatButton
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/open_ap"
                    android:background="@drawable/btn_primary_round_corner"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/x_dp_48"
                    android:layout_marginTop="105dp"
                    android:layout_marginBottom="46dp"
                    android:text="@string/hotspot_set"
                    style="@style/button_text_style_bold"/>
            </LinearLayout>
        </RelativeLayout>
    </LinearLayout>
    <include layout="@layout/activity_connect_jio_2"/>
</com.userlabs.xshare.views.XLinearLayout>
