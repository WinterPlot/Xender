<?xml version="1.0" encoding="utf-8"?>
<com.userlabs.xshare.views.drawer.DrawerView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/drawer_view_layer"
    android:tag="layout/menu_scrollview_0"
    android:background="@color/app_window_bg"
    android:focusable="true"
    android:visibility="invisible"
    android:fitsSystemWindows="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:layout_width="wrap_content"
        android:layout_height="@dimen/x_dp_100"
        android:layoutDirection="locale"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/x_drawer_me"/>
    <ScrollView
        android:id="@+id/action_bar_scroll"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@+id/x_drawer_me_item"/>
</com.userlabs.xshare.views.drawer.DrawerView>
