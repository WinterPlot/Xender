<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="1dp"
    app:cardBackgroundColor="@color/app_window_bg"
    app:cardCornerRadius="@dimen/x_dp_2">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="center"
        android:id="@+id/history_progress_lay"
        android:layout_width="match_parent"
        android:layout_height="@dimen/x_dp_102">
        <ProgressBar
            android:id="@+id/history_progress_bar"
            android:background="@color/x_transparent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:max="100"
            android:progress="30"
            android:progressDrawable="@drawable/bg_progress_primary_corner_8dp"
            style="?android:attr/progressBarStyleHorizontal"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/history_progress_item_file_icon_iv"
            android:layout_marginLeft="@dimen/x_dp_16"
            android:layout_marginRight="@dimen/x_dp_16"
            android:layout_marginHorizontal="@dimen/x_dp_16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/history_item_file_icon_iv_style"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/xshare_text_size_medium"
            android:ellipsize="end"
            android:gravity="start|center_vertical"
            android:id="@+id/history_progress_item_file_name_tv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_marginStart="@dimen/x_dp_16"
            android:layout_marginEnd="94dp"
            app:layout_constraintBottom_toTopOf="@+id/history_progress_item_file_size_tv"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/history_progress_item_file_icon_iv"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            style="@style/history_item_file_name_tv_style"/>
        <TextView
            android:textSize="@dimen/xshare_text_size_small"
            android:textColor="@color/txt_secondary"
            android:ellipsize="middle"
            android:gravity="start|bottom"
            android:id="@+id/history_progress_item_file_size_tv"
            android:background="@null"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/x_dp_10"
            android:singleLine="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="@+id/history_progress_item_file_name_tv"
            app:layout_constraintTop_toBottomOf="@+id/history_progress_item_file_name_tv"
            style="@style/title_text_font_style"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/xshare_text_size_small"
            android:textColor="@color/x_red"
            android:ellipsize="middle"
            android:gravity="start|bottom"
            android:id="@+id/history_progress_item_state_tv"
            android:background="@null"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/str_paused"
            android:singleLine="true"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp"
            app:layout_constraintBottom_toBottomOf="@+id/history_progress_item_file_size_tv"
            app:layout_constraintStart_toEndOf="@+id/history_progress_item_file_size_tv"
            style="@style/title_text_font_style"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/xshare_text_size_small"
            android:textColor="@color/primary"
            android:gravity="center"
            android:id="@+id/history_progress_complete_opt_btn"
            android:background="@drawable/btn_line_primary_solid_transparent"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="@dimen/x_dp_66"
            android:layout_height="30dp"
            android:maxHeight="40dp"
            android:minHeight="@dimen/x_dp_26"
            android:text="@string/btn_download"
            android:singleLine="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="@dimen/x_dp_16"
            android:layout_alignParentEnd="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/title_text_style_bold"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/history_progress_cancel_iv"
            android:background="?attr/actionBarItemBackground"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="@dimen/x_dp_48"
            android:layout_height="@dimen/x_dp_48"
            android:src="@drawable/svg_ic_cancel"
            android:scaleType="center"
            android:tint="@color/x_222_or_fff"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/history_progress_complete_opt_btn"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
