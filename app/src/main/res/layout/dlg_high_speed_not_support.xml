<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingLeft="@dimen/x_dp_16"
    android:paddingRight="@dimen/x_dp_16"
    android:paddingBottom="@dimen/x_dp_16"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="@dimen/x_dp_16">
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_medium"
        android:textColor="@color/txt_primary"
        android:gravity="start"
        android:id="@+id/unable_connect_dlg_msg_tv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/x_dp_16"
        android:text="@string/x_high_speed_not_support_tips_new"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/unable_connect_high_speed_bar_iv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/x_dp_30"
        android:layout_marginTop="@dimen/x_dp_30"
        android:layout_marginRight="@dimen/x_dp_30"
        android:src="@drawable/x_not_support_high_tips"
        android:scaleType="centerInside"
        android:text="@string/x_high_speed"
        android:layout_marginHorizontal="@dimen/x_dp_30"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/unable_connect_dlg_msg_tv"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_medium"
        android:textColor="@color/txt_primary"
        android:id="@+id/unable_connect_dlg_tips_tv"
        android:background="@drawable/bg_window_2_color_corner_10"
        android:padding="@dimen/x_dp_5"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/x_high_speed_turn_off_switch"
        app:layout_constraintEnd_toEndOf="@+id/unable_connect_high_speed_bar_iv"
        app:layout_constraintTop_toBottomOf="@+id/unable_connect_high_speed_bar_iv"/>
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/unable_connect_dlg_btn"
        android:background="@drawable/btn_primary_round_corner"
        android:layout_width="match_parent"
        android:layout_height="@dimen/x_dp_36"
        android:layout_marginLeft="@dimen/x_dp_8"
        android:layout_marginTop="@dimen/x_dp_24"
        android:layout_marginRight="@dimen/x_dp_8"
        android:text="@string/dlg_ok"
        android:layout_marginHorizontal="@dimen/x_dp_8"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/unable_connect_dlg_tips_tv"
        style="@style/button_text_style_bold"/>
</androidx.constraintlayout.widget.ConstraintLayout>
