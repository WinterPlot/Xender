<?xml version="1.0" encoding="utf-8"?>
<com.userlabs.xshare.views.XConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:id="@+id/share_parent_layer"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.AppCompatTextView
        android:gravity="center"
        android:id="@+id/share_this_to_whatsapp_btn"
        android:background="@drawable/btn_secondary_round_corner"
        android:layout_width="match_parent"
        android:layout_height="@dimen/x_dp_48"
        android:layout_marginLeft="@dimen/x_dp_16"
        android:layout_marginRight="@dimen/x_dp_16"
        android:layout_marginBottom="@dimen/x_dp_16"
        android:text="@string/share_xshare_to_whatsapp"
        android:layout_marginHorizontal="@dimen/x_dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        style="@style/button_text_style_bold"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="22sp"
        android:gravity="center"
        android:id="@+id/noad_en"
        android:background="#64f29e"
        android:layout_width="180dp"
        android:layout_height="40dp"
        android:layout_marginTop="@dimen/x_dp_50"
        android:text="@string/guide_no_ad_en"
        android:layout_centerHorizontal="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/toolbar_text_style_bold"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="18sp"
        android:gravity="center"
        android:id="@+id/noad_ma"
        android:background="#ff7373"
        android:paddingBottom="5dp"
        android:layout_width="120dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/guide_no_ad_ma"
        app:layout_constraintEnd_toStartOf="@+id/noad_pt"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/noad_en"
        style="@style/toolbar_text_style_bold"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="20sp"
        android:gravity="center"
        android:id="@+id/noad_pt"
        android:background="#ffb871"
        android:paddingLeft="@dimen/x_dp_10"
        android:paddingRight="@dimen/x_dp_10"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_marginTop="@dimen/x_dp_10"
        android:layout_marginBottom="10dp"
        android:text="@string/guide_no_ad_pt"
        android:layout_marginStart="30dp"
        android:paddingHorizontal="@dimen/x_dp_10"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/noad_ma"
        app:layout_constraintTop_toTopOf="@+id/noad_ma"
        style="@style/toolbar_text_style_bold"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="22sp"
        android:gravity="center"
        android:id="@+id/noad_te"
        android:background="#6ebeff"
        android:padding="5dp"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/x_dp_10"
        android:text="@string/guide_no_ad_te"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/noad_ma"
        style="@style/toolbar_text_style_bold"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="20sp"
        android:gravity="center"
        android:id="@+id/noad_hi"
        android:background="#f4df60"
        android:paddingLeft="@dimen/x_dp_16"
        android:paddingRight="@dimen/x_dp_16"
        android:layout_width="wrap_content"
        android:layout_height="45dp"
        android:layout_marginTop="15dp"
        android:text="@string/guide_no_ad_hi"
        android:paddingHorizontal="@dimen/x_dp_16"
        app:layout_constraintEnd_toStartOf="@+id/noad_it"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/noad_te"
        style="@style/toolbar_text_style_bold"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="18sp"
        android:gravity="center"
        android:id="@+id/noad_it"
        android:background="#9bed66"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:layout_width="140dp"
        android:layout_height="wrap_content"
        android:text="@string/guide_no_ad_it"
        android:layout_marginStart="40dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/noad_hi"
        app:layout_constraintTop_toTopOf="@+id/noad_hi"
        style="@style/toolbar_text_style_bold"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="22sp"
        android:id="@+id/noad_gr"
        android:background="#e281e2"
        android:padding="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/x_dp_10"
        android:text="@string/guide_no_ad_gr"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/noad_it"
        style="@style/toolbar_text_style_bold"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="18sp"
        android:gravity="center"
        android:id="@+id/noad_hu"
        android:background="#8282e0"
        android:padding="5dp"
        android:layout_width="140dp"
        android:layout_height="50dp"
        android:layout_marginTop="10dp"
        android:text="@string/guide_no_ad_hu"
        app:layout_constraintEnd_toStartOf="@+id/noad_in"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/noad_gr"
        style="@style/toolbar_text_style_bold"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="20sp"
        android:gravity="center"
        android:id="@+id/noad_in"
        android:background="#83ddd0"
        android:padding="8dp"
        android:layout_width="wrap_content"
        android:layout_height="45dp"
        android:layout_marginTop="15dp"
        android:text="@string/guide_no_ad_in"
        android:layout_marginStart="30dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/noad_hu"
        app:layout_constraintTop_toTopOf="@+id/noad_hu"
        style="@style/toolbar_text_style_bold"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="20sp"
        android:gravity="center"
        android:background="#ff9e73"
        android:padding="10dp"
        android:layout_width="170dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="@string/guide_no_ad_kr"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/noad_in"
        style="@style/toolbar_text_style_bold"/>
</com.userlabs.xshare.views.XConstraintLayout>
