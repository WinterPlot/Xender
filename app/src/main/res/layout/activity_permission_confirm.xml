<?xml version="1.0" encoding="utf-8"?>
<com.userlabs.xshare.views.XConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/parent_layer"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/permission_toolbar"
        android:background="@color/primary"
        android:layout_width="match_parent"
        android:layout_height="@dimen/cx_dp_48"
        android:minHeight="@dimen/cx_dp_48"
        app:layout_constraintTop_toTopOf="parent"
        app:popupTheme="@style/Theme.AppCompat.Light.DarkActionBar"
        app:titleTextColor="@color/txt_white"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/normal_layer"
        android:visibility="visible"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:constraint_referenced_ids="normal_step1,normal_permission_layer"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/normal_step1"
        android:background="@drawable/bg_window_2_color_corner_10"
        android:paddingBottom="@dimen/cx_dp_16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/cx_dp_16"
        app:layout_constraintTop_toBottomOf="@+id/permission_toolbar">
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="@color/txt_white"
            android:gravity="center"
            android:id="@+id/tv_title_step1"
            android:background="@drawable/bg_primary_oval"
            android:layout_width="@dimen/cx_dp_24"
            android:layout_height="@dimen/cx_dp_24"
            android:layout_margin="@dimen/cx_dp_10"
            android:text="1"
            android:layout_marginStart="@dimen/cx_dp_16"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="16sp"
            android:textColor="@color/txt_primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/cx_dp_10"
            android:layout_marginRight="@dimen/cx_dp_10"
            android:text="@string/permission_title_step1"
            android:layout_marginHorizontal="@dimen/cx_dp_10"
            app:layout_constraintBaseline_toBaselineOf="@+id/tv_title_step1"
            app:layout_constraintLeft_toRightOf="@+id/tv_title_step1"
            app:layout_constraintStart_toEndOf="@+id/tv_title_step1"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="vertical"
            android:background="@drawable/bg_window_1_color_corner_10"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/cx_dp_16"
            app:layout_constraintTop_toBottomOf="@+id/tv_title_step1">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="12sp"
                android:textColor="@color/txt_primary"
                android:gravity="center_vertical"
                android:layout_width="match_parent"
                android:layout_height="@dimen/cx_dp_42"
                android:layout_marginLeft="@dimen/cx_dp_16"
                android:layout_marginRight="@dimen/cx_dp_16"
                android:text="@string/data_usage"
                android:fontFamily="@string/theme_roboto_medium_font"
                android:layout_marginHorizontal="@dimen/cx_dp_16"/>
            <View
                android:background="@color/x_line"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_alignParentTop="true"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="12sp"
                android:textColor="@color/txt_primary"
                android:gravity="center_vertical"
                android:layout_width="match_parent"
                android:layout_height="@dimen/cx_dp_42"
                android:layout_marginLeft="@dimen/cx_dp_16"
                android:layout_marginRight="@dimen/cx_dp_16"
                android:text="@string/permission"
                android:layout_centerVertical="true"
                android:fontFamily="@string/theme_roboto_medium_font"
                android:layout_marginHorizontal="@dimen/cx_dp_16"/>
            <View
                android:background="@color/x_line"
                android:layout_width="match_parent"
                android:layout_height="1dp"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="12sp"
                android:textColor="@color/txt_primary"
                android:gravity="center_vertical"
                android:layout_width="match_parent"
                android:layout_height="@dimen/cx_dp_42"
                android:layout_marginLeft="@dimen/cx_dp_16"
                android:layout_marginRight="@dimen/cx_dp_16"
                android:text="@string/notifications"
                android:fontFamily="@string/theme_roboto_medium_font"
                android:layout_marginHorizontal="@dimen/cx_dp_16"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/normal_permission_layer"
        android:background="@drawable/bg_window_2_color_corner_10"
        android:paddingBottom="@dimen/cx_dp_16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/cx_dp_16"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@+id/normal_step1">
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="@color/txt_white"
            android:gravity="center"
            android:id="@+id/tv_title_step2"
            android:background="@drawable/bg_primary_oval"
            android:layout_width="@dimen/cx_dp_24"
            android:layout_height="@dimen/cx_dp_24"
            android:layout_margin="@dimen/cx_dp_10"
            android:text="2"
            android:layout_marginStart="16dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="16sp"
            android:textColor="@color/txt_primary"
            android:id="@+id/step2_content_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/cx_dp_10"
            android:layout_marginRight="@dimen/cx_dp_10"
            android:text="@string/permission_title_step2"
            android:layout_marginHorizontal="@dimen/cx_dp_10"
            app:layout_constraintBaseline_toBaselineOf="@+id/tv_title_step2"
            app:layout_constraintLeft_toRightOf="@+id/tv_title_step2"
            app:layout_constraintStart_toEndOf="@+id/tv_title_step2"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="12sp"
            android:textColor="@color/txt_primary"
            android:id="@+id/tv_permission_step2_desc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/cx_dp_10"
            android:layout_marginTop="5dp"
            android:layout_marginRight="@dimen/cx_dp_10"
            android:text="@string/permission_title_step2_desc"
            android:layout_marginHorizontal="@dimen/cx_dp_10"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintLeft_toRightOf="@+id/tv_title_step2"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tv_title_step2"
            app:layout_constraintTop_toBottomOf="@+id/step2_content_tv"/>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="vertical"
            android:id="@+id/current_grant_permission_tv_layout"
            android:background="@drawable/bg_window_1_color_corner_10"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/cx_dp_16"
            android:layout_marginTop="@dimen/cx_dp_20"
            android:layout_marginRight="@dimen/cx_dp_16"
            android:layout_marginHorizontal="@dimen/cx_dp_16"
            app:layout_constraintTop_toBottomOf="@+id/tv_permission_step2_desc">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="12sp"
                android:textColor="@color/txt_primary"
                android:gravity="center_vertical"
                android:id="@+id/current_grant_permission_tv"
                android:layout_width="match_parent"
                android:layout_height="@dimen/cx_dp_42"
                android:text="@string/permission_storage"
                android:drawablePadding="@dimen/cx_dp_16"
                android:layout_centerHorizontal="true"
                android:drawableEnd="@drawable/cx_svg_switch_on"
                android:fontFamily="@string/theme_roboto_medium_font"
                android:paddingStart="@dimen/cx_dp_16"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
        <androidx.appcompat.widget.AppCompatImageView
            android:background="@drawable/x_ic_setting_grant"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="21dp"
            android:layout_marginEnd="35dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@+id/current_grant_permission_tv_layout"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/miui_layer"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:constraint_referenced_ids="miui_step1,miui_step2"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/miui_step1"
        android:background="@drawable/bg_window_2_color_corner_10"
        android:paddingBottom="@dimen/cx_dp_16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/cx_dp_16"
        app:layout_constraintTop_toBottomOf="@+id/permission_toolbar">
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="@color/txt_white"
            android:gravity="center"
            android:id="@+id/miui_tv_title_step1"
            android:background="@drawable/bg_primary_oval"
            android:layout_width="@dimen/cx_dp_24"
            android:layout_height="@dimen/cx_dp_24"
            android:layout_margin="@dimen/cx_dp_10"
            android:text="1"
            android:layout_marginStart="16dp"
            app:layout_constraintBottom_toBottomOf="@+id/miui_step1_content_tv"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/miui_step1_content_tv"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="16sp"
            android:textColor="@color/txt_primary"
            android:id="@+id/miui_step1_content_tv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/cx_dp_10"
            android:layout_marginTop="@dimen/cx_dp_10"
            android:layout_marginRight="@dimen/cx_dp_10"
            android:text="@string/permission_miui_step1"
            android:layout_marginHorizontal="@dimen/cx_dp_10"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintLeft_toRightOf="@+id/miui_tv_title_step1"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintStart_toEndOf="@+id/miui_tv_title_step1"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="vertical"
            android:background="@drawable/bg_window_1_color_corner_10"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/cx_dp_16"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toBottomOf="@+id/miui_tv_title_step1">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="12sp"
                android:textColor="@color/txt_primary"
                android:gravity="center_vertical"
                android:id="@+id/miui_step1_title1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="@string/permission_miui_manager1"
                android:fontFamily="@string/theme_roboto_medium_font"
                android:layout_marginStart="@dimen/cx_dp_16"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="12sp"
                android:textColor="@color/txt_secondary"
                android:gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="5dp"
                android:text="@string/permission_miui_manager2"
                android:layout_below="@+id/miui_step1_title1"
                android:fontFamily="@string/theme_roboto_medium_font"
                android:layout_marginStart="@dimen/cx_dp_16"
                android:layout_marginVertical="5dp"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/miui_step2"
        android:background="@drawable/bg_window_2_color_corner_10"
        android:paddingBottom="@dimen/cx_dp_16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/cx_dp_16"
        app:layout_constraintTop_toBottomOf="@+id/miui_step1">
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="@color/txt_white"
            android:gravity="center"
            android:id="@+id/miui_tv_title_step2"
            android:background="@drawable/bg_primary_oval"
            android:layout_width="@dimen/cx_dp_24"
            android:layout_height="@dimen/cx_dp_24"
            android:layout_margin="@dimen/cx_dp_10"
            android:text="2"
            android:layout_marginStart="16dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="16sp"
            android:textColor="@color/txt_primary"
            android:id="@+id/miui_step2_content_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/cx_dp_10"
            android:layout_marginRight="@dimen/cx_dp_10"
            android:text="@string/permission_title_step2"
            android:layout_marginHorizontal="@dimen/cx_dp_10"
            app:layout_constraintBaseline_toBaselineOf="@+id/miui_tv_title_step2"
            app:layout_constraintLeft_toRightOf="@+id/miui_tv_title_step2"
            app:layout_constraintStart_toEndOf="@+id/miui_tv_title_step2"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="vertical"
            android:id="@+id/current_grant_miui_permission_tv_layout"
            android:background="@drawable/bg_window_1_color_corner_10"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/cx_dp_16"
            android:layout_marginTop="@dimen/cx_dp_20"
            android:layout_marginRight="@dimen/cx_dp_16"
            android:layout_marginHorizontal="@dimen/cx_dp_16"
            app:layout_constraintTop_toBottomOf="@+id/miui_step2_content_tv">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="12sp"
                android:textColor="@color/txt_primary"
                android:gravity="center_vertical"
                android:id="@+id/miui_step2_title1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="@string/permission_location"
                android:fontFamily="@string/theme_roboto_medium_font"
                android:layout_marginStart="@dimen/cx_dp_16"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="12sp"
                android:textColor="@color/txt_secondary"
                android:gravity="center_vertical"
                android:id="@+id/miui_step2_title2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="5dp"
                android:text="@string/miui_permission_location_info"
                android:layout_below="@+id/miui_step2_title1"
                android:fontFamily="@string/theme_roboto_medium_font"
                android:layout_marginStart="@dimen/cx_dp_16"
                android:layout_marginVertical="5dp"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
        <androidx.appcompat.widget.AppCompatImageView
            android:background="@drawable/x_ic_setting_grant"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="21dp"
            android:layout_marginEnd="90dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@+id/current_grant_miui_permission_tv_layout"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.appcompat.widget.AppCompatButton
        android:gravity="center"
        android:id="@+id/setup_btn"
        android:background="@drawable/btn_primary_round_corner"
        android:layout_width="match_parent"
        android:layout_height="@dimen/cx_dp_48"
        android:layout_marginLeft="@dimen/cx_dp_24"
        android:layout_marginRight="@dimen/cx_dp_24"
        android:layout_marginBottom="40dp"
        android:text="@string/setup_text"
        android:layout_alignParentBottom="true"
        android:layout_marginHorizontal="@dimen/cx_dp_24"
        app:layout_constraintBottom_toBottomOf="parent"
        style="@style/cx_button_text_style_bold"/>
</com.userlabs.xshare.views.XConstraintLayout>
