<?xml version="1.0" encoding="utf-8"?>
<com.userlabs.xshare.views.bottombar.SelectActionLinear3 xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="bottom"
    android:orientation="horizontal"
    android:focusable="true"
    android:visibility="visible"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="@dimen/x_dp_54">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/select_action2_button_cancel"
        android:background="@drawable/selector_list_item"
        android:layout_width="@dimen/x_dp_54"
        android:layout_height="match_parent"
        android:src="@drawable/svg_ic_cancel"
        android:scaleType="center"
        android:tint="@color/x_222_or_fff"/>
    <View
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_large"
        android:textColor="@color/txt_white"
        android:gravity="center"
        android:layout_gravity="center_vertical"
        android:id="@+id/select_action2_count"
        android:paddingLeft="@dimen/x_dp_16"
        android:paddingRight="@dimen/x_dp_16"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/x_dp_40"
        android:text="@string/image_detail_select"
        android:singleLine="true"
        android:paddingHorizontal="@dimen/x_dp_16"
        style="@style/header_title_text_style_bold"/>
    <View
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/select_action2_button_delete"
        android:background="?attr/selectableItemBackground"
        android:layout_width="@dimen/x_dp_54"
        android:layout_height="match_parent"
        android:layout_margin="1dp"
        android:src="@drawable/svg_ic_delete"
        android:scaleType="center"
        android:tint="@color/x_222_or_fff"/>
</com.userlabs.xshare.views.bottombar.SelectActionLinear3>
