<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/bg_window_2_color_corner_10"
        android:paddingBottom="@dimen/cx_dp_16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/cx_dp_16">
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="@color/txt_white"
            android:gravity="center"
            android:id="@+id/precise_step1"
            android:background="@drawable/bg_primary_oval"
            android:layout_width="@dimen/cx_dp_24"
            android:layout_height="@dimen/cx_dp_24"
            android:layout_margin="@dimen/cx_dp_10"
            android:text="2"
            android:layout_marginStart="@dimen/cx_dp_16"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="16sp"
            android:textColor="@color/txt_primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/cx_dp_10"
            android:layout_marginRight="@dimen/cx_dp_10"
            android:text="@string/permission_title_step2_over_S"
            android:layout_marginHorizontal="@dimen/cx_dp_10"
            app:layout_constraintBaseline_toBaselineOf="@+id/precise_step1"
            app:layout_constraintLeft_toRightOf="@+id/precise_step1"
            app:layout_constraintStart_toEndOf="@+id/precise_step1"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="vertical"
            android:background="@drawable/bg_window_1_color_corner_10"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/cx_dp_16"
            app:layout_constraintTop_toBottomOf="@+id/precise_step1">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="12sp"
                android:textColor="@color/txt_primary"
                android:gravity="center_vertical"
                android:layout_width="match_parent"
                android:layout_height="@dimen/cx_dp_42"
                android:layout_marginLeft="@dimen/cx_dp_16"
                android:layout_marginRight="@dimen/cx_dp_16"
                android:text="@string/permission_files_and_median"
                android:fontFamily="@string/theme_roboto_medium_font"
                android:layout_marginHorizontal="@dimen/cx_dp_16"/>
            <View
                android:background="@color/x_line"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_alignParentTop="true"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="12sp"
                android:textColor="@color/txt_primary"
                android:gravity="center_vertical"
                android:layout_width="match_parent"
                android:layout_height="@dimen/cx_dp_42"
                android:layout_marginLeft="@dimen/cx_dp_16"
                android:layout_marginRight="@dimen/cx_dp_16"
                android:text="@string/permission_location"
                android:layout_centerVertical="true"
                android:fontFamily="@string/theme_roboto_medium_font"
                android:layout_marginHorizontal="@dimen/cx_dp_16"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/bg_window_2_color_corner_10"
        android:paddingBottom="@dimen/cx_dp_16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/cx_dp_16">
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="@color/txt_white"
            android:gravity="center"
            android:id="@+id/precise_step2"
            android:background="@drawable/bg_primary_oval"
            android:layout_width="@dimen/cx_dp_24"
            android:layout_height="@dimen/cx_dp_24"
            android:layout_margin="@dimen/cx_dp_10"
            android:text="3"
            android:layout_marginStart="16dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="16sp"
            android:textColor="@color/txt_primary"
            android:id="@+id/step2_content_tv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/cx_dp_10"
            android:layout_marginRight="@dimen/cx_dp_10"
            android:text="@string/permission_precise_location"
            android:layout_marginHorizontal="@dimen/cx_dp_10"
            app:layout_constraintBaseline_toBaselineOf="@+id/precise_step2"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintLeft_toRightOf="@+id/precise_step2"
            app:layout_constraintStart_toEndOf="@+id/precise_step2"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="12sp"
            android:textColor="@color/txt_primary"
            android:id="@+id/precise_step2_desc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/cx_dp_10"
            android:layout_marginTop="5dp"
            android:layout_marginRight="@dimen/cx_dp_10"
            android:text="@string/permission_title_step2_desc"
            android:layout_marginHorizontal="@dimen/cx_dp_10"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintLeft_toRightOf="@+id/precise_step2"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintStart_toEndOf="@+id/precise_step2"
            app:layout_constraintTop_toBottomOf="@+id/step2_content_tv"/>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="vertical"
            android:id="@+id/precise_permission_tv_layout"
            android:background="@drawable/bg_window_1_color_corner_10"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/cx_dp_16"
            android:layout_marginTop="@dimen/cx_dp_20"
            android:layout_marginRight="@dimen/cx_dp_16"
            android:layout_marginHorizontal="@dimen/cx_dp_16"
            app:layout_constraintTop_toBottomOf="@+id/precise_step2_desc">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="12sp"
                android:textColor="@color/txt_primary"
                android:gravity="center_vertical"
                android:layout_width="match_parent"
                android:layout_height="@dimen/cx_dp_42"
                android:text="@string/permission_use_precise_location"
                android:drawablePadding="@dimen/cx_dp_16"
                android:drawableEnd="@drawable/cx_svg_switch_on"
                android:fontFamily="@string/theme_roboto_medium_font"
                android:paddingStart="@dimen/cx_dp_16"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
        <androidx.appcompat.widget.AppCompatImageView
            android:background="@drawable/x_ic_setting_grant"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="21dp"
            android:layout_marginEnd="35dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@+id/precise_permission_tv_layout"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.appcompat.widget.LinearLayoutCompat>
