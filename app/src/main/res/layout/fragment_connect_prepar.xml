<?xml version="1.0" encoding="utf-8"?>
<com.userlabs.xshare.views.XConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="bottom"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:textDirection="locale"
    android:layoutDirection="locale">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/precondition_toolbar"
        android:background="@color/primary"
        android:layout_width="match_parent"
        android:layout_height="@dimen/cx_dp_48"
        android:tintMode="src_atop"
        app:contentInsetStartWithNavigation="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:popupTheme="@style/Theme.AppCompat.Light.DarkActionBar"
        app:titleTextAppearance="@style/toolbar_text_style_bold"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/precondition_tips_iv"
        android:layout_width="201dp"
        android:layout_height="138dp"
        android:layout_marginTop="@dimen/cx_dp_16"
        android:scaleType="centerInside"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/precondition_toolbar"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/connect_preconditions_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/cx_dp_16"
        android:layout_marginBottom="@dimen/cx_dp_16"
        app:layout_constraintBottom_toTopOf="@+id/precondition_need_des"
        app:layout_constraintTop_toBottomOf="@+id/precondition_tips_iv"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_small"
        android:textStyle="bold"
        android:textColor="@color/txt_primary"
        android:gravity="center"
        android:id="@+id/precondition_need_des"
        android:paddingLeft="@dimen/cx_dp_16"
        android:paddingRight="@dimen/cx_dp_16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="32dp"
        android:layout_marginRight="32dp"
        android:layout_marginBottom="@dimen/cx_dp_16"
        android:minHeight="@dimen/cx_dp_48"
        android:maxLines="3"
        android:lineSpacingMultiplier="1.2"
        android:layout_marginHorizontal="32dp"
        android:paddingHorizontal="@dimen/cx_dp_16"
        app:layout_constraintBottom_toTopOf="@+id/prepar_next"/>
    <androidx.appcompat.widget.AppCompatButton
        android:gravity="center"
        android:id="@+id/prepar_next"
        android:background="@drawable/btn_primary_round_corner"
        android:layout_width="match_parent"
        android:layout_height="@dimen/cx_dp_48"
        android:layout_marginLeft="@dimen/cx_dp_16"
        android:layout_marginRight="@dimen/cx_dp_16"
        android:layout_marginBottom="@dimen/cx_dp_16"
        android:text="@string/dlg_next"
        android:layout_marginHorizontal="@dimen/cx_dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        style="@style/cx_button_text_style_bold"/>
</com.userlabs.xshare.views.XConstraintLayout>
