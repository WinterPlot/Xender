<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.Toolbar xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/x_pl_toolbar"
    android:background="@color/primary"
    android:layout_width="match_parent"
    android:layout_height="@dimen/x_dp_48"
    app:contentInsetStartWithNavigation="0dp"
    app:popupTheme="@style/Theme.AppCompat.Light.DarkActionBar"
    app:titleTextAppearance="@style/toolbar_text_style_bold">
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_large"
        android:textColor="@color/txt_white"
        android:layout_gravity="end"
        android:id="@+id/x_pl_toolbar_menu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/x_dp_16"
        android:layout_marginRight="@dimen/x_dp_16"
        android:text="@string/search_all_cate"
        android:layout_marginHorizontal="@dimen/x_dp_16"
        style="@style/text_style_bold"/>
</androidx.appcompat.widget.Toolbar>
