<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_primary_0e_corner_10"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/rate_us_item_iv"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="@dimen/x_dp_8"
        android:scaleType="fitXY"
        android:layout_marginStart="@dimen/x_dp_16"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_small"
        android:textColor="@color/txt_primary"
        android:id="@+id/rate_us_item_tv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/x_dp_16"
        android:layout_marginRight="@dimen/x_dp_16"
        android:layout_marginHorizontal="@dimen/x_dp_16"
        app:layout_constraintBottom_toBottomOf="@+id/rate_us_item_iv"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/rate_us_item_iv"
        app:layout_constraintTop_toTopOf="@+id/rate_us_item_iv"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/rate_us_five_star_iv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/x_dp_3"
        android:src="@drawable/svg_rate_us_five_star_small"
        android:layout_marginStart="@dimen/x_dp_16"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/rate_us_item_iv"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_medium"
        android:textColor="@color/txt_primary"
        android:id="@+id/rate_us_item_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/x_dp_3"
        android:layout_marginBottom="12dp"
        android:maxLines="2"
        android:layout_marginStart="@dimen/x_dp_16"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/rate_us_five_star_iv"/>
</androidx.constraintlayout.widget.ConstraintLayout>
