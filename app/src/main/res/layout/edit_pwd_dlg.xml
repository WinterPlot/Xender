<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="@dimen/x_dp_24"
    android:layout_marginTop="@dimen/x_dp_24"
    android:layout_marginRight="@dimen/x_dp_24"
    android:textDirection="locale"
    android:layoutDirection="locale"
    android:layout_marginStart="@dimen/x_dp_24"
    android:layout_marginEnd="@dimen/x_dp_24">
    <androidx.appcompat.widget.AppCompatEditText
        android:textSize="@dimen/xshare_text_size_medium"
        android:textColor="@color/txt_primary"
        android:textColorHint="@color/txt_secondary"
        android:id="@+id/pwd_edit"
        android:background="@null"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/x_dp_16"
        android:hint="@string/settings_pwd_hint"
        android:password="true"
        android:maxLength="8"
        android:inputType="textNoSuggestions"
        android:textCursorDrawable="@null"
        android:layout_marginStart="@dimen/x_dp_16"/>
    <View
        android:background="@color/x_line"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="10dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="@dimen/x_dp_16"/>
    <CheckBox
        android:textSize="@dimen/xshare_text_size_large"
        android:textColor="@color/txt_secondary"
        android:id="@+id/cb_showPassword"
        android:duplicateParentState="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:checked="false"
        android:scaleType="center"
        android:text="@string/show_hide_password"
        android:layout_marginStart="16dp"/>
</LinearLayout>
