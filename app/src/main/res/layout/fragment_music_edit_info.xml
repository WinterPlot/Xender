<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/edit_info"
    android:tag="layout/fragment_music_edit_info_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/edit_info_top_line"
        android:layout_width="@dimen/x_dp_45"
        android:layout_height="@dimen/x_dp_4"
        android:layout_marginTop="@dimen/x_dp_5"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/edit_info_icon"
        android:layout_width="@dimen/x_dp_64"
        android:layout_height="@dimen/x_dp_64"
        android:layout_marginTop="@dimen/x_dp_16"
        android:scaleType="centerCrop"
        android:layout_marginStart="@dimen/x_dp_16"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/edit_info_top_line"
        app:shapeAppearance="@style/RoundedStyle"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_large_greater"
        android:textColor="@color/txt_primary"
        android:ellipsize="end"
        android:gravity="start"
        android:id="@+id/edit_info_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/x_dp_16"
        android:layout_marginRight="@dimen/x_dp_16"
        android:maxLines="1"
        android:fontFamily="sans-serif-medium"
        android:layout_marginHorizontal="@dimen/x_dp_16"
        app:layout_constraintBottom_toTopOf="@+id/edit_info_artist"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/edit_info_icon"
        app:layout_constraintTop_toTopOf="@+id/edit_info_icon"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_medium"
        android:textColor="@color/txt_secondary"
        android:ellipsize="end"
        android:gravity="start|center_vertical"
        android:id="@+id/edit_info_artist"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/x_dp_16"
        android:layout_marginRight="@dimen/x_dp_16"
        android:maxLines="1"
        android:fontFamily="sans-serif-medium"
        android:layout_marginHorizontal="@dimen/x_dp_16"
        app:layout_constraintBottom_toBottomOf="@+id/edit_info_icon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/edit_info_icon"
        app:layout_constraintTop_toBottomOf="@+id/edit_info_title"/>
    <View
        android:id="@+id/edit_info_divider"
        android:background="@color/x_child_bg_line"
        android:layout_width="match_parent"
        android:layout_height="@dimen/x_dp_1"
        android:layout_marginTop="@dimen/x_dp_16"
        app:layout_constraintTop_toBottomOf="@+id/edit_info_icon"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_small"
        android:textColor="@color/txt_primary"
        android:gravity="center"
        android:id="@+id/edit_info_title_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/x_dp_20"
        android:text="@string/mp_des_title"
        android:layout_marginStart="@dimen/x_dp_16"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/edit_info_divider"/>
    <androidx.appcompat.widget.AppCompatEditText
        android:textSize="@dimen/xshare_text_size_medium"
        android:textColor="@color/txt_secondary"
        android:gravity="start"
        android:layout_gravity="center_horizontal"
        android:id="@+id/edit_info_title_edit"
        android:focusable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/x_dp_16"
        android:layout_marginTop="@dimen/x_dp_12"
        android:layout_marginRight="@dimen/x_dp_16"
        android:maxLength="50"
        android:inputType="text"
        android:imeOptions="actionNext"
        android:textCursorDrawable="@null"
        android:backgroundTint="@color/x_child_bg_line"
        android:layout_marginHorizontal="@dimen/x_dp_16"
        app:layout_constraintTop_toBottomOf="@+id/edit_info_title_tv"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_small"
        android:textColor="@color/txt_primary"
        android:gravity="center"
        android:id="@+id/edit_info_artist_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/x_dp_20"
        android:text="@string/mp_des_artist"
        android:layout_marginStart="@dimen/x_dp_16"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/edit_info_title_edit"/>
    <androidx.appcompat.widget.AppCompatEditText
        android:textSize="@dimen/xshare_text_size_medium"
        android:textColor="@color/txt_secondary"
        android:gravity="start"
        android:layout_gravity="center_horizontal"
        android:id="@+id/edit_info_artist_edit"
        android:focusable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/x_dp_16"
        android:layout_marginTop="@dimen/x_dp_12"
        android:layout_marginRight="@dimen/x_dp_16"
        android:layout_marginBottom="@dimen/x_dp_30"
        android:maxLength="50"
        android:inputType="text"
        android:imeOptions="actionDone"
        android:textCursorDrawable="@null"
        android:backgroundTint="@color/x_child_bg_line"
        android:layout_marginHorizontal="@dimen/x_dp_16"
        app:layout_constraintTop_toBottomOf="@+id/edit_info_artist_tv"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:gravity="center"
        android:id="@+id/edit_info_save"
        android:layout_width="0dp"
        android:layout_height="@dimen/x_dp_40"
        android:layout_marginLeft="@dimen/x_dp_60"
        android:layout_marginRight="@dimen/x_dp_60"
        android:layout_marginBottom="@dimen/x_dp_10"
        android:textAllCaps="true"
        android:layout_marginHorizontal="@dimen/x_dp_60"
        app:layout_constraintBottom_toBottomOf="@+id/edit_info_space"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/cx_button_text_style_bold"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/edit_info_title_sug_layout"
        android:background="@drawable/bg_window_2_color_corner_10"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/x_dp_16"
        android:layout_marginRight="@dimen/x_dp_16"
        android:layout_marginBottom="@dimen/x_dp_20"
        android:elevation="@dimen/x_dp_2"
        android:layout_marginHorizontal="@dimen/x_dp_16"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toTopOf="@+id/edit_info_save"
        app:layout_constraintTop_toBottomOf="@+id/edit_info_title_edit"
        app:layout_constraintVertical_bias="0">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/title_sug_recycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/title_sug_close"
            android:padding="@dimen/x_dp_8"
            android:layout_width="@dimen/x_dp_40"
            android:layout_height="@dimen/x_dp_40"
            android:src="@drawable/svg_ad_close"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/x_999"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/edit_info_artist_sug_layout"
        android:background="@drawable/bg_window_2_color_corner_10"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/x_dp_16"
        android:layout_marginRight="@dimen/x_dp_16"
        android:layout_marginBottom="@dimen/x_dp_20"
        android:elevation="@dimen/x_dp_2"
        android:layout_marginHorizontal="@dimen/x_dp_16"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toTopOf="@+id/edit_info_save"
        app:layout_constraintTop_toBottomOf="@+id/edit_info_artist_edit"
        app:layout_constraintVertical_bias="0">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/artist_sug_recycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/artist_sug_close"
            android:padding="@dimen/x_dp_8"
            android:layout_width="@dimen/x_dp_40"
            android:layout_height="@dimen/x_dp_40"
            android:src="@drawable/svg_ad_close"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/x_999"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <Space
        android:id="@+id/edit_info_space"
        android:layout_width="match_parent"
        android:layout_height="@dimen/x_dp_20"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
