<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/audio_list_item_layer"
    android:background="@drawable/selector_list_item"
    android:addStatesFromChildren="false"
    android:descendantFocusability="blocksDescendants"
    android:layout_width="match_parent"
    android:layout_height="@dimen/x_dp_80"
    android:textDirection="locale"
    android:layoutDirection="locale">
    <com.userlabs.xshare.views.XCheckBox
        android:id="@+id/cb_audio_check"
        android:focusable="false"
        android:clickable="false"
        android:duplicateParentState="false"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:scaleType="center"
        android:layout_marginEnd="@dimen/x_dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/audio_play_icon"
        android:layout_width="@dimen/x_dp_56"
        android:layout_height="@dimen/x_dp_56"
        android:layout_marginLeft="@dimen/x_dp_16"
        android:layout_marginRight="@dimen/x_dp_16"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/new_badge"
        android:visibility="gone"
        android:layout_width="@dimen/x_dp_20"
        android:layout_height="@dimen/x_dp_20"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_smaller"
        android:textColor="@color/txt_white"
        android:gravity="center"
        android:layout_gravity="start|bottom"
        android:id="@+id/audio_duration_item"
        android:background="@drawable/bg_duration"
        android:paddingLeft="5dp"
        android:paddingRight="5dp"
        android:layout_width="wrap_content"
        android:layout_height="16dp"
        android:layout_marginBottom="5dp"
        android:singleLine="true"
        android:layout_marginEnd="3dp"
        android:paddingHorizontal="5dp"
        app:layout_constraintBottom_toBottomOf="@+id/audio_play_icon"
        app:layout_constraintEnd_toEndOf="@+id/audio_play_icon"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/cx_sp_15"
        android:textColor="@color/txt_primary"
        android:ellipsize="middle"
        android:gravity="start|center_vertical"
        android:id="@+id/audio_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/x_dp_12"
        android:layout_marginRight="@dimen/x_dp_12"
        android:singleLine="true"
        android:layout_marginHorizontal="@dimen/x_dp_12"
        app:layout_constraintBottom_toTopOf="@+id/audio_artist_or_path"
        app:layout_constraintEnd_toStartOf="@+id/cb_audio_check"
        app:layout_constraintStart_toEndOf="@+id/audio_play_icon"
        app:layout_constraintTop_toTopOf="@+id/audio_play_icon"
        app:layout_constraintVertical_chainStyle="spread"
        app:layout_constraintVertical_weight="1"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_small"
        android:textColor="@color/txt_secondary"
        android:gravity="start|center_vertical"
        android:id="@+id/audio_artist_or_path"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:layout_marginEnd="@dimen/x_dp_16"
        app:layout_constraintBottom_toTopOf="@+id/audio_size"
        app:layout_constraintEnd_toStartOf="@+id/cb_audio_check"
        app:layout_constraintStart_toStartOf="@+id/audio_name"
        app:layout_constraintTop_toBottomOf="@+id/audio_name"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_small"
        android:textColor="@color/txt_secondary"
        android:gravity="start|center_vertical"
        android:id="@+id/audio_size"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        app:layout_constraintBottom_toBottomOf="@+id/audio_play_icon"
        app:layout_constraintStart_toStartOf="@+id/audio_name"
        app:layout_constraintTop_toBottomOf="@+id/audio_artist_or_path"/>
</androidx.constraintlayout.widget.ConstraintLayout>
