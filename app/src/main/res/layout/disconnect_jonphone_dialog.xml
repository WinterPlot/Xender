<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:id="@+id/quit_connect_jio_layout"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="@dimen/xshare_text_size_large"
        android:textColor="@color/txt_secondary"
        android:gravity="center"
        android:paddingLeft="@dimen/x_dp_16"
        android:paddingTop="@dimen/x_dp_16"
        android:paddingRight="@dimen/x_dp_16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/kaios_disconnect_tips"
        android:paddingStart="@dimen/x_dp_16"
        android:paddingEnd="@dimen/x_dp_16"/>
    <TextView
        android:textSize="@dimen/xshare_text_size_large"
        android:textColor="@color/txt_primary"
        android:gravity="center"
        android:id="@+id/quit_connect_jio_tv"
        android:paddingLeft="@dimen/x_dp_16"
        android:paddingTop="12dp"
        android:paddingRight="@dimen/x_dp_16"
        android:paddingBottom="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/disconnect_jiophone_tips"
        android:paddingStart="@dimen/x_dp_16"
        android:paddingEnd="@dimen/x_dp_16"/>
    <View
        android:background="@color/x_line"
        android:layout_width="match_parent"
        android:layout_height="1dp"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="@dimen/xshare_text_size_medium"
            android:textColor="@color/txt_secondary"
            android:gravity="center"
            android:layout_gravity="end"
            android:id="@+id/connecting_jiophone_quit"
            android:layout_width="0dp"
            android:layout_height="@dimen/x_dp_50"
            android:text="@string/disconnect_jiophone_quit"
            android:layout_weight="1"
            style="@style/header_title_text_style_bold"/>
        <View
            android:background="@color/x_line"
            android:layout_width="1dp"
            android:layout_height="match_parent"/>
        <TextView
            android:textSize="@dimen/xshare_text_size_medium"
            android:textColor="@color/primary"
            android:gravity="center"
            android:id="@+id/connecting_jiophone_cancel"
            android:layout_width="0dp"
            android:layout_height="@dimen/x_dp_50"
            android:text="@string/dlg_cancel"
            android:layout_weight="1"
            style="@style/header_title_text_style_bold"/>
    </LinearLayout>
</LinearLayout>
