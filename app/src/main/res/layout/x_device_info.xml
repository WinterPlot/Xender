<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/x_device_info_layout"
    android:background="@drawable/bg_window_1_color_top_corner_20"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:textDirection="locale"
    android:layoutDirection="locale">
    <View
        android:layout_gravity="center"
        android:background="@drawable/bg_dlg_top_handle"
        android:layout_width="@dimen/x_dp_45"
        android:layout_height="@dimen/x_dp_4"
        android:layout_marginTop="@dimen/x_dp_5"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_small"
        android:textColor="@color/txt_primary"
        android:id="@+id/device_name_tv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:lineSpacingMultiplier="1.5"
        android:fontFamily="@string/roboto_font"
        android:layout_marginStart="@dimen/x_dp_16"
        android:layout_marginEnd="@dimen/x_dp_16"/>
    <androidx.appcompat.widget.AppCompatButton
        android:textSize="@dimen/xshare_text_size_large_greater"
        android:textColor="@color/txt_primary"
        android:gravity="center"
        android:id="@+id/sync_info_btn"
        android:visibility="gone"
        android:layout_width="220dp"
        android:layout_height="48dp"
        android:layout_marginStart="@dimen/x_dp_16"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_small"
        android:textColor="@color/txt_primary"
        android:id="@+id/task_one_tv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/x_dp_16"
        android:layout_marginRight="@dimen/x_dp_16"
        android:fontFamily="@string/roboto_font"/>
</androidx.appcompat.widget.LinearLayoutCompat>
