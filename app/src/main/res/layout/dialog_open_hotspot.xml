<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:paddingLeft="@dimen/x_dp_24"
    android:paddingTop="@dimen/x_dp_16"
    android:paddingRight="@dimen/x_dp_24"
    android:paddingBottom="@dimen/x_dp_8"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:textDirection="locale"
    android:layoutDirection="locale"
    android:paddingStart="@dimen/x_dp_24"
    android:paddingEnd="@dimen/x_dp_24">
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_medium"
        android:textColor="@color/primary"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/pc_open_title"
        style="@style/title_text_style_bold"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:src="@drawable/x_pc_tips_1"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:src="@drawable/x_pc_tips_2"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/go_open_hotspot"
        android:background="@drawable/btn_primary_round_corner"
        android:layout_width="wrap_content"
        android:layout_height="30dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:minWidth="120dp"
        android:text="@string/x_go"
        android:layout_marginVertical="10dp"
        style="@style/button_text_style_bold"/>
</LinearLayout>
