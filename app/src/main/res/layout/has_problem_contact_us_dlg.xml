<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_large_greater"
        android:textColor="@color/primary"
        android:gravity="center"
        android:layout_gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="24dp"
        android:layout_marginRight="8dp"
        android:text="@string/has_problem_title"
        style="@style/bold_text_style"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_large"
        android:textColor="@color/txt_secondary"
        android:gravity="start|center_vertical"
        android:layout_gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/x_dp_16"
        android:layout_marginTop="@dimen/x_dp_16"
        android:layout_marginRight="@dimen/x_dp_16"
        android:text="@string/has_problem_sub_title"
        android:lineSpacingMultiplier="1.2"
        android:fontFamily="@string/roboto_medium_font"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_medium"
        android:textColor="@color/txt_secondary"
        android:layout_gravity="center"
        android:id="@+id/device_info_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/x_dp_16"
        android:layout_marginTop="@dimen/x_dp_16"
        android:layout_marginRight="@dimen/x_dp_16"
        android:lineSpacingMultiplier="1.2"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/contact_wa_bt"
        android:background="@drawable/btn_primary_round_corner"
        android:paddingLeft="@dimen/x_dp_16"
        android:paddingRight="@dimen/x_dp_16"
        android:layout_width="match_parent"
        android:layout_height="@dimen/x_dp_48"
        android:layout_marginLeft="24dp"
        android:layout_marginTop="32dp"
        android:layout_marginRight="24dp"
        android:text="@string/whatsapp_str"
        android:drawablePadding="8dp"
        android:drawableStart="@drawable/svg_whatsapp"
        android:paddingHorizontal="@dimen/x_dp_16"
        style="@style/button_text_style_bold"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@color/txt_secondary"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/cancel_problem_dlg"
        android:background="?attr/selectableItemBackground"
        android:layout_width="match_parent"
        android:layout_height="@dimen/x_dp_48"
        android:layout_marginLeft="24dp"
        android:layout_marginTop="@dimen/x_dp_16"
        android:layout_marginRight="24dp"
        android:layout_marginBottom="@dimen/x_dp_16"
        android:text="@string/dlg_cancel"
        style="@style/button_text_style_bold"/>
</LinearLayout>
