<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/pc_connected_tabs"
        android:background="@color/primary"
        android:layout_width="match_parent"
        android:layout_height="@dimen/x_dp_40"
        app:layout_constraintTop_toTopOf="parent"
        app:tabIconTint="@drawable/selector_tab_color"
        app:tabIndicatorColor="@color/tab_color_selected"
        app:tabMode="fixed"
        app:tabSelectedTextColor="@color/tab_color_selected"
        app:tabTextAppearance="@style/TabLayoutTextStyle"
        app:tabTextColor="@color/tab_color_normal"/>
    <androidx.viewpager2.widget.ViewPager2
        android:layout_gravity="center"
        android:id="@+id/vPager"
        android:persistentDrawingCache="animation"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:flipInterval="30"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/pc_connected_tabs"/>
</androidx.constraintlayout.widget.ConstraintLayout>
