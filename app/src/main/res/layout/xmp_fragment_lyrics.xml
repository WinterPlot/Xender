<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/xmp_fragment_lyrics_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:textDirection="locale"
    android:layoutDirection="locale">
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_large"
        android:textColor="@color/txt_white"
        android:id="@+id/mp_lyrics_loading_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/x_dp_16"
        android:layout_marginRight="@dimen/x_dp_16"
        android:layout_marginHorizontal="@dimen/x_dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ProgressBar
        android:id="@+id/mp_lyrics_loading_pb"
        android:layout_width="@dimen/x_dp_32"
        android:layout_height="@dimen/x_dp_32"
        android:layout_marginBottom="@dimen/x_dp_16"
        android:indeterminate="true"
        android:indeterminateTint="@color/x_white"
        app:layout_constraintBottom_toTopOf="@+id/mp_lyrics_loading_tv"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/mp_lyrics_loading_group"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="mp_lyrics_loading_pb,mp_lyrics_loading_tv"/>
    <FrameLayout
        android:id="@+id/mp_lyrics_show_layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="@dimen/x_dp_10"
        app:layout_constraintBottom_toTopOf="@+id/mp_bottom_search_from_tv"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_medium"
        android:textColor="#c6c6c6"
        android:gravity="start|center_vertical"
        android:id="@+id/mp_bottom_search_from_tv"
        android:layout_width="0dp"
        android:layout_height="@dimen/x_dp_50"
        android:layout_marginLeft="@dimen/x_dp_16"
        android:layout_marginRight="@dimen/x_dp_16"
        android:layout_marginHorizontal="@dimen/x_dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/mp_bottom_search_iv"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/mp_bottom_search_iv"
        android:layout_width="@dimen/x_dp_50"
        android:layout_height="@dimen/x_dp_50"
        android:scaleType="center"
        android:layout_marginEnd="@dimen/x_dp_4"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/mp_bottom_search_group"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="mp_bottom_search_from_tv,mp_bottom_search_iv"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_medium"
        android:textColor="@color/txt_white"
        android:gravity="center"
        android:id="@+id/mp_bottom_save_save_btn"
        android:layout_width="@dimen/x_dp_120"
        android:layout_height="@dimen/x_dp_30"
        android:layout_marginLeft="@dimen/x_dp_16"
        android:layout_marginRight="@dimen/x_dp_16"
        android:layout_marginBottom="@dimen/x_dp_10"
        android:layout_marginHorizontal="@dimen/x_dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/mp_bottom_save_search_again_btn"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_medium"
        android:textColor="@color/primary"
        android:gravity="center"
        android:id="@+id/mp_bottom_save_search_again_btn"
        android:layout_width="@dimen/x_dp_120"
        android:layout_height="@dimen/x_dp_30"
        android:layout_marginLeft="@dimen/x_dp_16"
        android:layout_marginRight="@dimen/x_dp_16"
        android:layout_marginHorizontal="@dimen/x_dp_16"
        app:layout_constraintBottom_toBottomOf="@+id/mp_bottom_save_save_btn"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/mp_bottom_save_save_btn"
        app:layout_constraintTop_toTopOf="@+id/mp_bottom_save_save_btn"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/mp_bottom_save_group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="mp_bottom_save_save_btn,mp_bottom_save_search_again_btn"/>
    <ViewStub
        android:id="@+id/mp_edit_search_parent"
        android:layout="@layout/mp_lyrics_edit"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_large"
        android:textColor="@color/txt_white"
        android:gravity="center"
        android:id="@+id/mp_bottom_powered_by_tv"
        android:layout_width="match_parent"
        android:layout_height="@dimen/x_dp_50"
        android:layout_marginLeft="@dimen/x_dp_16"
        android:layout_marginRight="@dimen/x_dp_16"
        android:layout_marginHorizontal="@dimen/x_dp_16"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
