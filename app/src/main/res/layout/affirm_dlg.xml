<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="top|center_horizontal"
    android:orientation="vertical"
    android:padding="@dimen/cx_dp_16"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_large"
        android:textColor="@color/txt_primary"
        android:gravity="center"
        android:id="@+id/affirm_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/bold_text_style"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_small"
        android:id="@+id/affirm_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/cx_dp_16"
        app:layout_constraintTop_toBottomOf="@+id/affirm_title"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_medium"
        android:textColor="@color/primary"
        android:gravity="center"
        android:id="@+id/affirm_cancel"
        android:background="@drawable/bg_line_round_corner"
        android:paddingLeft="@dimen/cx_dp_16"
        android:paddingRight="@dimen/cx_dp_16"
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:layout_marginTop="@dimen/cx_dp_42"
        android:text="@string/cx_dlg_cancel"
        android:drawablePadding="10dp"
        android:drawableStart="@drawable/cx_svg_cancel"
        android:paddingHorizontal="@dimen/cx_dp_16"
        app:layout_constraintEnd_toStartOf="@+id/affirm_continue"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/affirm_content"
        style="@style/bold_text_style"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_medium"
        android:textColor="@color/txt_white"
        android:gravity="center"
        android:id="@+id/affirm_continue"
        android:background="@drawable/btn_primary_round_corner"
        android:paddingLeft="@dimen/cx_dp_16"
        android:paddingRight="@dimen/cx_dp_16"
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:text="@string/btn_continue"
        android:drawablePadding="10dp"
        android:drawableStart="@drawable/cx_svg_right"
        android:layout_marginStart="@dimen/cx_dp_16"
        android:paddingHorizontal="@dimen/cx_dp_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/affirm_cancel"
        app:layout_constraintTop_toTopOf="@+id/affirm_cancel"
        style="@style/bold_text_style"/>
</androidx.constraintlayout.widget.ConstraintLayout>
