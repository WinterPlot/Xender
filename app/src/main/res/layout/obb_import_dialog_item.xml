<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="@dimen/x_dp_48">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/obb_import_res_iv"
        android:layout_width="@dimen/x_dp_36"
        android:layout_height="@dimen/x_dp_36"
        android:layout_marginLeft="@dimen/cx_dp_16"
        android:layout_marginRight="@dimen/cx_dp_16"
        android:src="@drawable/svg_obb_files"
        android:scaleType="centerCrop"
        android:layout_marginHorizontal="@dimen/cx_dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/history_item_file_icon_iv_style"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/obb_import_app_iv"
        android:layout_width="20dp"
        android:layout_height="20dp"
        app:layout_constraintBottom_toBottomOf="@+id/obb_import_res_iv"
        app:layout_constraintEnd_toEndOf="@+id/obb_import_res_iv"
        app:layout_constraintRight_toRightOf="@+id/obb_import_res_iv"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/obb_import_iv"
        android:layout_width="@dimen/x_dp_36"
        android:layout_height="match_parent"
        android:layout_marginLeft="@dimen/x_dp_8"
        android:layout_marginRight="@dimen/x_dp_8"
        android:src="@drawable/svg_obb_import"
        android:scaleType="center"
        android:layout_marginHorizontal="@dimen/x_dp_8"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/obb_import_cancel"
        android:layout_width="@dimen/x_dp_36"
        android:layout_height="match_parent"
        android:layout_marginLeft="@dimen/x_dp_8"
        android:layout_marginRight="@dimen/x_dp_8"
        android:src="@drawable/svg_ic_delete"
        android:scaleType="center"
        android:tint="@color/x_red"
        android:layout_marginHorizontal="@dimen/x_dp_8"
        app:layout_constraintEnd_toStartOf="@+id/obb_import_iv"
        app:layout_goneMarginRight="@dimen/x_dp_52"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/obb_importing_app_iv"
        android:visibility="gone"
        android:layout_width="@dimen/x_dp_36"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/x_dp_8"
        android:layout_marginRight="@dimen/x_dp_8"
        android:src="@drawable/cx_svg_waiting"
        android:layout_marginHorizontal="@dimen/x_dp_8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_medium"
        android:ellipsize="end"
        android:gravity="start|top"
        android:id="@+id/obb_res_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/cx_dp_16"
        android:layout_marginRight="@dimen/cx_dp_16"
        android:maxLines="1"
        android:singleLine="false"
        android:layout_marginHorizontal="@dimen/cx_dp_16"
        app:layout_constraintBottom_toBottomOf="@+id/obb_import_res_iv"
        app:layout_constraintEnd_toStartOf="@+id/obb_import_cancel"
        app:layout_constraintLeft_toRightOf="@+id/obb_import_res_iv"
        app:layout_constraintRight_toRightOf="@+id/obb_import_cancel"
        app:layout_constraintStart_toEndOf="@+id/obb_import_res_iv"
        app:layout_constraintTop_toTopOf="@+id/obb_import_res_iv"
        style="@style/history_item_file_name_tv_style"/>
</androidx.constraintlayout.widget.ConstraintLayout>
