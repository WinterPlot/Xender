<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout-v35/mp_lyrics_edit_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent">
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_large"
        android:textColor="@color/x_ccc"
        android:gravity="center"
        android:id="@+id/mp_lyrics_edit_search_title_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/x_dp_96"
        android:layout_marginHorizontal="@dimen/x_dp_16"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatEditText
        android:textSize="@dimen/xshare_text_size_large"
        android:textColor="#222222"
        android:textColorHint="#999999"
        android:gravity="start|center_vertical"
        android:id="@+id/mp_lyrics_edit_search_title_et"
        android:layout_width="match_parent"
        android:layout_height="@dimen/x_dp_48"
        android:layout_marginTop="@dimen/x_dp_16"
        android:maxLines="1"
        android:inputType="textNoSuggestions"
        android:textCursorDrawable="@null"
        android:layout_marginHorizontal="@dimen/x_dp_16"
        android:paddingHorizontal="@dimen/x_dp_16"
        android:useLocalePreferredLineHeightForMinimum="false"
        app:layout_constraintTop_toBottomOf="@+id/mp_lyrics_edit_search_title_tv"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_large"
        android:textColor="@color/x_ccc"
        android:gravity="center"
        android:id="@+id/mp_lyrics_edit_search_artist_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/x_dp_30"
        android:layout_marginHorizontal="@dimen/x_dp_16"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/mp_lyrics_edit_search_title_et"/>
    <androidx.appcompat.widget.AppCompatEditText
        android:textSize="@dimen/xshare_text_size_large"
        android:textColor="#222222"
        android:textColorHint="#999999"
        android:gravity="start|center_vertical"
        android:id="@+id/mp_lyrics_edit_search_artist_et"
        android:layout_width="match_parent"
        android:layout_height="@dimen/x_dp_48"
        android:layout_marginTop="@dimen/x_dp_16"
        android:maxLines="1"
        android:inputType="textNoSuggestions"
        android:textCursorDrawable="@null"
        android:layout_marginHorizontal="@dimen/x_dp_16"
        android:paddingHorizontal="@dimen/x_dp_16"
        android:useLocalePreferredLineHeightForMinimum="false"
        app:layout_constraintTop_toBottomOf="@+id/mp_lyrics_edit_search_artist_tv"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_large"
        android:textStyle="normal"
        android:textColor="#c6c6c6"
        android:gravity="center"
        android:id="@+id/mp_lyrics_edit_search_des_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/x_dp_16"
        android:fontFamily="sans-serif-medium"
        android:layout_marginHorizontal="@dimen/x_dp_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/mp_lyrics_edit_search_artist_et"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/xshare_text_size_large"
        android:textStyle="normal"
        android:textColor="@color/txt_white"
        android:gravity="center"
        android:id="@+id/mp_lyrics_edit_search_btn"
        android:background="@drawable/btn_primary_round_corner"
        android:layout_width="@dimen/x_dp_240"
        android:layout_height="@dimen/x_dp_40"
        android:layout_marginTop="@dimen/x_dp_30"
        android:fontFamily="sans-serif-medium"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/mp_lyrics_edit_search_des_tv"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/mp_lyrics_artist_sug_layout"
        android:background="@drawable/bg_window_2_color_corner_10"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/x_dp_30"
        android:elevation="@dimen/x_dp_2"
        android:layout_marginHorizontal="@dimen/x_dp_16"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/mp_lyrics_edit_search_artist_et"
        app:layout_constraintVertical_bias="0">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/mp_lyrics_artist_sug_recycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/mp_lyrics_artist_sug_close"
            android:padding="@dimen/x_dp_8"
            android:layout_width="@dimen/x_dp_40"
            android:layout_height="@dimen/x_dp_40"
            android:src="@drawable/svg_ad_close"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/txt_secondary"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/mp_lyrics_title_sug_layout"
        android:background="@drawable/bg_window_2_color_corner_10"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/x_dp_30"
        android:elevation="@dimen/x_dp_2"
        android:layout_marginHorizontal="@dimen/x_dp_16"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/mp_lyrics_edit_search_title_et"
        app:layout_constraintVertical_bias="0">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/mp_lyrics_title_sug_recycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/mp_lyrics_title_sug_close"
            android:padding="@dimen/x_dp_8"
            android:layout_width="@dimen/x_dp_40"
            android:layout_height="@dimen/x_dp_40"
            android:src="@drawable/svg_ad_close"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/txt_secondary"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
