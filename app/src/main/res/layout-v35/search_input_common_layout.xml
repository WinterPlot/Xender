<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/search_layout"
    android:focusable="false"
    android:focusableInTouchMode="true"
    android:layout_width="match_parent"
    android:layout_height="32dp"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="4dp">
    <androidx.appcompat.widget.AppCompatEditText
        android:textSize="@dimen/xshare_text_size_small"
        android:textColor="@color/txt_primary"
        android:textColorHint="@color/txt_secondary"
        android:gravity="start|center_vertical"
        android:layout_gravity="start|center_vertical"
        android:id="@+id/common_search_et"
        android:background="@drawable/bg_window_2_color_round_corner"
        android:focusable="true"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:hint="@string/file_search_bar_hint"
        android:singleLine="true"
        android:drawablePadding="7dp"
        android:inputType="textNoSuggestions"
        android:windowSoftInputMode="stateAlwaysVisible"
        android:imeOptions="flagNoFullscreen|actionSearch"
        android:drawableStart="@drawable/svg_search"
        android:paddingStart="9dp"
        android:paddingEnd="32dp"
        android:layout_marginStart="@dimen/x_dp_16"
        android:layout_marginEnd="@dimen/x_dp_16"
        android:drawableTint="@color/x_222_or_fff"
        android:useLocalePreferredLineHeightForMinimum="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/cancel_layout_btn"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/cancel_layout_btn"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="end|center_vertical"
        android:id="@+id/common_clear_search_text"
        android:focusable="false"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/svg_ic_cancel"
        android:tint="@color/x_222_or_fff"
        android:layout_marginEnd="7dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/common_search_et"
        app:layout_constraintRight_toRightOf="@+id/common_search_et"
        app:layout_constraintTop_toTopOf="parent"/>
    <ProgressBar
        android:id="@+id/search_loading"
        android:focusable="false"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="7dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/common_search_et"
        app:layout_constraintRight_toRightOf="@+id/common_search_et"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/ProgressBar.Loading"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@color/txt_primary"
        android:gravity="center"
        android:id="@+id/cancel_layout_btn"
        android:focusable="false"
        android:visibility="gone"
        android:layout_width="50dp"
        android:layout_height="match_parent"
        android:text="@string/messenger_cancel"
        android:layout_marginEnd="@dimen/x_dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
