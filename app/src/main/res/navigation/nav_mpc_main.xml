<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" app:startDestination="@+id/mpc_normal_fragment">
    <fragment
        android:label="MPCPreconditionFragment"
        android:name="com.userlabs.xshare.mppcconnection.ui.MPCPreconditionFragment"
        android:id="@+id/mpc_normal_fragment">
        <action
            android:id="@+id/mpc_normal_to_connecting"
            app:destination="@+id/mpc_connecting_fragment"
            app:enterAnim="@anim/mpc_in_right_left"
            app:exitAnim="@anim/mpc_out_no"
            app:popExitAnim="@anim/mpc_out_left_right"/>
    </fragment>
    <fragment
        android:label="MPCConnectingFragment"
        android:name="com.userlabs.xshare.mppcconnection.ui.MPCConnectingFragment"
        android:id="@+id/mpc_connecting_fragment">
        <action
            android:id="@+id/mpc_connecting_to_connected"
            app:destination="@+id/mpc_connected_fragment"
            app:enterAnim="@anim/mpc_in_right_left"
            app:exitAnim="@anim/mpc_out_no"
            app:popExitAnim="@anim/mpc_out_left_right"
            app:popUpTo="@+id/mpc_connecting_fragment"
            app:popUpToInclusive="true"/>
        <action
            android:id="@+id/mpc_connecting_to_connect_failed"
            app:destination="@+id/mpc_connect_failed_fragment"
            app:enterAnim="@anim/mpc_in_right_left"
            app:exitAnim="@anim/mpc_out_no"
            app:popExitAnim="@anim/mpc_out_left_right"
            app:popUpTo="@+id/mpc_connecting_fragment"
            app:popUpToInclusive="true"/>
    </fragment>
    <fragment
        android:label="MPCConnectedFragment"
        android:name="com.userlabs.xshare.mppcconnection.ui.MPCConnectedFragment"
        android:id="@+id/mpc_connected_fragment">
        <action
            android:id="@+id/mpc_transferred_to_normal"
            app:destination="@+id/mpc_normal_fragment"
            app:enterAnim="@anim/mpc_in_right_left"
            app:exitAnim="@anim/mpc_out_no"
            app:launchSingleTop="true"
            app:popExitAnim="@anim/mpc_out_left_right"
            app:popUpTo="@+id/mpc_normal_fragment"/>
    </fragment>
    <fragment
        android:label="MPCConnectFailedFragment"
        android:name="com.userlabs.xshare.mppcconnection.ui.MPCConnectFailedFragment"
        android:id="@+id/mpc_connect_failed_fragment"/>
</navigation>
