<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" app:startDestination="@+id/ex_main_fragment">
    <fragment
        android:label="ChangePhoneMainFragment"
        android:name="com.userlabs.xshare.importdata.ExFirstFragment"
        android:id="@+id/ex_main_fragment">
        <action
            android:id="@+id/ex_main_to_old_phone_scan"
            app:destination="@+id/ex_old_phone_scan_fragment"
            app:enterAnim="@anim/ex_in_right_left"
            app:exitAnim="@anim/ex_out_no"
            app:popExitAnim="@anim/ex_out_left_right"/>
        <action
            android:id="@+id/ex_main_to_new_phone_import_from"
            app:destination="@+id/ex_new_phone_import_from_fragment"
            app:enterAnim="@anim/ex_in_right_left"
            app:exitAnim="@anim/ex_out_no"
            app:popExitAnim="@anim/ex_out_left_right"/>
    </fragment>
    <fragment
        android:label="NewPhoneImportFromFragment"
        android:name="com.userlabs.xshare.importdata.NewPhoneImportFromFragment"
        android:id="@+id/ex_new_phone_import_from_fragment">
        <action
            android:id="@+id/ex_import_from_to_qr_android"
            app:destination="@+id/ex_new_phone_qr_for_android_fragment"
            app:enterAnim="@anim/ex_in_right_left"
            app:exitAnim="@anim/ex_out_no"
            app:popExitAnim="@anim/ex_out_left_right"
            app:popUpTo="@+id/ex_new_phone_import_from_fragment"
            app:popUpToInclusive="true"/>
        <action
            android:id="@+id/ex_import_from_to_qr_iphone"
            app:destination="@+id/ex_new_phone_qr_for_iphone_fragment"
            app:enterAnim="@anim/ex_in_right_left"
            app:exitAnim="@anim/ex_out_no"
            app:popExitAnim="@anim/ex_out_left_right"
            app:popUpTo="@+id/ex_new_phone_import_from_fragment"
            app:popUpToInclusive="true"/>
    </fragment>
    <fragment
        android:label="NewPhoneQrcodeForIphoneFragment"
        android:name="com.userlabs.xshare.importdata.NewPhoneQrcodeForIphoneFragment"
        android:id="@+id/ex_new_phone_qr_for_iphone_fragment">
        <action
            android:id="@+id/ex_qr_iphone_to_wait_iphone_join"
            app:destination="@+id/ex_new_phone_wait_iphone_fragment"
            app:enterAnim="@anim/ex_in_right_left"
            app:exitAnim="@anim/ex_out_no"
            app:popExitAnim="@anim/ex_out_left_right"
            app:popUpTo="@+id/ex_new_phone_qr_for_iphone_fragment"
            app:popUpToInclusive="true"/>
    </fragment>
    <fragment
        android:label="NewPhoneQrcodeFragment"
        android:name="com.userlabs.xshare.importdata.NewPhoneQrcodeFragment"
        android:id="@+id/ex_new_phone_qr_for_android_fragment">
        <action
            android:id="@+id/ex_qr_android_to_wait_join"
            app:destination="@+id/ex_new_phone_wait_old_android_fragment"
            app:enterAnim="@anim/ex_in_right_left"
            app:exitAnim="@anim/ex_out_no"
            app:popExitAnim="@anim/ex_out_left_right"
            app:popUpTo="@+id/ex_new_phone_qr_for_android_fragment"
            app:popUpToInclusive="true"/>
        <action
            android:id="@+id/ex_qr_android_to_wait_download_me"
            app:destination="@+id/ex_new_phone_wait_download_xd_fragment"
            app:enterAnim="@anim/ex_in_right_left"
            app:exitAnim="@anim/ex_out_no"
            app:popExitAnim="@anim/ex_out_left_right"
            app:popUpTo="@+id/ex_new_phone_qr_for_android_fragment"
            app:popUpToInclusive="true"/>
    </fragment>
    <fragment
        android:label="NewPhoneWaitIPhoneJoinFragment"
        android:name="com.userlabs.xshare.importdata.NewPhoneWaitIPhoneJoinFragment"
        android:id="@+id/ex_new_phone_wait_iphone_fragment">
        <action
            android:id="@+id/ex_wait_iphone_to_reduplicate"
            app:destination="@+id/ex_new_phone_reduplicate_fragment"
            app:enterAnim="@anim/ex_in_right_left"
            app:exitAnim="@anim/ex_out_no"
            app:popExitAnim="@anim/ex_out_left_right"
            app:popUpTo="@+id/ex_new_phone_wait_iphone_fragment"
            app:popUpToInclusive="true"/>
    </fragment>
    <fragment
        android:label="NewPhoneWaitOldPhoneDownloadMeFragment"
        android:name="com.userlabs.xshare.importdata.NewPhoneWaitOldPhoneDownloadMeFragment"
        android:id="@+id/ex_new_phone_wait_download_xd_fragment">
        <action
            android:id="@+id/ex_wait_down_xd_to_wait_join"
            app:destination="@+id/ex_new_phone_wait_old_android_fragment"
            app:enterAnim="@anim/ex_in_right_left"
            app:exitAnim="@anim/ex_out_no"
            app:popExitAnim="@anim/ex_out_left_right"
            app:popUpTo="@+id/ex_new_phone_wait_download_xd_fragment"
            app:popUpToInclusive="true"/>
    </fragment>
    <fragment
        android:label="NewPhoneWaitOldPhoneJoinFragment"
        android:name="com.userlabs.xshare.importdata.NewPhoneWaitOldPhoneJoinFragment"
        android:id="@+id/ex_new_phone_wait_old_android_fragment">
        <action
            android:id="@+id/ex_wait_old_android_to_reduplicate"
            app:destination="@+id/ex_new_phone_reduplicate_fragment"
            app:enterAnim="@anim/ex_in_right_left"
            app:exitAnim="@anim/ex_out_no"
            app:popExitAnim="@anim/ex_out_left_right"
            app:popUpTo="@+id/ex_new_phone_wait_old_android_fragment"
            app:popUpToInclusive="true"/>
    </fragment>
    <fragment
        android:label="NewPhoneReduplicateFragment"
        android:name="com.userlabs.xshare.importdata.NewPhoneReduplicateFragment"
        android:id="@+id/ex_new_phone_reduplicate_fragment"/>
    <fragment
        android:label="OldPhoneScanFragment"
        android:name="com.userlabs.xshare.importdata.OldPhoneJoinFragment"
        android:id="@+id/ex_old_phone_scan_fragment"/>
    <fragment
        android:label="OldPhoneTransferFragment"
        android:name="com.userlabs.xshare.importdata.OldPhoneTransferFragment"
        android:id="@+id/ex_old_phone_transfer_fragment"/>
</navigation>
