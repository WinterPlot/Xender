<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" app:startDestination="@+id/x_video_time_fragment">
    <fragment
        android:label="video_sort_time"
        android:name="com.userlabs.xshare.ui.fragment.res.MediaVideoTimeSortFragment"
        android:id="@+id/x_video_time_fragment">
        <action
            android:id="@+id/x_video_time_to_search_fragment"
            app:destination="@+id/x_video_search_fragment"/>
        <action
            android:id="@+id/x_video_time_to_name_fragment"
            app:destination="@+id/x_video_fragment"/>
    </fragment>
    <fragment
        android:label="video_sort_name"
        android:name="com.userlabs.xshare.ui.fragment.res.MediaVideoNameSortFragment"
        android:id="@+id/x_video_fragment">
        <action
            android:id="@+id/x_video_name_to_search_fragment"
            app:destination="@+id/x_video_search_fragment"/>
    </fragment>
    <fragment
        android:label="v_search"
        android:name="com.userlabs.xshare.ui.fragment.res.MediaVideoSearchFragment"
        android:id="@+id/x_video_search_fragment"/>
</navigation>
