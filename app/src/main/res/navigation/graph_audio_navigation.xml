<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" app:startDestination="@+id/x_audio_time_sort_fragment">
    <fragment
        android:label="time_sort"
        android:name="com.userlabs.xshare.ui.fragment.res.AudioTimeSortFragment"
        android:id="@+id/x_audio_time_sort_fragment">
        <action
            android:id="@+id/x_audio_time_to_search_fragment"
            app:destination="@+id/x_audio_search_fragment"/>
        <action
            android:id="@+id/x_audio_time_to_name_fragment"
            app:destination="@+id/x_audio_name_sort_fragment"/>
    </fragment>
    <fragment
        android:label="name_sort"
        android:name="com.userlabs.xshare.ui.fragment.res.AudioNameSortFragment"
        android:id="@+id/x_audio_name_sort_fragment">
        <action
            android:id="@+id/x_audio_name_to_search_fragment"
            app:destination="@+id/x_audio_search_fragment"/>
    </fragment>
    <fragment
        android:label="a_search"
        android:name="com.userlabs.xshare.ui.fragment.res.AudioSearchFragment"
        android:id="@+id/x_audio_search_fragment"/>
</navigation>
